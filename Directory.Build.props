<Project>

  <!--
    What every project in the solution shares. Anything only one project needs stays in its
    own csproj, so this file stays short enough to read.
  -->
  <PropertyGroup>
    <!--
      The Windows version in the target framework is what makes the type library for
      Windows.Graphics.Capture available, and the capture actions need it to read a window that
      another window is covering. It is a ceiling on the API the build may use, not a floor on
      where the program runs: a machine older than this one has no graphics capture, so those
      actions fall back to the other ways of reading the screen. See WindowsScreenDevice.
    -->
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- A warning is a defect that has not been fixed yet, so the build stops on one. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
