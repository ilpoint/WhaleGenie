<Solution>
  <!--
    The library on its own: the engine and the two Windows projects that implement its contracts,
    plus their tests. It is buildable, testable and packable without the editor, which is what
    "the engine can be taken out" has to mean in practice. A frontend — the Avalonia shell today,
    a WebView one later — references WhaleGenie.Platform.Windows and gets all three.

    Keep this list in step with the packaging: anything a consumer gets by referencing one package
    belongs here, and anything that is only the editor's does not.
  -->
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="Release" />
    <Platform Name="x64" />
  </Configurations>
  <Project Path="src/WhaleGenie.Core/WhaleGenie.Core.csproj">
    <Platform Solution="*|x64" Project="x64" />
  </Project>
  <Project Path="src/WhaleGenie.GraphicsCapture/WhaleGenie.GraphicsCapture.csproj">
    <Platform Solution="*|x64" Project="x64" />
  </Project>
  <Project Path="src/WhaleGenie.Platform.Windows/WhaleGenie.Platform.Windows.csproj">
    <Platform Solution="*|x64" Project="x64" />
  </Project>
  <Project Path="tests/WhaleGenie.TestSupport/WhaleGenie.TestSupport.csproj">
    <Platform Solution="*|x64" Project="x64" />
  </Project>
  <Project Path="tests/WhaleGenie.Core.Tests/WhaleGenie.Core.Tests.csproj">
    <Platform Solution="*|x64" Project="x64" />
  </Project>
  <Project Path="tests/WhaleGenie.GraphicsCapture.Tests/WhaleGenie.GraphicsCapture.Tests.csproj">
    <Platform Solution="*|x64" Project="x64" />
  </Project>
  <Project Path="tests/WhaleGenie.Platform.Tests/WhaleGenie.Platform.Tests.csproj">
    <Platform Solution="*|x64" Project="x64" />
  </Project>
</Solution>
