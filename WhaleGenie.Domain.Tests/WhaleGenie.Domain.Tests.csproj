<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The document, the project and the things around a run that need no window: the macro file
    format, the design-time checks, the variables a project keeps, the triggers as values, and the
    services the application layer offers a run. The window suite keeps what drives the window; a
    check that never opens one belongs here, where it costs a second rather than a window toolkit.
  -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <!--
      The test host asks the process that started it to end it when that process goes away. On this
      machine the host is refused the handle (Win32Exception 5) and the run stops before discovery,
      which reads as "the test host exited with an error". This is the switch the SDK itself uses
      for UWP tools; the only thing given up is the automatic clean-up of a host left behind by a
      killed run. The platform suite needs the same, for the same reason.
    -->
    <_MSTestEnableParentProcessQuery>false</_MSTestEnableParentProcessQuery>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WhaleGenie.App\WhaleGenie.App.csproj" />
    <ProjectReference Include="..\WhaleGenie.Core\WhaleGenie.Core.csproj" />
    <ProjectReference Include="..\WhaleGenie.Domain\WhaleGenie.Domain.csproj" />
    <ProjectReference Include="..\WhaleGenie.Localization\WhaleGenie.Localization.csproj" />
    <ProjectReference Include="..\WhaleGenie.App.TestSupport\WhaleGenie.App.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="WhaleGenie.Tests.Support" />
  </ItemGroup>

</Project>
