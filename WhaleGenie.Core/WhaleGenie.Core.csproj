<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageReference Include="OpenCvSharp5.AvaloniaExtensions" Version="5.0.0.20260712" />
    <PackageReference Include="OpenCvSharp5.Windows" Version="5.0.0.20260702" />
    <PackageReference Include="Sdcb.SimdPaddleOCR" Version="2.0.0" />
    <PackageReference Include="Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny" Version="1.0.0" />
    <PackageReference Include="SharpHook" Version="8.0.0" />
    <PackageReference Include="Viiper.Client" Version="0.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Taking a picture of the screen: the ways Windows hands pixels over, and which of them to reach
      for. The engine says what it is looking at; what the machine can do with that is that project's
      business, which is what keeps Direct3D and DXGI out of the engine.
    -->
    <ProjectReference Include="..\WhaleGenie.GraphicsCapture\WhaleGenie.GraphicsCapture.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine tests look at how a step's input is routed between the devices. -->
    <InternalsVisibleTo Include="WhaleGenie.Core.Tests" />
  </ItemGroup>

</Project>
