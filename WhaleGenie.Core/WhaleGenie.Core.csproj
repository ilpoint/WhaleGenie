<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The engine reads and writes CSV files itself: a table step is about the data, not about the
      machine, so the parser stays here rather than moving down with the Windows adapters.
    -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <!--
      The key vocabulary is the one exception: a macro names keys, and the engine has to turn those
      names into the codes the hook sends. That table is spelled in SharpHook's own enum today, so
      the enum — not the hook — comes with it. Replacing it with a Core-owned code table is the
      next step; then this reference goes too.
    -->
  </ItemGroup>

  <ItemGroup>
    <!--
      Taking a picture of the screen: the ways Windows hands pixels over, and which of them to reach
      for. The engine says what it is looking at; what the machine can do with that is that project's
      business, which is what keeps Direct3D and DXGI out of the engine.
    -->
    <ProjectReference Include="..\WhaleGenie.GraphicsCapture\WhaleGenie.GraphicsCapture.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine tests look at how a step's input is routed between the devices. -->
    <InternalsVisibleTo Include="WhaleGenie.Core.Tests" />
    <InternalsVisibleTo Include="WhaleGenie.TestSupport" />
    <InternalsVisibleTo Include="WhaleGenie.Platform.Tests" />
    <!-- The Windows adapters read the engine's key table; nothing else of Core is theirs to use. -->
    <InternalsVisibleTo Include="WhaleGenie.Platform.Windows" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The action facts travel with the engine: a headless run, a design-time check and the editor
      all read the same file, so none of them can answer from a different parameter declaration.
    -->
    <EmbeddedResource Include="Execution\ActionSemantics.json" />
  </ItemGroup>

</Project>
