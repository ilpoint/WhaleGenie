<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      层 1：改 Fluent 模板自己会读的那批资源键，让裸控件（不带类名的 Button、TextBox、ComboBox）
      一出生就是我们这套颜色。层 3（Controls.axaml）只补度量与偏离默认的部分，能靠这里给的一律不给。

      键名是 `WhaleGenie.csproj` 里那个 Avalonia 版本自带的 FluentTheme 中真实存在的那些，逐个
      从主题资源里枚举出来核对过（当前共 830 个键）。写错一个键名不会报错、也不会有任何效果——静默地"看起来正常"，所以这个文件
      里不许出现没核过的名字。

      这份清单只覆盖设计规范里给了取值的四个族（Button / TextControl / ComboBox / ToolTip）加四个
      度量键。ScrollBar、MenuFlyout、CheckBox、ToggleSwitch、ToggleButton、TableView 六个族的四态
      取值规范里还没给，先不写：凭空补 130 个键的取值，等于把设计决定悄悄做在实现里。

      注意这里的别名只能引用同一层能看见的键：主题变体里的别名能引 Tokens 变体里的颜色，文件末尾
      那些与明暗无关的别名只能引 Tokens 里同在最外层的键（圆角、字号那批）。放在最外层去引
      `FocusRing` 会在取值时抛 KeyNotFound——颜色只存在于变体里，变体外面看不见它。

      取值一律引 Tokens.axaml 的令牌，不写字面量。与 Fluent 默认相同的键不写——写了只是把默认值
      抄一遍，还让人以为我们特意定过。

      **"裸值"指十六进制和数字。** `Transparent` 是语言常量、不是我们定的颜色，可以直接写：它没有
      会漂移的值，也不参与对比度核算（底透出来，实际颜色由底下那层决定，与 `OverlayHover` 那类
      叠层同理）。区别在"有没有值"：`OverlayHover` / `OverlayPressed` 是令牌，因为它们有半透明
      的值、且随主题变；`Transparent` 没有值。**别为"不画"开令牌**：每个键自己定义一支
      `Transparent` 画笔就够，共享一个键只多一处要同步。
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!--
              WinUI 的文本填充与选中指示条。主题里的控件（页签、菜单、提示）读的是这一族名字，
              而不是我们原先覆盖的 TextControl*/Button* 那批；少了它们，页签的选中条会是主题自己的
              蓝色，页签文字也会落到它自己的灰上——一层看着"没生效"的样式，其实缺的是键名。
            -->
            <StaticResource x:Key="TextFillColorPrimaryBrush" ResourceKey="TextPrimary" />
            <StaticResource x:Key="TextFillColorSecondaryBrush" ResourceKey="TextSecondary" />
            <StaticResource x:Key="TextFillColorTertiaryBrush" ResourceKey="TextTertiary" />
            <StaticResource x:Key="TextFillColorDisabledBrush" ResourceKey="TextDisabled" />
            <StaticResource x:Key="PivotHeaderItemSelectedPipeFill" ResourceKey="AccentFill" />
            <StaticResource x:Key="SystemAccentColor" ResourceKey="AccentFillColor" />
            <StaticResource x:Key="SystemAccentColorLight1" ResourceKey="AccentFillHoverColor" />
            <StaticResource x:Key="SystemAccentColorLight2" ResourceKey="AccentFillHoverColor" />
            <StaticResource x:Key="SystemAccentColorDark1" ResourceKey="AccentFillPressedColor" />
            <StaticResource x:Key="SystemAccentColorDark2" ResourceKey="AccentFillPressedColor" />
            <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="AccentFill" />
            <!-- 裸按钮、也是 Button.Secondary 的底：次按钮的样子由这里给四态 -->
            <StaticResource x:Key="ButtonBackground" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceControlHover" />
            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfaceControlPressed" />
            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="ButtonForeground" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="BorderControl" />
            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="BorderControlHover" />
            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="BorderControl" />
            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="ButtonPadding" ResourceKey="PadControl" />

            <!-- 输入框：四态都在这里，层 3 只补高度 -->
            <StaticResource x:Key="TextControlBackground" ResourceKey="SurfaceField" />
            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SurfaceField" />
            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SurfaceField" />
            <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="TextControlForeground" ResourceKey="TextPrimary" />
            <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextPrimary" />
            <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="BorderControl" />
            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="BorderControlHover" />
            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AccentFill" />
            <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TextTertiary" />
            <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="TextTertiary" />
            <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="TextTertiary" />
            <StaticResource x:Key="TextControlPlaceholderForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="TextControlThemePadding" ResourceKey="PadField" />

            <!-- 下拉：输入框的样子 + 弹出的那一层 -->
            <StaticResource x:Key="ComboBoxBackground" ResourceKey="SurfaceField" />
            <StaticResource x:Key="ComboBoxBackgroundUnfocused" ResourceKey="SurfaceField" />
            <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SurfaceField" />
            <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="SurfaceField" />
            <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="ComboBoxForeground" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ComboBoxForegroundFocused" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ComboBoxForegroundFocusedPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ComboBoxForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="BorderControl" />
            <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="BorderControlHover" />
            <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="BorderControl" />
            <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="SurfaceFlyout" />
            <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="BorderControl" />
            <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="TextSecondary" />
            <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocused" ResourceKey="TextSecondary" />
            <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" ResourceKey="TextSecondary" />
            <StaticResource x:Key="ComboBoxDropDownGlyphForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="ComboBoxPlaceHolderForeground" ResourceKey="TextTertiary" />
            <StaticResource x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" ResourceKey="TextTertiary" />
            <StaticResource x:Key="ComboBoxItemBackground" ResourceKey="SurfaceFlyout" />
            <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="SurfaceHover" />
            <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="SurfacePressed" />
            <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="AccentSurface" />
            <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="AccentSurface" />
            <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="AccentSurface" />
            <StaticResource x:Key="ComboBoxItemBackgroundSelectedDisabled" ResourceKey="SurfaceFlyout" />
            <StaticResource x:Key="ComboBoxItemBackgroundDisabled" ResourceKey="SurfaceFlyout" />
            <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ComboBoxItemForegroundPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="AccentText" />
            <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="AccentText" />
            <StaticResource x:Key="ComboBoxItemForegroundSelectedPressed" ResourceKey="AccentText" />
            <StaticResource x:Key="ComboBoxItemForegroundSelectedDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="ComboBoxItemForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="ComboBoxItemThemePadding" ResourceKey="PadRow" />

            <!--
              悬停提示：浮层底 + 一层描边。这四个键此刻还被 App.axaml 末尾那条 `<Style Selector="ToolTip">`
              压着（样式比主题资源更靠前），要等那条样式搬进 Controls.axaml 才会真的生效。
            -->
            <StaticResource x:Key="ToolTipBackground" ResourceKey="SurfaceFlyout" />
            <StaticResource x:Key="ToolTipBorderBrush" ResourceKey="BorderControl" />
            <StaticResource x:Key="ToolTipForeground" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ToolTipBorderThemePadding" ResourceKey="PadRow" />

            <!-- 焦点环：模板读这两个刷子。厚度没有键（主题里只有这两个刷子键），厚度只能由 FocusAdorner 给。 -->
            <StaticResource x:Key="SystemControlFocusVisualPrimaryBrush" ResourceKey="FocusRing" />
            <StaticResource x:Key="SystemControlFocusVisualSecondaryBrush" ResourceKey="FocusRingInner" />

            <!-- 滚动条：轨道透明，滑块是唯一看得见的东西 -->
            <StaticResource x:Key="ScrollBarThumbBackgroundColor" ResourceKey="BorderControlColor" />
            <StaticResource x:Key="ScrollBarThumbFillPointerOver" ResourceKey="BorderControlHover" />
            <StaticResource x:Key="ScrollBarThumbFillPressed" ResourceKey="BorderStrong" />
            <StaticResource x:Key="ScrollBarThumbFillDisabled" ResourceKey="BorderSubtle" />
            <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="Transparent" />
            <StaticResource x:Key="ScrollBarPanningThumbBackground" ResourceKey="BorderControl" />
            <StaticResource x:Key="ScrollBarForeground" ResourceKey="TextSecondary" />

            <!-- 弹出菜单：浮层底，项静息透明 -->
            <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="SurfaceFlyout" />
            <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="BorderSubtle" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent" />
            <StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="SurfaceHover" />
            <StaticResource x:Key="MenuFlyoutItemBackgroundPressed" ResourceKey="SurfacePressed" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundDisabled" Color="Transparent" />
            <StaticResource x:Key="MenuFlyoutItemForeground" ResourceKey="TextPrimary" />
            <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="MenuFlyoutItemForegroundPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="MenuFlyoutItemForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" ResourceKey="TextTertiary" />
            <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" ResourceKey="TextTertiary" />
            <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" ResourceKey="TextTertiary" />
            <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="MenuFlyoutSubItemChevron" ResourceKey="TextSecondary" />
            <StaticResource x:Key="MenuFlyoutSubItemChevronPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="MenuFlyoutSubItemChevronPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="MenuFlyoutSubItemChevronDisabled" ResourceKey="TextDisabled" />

            <!-- 勾选框：未选是输入框的样子，选中是强调色，勾形取按钮上的白 -->
            <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked" ResourceKey="SurfaceField" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" ResourceKey="SurfaceControlHover" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" ResourceKey="SurfaceControlPressed" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUnchecked" ResourceKey="BorderControl" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" ResourceKey="BorderControlHover" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" ResourceKey="BorderControl" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundUnchecked" ResourceKey="TextSecondary" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundUncheckedPointerOver" ResourceKey="TextSecondary" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundUncheckedPressed" ResourceKey="TextSecondary" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundUncheckedDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="CheckBoxForegroundUnchecked" ResourceKey="TextPrimary" />
            <StaticResource x:Key="CheckBoxForegroundUncheckedPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="CheckBoxForegroundUncheckedPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="CheckBoxForegroundUncheckedDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="AccentFill" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="CheckBoxForegroundChecked" ResourceKey="TextPrimary" />
            <StaticResource x:Key="CheckBoxForegroundCheckedPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="CheckBoxForegroundCheckedPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="CheckBoxForegroundCheckedDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminate" ResourceKey="AccentFill" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminateDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminateDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminate" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminateDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="CheckBoxForegroundIndeterminate" ResourceKey="TextPrimary" />
            <StaticResource x:Key="CheckBoxForegroundIndeterminatePointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="CheckBoxForegroundIndeterminatePressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="CheckBoxForegroundIndeterminateDisabled" ResourceKey="TextDisabled" />

            <!-- 开关：开态强调色，滑块取按钮上的白 -->
            <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="AccentFill" />
            <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="ToggleSwitchFillOnDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="AccentFill" />
            <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="ToggleSwitchStrokeOnDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="ToggleSwitchKnobFillOnPointerOver" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="ToggleSwitchKnobFillOnPressed" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="ToggleSwitchKnobFillOnDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="ToggleSwitchFillOff" ResourceKey="SurfaceField" />
            <StaticResource x:Key="ToggleSwitchFillOffPointerOver" ResourceKey="SurfaceControlHover" />
            <StaticResource x:Key="ToggleSwitchFillOffPressed" ResourceKey="SurfaceControlPressed" />
            <StaticResource x:Key="ToggleSwitchStrokeOff" ResourceKey="BorderControl" />
            <StaticResource x:Key="ToggleSwitchStrokeOffPointerOver" ResourceKey="BorderControlHover" />
            <StaticResource x:Key="ToggleSwitchStrokeOffPressed" ResourceKey="BorderControl" />
            <StaticResource x:Key="ToggleSwitchStrokeOffDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="ToggleSwitchKnobFillOff" ResourceKey="TextSecondary" />
            <StaticResource x:Key="ToggleSwitchKnobFillOffPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ToggleSwitchKnobFillOffPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ToggleSwitchKnobFillOffDisabled" ResourceKey="TextDisabled" />
            <SolidColorBrush x:Key="ToggleSwitchContainerBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPressed" Color="Transparent" />
            <StaticResource x:Key="ToggleSwitchContentForeground" ResourceKey="TextPrimary" />

            <!-- 开关按钮：未选是次按钮，选中是主按钮，六态写满（空一格就露 Fluent 默认） -->
            <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="ToggleButtonForeground" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="BorderControl" />
            <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SurfaceControlHover" />
            <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="BorderControlHover" />
            <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SurfaceControlPressed" />
            <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="BorderControl" />
            <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="ToggleButtonForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="ToggleButtonBorderBrushDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="AccentFill" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="AccentFill" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="ToggleButtonBackgroundIndeterminate" ResourceKey="AccentFill" />
            <StaticResource x:Key="ToggleButtonBackgroundIndeterminatePointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="ToggleButtonBackgroundIndeterminatePressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="ToggleButtonBackgroundIndeterminateDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="ToggleButtonForegroundIndeterminate" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="ToggleButtonForegroundIndeterminatePointerOver" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="ToggleButtonForegroundIndeterminatePressed" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="ToggleButtonForegroundIndeterminateDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="ToggleButtonBorderBrushIndeterminate" ResourceKey="AccentFill" />
            <StaticResource x:Key="ToggleButtonBorderBrushIndeterminatePointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="ToggleButtonBorderBrushIndeterminatePressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="ToggleButtonBorderBrushIndeterminateDisabled" ResourceKey="BorderSubtle" />

            <!-- 表格：行底卡片色，靠 hover 与选中区分（表头底色没有键，只有分隔线） -->
            <StaticResource x:Key="TableViewRowBackground" ResourceKey="SurfaceCard" />
            <StaticResource x:Key="TableViewRowBackgroundPointerOver" ResourceKey="SurfaceHover" />
            <StaticResource x:Key="TableViewRowBackgroundPressed" ResourceKey="SurfacePressed" />
            <StaticResource x:Key="TableViewRowBackgroundDisabled" ResourceKey="SurfaceCard" />
            <StaticResource x:Key="TableViewRowBackgroundSelected" ResourceKey="AccentSurface" />
            <StaticResource x:Key="TableViewRowBackgroundSelectedPointerOver" ResourceKey="AccentSurface" />
            <StaticResource x:Key="TableViewRowBackgroundSelectedPressed" ResourceKey="AccentSurface" />
            <StaticResource x:Key="TableViewRowForegroundPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="TableViewRowForegroundPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="TableViewRowForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="TableViewRowForegroundSelected" ResourceKey="AccentText" />
            <StaticResource x:Key="TableViewRowForegroundSelectedPointerOver" ResourceKey="AccentText" />
            <StaticResource x:Key="TableViewRowForegroundSelectedPressed" ResourceKey="AccentText" />
            <StaticResource x:Key="TableViewColumnHeaderSeparatorBackground" ResourceKey="BorderSubtle" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="TextFillColorPrimaryBrush" ResourceKey="TextPrimary" />
            <StaticResource x:Key="TextFillColorSecondaryBrush" ResourceKey="TextSecondary" />
            <StaticResource x:Key="TextFillColorTertiaryBrush" ResourceKey="TextTertiary" />
            <StaticResource x:Key="TextFillColorDisabledBrush" ResourceKey="TextDisabled" />
            <StaticResource x:Key="PivotHeaderItemSelectedPipeFill" ResourceKey="AccentFill" />
            <StaticResource x:Key="SystemAccentColor" ResourceKey="AccentFillColor" />
            <StaticResource x:Key="SystemAccentColorLight1" ResourceKey="AccentFillHoverColor" />
            <StaticResource x:Key="SystemAccentColorLight2" ResourceKey="AccentFillHoverColor" />
            <StaticResource x:Key="SystemAccentColorDark1" ResourceKey="AccentFillPressedColor" />
            <StaticResource x:Key="SystemAccentColorDark2" ResourceKey="AccentFillPressedColor" />
            <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="AccentFill" />
            <!-- 裸按钮、也是 Button.Secondary 的底：次按钮的样子由这里给四态 -->
            <StaticResource x:Key="ButtonBackground" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceControlHover" />
            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfaceControlPressed" />
            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="ButtonForeground" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="BorderControl" />
            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="BorderControlHover" />
            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="BorderControl" />
            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="ButtonPadding" ResourceKey="PadControl" />

            <!-- 输入框：四态都在这里，层 3 只补高度 -->
            <StaticResource x:Key="TextControlBackground" ResourceKey="SurfaceField" />
            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SurfaceField" />
            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SurfaceField" />
            <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="TextControlForeground" ResourceKey="TextPrimary" />
            <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextPrimary" />
            <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="BorderControl" />
            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="BorderControlHover" />
            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AccentFill" />
            <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TextTertiary" />
            <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="TextTertiary" />
            <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="TextTertiary" />
            <StaticResource x:Key="TextControlPlaceholderForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="TextControlThemePadding" ResourceKey="PadField" />

            <!-- 下拉：输入框的样子 + 弹出的那一层 -->
            <StaticResource x:Key="ComboBoxBackground" ResourceKey="SurfaceField" />
            <StaticResource x:Key="ComboBoxBackgroundUnfocused" ResourceKey="SurfaceField" />
            <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SurfaceField" />
            <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="SurfaceField" />
            <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="ComboBoxForeground" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ComboBoxForegroundFocused" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ComboBoxForegroundFocusedPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ComboBoxForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="BorderControl" />
            <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="BorderControlHover" />
            <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="BorderControl" />
            <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="SurfaceFlyout" />
            <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="BorderControl" />
            <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="TextSecondary" />
            <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocused" ResourceKey="TextSecondary" />
            <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" ResourceKey="TextSecondary" />
            <StaticResource x:Key="ComboBoxDropDownGlyphForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="ComboBoxPlaceHolderForeground" ResourceKey="TextTertiary" />
            <StaticResource x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" ResourceKey="TextTertiary" />
            <StaticResource x:Key="ComboBoxItemBackground" ResourceKey="SurfaceFlyout" />
            <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="SurfaceHover" />
            <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="SurfacePressed" />
            <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="AccentSurface" />
            <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="AccentSurface" />
            <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="AccentSurface" />
            <StaticResource x:Key="ComboBoxItemBackgroundSelectedDisabled" ResourceKey="SurfaceFlyout" />
            <StaticResource x:Key="ComboBoxItemBackgroundDisabled" ResourceKey="SurfaceFlyout" />
            <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ComboBoxItemForegroundPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="AccentText" />
            <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="AccentText" />
            <StaticResource x:Key="ComboBoxItemForegroundSelectedPressed" ResourceKey="AccentText" />
            <StaticResource x:Key="ComboBoxItemForegroundSelectedDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="ComboBoxItemForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="ComboBoxItemThemePadding" ResourceKey="PadRow" />

            <!--
              悬停提示：浮层底 + 一层描边。这四个键此刻还被 App.axaml 末尾那条 `<Style Selector="ToolTip">`
              压着（样式比主题资源更靠前），要等那条样式搬进 Controls.axaml 才会真的生效。
            -->
            <StaticResource x:Key="ToolTipBackground" ResourceKey="SurfaceFlyout" />
            <StaticResource x:Key="ToolTipBorderBrush" ResourceKey="BorderControl" />
            <StaticResource x:Key="ToolTipForeground" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ToolTipBorderThemePadding" ResourceKey="PadRow" />

            <!-- 焦点环：模板读这两个刷子。厚度没有键（主题里只有这两个刷子键），厚度只能由 FocusAdorner 给。 -->
            <StaticResource x:Key="SystemControlFocusVisualPrimaryBrush" ResourceKey="FocusRing" />
            <StaticResource x:Key="SystemControlFocusVisualSecondaryBrush" ResourceKey="FocusRingInner" />

            <!-- 滚动条：轨道透明，滑块是唯一看得见的东西 -->
            <StaticResource x:Key="ScrollBarThumbBackgroundColor" ResourceKey="BorderControlColor" />
            <StaticResource x:Key="ScrollBarThumbFillPointerOver" ResourceKey="BorderControlHover" />
            <StaticResource x:Key="ScrollBarThumbFillPressed" ResourceKey="BorderStrong" />
            <StaticResource x:Key="ScrollBarThumbFillDisabled" ResourceKey="BorderSubtle" />
            <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="Transparent" />
            <StaticResource x:Key="ScrollBarPanningThumbBackground" ResourceKey="BorderControl" />
            <StaticResource x:Key="ScrollBarForeground" ResourceKey="TextSecondary" />

            <!-- 弹出菜单：浮层底，项静息透明 -->
            <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="SurfaceFlyout" />
            <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="BorderSubtle" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent" />
            <StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="SurfaceHover" />
            <StaticResource x:Key="MenuFlyoutItemBackgroundPressed" ResourceKey="SurfacePressed" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundDisabled" Color="Transparent" />
            <StaticResource x:Key="MenuFlyoutItemForeground" ResourceKey="TextPrimary" />
            <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="MenuFlyoutItemForegroundPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="MenuFlyoutItemForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" ResourceKey="TextTertiary" />
            <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" ResourceKey="TextTertiary" />
            <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" ResourceKey="TextTertiary" />
            <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="MenuFlyoutSubItemChevron" ResourceKey="TextSecondary" />
            <StaticResource x:Key="MenuFlyoutSubItemChevronPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="MenuFlyoutSubItemChevronPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="MenuFlyoutSubItemChevronDisabled" ResourceKey="TextDisabled" />

            <!-- 勾选框：未选是输入框的样子，选中是强调色，勾形取按钮上的白 -->
            <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked" ResourceKey="SurfaceField" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" ResourceKey="SurfaceControlHover" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" ResourceKey="SurfaceControlPressed" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUnchecked" ResourceKey="BorderControl" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" ResourceKey="BorderControlHover" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" ResourceKey="BorderControl" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundUnchecked" ResourceKey="TextSecondary" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundUncheckedPointerOver" ResourceKey="TextSecondary" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundUncheckedPressed" ResourceKey="TextSecondary" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundUncheckedDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="CheckBoxForegroundUnchecked" ResourceKey="TextPrimary" />
            <StaticResource x:Key="CheckBoxForegroundUncheckedPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="CheckBoxForegroundUncheckedPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="CheckBoxForegroundUncheckedDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="AccentFill" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="CheckBoxForegroundChecked" ResourceKey="TextPrimary" />
            <StaticResource x:Key="CheckBoxForegroundCheckedPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="CheckBoxForegroundCheckedPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="CheckBoxForegroundCheckedDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminate" ResourceKey="AccentFill" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminateDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminateDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminate" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminateDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="CheckBoxForegroundIndeterminate" ResourceKey="TextPrimary" />
            <StaticResource x:Key="CheckBoxForegroundIndeterminatePointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="CheckBoxForegroundIndeterminatePressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="CheckBoxForegroundIndeterminateDisabled" ResourceKey="TextDisabled" />

            <!-- 开关：开态强调色，滑块取按钮上的白 -->
            <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="AccentFill" />
            <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="ToggleSwitchFillOnDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="AccentFill" />
            <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="ToggleSwitchStrokeOnDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="ToggleSwitchKnobFillOnPointerOver" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="ToggleSwitchKnobFillOnPressed" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="ToggleSwitchKnobFillOnDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="ToggleSwitchFillOff" ResourceKey="SurfaceField" />
            <StaticResource x:Key="ToggleSwitchFillOffPointerOver" ResourceKey="SurfaceControlHover" />
            <StaticResource x:Key="ToggleSwitchFillOffPressed" ResourceKey="SurfaceControlPressed" />
            <StaticResource x:Key="ToggleSwitchStrokeOff" ResourceKey="BorderControl" />
            <StaticResource x:Key="ToggleSwitchStrokeOffPointerOver" ResourceKey="BorderControlHover" />
            <StaticResource x:Key="ToggleSwitchStrokeOffPressed" ResourceKey="BorderControl" />
            <StaticResource x:Key="ToggleSwitchStrokeOffDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="ToggleSwitchKnobFillOff" ResourceKey="TextSecondary" />
            <StaticResource x:Key="ToggleSwitchKnobFillOffPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ToggleSwitchKnobFillOffPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ToggleSwitchKnobFillOffDisabled" ResourceKey="TextDisabled" />
            <SolidColorBrush x:Key="ToggleSwitchContainerBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPressed" Color="Transparent" />
            <StaticResource x:Key="ToggleSwitchContentForeground" ResourceKey="TextPrimary" />

            <!-- 开关按钮：未选是次按钮，选中是主按钮，六态写满（空一格就露 Fluent 默认） -->
            <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="ToggleButtonForeground" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="BorderControl" />
            <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SurfaceControlHover" />
            <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="BorderControlHover" />
            <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SurfaceControlPressed" />
            <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="BorderControl" />
            <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="ToggleButtonForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="ToggleButtonBorderBrushDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="AccentFill" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="AccentFill" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedDisabled" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="ToggleButtonBackgroundIndeterminate" ResourceKey="AccentFill" />
            <StaticResource x:Key="ToggleButtonBackgroundIndeterminatePointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="ToggleButtonBackgroundIndeterminatePressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="ToggleButtonBackgroundIndeterminateDisabled" ResourceKey="SurfaceControl" />
            <StaticResource x:Key="ToggleButtonForegroundIndeterminate" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="ToggleButtonForegroundIndeterminatePointerOver" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="ToggleButtonForegroundIndeterminatePressed" ResourceKey="TextOnAccent" />
            <StaticResource x:Key="ToggleButtonForegroundIndeterminateDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="ToggleButtonBorderBrushIndeterminate" ResourceKey="AccentFill" />
            <StaticResource x:Key="ToggleButtonBorderBrushIndeterminatePointerOver" ResourceKey="AccentFillHover" />
            <StaticResource x:Key="ToggleButtonBorderBrushIndeterminatePressed" ResourceKey="AccentFillPressed" />
            <StaticResource x:Key="ToggleButtonBorderBrushIndeterminateDisabled" ResourceKey="BorderSubtle" />

            <!-- 表格：行底卡片色，靠 hover 与选中区分（表头底色没有键，只有分隔线） -->
            <StaticResource x:Key="TableViewRowBackground" ResourceKey="SurfaceCard" />
            <StaticResource x:Key="TableViewRowBackgroundPointerOver" ResourceKey="SurfaceHover" />
            <StaticResource x:Key="TableViewRowBackgroundPressed" ResourceKey="SurfacePressed" />
            <StaticResource x:Key="TableViewRowBackgroundDisabled" ResourceKey="SurfaceCard" />
            <StaticResource x:Key="TableViewRowBackgroundSelected" ResourceKey="AccentSurface" />
            <StaticResource x:Key="TableViewRowBackgroundSelectedPointerOver" ResourceKey="AccentSurface" />
            <StaticResource x:Key="TableViewRowBackgroundSelectedPressed" ResourceKey="AccentSurface" />
            <StaticResource x:Key="TableViewRowForegroundPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="TableViewRowForegroundPressed" ResourceKey="TextPrimary" />
            <StaticResource x:Key="TableViewRowForegroundDisabled" ResourceKey="TextDisabled" />
            <StaticResource x:Key="TableViewRowForegroundSelected" ResourceKey="AccentText" />
            <StaticResource x:Key="TableViewRowForegroundSelectedPointerOver" ResourceKey="AccentText" />
            <StaticResource x:Key="TableViewRowForegroundSelectedPressed" ResourceKey="AccentText" />
            <StaticResource x:Key="TableViewColumnHeaderSeparatorBackground" ResourceKey="BorderSubtle" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 与明暗无关的度量 -->
    <StaticResource x:Key="ControlCornerRadius" ResourceKey="RadiusControl" />
    <StaticResource x:Key="OverlayCornerRadius" ResourceKey="RadiusOverlay" />
    <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="UiFont" />
    <StaticResource x:Key="ControlContentThemeFontSize" ResourceKey="UiBodySize" />

</ResourceDictionary>
