<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      22 个 App* 键是二十三个窗口还在用的名字，值现在全部落在 Themes/Tokens.axaml 的 Color 上：
      旧键不再有自己的颜色，于是改令牌就是改窗口，窗口也不会再各有一套值。
      这张表是过渡用的，等窗口改用新令牌就整份删掉。

      四行强调色用 DynamicResource，其余用 StaticResource：强调色是唯一会在运行时改的一档
      颜色，自定义主题把它写进 Application.Resources 覆盖掉，DynamicResource 才跟得上；
      别的令牌启动时定下来就不再变，StaticResource 在解析时读一次就够。
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppSurface" Color="{StaticResource SurfacePanelColor}" />
            <SolidColorBrush x:Key="AppBackdrop" Color="{StaticResource SurfaceWindowColor}" />
            <SolidColorBrush x:Key="AppChrome" Color="{StaticResource SurfaceChromeColor}" />
            <SolidColorBrush x:Key="AppField" Color="{StaticResource SurfaceFieldColor}" />
            <SolidColorBrush x:Key="AppBorder" Color="{StaticResource BorderControlColor}" />
            <SolidColorBrush x:Key="AppText" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="AppTextStrong" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="AppMuted" Color="{StaticResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="AppAccent" Color="{DynamicResource AccentFillColor}" />
            <SolidColorBrush x:Key="AppControl" Color="{StaticResource SurfaceControlColor}" />
            <SolidColorBrush x:Key="AppGroup" Color="{StaticResource SurfaceSunkenColor}" />
            <SolidColorBrush x:Key="AppHover" Color="{StaticResource SurfaceHoverColor}" />
            <SolidColorBrush x:Key="AppDock" Color="{StaticResource SurfacePanelColor}" />
            <SolidColorBrush x:Key="AppSelected" Color="{DynamicResource AccentSurfaceColor}" />
            <SolidColorBrush x:Key="AppLabel" Color="{StaticResource WarningColor}" />
            <SolidColorBrush x:Key="AppInfo" Color="{StaticResource InfoColor}" />
            <SolidColorBrush x:Key="AppInfoSoft" Color="{StaticResource InfoSurfaceColor}" />
            <SolidColorBrush x:Key="AppWarning" Color="{StaticResource WarningColor}" />
            <SolidColorBrush x:Key="AppDanger" Color="{StaticResource DangerColor}" />
            <SolidColorBrush x:Key="AppSuccess" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="AppAccentSoft" Color="{DynamicResource AccentSurfaceColor}" />
            <SolidColorBrush x:Key="AppAccentHover" Color="{DynamicResource AccentFillHoverColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppSurface" Color="{StaticResource SurfacePanelColor}" />
            <SolidColorBrush x:Key="AppBackdrop" Color="{StaticResource SurfaceWindowColor}" />
            <SolidColorBrush x:Key="AppChrome" Color="{StaticResource SurfaceChromeColor}" />
            <SolidColorBrush x:Key="AppField" Color="{StaticResource SurfaceFieldColor}" />
            <SolidColorBrush x:Key="AppBorder" Color="{StaticResource BorderControlColor}" />
            <SolidColorBrush x:Key="AppText" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="AppTextStrong" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="AppMuted" Color="{StaticResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="AppAccent" Color="{DynamicResource AccentFillColor}" />
            <SolidColorBrush x:Key="AppControl" Color="{StaticResource SurfaceControlColor}" />
            <SolidColorBrush x:Key="AppGroup" Color="{StaticResource SurfaceSunkenColor}" />
            <SolidColorBrush x:Key="AppHover" Color="{StaticResource SurfaceHoverColor}" />
            <SolidColorBrush x:Key="AppDock" Color="{StaticResource SurfacePanelColor}" />
            <SolidColorBrush x:Key="AppSelected" Color="{DynamicResource AccentSurfaceColor}" />
            <SolidColorBrush x:Key="AppLabel" Color="{StaticResource WarningColor}" />
            <SolidColorBrush x:Key="AppInfo" Color="{StaticResource InfoColor}" />
            <SolidColorBrush x:Key="AppInfoSoft" Color="{StaticResource InfoSurfaceColor}" />
            <SolidColorBrush x:Key="AppWarning" Color="{StaticResource WarningColor}" />
            <SolidColorBrush x:Key="AppDanger" Color="{StaticResource DangerColor}" />
            <SolidColorBrush x:Key="AppSuccess" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="AppAccentSoft" Color="{DynamicResource AccentSurfaceColor}" />
            <SolidColorBrush x:Key="AppAccentHover" Color="{DynamicResource AccentFillHoverColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
