<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WhaleGenie.App"
             xmlns:local="using:WhaleGenie"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->


    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppSurface" Color="#292929" />
                    <SolidColorBrush x:Key="AppBackdrop" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="AppChrome" Color="#202020" />
                    <SolidColorBrush x:Key="AppField" Color="#2E2E2E" />
                    <SolidColorBrush x:Key="AppBorder" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="AppText" Color="#E8E8E8" />
                    <SolidColorBrush x:Key="AppMuted" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="AppAccent" Color="#C8401C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppSurface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppBackdrop" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="AppChrome" Color="#ECECEC" />
                    <SolidColorBrush x:Key="AppField" Color="#F7F7F7" />
                    <SolidColorBrush x:Key="AppBorder" Color="#D5D5D5" />
                    <SolidColorBrush x:Key="AppText" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="AppMuted" Color="#666666" />
                    <SolidColorBrush x:Key="AppAccent" Color="#C8401C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <!-- The dock that narrows a wall of buttons to one group of them. The variable wall and the
             expression builder's list of functions each stand one on screen, and one control with
             one look is worth a style above both windows rather than two that drift apart. -->
        <Style Selector="ListBox.Dock ListBoxItem">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="11,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style Selector="ListBox.Dock ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#454545" />
        </Style>
        <Style Selector="ListBox.Dock ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#C8401C" />
        </Style>

        <!-- What comes up when the pointer rests on something. It is painted here rather than in a
             window because a tooltip is not drawn inside the window it belongs to: it stands in a
             popup of its own, where the window's styles do not reach it. -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="BorderBrush" Value="#3F3F3F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,9" />
        </Style>
    </Application.Styles>
</Application>
