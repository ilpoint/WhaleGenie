<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WhaleGenie.App"
             xmlns:local="using:WhaleGenie"
             xmlns:styling="using:Avalonia.Styling"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->


    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AppSurface" Color="#292929" />
            <SolidColorBrush x:Key="AppBackdrop" Color="#1E1E1E" />
            <SolidColorBrush x:Key="AppChrome" Color="#202020" />
            <SolidColorBrush x:Key="AppField" Color="#2E2E2E" />
            <SolidColorBrush x:Key="AppBorder" Color="#3A3A3A" />
            <SolidColorBrush x:Key="AppText" Color="#E8E8E8" />
            <SolidColorBrush x:Key="AppTextStrong" Color="#F5F5F5" />
            <SolidColorBrush x:Key="AppMuted" Color="#9A9A9A" />
            <SolidColorBrush x:Key="AppAccent" Color="#C8401C" />
            <SolidColorBrush x:Key="AppControl" Color="#404040" />
            <SolidColorBrush x:Key="AppGroup" Color="#1F1F1F" />
            <SolidColorBrush x:Key="AppHover" Color="#3C3C3C" />
            <SolidColorBrush x:Key="AppDock" Color="#2A2A2A" />
            <SolidColorBrush x:Key="AppSelected" Color="#4A2A20" />
            <SolidColorBrush x:Key="AppLabel" Color="#C8A165" />
            <SolidColorBrush x:Key="AppInfo" Color="#8FB3D9" />
            <SolidColorBrush x:Key="AppInfoSoft" Color="#2B3A4A" />
            <SolidColorBrush x:Key="AppWarning" Color="#E0A060" />
            <SolidColorBrush x:Key="AppDanger" Color="#E06C75" />
            <SolidColorBrush x:Key="AppSuccess" Color="#7FC97F" />
            <SolidColorBrush x:Key="AppAccentSoft" Color="#4A342E" />
            <SolidColorBrush x:Key="AppAccentHover" Color="#D9502A" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

        <!-- The dock that narrows a wall of buttons to one group of them. The variable wall and the
             expression builder's list of functions each stand one on screen, and one control with
             one look is worth a style above both windows rather than two that drift apart. -->
        <Style Selector="ListBox.Dock ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource AppDock}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="11,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="ListBox.Dock ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="ListBox.Dock ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccent}" />
        </Style>

        <!-- What comes up when the pointer rests on something. It is painted here rather than in a
             window because a tooltip is not drawn inside the window it belongs to: it stands in a
             popup of its own, where the window's styles do not reach it. -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource AppDock}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,9" />
        </Style>
    </Application.Styles>
</Application>
