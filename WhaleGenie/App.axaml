<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WhaleGenie.App"
             xmlns:local="using:WhaleGenie"
             xmlns:styling="using:Avalonia.Styling"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->


    <!--
      颜色只有一套，写在 Themes/Tokens.axaml 里，按 ThemeVariant 分红。App* 是二十三个窗口仍在
      用的旧名字，住在 Themes/LegacyKeys.axaml，值也只是引用令牌里的 Color。两份字典都在这里合并
      进来，所以设计器预览与运行时看到的是同一处颜色，不会像从前那样 XAML 与 ThemePalette.cs
      各抄一份再慢慢走散。运行时唯一会被改写的是自定义强调色那五个令牌：ThemePalette.Apply 把
      它们的 Color 与 Brush 两种形状写进 Application.Resources 盖住这里，非自定义时再摘掉。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://WhaleGenie/Themes/Tokens.axaml" />
                <ResourceInclude Source="avares://WhaleGenie/Themes/LegacyKeys.axaml" />
                <ResourceInclude Source="avares://WhaleGenie/Themes/FluentKeys.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <!--
          Compact 收紧 Fluent 自己的行高与控件内边距（表格行、列表项、菜单项都跟着变）。
          我们只覆盖颜色与圆角，密度用它给的，不再自己写一套行高。
        -->
        <FluentTheme DensityStyle="Compact" />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

        <!--
          层 3 排在这里：同样是 `Button`，我们写的类比主题里的更靠后，选择器也更具体，所以压得住。
          放在 FluentTheme 之前会被它盖回去，而且不报错。
        -->
        <StyleInclude Source="avares://WhaleGenie/Themes/Controls.axaml" />

        <!-- The dock that narrows a wall of buttons to one group of them. The variable wall and the
             expression builder's list of functions each stand one on screen, and one control with
             one look is worth a style above both windows rather than two that drift apart. -->
        <Style Selector="ListBox.Dock ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource AppDock}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="11,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="ListBox.Dock ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="ListBox.Dock ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccent}" />
        </Style>

        <!-- What comes up when the pointer rests on something. It is painted here rather than in a
             window because a tooltip is not drawn inside the window it belongs to: it stands in a
             popup of its own, where the window's styles do not reach it. -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource AppDock}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,9" />
        </Style>
    </Application.Styles>
</Application>
