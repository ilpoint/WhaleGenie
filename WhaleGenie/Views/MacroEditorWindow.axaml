<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:conv="using:WhaleGenie.Converters"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="760"
        x:Class="WhaleGenie.Views.MacroEditorWindow"
        x:DataType="vm:MacroEditorViewModel"
        Title="Macro Editor"
        Width="1486" Height="800"
        MinWidth="1320" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource AppBackdrop}">

    <Design.DataContext>
        <vm:MacroEditorViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <!-- Ctrl + F10 starts and stops recording. Escape is deliberately left unbound: it is a
             key the work being recorded is likely to use, and it must not end the recording or
             throw the editor away. -->
        <KeyBinding Gesture="Ctrl+F10" Command="{Binding ToggleRecordCommand}" />
        <KeyBinding Gesture="Insert" Command="{Binding NewStepCommand}" />
    </Window.KeyBindings>

    <Window.Resources>
        <conv:BoolToOpacityConverter x:Key="RowOpacity" />
        <conv:HexColorToBrushConverter x:Key="HexBrush" />
    </Window.Resources>

    <Window.Styles>
        <!-- Line-art icon used beside each recordable action row -->
        <Style Selector="views|IconView.RecordIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stroke" Value="{DynamicResource AppText}" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="FitToBounds" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Idle: red record dot. Recording: white stop square. -->
        <Style Selector="Path.RecordIndicator">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="#E23B18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Path.RecordIndicator.Stop">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Fill" Value="#FFFFFF" />
            <Style.Animations>
                <!-- Slow pulse so an in-progress recording is obvious at a glance. -->
                <Animation Duration="0:0:1.2" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>


        <Style Selector="views|IconView.ProblemMark">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stroke" Value="#E0A23C" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="FitToBounds" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- The warning itself is small, but its tooltip has to be easy to reach with the pointer. -->
        <Style Selector="Border.ProblemTip">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.DropTarget">
            <Setter Property="Background" Value="#33FF6A35" />
            <Setter Property="BorderBrush" Value="#FF6A35" />
        </Style>
        <Style Selector="Border.DropTarget.Rejected">
            <Setter Property="Background" Value="#33E06C75" />
            <Setter Property="BorderBrush" Value="#E06C75" />
        </Style>

        <!-- The two ends of a block: the line its steps start under, and the line that closes it.
             They are what makes "inside the loop" and "after the loop" tell themselves apart. -->
        <Style Selector="Border.StepHead">
            <Setter Property="Background" Value="{DynamicResource AppSurface}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="Border.StepFoot">
            <Setter Property="BorderBrush" Value="{DynamicResource AppHover}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="Padding" Value="8,1" />
        </Style>

        <!-- Fold arrow on a block, and the "add a step in here" button on a block's title. -->
        <Style Selector="Button.Ghost.Tiny views|IconView">
            <Setter Property="Stroke" Value="{DynamicResource AppMuted}" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="FitToBounds" Value="True" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.Ghost.Tiny:pointerover views|IconView">
            <Setter Property="Stroke" Value="#FF8A5C" />
        </Style>

        <!-- Record toggle, idle: dark plate with a red dot. -->
        <Style Selector="Button.RecordButton">
            <Setter Property="Background" Value="#4A2417" />
            <Setter Property="BorderBrush" Value="#8A4227" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.RecordButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#5C2D1C" />
            <Setter Property="BorderBrush" Value="#A6512F" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Button.RecordButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#3D1D12" />
            <Setter Property="BorderBrush" Value="#A6512F" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>

        <!-- Recording: hot red plate with a white stop square and a heavier border. -->
        <Style Selector="Button.RecordButton.Recording">
            <Setter Property="Background" Value="#D8451B" />
            <Setter Property="BorderBrush" Value="#FF7A4D" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.RecordButton.Recording /template/ ContentPresenter">
            <Setter Property="Background" Value="#D8451B" />
            <Setter Property="BorderBrush" Value="#FF7A4D" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.RecordButton.Recording:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E8501F" />
            <Setter Property="BorderBrush" Value="#FF9A70" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.RecordButton.Recording:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#C23D16" />
            <Setter Property="BorderBrush" Value="#FF9A70" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Button.Chrome.Icon.pinned /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSelected}" />
        </Style>

        <!-- 图标块：外观全由 `Button.Icon` 给（34×32 逐格一致），这里只补"图标本身用什么色、
             多粗"——图元不是控件，词汇表管不到它的描边。 -->
        <Style Selector="Button.Icon views|IconView">
            <Setter Property="Stroke" Value="{DynamicResource TextPrimary}" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>

        <!-- 命令入口按裁定回落到强调色：它和别的调色板钮不靠色相区分，靠位置与文案。
             那 44 的宽是"这一格更要醒目"的存量度量，留在这里并记账（宽度不在三档里，
             但它不是高度，收敛规则管不到它）。 -->
        <Style Selector="Button.Icon.primary">
            <Setter Property="Width" Value="44" />
        </Style>
        <Style Selector="Button.Icon.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFill}" />
        </Style>
        <Style Selector="Button.Icon.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillHover}" />
        </Style>
        <Style Selector="Button.Icon.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceControl}" />
        </Style>
        <Style Selector="Button.Icon.primary views|IconView">
            <Setter Property="Stroke" Value="{DynamicResource TextOnAccent}" />
            <Setter Property="StrokeThickness" Value="1.7" />
        </Style>
        <Style Selector="Button.Icon.primary:disabled views|IconView">
            <Setter Property="Stroke" Value="{DynamicResource TextDisabled}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="38,*">

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="{DynamicResource AppChrome}" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                <Image Source="/Assets/WhaleGenie.png" Width="22" Height="22" Stretch="Uniform" />
                <TextBlock Foreground="{DynamicResource AppText}" FontSize="13" VerticalAlignment="Center"
                           Text="{Binding [Editor.Title], Source={x:Static loc:Strings.Current}}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
                <Button Classes="Chrome Icon" Name="PinButton"
                        ToolTip.Tip="{Binding [Common.Pin], Source={x:Static loc:Strings.Current}}">
                    <views:IconView Name="PinIcon" Width="11" Height="11"
                                    Stroke="{DynamicResource AppText}" StrokeThickness="1.2"
                                    FitToBounds="True" Data="{x:Static vm:AppIcons.Pin}" />
                </Button>
                <Button Classes="Chrome Icon" Name="MinimizeButton"
                        ToolTip.Tip="{Binding [Common.Minimize], Source={x:Static loc:Strings.Current}}">
                    <views:IconView Width="10" Height="10" Stroke="{DynamicResource AppText}" StrokeThickness="1.2" FitToBounds="True" Data="{x:Static vm:AppIcons.Minus}" />
                </Button>
                <Button Classes="Chrome Icon" Name="MaximizeButton"
                        ToolTip.Tip="{Binding [Common.Maximize], Source={x:Static loc:Strings.Current}}">
                    <views:IconView Name="MaximizeIcon" Width="10" Height="10"
                                    Stroke="{DynamicResource AppText}" StrokeThickness="1.2"
                                    FitToBounds="True" Data="{x:Static vm:AppIcons.Maximize}" />
                </Button>
                <Button Classes="Chrome Icon" Name="CloseButton"
                        ToolTip.Tip="{Binding [Common.Close], Source={x:Static loc:Strings.Current}}">
                    <views:IconView Width="10" Height="10" Stroke="{DynamicResource AppText}" StrokeThickness="1.2" FitToBounds="True" Data="{x:Static vm:AppIcons.X}" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Name="EditorColumns" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="360" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Left: the action library. -->
            <Grid Grid.Column="0" Name="ActionLibraryColumn" RowDefinitions="*,Auto">
                <views:ActionPaletteView Grid.Row="0" Name="ActionPalette" />
                <Button Grid.Row="1" Classes="Secondary" Height="34" Margin="4,2,4,4"
                        Click="OnShowRecording">
                    <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                        <views:IconView Width="14" Height="14" Stroke="{DynamicResource AppText}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static vm:AppIcons.Record}" />
                        <TextBlock Text="{Binding [Editor.RecordActions], Source={x:Static loc:Strings.Current}}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="180" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="3*" MinHeight="240" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Name="VariableCenterPanel"
                        Background="{DynamicResource AppSurface}" CornerRadius="6"
                        Padding="12,12,12,8">
                    <Grid RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="{Binding VariableCenter.Header}" FontSize="13"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}"
                                           Margin="4,0,0,2" />
                                <TextBlock Text="{Binding VariableCenter.Help}" FontSize="11.5"
                                           TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}"
                                           Margin="4,0,0,8" />
                            </StackPanel>
                            <Button Grid.Column="1" Name="ManageGlobalsButton" Classes="Secondary"
                                    VerticalAlignment="Top" Margin="0,0,2,0"
                                    ToolTip.Tip="{Binding [Editor.ManageGlobalsHint], Source={x:Static loc:Strings.Current}}"
                                    Content="{Binding [Editor.ManageGlobals], Source={x:Static loc:Strings.Current}}"
                                    Click="OnManageGlobals" />
                        </Grid>
                        <views:VariableWall Grid.Row="1" Name="VariableCenterWall"
                                            DataContext="{Binding VariableCenter.Wall}" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="8" Background="Transparent"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Cursor="SizeNorthSouth" />

                <Border Grid.Row="2" Name="MacroSettingsDrawer"
                        IsVisible="True" Background="{DynamicResource AppSurface}" CornerRadius="6">
                <Grid RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0" Padding="18,16,18,8" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7" Margin="2,0,0,10">
                                <views:IconView Width="15" Height="15"
                                                Stroke="{DynamicResource AppTextStrong}"
                                                StrokeThickness="1.4" FitToBounds="True"
                                                Data="{x:Static vm:AppIcons.Settings}" />
                                <TextBlock Grid.Column="1" Name="MacroSettingsTitle"
                                           VerticalAlignment="Center"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextStrong}"
                                           Text="{Binding [Editor.MacroSettings], Source={x:Static loc:Strings.Current}}" />
                            </Grid>
                            <TextBlock Classes="FieldLabel" Text="{Binding [Editor.MacroName], Source={x:Static loc:Strings.Current}}" />
                            <TextBox Name="NameInput" Classes="Field" Text="{Binding Name}"
                                     PlaceholderText="{Binding [Editor.NamePlaceholder], Source={x:Static loc:Strings.Current}}" />
                            <TextBlock Classes="Problem" Margin="2,4,0,0"
                                       IsVisible="{Binding HasNameProblem}" Text="{Binding NameProblem}" />
                            <TextBlock Classes="FieldLabel" Margin="2,8,0,6"
                                       Text="{Binding [Editor.MacroDescription], Source={x:Static loc:Strings.Current}}" />
                            <TextBox Name="DescriptionInput" Text="{Binding Description}"
                                     PlaceholderText="{Binding [Editor.DescriptionPlaceholder], Source={x:Static loc:Strings.Current}}" />
                            <Border Margin="0,8,0,0" Padding="9,7" CornerRadius="5"
                                    Background="{DynamicResource AppField}"
                                    IsVisible="{Binding HasOrigin}">
                                <TextBlock Text="{Binding OriginLabel}" TextWrapping="Wrap"
                                           FontSize="11.5" Foreground="{DynamicResource AppMuted}" />
                            </Border>
                            <Button Classes="Secondary" Height="32" Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    IsVisible="{Binding IsSubMacro}"
                                    Content="{Binding [Editor.DeleteSubMacro], Source={x:Static loc:Strings.Current}}"
                                    Click="OnDeleteSubMacro" />

                            <StackPanel IsVisible="{Binding !IsSubMacro}">
                            <Border Name="TriggerEntriesGroup" Classes="Sunken" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Editor.TriggerEntries], Source={x:Static loc:Strings.Current}}" />
                                    <ListBox Name="TriggerEntries" Classes="List Bare Gapped" MaxHeight="180"
                                             ItemsSource="{Binding TriggerEntries}"
                                             SelectedItem="{Binding SelectedTrigger, Mode=TwoWay}"
                                             SelectionMode="Single"
                                             Background="Transparent" BorderThickness="0" Padding="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:TriggerEntry">
                                                <Border Classes="Card Selectable">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                        <CheckBox IsChecked="{Binding IsEnabled}"
                                                                  VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock FontSize="12.5"
                                                                       Foreground="{DynamicResource AppText}"
                                                                       Text="{Binding KindLabel}" />
                                                            <TextBlock FontSize="11.5"
                                                                       Foreground="{DynamicResource AppMuted}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Text="{Binding Summary}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Classes="RemoveButton"
                                                                Width="24" Height="24"
                                                                IsVisible="{Binding IsRemovable}"
                                                                ToolTip.Tip="{Binding [Editor.RemoveTrigger], Source={x:Static loc:Strings.Current}}"
                                                                Command="{Binding $parent[ListBox].((vm:MacroEditorViewModel)DataContext).RemoveTriggerCommand}"
                                                                CommandParameter="{Binding}">
                                                            <views:IconView Width="10" Height="10"
                                                                            Stroke="{DynamicResource AppText}"
                                                                            StrokeThickness="1.3"
                                                                            FitToBounds="True"
                                                                            Data="{x:Static vm:AppIcons.X}" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Button Name="AddTriggerButton"
                                            Classes="Secondary" Height="32" Padding="11,0"
                                            HorizontalAlignment="Left" Margin="0,7,0,0">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <views:IconView Width="13" Height="13"
                                                                Stroke="{DynamicResource AppText}"
                                                                StrokeThickness="1.4"
                                                                FitToBounds="True"
                                                                Data="{x:Static vm:AppIcons.Plus}" />
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{Binding [Editor.AddTrigger], Source={x:Static loc:Strings.Current}}" />
                                                <views:IconView Width="10" Height="10"
                                                                Stroke="{DynamicResource AppMuted}"
                                                                StrokeThickness="1.3"
                                                                FitToBounds="True"
                                                                Data="{x:Static vm:AppIcons.ChevronDown}" />
                                            </StackPanel>
                                        </Button.Content>
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="{Binding [Trigger.Keys], Source={x:Static loc:Strings.Current}}"
                                                          Tag="{x:Static models:TriggerKind.Key}"
                                                          Click="OnAddTriggerMenu" />
                                                <MenuItem Header="{Binding [Trigger.Color], Source={x:Static loc:Strings.Current}}"
                                                          Tag="{x:Static models:TriggerKind.Color}"
                                                          Click="OnAddTriggerMenu" />
                                                <MenuItem Header="{Binding [Trigger.Interface], Source={x:Static loc:Strings.Current}}"
                                                          Tag="{x:Static models:TriggerKind.Interface}"
                                                          Click="OnAddTriggerMenu" />
                                                <MenuItem Header="{Binding [Trigger.Hotstring], Source={x:Static loc:Strings.Current}}"
                                                          Tag="{x:Static models:TriggerKind.Hotstring}"
                                                          Click="OnAddTriggerMenu" />
                                                <MenuItem Header="{Binding [Trigger.Timer], Source={x:Static loc:Strings.Current}}"
                                                          Tag="{x:Static models:TriggerKind.Timer}"
                                                          Click="OnAddTriggerMenu" />
                                                <MenuItem Header="{Binding [Trigger.File], Source={x:Static loc:Strings.Current}}"
                                                          Tag="{x:Static models:TriggerKind.File}"
                                                          Click="OnAddTriggerMenu" />
                                                <MenuItem Header="{Binding [Trigger.Process], Source={x:Static loc:Strings.Current}}"
                                                          Tag="{x:Static models:TriggerKind.Process}"
                                                          Click="OnAddTriggerMenu" />
                                                <MenuItem Header="{Binding [Trigger.Window], Source={x:Static loc:Strings.Current}}"
                                                          Tag="{x:Static models:TriggerKind.Window}"
                                                          Click="OnAddTriggerMenu" />
                                                <MenuItem Header="{Binding [Trigger.Idle], Source={x:Static loc:Strings.Current}}"
                                                          Tag="{x:Static models:TriggerKind.Idle}"
                                                          Click="OnAddTriggerMenu" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>

                                    <TextBlock Classes="Hint" Margin="2,8,0,0"
                                               IsVisible="{Binding !HasSelectedTrigger}"
                                               Text="{Binding [Editor.NoTriggerSelected], Source={x:Static loc:Strings.Current}}" />

                                    <StackPanel Name="SelectedTriggerDetailsPanel"
                                                IsVisible="{Binding ShowsTriggerSettings}">
                                    <StackPanel Name="SelectedTriggerSettingsPanel"
                                                Margin="0,12,0,0">
                                        <StackPanel Name="LoopModePanel"
                                                    IsVisible="{Binding ShowsLoopMode}">
                                            <TextBlock Classes="FieldLabel"
                                                       Text="{Binding [Editor.Loop], Source={x:Static loc:Strings.Current}}" />
                                            <ComboBox Name="LoopModeSelect" Classes="Field"
                                                      ItemsSource="{Binding LoopOptions}"
                                                      SelectedIndex="{Binding LoopIndex}" />
                                        </StackPanel>
                                        <CheckBox Name="TriggerOnceCheck"
                                                  Margin="2,10,0,0"
                                                  IsVisible="{Binding ShowsTriggerOnce}"
                                                  Foreground="{DynamicResource AppMuted}" FontSize="12.5"
                                                  Content="{Binding [Editor.TriggerOnce], Source={x:Static loc:Strings.Current}}"
                                                  IsChecked="{Binding TriggerOnce}" />
                                    </StackPanel>

                                    <TextBlock Classes="Problem" Margin="2,6,0,0"
                                               IsVisible="{Binding HasTriggerProblem}"
                                               Text="{Binding TriggerProblemSummary}" />

                            <!-- Keystroke / button trigger settings -->
                            <StackPanel Name="KeyTriggerSettingsPanel"
                                        IsVisible="{Binding IsKeyTrigger}">
                                <TextBlock Classes="FieldLabel" Margin="2,8,0,6"
                                           Text="{Binding [Editor.BindKey], Source={x:Static loc:Strings.Current}}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Border Background="{DynamicResource AppField}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                                            CornerRadius="5" Padding="11,8">
                                        <TextBlock Text="{Binding BindKeyDisplay}" FontSize="12.5"
                                                   Foreground="{DynamicResource AppText}" VerticalAlignment="Center" />
                                    </Border>
                                    <Button Grid.Column="1" Classes="Secondary" Margin="8,0,0,0" Height="34"
                                            Content="{Binding SetKeyLabel}"
                                            IsEnabled="{Binding !IsRecording}"
                                            ToolTip.Tip="{Binding [Editor.Tip.SetKey], Source={x:Static loc:Strings.Current}}"
                                            Command="{Binding SetKeyCommand}" />
                                </Grid>
                            </StackPanel>

                            <!-- Colour / pixel trigger settings -->
                            <Grid Name="ColorTriggerSettings" IsVisible="{Binding IsColorTrigger}"
                                  ColumnDefinitions="140,*" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="10" RowSpacing="12">
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Classes="FieldLabel" Margin="2,8,0,6"
                                               Text="{Binding [Editor.When], Source={x:Static loc:Strings.Current}}" />
                                    <ComboBox Name="ColorMatchSelect" Classes="Field"
                                              ItemsSource="{Binding ColorMatchOptions}"
                                              SelectedIndex="{Binding ColorMatchIndex}" />

                                    <TextBlock Classes="FieldLabel" Margin="2,12,0,6"
                                               Text="{Binding [Editor.ColorPosition], Source={x:Static loc:Strings.Current}}" />
                                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                                        <TextBlock Grid.Column="0" Classes="FieldLabel"
                                                   Text="{Binding [Editor.X], Source={x:Static loc:Strings.Current}}"
                                                   VerticalAlignment="Center" Margin="2,0,0,0" />
                                        <TextBox Grid.Column="1" Classes="Field"
                                                 Text="{Binding ColorPositionX}" />
                                        <TextBlock Grid.Column="2" Classes="FieldLabel"
                                                   Text="{Binding [Editor.Y], Source={x:Static loc:Strings.Current}}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3" Classes="Field"
                                                 Text="{Binding ColorPositionY}" />
                                    </Grid>

                                    <CheckBox Margin="0,10,0,0"
                                              Content="{Binding [Editor.UseCursorPosition], Source={x:Static loc:Strings.Current}}"
                                              Foreground="{DynamicResource AppMuted}" FontSize="12.5"
                                              IsChecked="{Binding UseCursorPosition}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,8,0,0">
                                    <TextBlock Classes="FieldLabel" Margin="2,0,0,6"
                                               Text="{Binding [Editor.HexColor], Source={x:Static loc:Strings.Current}}" />
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                        <TextBox Name="HexColorInput" Classes="Field"
                                                 MinWidth="84" Text="{Binding HexColor}" />
                                        <Border Grid.Column="1" Width="33" Height="33" CornerRadius="5"
                                                Background="{Binding HexColor, Converter={StaticResource HexBrush}}"
                                                BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" />
                                        <Button Grid.Column="2" Classes="Secondary" Name="PickColorButton"
                                                Width="38" Height="33" Padding="0"
                                                ToolTip.Tip="{Binding [Editor.PickColor], Source={x:Static loc:Strings.Current}}"
                                                Click="OnPickColorClicked">
                                            <views:IconView Width="17" Height="17" Stroke="{DynamicResource AppText}" StrokeThickness="1.5" FitToBounds="True" Data="{x:Static vm:AppIcons.Dropper}" />
                                        </Button>
                                    </Grid>

                                    <TextBlock Classes="FieldLabel" Margin="2,12,0,6"
                                               Text="{Binding [Editor.ColorTolerance], Source={x:Static loc:Strings.Current}}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Classes="Field" Width="90" Text="{Binding ColorTolerance}" />
                                        <TextBlock Text="%" FontSize="12.5" Foreground="{DynamicResource AppMuted}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                    <TextBlock Classes="Hint"
                                               Text="{Binding [Editor.AltXHint], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,2,0,0"
                                               Text="{Binding [Editor.AltCHint], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,2,0,0" Name="PickStatus"
                                               Foreground="#8FC7F0" />
                                </StackPanel>
                            </Grid>

                            <!-- Timer trigger settings -->
                            <StackPanel IsVisible="{Binding IsTimerTrigger}">
                                <TextBlock Classes="FieldLabel" Margin="2,8,0,6"
                                           Text="{Binding [Editor.Schedule], Source={x:Static loc:Strings.Current}}" />
                                <ComboBox Classes="Field" ItemsSource="{Binding ScheduleOptions}"
                                          SelectedIndex="{Binding ScheduleIndex}" />

                                <!-- Every so often: how many, and the unit they are counted in -->
                                <TextBlock Classes="FieldLabel" Margin="2,12,0,6"
                                           IsVisible="{Binding IsIntervalSchedule}"
                                           Text="{Binding [Editor.Interval], Source={x:Static loc:Strings.Current}}" />
                                <Grid IsVisible="{Binding IsIntervalSchedule}"
                                      ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <views:NumberBox Grid.Column="0" Value="{Binding ScheduleInterval}"
                                                   Minimum="1" Maximum="9999" Increment="1" FormatString="0" />
                                    <ComboBox Grid.Column="1" Classes="Field" Width="112"
                                              ItemsSource="{Binding ScheduleUnitOptions}"
                                              SelectedIndex="{Binding ScheduleUnitIndex}" />
                                </Grid>

                                <!-- Every day at a time of day -->
                                <TextBlock Classes="FieldLabel" Margin="2,12,0,6"
                                           IsVisible="{Binding !IsIntervalSchedule}"
                                           Text="{Binding [Editor.ScheduleTime], Source={x:Static loc:Strings.Current}}" />
                                <TextBox Classes="Field" IsVisible="{Binding !IsIntervalSchedule}"
                                         Text="{Binding ScheduleTime}"
                                         PlaceholderText="{Binding [Editor.ScheduleTimeHint], Source={x:Static loc:Strings.Current}}" />

                                <TextBlock Classes="Hint" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="{Binding [Editor.ScheduleNote], Source={x:Static loc:Strings.Current}}" />
                            </StackPanel>

                            <!-- File / folder trigger settings -->
                            <StackPanel IsVisible="{Binding IsFileTrigger}">
                                <TextBlock Classes="FieldLabel" Margin="2,8,0,6"
                                           Text="{Binding [Editor.WatchPath], Source={x:Static loc:Strings.Current}}" />
                                <TextBox Classes="Field" Text="{Binding WatchPath}"
                                         PlaceholderText="{Binding [Editor.WatchPathHint], Source={x:Static loc:Strings.Current}}" />

                                <TextBlock Classes="FieldLabel" Margin="2,12,0,6"
                                           Text="{Binding [Editor.WatchChange], Source={x:Static loc:Strings.Current}}" />
                                <ComboBox Classes="Field" ItemsSource="{Binding WatchChangeOptions}"
                                          SelectedIndex="{Binding WatchChangeIndex}" />

                                <!-- Only a watched folder has names inside it to filter and folders below it -->
                                <TextBlock Classes="FieldLabel" Margin="2,12,0,6"
                                           Text="{Binding [Editor.WatchFilter], Source={x:Static loc:Strings.Current}}" />
                                <TextBox Classes="Field" Text="{Binding WatchFilter}"
                                         PlaceholderText="*" />

                                <CheckBox Margin="0,10,0,0" Foreground="{DynamicResource AppMuted}" FontSize="12.5"
                                          Content="{Binding [Editor.WatchSubfolders], Source={x:Static loc:Strings.Current}}"
                                          IsChecked="{Binding WatchSubfolders}" />

                                <TextBlock Classes="Hint" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="{Binding [Editor.WatchNote], Source={x:Static loc:Strings.Current}}" />
                            </StackPanel>

                            <!-- Program trigger settings -->
                            <StackPanel IsVisible="{Binding IsProcessTrigger}">
                                <TextBlock Classes="FieldLabel" Margin="2,12,0,6"
                                           Text="{Binding [Editor.ProcessName], Source={x:Static loc:Strings.Current}}" />
                                <TextBox Classes="Field" Text="{Binding ProcessName}"
                                         PlaceholderText="{Binding [Editor.ProcessNameHint], Source={x:Static loc:Strings.Current}}" />

                                <TextBlock Classes="FieldLabel" Margin="2,12,0,6"
                                           Text="{Binding [Editor.ProcessWhen], Source={x:Static loc:Strings.Current}}" />
                                <ComboBox Classes="Field" ItemsSource="{Binding ProcessChangeOptions}"
                                          SelectedIndex="{Binding ProcessChangeIndex}" />

                                <TextBlock Classes="Hint" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="{Binding [Editor.ProcessNote], Source={x:Static loc:Strings.Current}}" />
                            </StackPanel>

                            <!-- Window rules are shared by disappearance triggers and floating interfaces. -->
                            <StackPanel IsVisible="{Binding IsWindowRuleTrigger}">
                                <TextBlock Classes="FieldLabel" Margin="2,12,0,6"
                                           Text="{Binding [WindowRule.Title], Source={x:Static loc:Strings.Current}}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <Border Background="{DynamicResource AppField}"
                                            BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                                            CornerRadius="5" Padding="10,7">
                                        <TextBlock Text="{Binding WindowTargetSummary}" FontSize="12.5"
                                                   Foreground="{DynamicResource AppText}" TextWrapping="Wrap" />
                                    </Border>
                                    <Button Grid.Column="1" Classes="Secondary" Height="33" Padding="11,0"
                                            Content="{Binding [Add.PickWindow], Source={x:Static loc:Strings.Current}}"
                                            ToolTip.Tip="{Binding [Add.PickWindowHint], Source={x:Static loc:Strings.Current}}"
                                            Click="OnPickTriggerWindow" />
                                </Grid>

                                <!-- The windows this rule picks out right now, so a rule written a
                                     little too wide is seen while it is being written rather than
                                     when it fires. -->
                                <StackPanel Margin="0,8,0,0" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <TextBlock Classes="Hint" VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding WindowPreview.Summary}" />
                                        <Button Grid.Column="1" Classes="Secondary" Height="28"
                                                Padding="10,0"
                                                Content="{Binding [WindowPicker.Refresh], Source={x:Static loc:Strings.Current}}"
                                                ToolTip.Tip="{Binding [WindowPicker.RefreshHint], Source={x:Static loc:Strings.Current}}"
                                                Command="{Binding WindowPreview.RefreshCommand}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding WindowPreview.Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WindowPreviewRow">
                                                <StackPanel Margin="2,0,0,0">
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource AppText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Title}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="5"
                                                                IsVisible="{Binding HasPart}">
                                                        <TextBlock Classes="Note" FontSize="11"
                                                                   Text="{Binding PartLabel}" />
                                                        <TextBlock Classes="Note" FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding Part}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Classes="Hint" TextWrapping="Wrap"
                                               Text="{Binding WindowPreview.More}"
                                               IsVisible="{Binding WindowPreview.HasMore}" />
                                    <TextBlock Classes="Hint" TextWrapping="Wrap"
                                               Text="{Binding WindowPreview.Note}"
                                               IsVisible="{Binding WindowPreview.HasNote}" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding IsWindowTrigger}">
                                    <TextBlock Classes="FieldLabel" Margin="2,12,0,6"
                                               Text="{Binding [Editor.WindowWhen], Source={x:Static loc:Strings.Current}}" />
                                    <ComboBox Classes="Field" ItemsSource="{Binding WindowChangeOptions}"
                                              SelectedIndex="{Binding WindowChangeIndex}" />

                                    <TextBlock Classes="Hint" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Editor.WindowNote], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding IsInterfaceTrigger}" Margin="0,10,0,0">
                                    <TextBlock Classes="Hint" TextWrapping="Wrap"
                                               Text="{Binding [Editor.InterfaceHint], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="FieldLabel" Margin="2,10,0,5"
                                               Text="{Binding [Editor.InterfaceMembers], Source={x:Static loc:Strings.Current}}" />
                                    <ItemsControl ItemsSource="{Binding InterfaceGroupMembers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,6,4" Padding="7,3" CornerRadius="4"
                                                        Background="{DynamicResource AppField}">
                                                    <TextBlock FontSize="11.5" Text="{Binding}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="FieldLabel" Margin="2,8,0,5"
                                               Text="{Binding [Editor.InterfaceHotkey], Source={x:Static loc:Strings.Current}}" />
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                        <TextBlock VerticalAlignment="Center" FontSize="12.5"
                                                   Foreground="{DynamicResource AppText}"
                                                   Text="{Binding InterfaceToggleHotkeyDisplay}" />
                                        <Button Grid.Column="1" Classes="Secondary" Height="32" Padding="10,0"
                                                Click="OnSetInterfaceHotkey"
                                                Content="{Binding InterfaceHotkeyButton}" />
                                        <Button Grid.Column="2" Classes="Secondary" Height="32" Padding="10,0"
                                                Command="{Binding ClearInterfaceHotkeyCommand}"
                                                Content="{Binding [Settings.HotkeyClear], Source={x:Static loc:Strings.Current}}" />
                                    </Grid>
                                    <TextBlock Classes="Hint" Margin="2,5,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Editor.InterfaceHotkeySupport], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="2,4,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppWarning}"
                                               Text="{Binding InterfaceHotkeyProblem}"
                                               IsVisible="{Binding InterfaceHotkeyProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Typed-string trigger settings -->
                            <StackPanel IsVisible="{Binding IsHotstringTrigger}">
                                <TextBlock Classes="FieldLabel"
                                           Text="{Binding [Editor.Hotstring], Source={x:Static loc:Strings.Current}}" />
                                <Button Classes="Field"
                                        Content="{Binding HotstringTextDisplay}"
                                        ToolTip.Tip="{Binding [Editor.HotstringKeyboard], Source={x:Static loc:Strings.Current}}"
                                        Click="OnOpenHotstringKeyboard" />
                                <TextBlock Margin="2,8,0,0" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#8FC7F0" TextWrapping="Wrap"
                                           Text="{Binding [Editor.HotstringMouseResetHint], Source={x:Static loc:Strings.Current}}" />
                                <CheckBox Margin="0,10,0,0" Foreground="{DynamicResource AppMuted}" FontSize="12.5"
                                          Content="{Binding [Editor.HotstringCase], Source={x:Static loc:Strings.Current}}"
                                          IsChecked="{Binding HotstringCaseSensitive}" />
                                <CheckBox Margin="0,6,0,0" Foreground="{DynamicResource AppMuted}" FontSize="12.5"
                                          Content="{Binding [Editor.HotstringInsideWord], Source={x:Static loc:Strings.Current}}"
                                          IsChecked="{Binding HotstringInsideWord}" />
                                <CheckBox Margin="0,6,0,0" Foreground="{DynamicResource AppMuted}" FontSize="12.5"
                                          Content="{Binding [Editor.HotstringRequireEnd], Source={x:Static loc:Strings.Current}}"
                                          IsChecked="{Binding HotstringRequireEnd}" />
                                <StackPanel Margin="22,4,0,0" IsEnabled="{Binding HotstringRequireEnd}">
                                    <ItemsControl ItemsSource="{Binding HotstringEndKeys}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:HotstringEndKeyOption">
                                                <ToggleButton Classes="Chip Key"
                                                              Content="{Binding Label}"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <Button Classes="Secondary" Height="32" Padding="10,0"
                                                Click="OnCaptureHotstringEnd"
                                                Content="{Binding HotstringEndCaptureButton}" />
                                        <Button Classes="Secondary" Height="32" Padding="10,0"
                                                Command="{Binding ResetHotstringEndCharsCommand}"
                                                Content="{Binding [Editor.HotstringEndCharsReset], Source={x:Static loc:Strings.Current}}" />
                                    </StackPanel>
                                    <TextBlock Classes="Hint" Margin="2,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding HotstringEndCaptureStatus}"
                                               IsVisible="{Binding HotstringEndCaptureStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Classes="Hint" Margin="2,5,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Editor.HotstringEndCharsHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <CheckBox Margin="0,6,0,0" Foreground="{DynamicResource AppMuted}" FontSize="12.5"
                                          Content="{Binding [Editor.HotstringErase], Source={x:Static loc:Strings.Current}}"
                                          IsChecked="{Binding HotstringEraseTyped}" />
                                <CheckBox Margin="0,6,0,0" Foreground="{DynamicResource AppMuted}" FontSize="12.5"
                                          IsEnabled="{Binding HotstringEraseTyped}"
                                          Content="{Binding [Editor.HotstringKeepEnd], Source={x:Static loc:Strings.Current}}"
                                          IsChecked="{Binding HotstringKeepEnd}" />
                            </StackPanel>

                            <!-- Idle trigger settings -->
                            <StackPanel IsVisible="{Binding IsIdleTrigger}">
                                <TextBlock Classes="FieldLabel" Margin="2,12,0,6"
                                           Text="{Binding [Editor.IdleSeconds], Source={x:Static loc:Strings.Current}}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <views:NumberBox Width="112" Height="30" Value="{Binding IdleSeconds}"
                                                   Minimum="1" Maximum="86400" Increment="10" FormatString="0" />
                                    <TextBlock FontSize="12.5" Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center"
                                               Text="{Binding [Schedule.Unit.Seconds], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>

                                <TextBlock Classes="Hint" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="{Binding [Editor.IdleNote], Source={x:Static loc:Strings.Current}}" />
                            </StackPanel>
                            </StackPanel>

                            <!-- Menu placement is project-wide and lives in the runtime menu. -->
                            <StackPanel IsVisible="{Binding IsMenuTrigger}">
                                <TextBlock Classes="Hint" TextWrapping="Wrap"
                                           Text="{Binding [Editor.MenuManagedInPanel], Source={x:Static loc:Strings.Current}}" />
                            </StackPanel>

                            </StackPanel>
                            </Border>
                            </StackPanel>

                            <!-- How this macro behaves when it is running at the same time as
                                 another one. It is not a trigger: the same question is asked
                                 whatever starts the macro. -->
                            <Border Classes="Sunken" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Classes="GroupHeader" HorizontalAlignment="Center" Margin="0,0,0,10"
                                               Text="{Binding [Editor.RunningTogether], Source={x:Static loc:Strings.Current}}" />

                                    <CheckBox Foreground="{DynamicResource AppMuted}" FontSize="12.5"
                                              Content="{Binding [Editor.ExclusiveInput], Source={x:Static loc:Strings.Current}}"
                                              IsChecked="{Binding ExclusiveInput}" />

                                    <TextBlock Classes="Hint" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Editor.ExclusiveInputNote], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Classes="GroupHeader" HorizontalAlignment="Center" Margin="0,16,0,9"
                                       Text="{Binding [Editor.MacroInterface], Source={x:Static loc:Strings.Current}}" />
                            <ContentControl Name="MacroInterfaceHost" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Save stays in this window; the title-bar close is the way out. The run
                         beside it loads the steps and stops in its own window. -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Name="SavedNotice" IsVisible="False" Margin="14,4,14,0"
                                   Foreground="#7FC97F" FontSize="11.5"
                                   Text="{Binding [Editor.SavedNotice], Source={x:Static loc:Strings.Current}}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Margin="12,8,12,12">
                            <Button Name="SaveButton" Classes="Primary"
                                    Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}">
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Center">
                                    <views:IconView Width="13" Height="13"
                                                    Stroke="{DynamicResource AppText}"
                                                    StrokeThickness="1.3" FitToBounds="True"
                                                    Data="{x:Static vm:AppIcons.Save}" />
                                    <TextBlock Text="{Binding [Editor.Save], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Name="RunDebugButton" Classes="Secondary"
                                    Command="{Binding RunCommand}" IsEnabled="{Binding HasSteps}">
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Center">
                                    <views:IconView Width="13" Height="13"
                                                    Stroke="{DynamicResource AppText}"
                                                    StrokeThickness="1.3" FitToBounds="True"
                                                    Data="{x:Static vm:AppIcons.BugPlay}" />
                                    <TextBlock Text="{Binding [Editor.RunDebug], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>

<!-- Middle: the step documents and their current list. -->
     <Border Grid.Column="2" Name="DocumentPanel"
             Background="{DynamicResource AppSurface}" CornerRadius="6">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="18,16">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <ListBox Name="DocumentTabs" ItemsSource="{Binding Documents}"
                     SelectionMode="Single" SelectionChanged="OnDocumentTabChanged"
                     Background="Transparent">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MacroDocumentPageViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="4">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" />
                            <views:IconView Grid.Column="1" Width="12" Height="12"
                                            IsVisible="{Binding HasProblem}"
                                            Stroke="#E06C75" StrokeThickness="1.4"
                                            Data="{x:Static vm:AppIcons.WarningTriangle}" />
                            <Button Grid.Column="2" Name="CloseDocumentButton"
                                    Classes="Ghost Tiny"
                                    IsVisible="{Binding !IsCurrent}"
                                    ToolTip.Tip="{Binding [Common.Close], Source={x:Static loc:Strings.Current}}"
                                    PointerPressed="OnDocumentTabClosePressed"
                                    Click="OnCloseDocumentTab">
                                <views:IconView Width="9" Height="9"
                                                Stroke="{DynamicResource AppMuted}"
                                                StrokeThickness="1.3" FitToBounds="True"
                                                Data="{x:Static vm:AppIcons.X}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- What is exported is the page that is showing: the macro itself, or the submacro
                 in front of you with the submacros it holds. -->
            <Button Grid.Column="1" Name="ExportDocumentButton" Classes="Secondary" Height="26"
                    Padding="9,0" VerticalAlignment="Center" Margin="8,0,0,0"
                    ToolTip.Tip="{Binding [Editor.ExportDocumentTip], Source={x:Static loc:Strings.Current}}"
                    Click="OnExportDocumentClicked">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <views:IconView Width="12" Height="12"
                                    Stroke="{DynamicResource AppMuted}"
                                    StrokeThickness="1.4" FitToBounds="True"
                                    Data="{x:Static vm:AppIcons.ExternalLink}" />
                    <TextBlock FontSize="11.5"
                               Text="{Binding [Editor.ExportDocument], Source={x:Static loc:Strings.Current}}" />
                </StackPanel>
            </Button>
            </Grid>
            <TextBlock Grid.Row="1" Classes="SectionHeader" HorizontalAlignment="Center"
                       Text="{Binding [Editor.ActionEditor], Source={x:Static loc:Strings.Current}}" />

             <ItemsControl Grid.Row="2" ItemsSource="{Binding ActionPalette}" Margin="0,0,0,12">
                 <ItemsControl.ItemsPanel>
                     <ItemsPanelTemplate>
                         <WrapPanel Orientation="Horizontal" />
                     </ItemsPanelTemplate>
                 </ItemsControl.ItemsPanel>
                 <ItemsControl.ItemTemplate>
                     <DataTemplate x:DataType="vm:MacroAction">
                        <Button Classes="Icon" Margin="0,0,5,5" Classes.primary="{Binding IsPrimary}"
                               ToolTip.Tip="{Binding Label}"
                               ToolTip.ShowOnDisabled="True"
                               IsEnabled="{Binding IsEnabled}"
                                Command="{Binding $parent[ItemsControl].((vm:MacroEditorViewModel)DataContext).AddActionCommand}"
                                CommandParameter="{Binding}">
                             <views:IconView Width="16" Height="16" Data="{Binding Icon}" />
                         </Button>
                     </DataTemplate>
                 </ItemsControl.ItemTemplate>
             </ItemsControl>

                   <!-- What the design-time check made of the steps, so a problem is known while
                        the macro is being written rather than when a trigger fires it. -->
                   <StackPanel Grid.Row="3" Spacing="2">
                       <TextBlock Classes="Problem" Margin="2,0,0,8" IsVisible="{Binding HasStepProblems}"
                                  Text="{Binding ProblemSummary}" />
                       <TextBlock Classes="Problem" Margin="2,0,0,8" IsVisible="{Binding HasDeclarationProblems}"
                                  Text="{Binding DeclarationProblemSummary}" TextWrapping="Wrap" />
                       <TextBlock Classes="Problem" Margin="2,0,0,8" IsVisible="{Binding HasCallImpact}"
                                  Text="{Binding CallImpactSummary}" TextWrapping="Wrap" />
                       <TextBlock Classes="Problem" Margin="2,0,0,8" IsVisible="{Binding HasNotice}"
                                  Text="{Binding Notice}" TextWrapping="Wrap" />
                   </StackPanel>

                   <!-- Empty state -->
                   <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4"
                               IsVisible="{Binding !HasSteps}" IsHitTestVisible="False">
                       <TextBlock Foreground="{DynamicResource AppMuted}" FontSize="13"
                                  Text="{Binding [Editor.NoSteps], Source={x:Static loc:Strings.Current}}"
                                  HorizontalAlignment="Center" />
                       <TextBlock Text="{Binding [Editor.NoStepsHint], Source={x:Static loc:Strings.Current}}"
                                  Classes="Hint" HorizontalAlignment="Center" TextAlignment="Center" />
                   </StackPanel>

                   <!-- Selection is restored after every edit. Following it would drag a long
                        macro from the reader's place to whichever row the rebuild picked last. -->
                   <ListBox Grid.Row="4" Name="StepList" Classes="List Bare Gapped"
                            ItemsSource="{Binding Rows}" SelectionMode="Multiple"
                            AutoScrollToSelectedItem="False"
                            Background="Transparent"
                            DoubleTapped="OnStepDoubleTapped">
                       <ListBox.ContextMenu>
                           <ContextMenu>
                               <MenuItem Header="{Binding [Editor.Context.Edit], Source={x:Static loc:Strings.Current}}"
                                         Click="OnStepContextEdit" />
                               <MenuItem Header="{Binding [Editor.Context.Copy], Source={x:Static loc:Strings.Current}}"
                                         Click="OnStepContextCopy" />
                               <MenuItem Header="{Binding [Editor.Context.Cut], Source={x:Static loc:Strings.Current}}"
                                         Click="OnStepContextCut" />
                               <MenuItem Header="{Binding [Editor.Context.Paste], Source={x:Static loc:Strings.Current}}"
                                         Click="OnStepContextPaste" />
                               <MenuItem Header="{Binding [Editor.Context.Delete], Source={x:Static loc:Strings.Current}}"
                                         Click="OnStepContextDelete" />
                               <Separator />
                               <MenuItem Header="{Binding [Editor.Context.MoveUp], Source={x:Static loc:Strings.Current}}"
                                         Click="OnStepContextMoveUp" />
                               <MenuItem Header="{Binding [Editor.Context.MoveDown], Source={x:Static loc:Strings.Current}}"
                                         Click="OnStepContextMoveDown" />
                               <MenuItem Header="{Binding [Editor.Context.Group], Source={x:Static loc:Strings.Current}}"
                                         Click="OnStepContextGroup" />
                               <MenuItem Header="{Binding [Editor.Context.Lift], Source={x:Static loc:Strings.Current}}"
                                         Click="OnStepContextLift" />
                               <Separator />
                               <MenuItem Header="{Binding [Editor.Context.ToggleEnabled], Source={x:Static loc:Strings.Current}}"
                                         Click="OnStepContextToggleEnabled" />
                           </ContextMenu>
                       </ListBox.ContextMenu>
                       <ListBox.ItemTemplate>
                           <DataTemplate x:DataType="vm:StepRow">
                              <Panel>
                                  <!-- A step, indented by how deep it sits. A block carries a
                                       fold arrow, so what is inside it can be put away. -->
                                  <Border Classes="Card Selectable" Classes.problem="{Binding HasProblem}"
                                          Opacity="{Binding RowOpacity}"
                                          Margin="{Binding Indent}"
                                          ToolTip.Tip="{Binding IdHint}"
                                          IsVisible="{Binding IsStep}">
                                      <StackPanel Orientation="Horizontal" Spacing="6">
                                          <Button Classes="Ghost Tiny" VerticalAlignment="Center" IsVisible="{Binding CanFold}"
                                                  ToolTip.Tip="{Binding FoldHint}"
                                                  Command="{Binding $parent[ItemsControl].((vm:MacroEditorViewModel)DataContext).ToggleFoldCommand}"
                                                  CommandParameter="{Binding}">
                                              <views:IconView StrokeThickness="1.4" FitToBounds="True" Data="{Binding FoldIcon}" />
                                          </Button>
                                          <views:IconView Width="16" Height="16" Stroke="{DynamicResource AppText}"
                                                          StrokeThickness="1.5" Data="{Binding Icon}"
                                                          VerticalAlignment="Center" Margin="0,0,4,0" />
                                          <StackPanel VerticalAlignment="Center">
                                              <StackPanel Orientation="Horizontal" Spacing="6">
                                                  <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                             FontWeight="SemiBold"
                                                             Foreground="{DynamicResource AppTextStrong}" />
                                                  <Border Background="#4A3A1E" CornerRadius="3" Padding="5,0"
                                                          VerticalAlignment="Center"
                                                          IsVisible="{Binding IsSkipped}">
                                                      <TextBlock Text="{Binding SkipLabel}" Classes="Caption"
                                                                 Foreground="#D8B36A" />
                                                  </Border>
                                                  <Border Background="#2C3A46" CornerRadius="3" Padding="5,0"
                                                          VerticalAlignment="Center"
                                                          IsVisible="{Binding HasId}">
                                                      <TextBlock Text="{Binding Id}" Classes="Caption"
                                                                 FontFamily="Consolas,Menlo,monospace"
                                                                 Foreground="#8FB3D9" />
                                                  </Border>
                                                  <!-- Where this step's input goes. It costs
                                                       different things in each of the three ways,
                                                       so it is read off the row like the name. -->
                                                  <Border Background="#26332A" CornerRadius="3" Padding="5,0"
                                                          VerticalAlignment="Center"
                                                          ToolTip.Tip="{Binding InputMarkHint}"
                                                          IsVisible="{Binding HasInputMark}">
                                                      <TextBlock Text="{Binding InputMark}" Classes="Caption"
                                                                 Foreground="#8FD9A8" />
                                                  </Border>
                                              </StackPanel>
                                              <TextBlock Text="{Binding Detail}" Classes="Hint"
                                                         TextWrapping="Wrap" />
                                              <TextBlock Text="{Binding Comment}" FontSize="11"
                                                         Foreground="#C8A165" TextWrapping="Wrap"
                                                         IsVisible="{Binding HasComment}" />
                                              <TextBlock Text="{Binding MetaSummary}" Classes="Caption"
                                                         Foreground="#8FB3D9" TextWrapping="Wrap"
                                                         IsVisible="{Binding HasMetaSummary}" />
                                          </StackPanel>
                                          <Border Classes="ProblemTip" IsVisible="{Binding HasProblem}"
                                                  ToolTip.Tip="{Binding Problem}">
                                              <views:IconView Classes="ProblemMark" StrokeThickness="1.4"
                                                              FitToBounds="True"
                                                              Data="{x:Static vm:AppIcons.WarningTriangle}" />
                                          </Border>
                                      </StackPanel>
                                  </Border>

                                   <!-- The title of one of a block's lists, with an entry that sends
                                        the person to the actions that can be dragged to its end. -->
                                  <Border Classes="StepHead" Margin="{Binding Indent}"
                                          IsVisible="{Binding IsHead}">
                                      <StackPanel Orientation="Horizontal" Spacing="8">
                                          <TextBlock Classes="Note" VerticalAlignment="Center"
                                                     Text="{Binding HeadLabel}" />
                                          <TextBlock Classes="Note" VerticalAlignment="Center"
                                                     Text="{Binding HeadCount}" />
                                          <Button Classes="Secondary" Height="28"
                                                  ToolTip.Tip="{Binding AddHint}"
                                                  Command="{Binding $parent[ItemsControl].((vm:MacroEditorViewModel)DataContext).AddInsideCommand}"
                                                  CommandParameter="{Binding}">
                                              <StackPanel Orientation="Horizontal" Spacing="5">
                                                  <views:IconView Width="14" Height="14"
                                                                  Stroke="{DynamicResource AppText}"
                                                                  StrokeThickness="1.6"
                                                                  FitToBounds="True"
                                                  Data="{x:Static vm:AppIcons.ArrowDown}" />
                                                  <TextBlock Text="{Binding AddLabel}"
                                                             VerticalAlignment="Center" />
                                              </StackPanel>
                                          </Button>
                                          <TextBlock IsVisible="{Binding IsEmptyList}"
                                                     Text="{Binding EmptyListHint}"
                                                     Classes="Hint"
                                                     VerticalAlignment="Center" />
                                      </StackPanel>
                                  </Border>

                                  <!-- The line that closes a block, so "inside the block" and "after
                                       the block" never read as the same place. -->
                                  <Border Classes="StepFoot" Margin="{Binding Indent}"
                                          IsVisible="{Binding IsFoot}">
                                      <TextBlock Classes="Caption" VerticalAlignment="Center" Text="{Binding FootLabel}" />
                                  </Border>
                              </Panel>
                           </DataTemplate>
                       </ListBox.ItemTemplate>
                   </ListBox>

                   <!-- The band a dragged action drops on. Sits in the same cell as the list and
                        is not hit-testable, so it never swallows the drag that draws it. -->
                   <Canvas Grid.Row="4" Name="DropLayer" IsHitTestVisible="False">
                       <Border Name="DropMarker" Classes="DropTarget" MinHeight="30" CornerRadius="4"
                               BorderThickness="3,0,0,0" IsVisible="False">
                           <TextBlock Name="DropHintText" Margin="10,0"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource AppTextStrong}"
                                      FontSize="12" TextWrapping="Wrap" />
                       </Border>
                   </Canvas>

               </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="16" Background="Transparent"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWestEast" />

            <GridSplitter Grid.Column="3" Width="16" Background="Transparent"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWestEast" />

            <Border Grid.Column="2" Name="RecordingPanel" Background="{DynamicResource AppSurface}"
                    CornerRadius="6" IsVisible="False">
                <StackPanel Margin="20,18" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="SectionHeader" HorizontalAlignment="Center"
                                   Text="{Binding [Editor.RecordActions], Source={x:Static loc:Strings.Current}}" />
                        <Button Grid.Column="1" Classes="Secondary" Height="28" Padding="8,0"
                                Content="{Binding [Common.Close], Source={x:Static loc:Strings.Current}}"
                                Click="OnCloseRecording" />
                    </Grid>
                    <TextBlock Classes="Hint" TextWrapping="Wrap"
                               Text="{Binding [Editor.RecordIdle], Source={x:Static loc:Strings.Current}}" />
                            <Border Classes="Sunken" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Classes="GroupHeader" HorizontalAlignment="Center" Margin="0,0,0,10"
                                               Text="{Binding [Editor.RecordActions], Source={x:Static loc:Strings.Current}}" />

                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Editor.PositionCapture], Source={x:Static loc:Strings.Current}}" />
                                    <ComboBox Classes="Field" ItemsSource="{Binding PositionCaptureOptions}"
                                              SelectedIndex="{Binding PositionCaptureIndex}" Margin="0,0,0,6" />

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                        <Border Grid.Row="0" Grid.Column="0" Classes="Card">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                                                            Opacity="{Binding RecordMouseMovement, Converter={StaticResource RowOpacity}}">
                                                    <views:IconView Classes="RecordIcon" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static vm:AppIcons.Cursor}" />
                                                    <TextBlock FontSize="12.5" VerticalAlignment="Center"
                                                               Text="{Binding [Editor.MouseMovement], Source={x:Static loc:Strings.Current}}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                              Width="40"
                                                              OnContent="" OffContent=""
                                                              IsChecked="{Binding RecordMouseMovement}" />
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="0" Grid.Column="1" Classes="Card">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                                                            Opacity="{Binding RecordMouseButtons, Converter={StaticResource RowOpacity}}">
                                                    <views:IconView Classes="RecordIcon" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static vm:AppIcons.Mouse}" />
                                                    <TextBlock FontSize="12.5" VerticalAlignment="Center"
                                                               Text="{Binding [Editor.MouseButtons], Source={x:Static loc:Strings.Current}}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                              Width="40"
                                                              OnContent="" OffContent=""
                                                              IsChecked="{Binding RecordMouseButtons}" />
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="0" Classes="Card">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                                                            Opacity="{Binding RecordKeyboardKeys, Converter={StaticResource RowOpacity}}">
                                                    <views:IconView Classes="RecordIcon" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static vm:AppIcons.Keyboard}" />
                                                    <TextBlock FontSize="12.5" VerticalAlignment="Center"
                                                               Text="{Binding [Editor.KeyboardKeys], Source={x:Static loc:Strings.Current}}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                              Width="40"
                                                              OnContent="" OffContent=""
                                                              IsChecked="{Binding RecordKeyboardKeys}" />
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="1" Classes="Card">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                                                            Opacity="{Binding RecordDelays, Converter={StaticResource RowOpacity}}">
                                                    <views:IconView Classes="RecordIcon" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static vm:AppIcons.Clock}" />
                                                    <TextBlock FontSize="12.5" VerticalAlignment="Center"
                                                               Text="{Binding [Editor.Delays], Source={x:Static loc:Strings.Current}}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                              Width="40"
                                                              OnContent="" OffContent=""
                                                              IsChecked="{Binding RecordDelays}" />
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="2" Grid.Column="0" Classes="Card">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                                                            Opacity="{Binding RecordGamepadButtons, Converter={StaticResource RowOpacity}}">
                                                    <views:IconView Classes="RecordIcon" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static vm:AppIcons.GameController}" />
                                                    <TextBlock FontSize="12.5" VerticalAlignment="Center"
                                                               Text="{Binding [Editor.GamepadButtons], Source={x:Static loc:Strings.Current}}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                              Width="40"
                                                              OnContent="" OffContent=""
                                                              IsChecked="{Binding RecordGamepadButtons}" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Border Classes="Card" Margin="0,4,0,0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                                                        Opacity="{Binding RecordIgnoreInjected, Converter={StaticResource RowOpacity}}">
                                                <!-- Funnel: input from elsewhere is filtered out -->
                                                <views:IconView Classes="RecordIcon" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static vm:AppIcons.Filter}" />
                                                <TextBlock FontSize="12.5" VerticalAlignment="Center"
                                                           Text="{Binding [Editor.IgnoreInjected], Source={x:Static loc:Strings.Current}}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                          Width="40"
                                                          OnContent="" OffContent=""
                                                          ToolTip.Tip="{Binding [Editor.Tip.IgnoreInjected], Source={x:Static loc:Strings.Current}}"
                                                          IsChecked="{Binding RecordIgnoreInjected}" />
                                        </Grid>
                                    </Border>

                                    <!-- One line, so the record button below keeps its place on screen -->
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="7"
                                                HorizontalAlignment="Center"
                                                IsEnabled="{Binding RecordDelays}"
                                                Opacity="{Binding RecordDelays, Converter={StaticResource RowOpacity}}">
                                        <TextBlock Classes="FieldLabel" FontSize="12.5" Margin="0"
                                                   Text="{Binding [Editor.IgnoreDelays], Source={x:Static loc:Strings.Current}}"
                                                   VerticalAlignment="Center" />
                                        <views:NumberBox Width="112" Height="30" Value="{Binding IgnoreDelaysBelowMs}"
                                                       Minimum="0" Maximum="60000" Increment="10" FormatString="0" />
                                        <TextBlock FontSize="12.5" Foreground="{DynamicResource AppMuted}"
                                                   Text="{Binding [Editor.Milliseconds], Source={x:Static loc:Strings.Current}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                </StackPanel>
                            </Border>
                    <Button Classes="RecordButton" Height="42" HorizontalAlignment="Stretch"
                            Classes.Recording="{Binding IsRecording}"
                            IsEnabled="{Binding !IsCapturingKey}"
                            AutomationProperties.Name="Record macro actions"
                            ToolTip.Tip="{Binding [Editor.Tip.Record], Source={x:Static loc:Strings.Current}}"
                            Command="{Binding ToggleRecordCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Classes="RecordIndicator"
                                  Data="M12,5.6 A6.4,6.4 0 1 0 12,18.4 A6.4,6.4 0 1 0 12,5.6 Z"
                                  IsVisible="{Binding !IsRecording}" />
                            <Path Classes="RecordIndicator Stop" Data="M7,7 H17 V17 H7 Z"
                                  IsVisible="{Binding IsRecording}" />
                            <StackPanel VerticalAlignment="Center" Width="112">
                                <TextBlock Text="{Binding RecordLabel}" HorizontalAlignment="Center"
                                           FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="Ctrl + F10" HorizontalAlignment="Center"
                                           FontSize="11" Foreground="#FFE3D6" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <TextBlock Classes="Hint" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Text="{Binding RecordStatusText}" />
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>

