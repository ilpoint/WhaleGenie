<views:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        x:Class="WhaleGenie.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="940" Height="740"
        MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceWindow}">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <!--
      Three groups named at the top of the window, and the pages of the one that is open listed on
      the left, the way Windows 11 settings are laid out. The groups used to be headings inside the
      one list, which left the reader working out which heading a page was under; a tab says it
      before the list is read. Page panels switch on IsVisible because they share one scroll area,
      which keeps a page's scroll position while another is looked at.
    -->
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2" Margin="20,10,20,0">
            <Button Classes="Tab Root" Tag="System" Click="OnRootTabClicked"
                    Classes.selected="{Binding IsSystemRoot}"
                    Content="{Binding [Settings.Root.System], Source={x:Static loc:Strings.Current}}" />
            <Button Classes="Tab Root" Tag="Triggers" Click="OnRootTabClicked"
                    Classes.selected="{Binding IsTriggersRoot}"
                    Content="{Binding [Settings.Root.Triggers], Source={x:Static loc:Strings.Current}}" />
            <Button Classes="Tab Root" Tag="Appearance" Click="OnRootTabClicked"
                    Classes.selected="{Binding IsAppearanceRoot}"
                    Content="{Binding [Settings.Root.Appearance], Source={x:Static loc:Strings.Current}}" />
        </StackPanel>

        <fa:FANavigationView Grid.Row="1" Name="Nav" Margin="6,0,6,0"
                            PaneDisplayMode="Left"
                            ExpandedModeThresholdWidth="0"
                            CompactModeThresholdWidth="0"
                            OpenPaneLength="212"
                            IsPaneToggleButtonVisible="False"
                            IsBackButtonVisible="False"
                            IsSettingsVisible="False"
                            SelectionChanged="OnNavSelectionChanged">
            <!--
              Every page is listed here and the window shows the ones that belong to the open group.
              The list itself is never rebuilt: taking items out of it leaves the panel's selection
              pointing at an item it no longer holds.
            -->
            <fa:FANavigationView.MenuItems>
                <fa:FANavigationViewItem Name="GeneralNavItem" Tag="General"
                                        Content="{Binding [Settings.Nav.General], Source={x:Static loc:Strings.Current}}" />
                <fa:FANavigationViewItem Name="HotkeysNavItem" Tag="Hotkeys"
                                        Content="{Binding [Settings.Nav.Hotkeys], Source={x:Static loc:Strings.Current}}" />
                <fa:FANavigationViewItem Name="ScreenNavItem" Tag="Screen"
                                        Content="{Binding [Settings.Nav.Screen], Source={x:Static loc:Strings.Current}}" />
                <fa:FANavigationViewItem Name="InputNavItem" Tag="Input"
                                        Content="{Binding [Settings.Nav.Input], Source={x:Static loc:Strings.Current}}" />
                <fa:FANavigationViewItem Name="DevicesNavItem" Tag="Devices"
                                        Content="{Binding [Settings.Nav.Devices], Source={x:Static loc:Strings.Current}}" />
                <fa:FANavigationViewItem Name="MenuLauncherNavItem" Tag="MenuLauncher"
                                        Content="{Binding [Settings.Nav.MenuLauncher], Source={x:Static loc:Strings.Current}}" />
                <fa:FANavigationViewItem Name="WindowRulesNavItem" Tag="WindowRules"
                                        Content="{Binding [Settings.Nav.WindowRules], Source={x:Static loc:Strings.Current}}" />
                <fa:FANavigationViewItem Name="WheelMenuNavItem" Tag="WheelMenu"
                                        Content="{Binding [Settings.Nav.WheelMenu], Source={x:Static loc:Strings.Current}}" />
                <fa:FANavigationViewItem Name="WheelActionsNavItem" Tag="WheelActions"
                                        Content="{Binding [Settings.Nav.WheelActions], Source={x:Static loc:Strings.Current}}" />
                <fa:FANavigationViewItem Name="ThemeNavItem" Tag="Theme"
                                        Content="{Binding [Settings.Nav.Theme], Source={x:Static loc:Strings.Current}}" />
            </fa:FANavigationView.MenuItems>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,2">
                <Panel Name="SettingsPanel" Margin="4,6,16,18">
                    <views:SettingsSystemView Name="SystemPages" />
                    <views:SettingsTriggersView Name="TriggerPages" />
                    <views:SettingsAppearanceView Name="AppearancePages" />
                </Panel>
            </ScrollViewer>
        </fa:FANavigationView>

        <Button Grid.Row="2" Classes="Secondary" Height="36" MinWidth="92"
                HorizontalAlignment="Right" Margin="20,6,20,16" Name="DoneButton"
                Content="{Binding [Settings.Close], Source={x:Static loc:Strings.Current}}" />
    </Grid>
</views:AppWindow>
