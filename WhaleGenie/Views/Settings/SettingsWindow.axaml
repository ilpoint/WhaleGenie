<views:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        x:Class="WhaleGenie.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="940" Height="740"
        MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceWindow}">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <!--
      Three groups listed on the left, the pages of the open one named at the top of the content
      column, the way Windows 11 settings are laid out. A group is a place a reader looks for a
      whole class of answers; a tab then picks the page inside it, so the two levels are never
      read as peers. Page panels switch on IsVisible because they share one scroll area, which
      keeps a page's scroll position while another is looked at.
    -->
    <fa:FANavigationView Name="Nav"
                        PaneDisplayMode="Left"
                        ExpandedModeThresholdWidth="0"
                        CompactModeThresholdWidth="0"
                        OpenPaneLength="200"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="False"
                        IsSettingsVisible="False"
                        SelectionChanged="OnNavSelectionChanged">
        <!--
          The list holds the three groups, not the pages: the pages of a group are already named
          at the top of the content column, and repeating them in the list would leave two
          controls offering the same choice. Every group is reachable in one click.
        -->
        <fa:FANavigationView.MenuItems>
            <fa:FANavigationViewItem Name="SystemNavItem" Tag="System">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <views:IconView Width="16" Height="16" StrokeThickness="1.5"
                                    Data="{x:Static vm:AppIcons.SettingsSystem}" />
                    <TextBlock Text="{Binding [Settings.Root.System], Source={x:Static loc:Strings.Current}}" />
                </StackPanel>
            </fa:FANavigationViewItem>
            <fa:FANavigationViewItem Name="TriggersNavItem" Tag="Triggers">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <views:IconView Width="16" Height="16" StrokeThickness="1.5"
                                    Data="{x:Static vm:AppIcons.SettingsTriggers}" />
                    <TextBlock Text="{Binding [Settings.Root.Triggers], Source={x:Static loc:Strings.Current}}" />
                </StackPanel>
            </fa:FANavigationViewItem>
            <fa:FANavigationViewItem Name="AppearanceNavItem" Tag="Appearance">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <views:IconView Width="16" Height="16" StrokeThickness="1.5"
                                    Data="{x:Static vm:AppIcons.SettingsAppearance}" />
                    <TextBlock Text="{Binding [Settings.Root.Appearance], Source={x:Static loc:Strings.Current}}" />
                </StackPanel>
            </fa:FANavigationViewItem>
        </fa:FANavigationView.MenuItems>

        <fa:FANavigationView.Content>
            <Grid RowDefinitions="Auto,*">
                <!--
                  The pages of the open group, as a row of capsules. Each panel is built in full and
                  only shown with its group: the page buttons keep their names and their order, and
                  switching groups never rebuilds the row.
                -->
                <Panel Grid.Row="0" Margin="20,14,20,0">
                    <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsSystemRoot}">
                        <Button Classes="Tab Root Capsule" Tag="General" Click="OnSubPageClicked"
                                Classes.selected="{Binding IsGeneralPage}"
                                Content="{Binding [Settings.Nav.General], Source={x:Static loc:Strings.Current}}" />
                        <Button Classes="Tab Root Capsule" Tag="Hotkeys" Click="OnSubPageClicked"
                                Classes.selected="{Binding IsHotkeysPage}"
                                Content="{Binding [Settings.Nav.Hotkeys], Source={x:Static loc:Strings.Current}}" />
                        <Button Classes="Tab Root Capsule" Tag="Screen" Click="OnSubPageClicked"
                                Classes.selected="{Binding IsScreenPage}"
                                Content="{Binding [Settings.Nav.Screen], Source={x:Static loc:Strings.Current}}" />
                        <Button Classes="Tab Root Capsule" Tag="Input" Click="OnSubPageClicked"
                                Classes.selected="{Binding IsInputPage}"
                                Content="{Binding [Settings.Nav.Input], Source={x:Static loc:Strings.Current}}" />
                        <Button Classes="Tab Root Capsule" Tag="Devices" Click="OnSubPageClicked"
                                Classes.selected="{Binding IsDevicesPage}"
                                Content="{Binding [Settings.Nav.Devices], Source={x:Static loc:Strings.Current}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsTriggersRoot}">
                        <Button Classes="Tab Root Capsule" Tag="MenuLauncher" Click="OnSubPageClicked"
                                Classes.selected="{Binding IsMenuLauncherPage}"
                                Content="{Binding [Settings.Nav.MenuLauncher], Source={x:Static loc:Strings.Current}}" />
                        <Button Classes="Tab Root Capsule" Tag="WindowRules" Click="OnSubPageClicked"
                                Classes.selected="{Binding IsWindowRulesPage}"
                                Content="{Binding [Settings.Nav.WindowRules], Source={x:Static loc:Strings.Current}}" />
                        <Button Classes="Tab Root Capsule" Tag="WheelMenu" Click="OnSubPageClicked"
                                Classes.selected="{Binding IsWheelMenuPage}"
                                Content="{Binding [Settings.Nav.WheelMenu], Source={x:Static loc:Strings.Current}}" />
                        <Button Classes="Tab Root Capsule" Tag="WheelActions" Click="OnSubPageClicked"
                                Classes.selected="{Binding IsWheelActionsPage}"
                                Content="{Binding [Settings.Nav.WheelActions], Source={x:Static loc:Strings.Current}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsAppearanceRoot}">
                        <Button Classes="Tab Root Capsule" Tag="Theme" Click="OnSubPageClicked"
                                Classes.selected="{Binding IsThemePage}"
                                Content="{Binding [Settings.Nav.Theme], Source={x:Static loc:Strings.Current}}" />
                    </StackPanel>
                </Panel>

                <ScrollViewer Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Panel Name="SettingsPanel" Margin="20,10,20,18">
                        <views:SettingsSystemView Name="SystemPages" />
                        <views:SettingsTriggersView Name="TriggerPages" />
                        <views:SettingsAppearanceView Name="AppearancePages" />
                    </Panel>
                </ScrollViewer>
            </Grid>
        </fa:FANavigationView.Content>
    </fa:FANavigationView>
</views:AppWindow>