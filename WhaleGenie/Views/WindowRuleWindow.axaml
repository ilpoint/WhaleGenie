<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:WhaleGenie.Localization"
        x:Class="WhaleGenie.Views.WindowRuleWindow"
        Title="WhaleGenie"
        Width="560" Height="430"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackdrop}">
    <Border Background="{DynamicResource AppSurface}" CornerRadius="8" Padding="20">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">
            <TextBlock Grid.Row="0" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppTextStrong}"
                       Text="{Binding [WindowRule.Title], Source={x:Static loc:Strings.Current}}" />

            <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="12.5"
                       Foreground="{DynamicResource AppMuted}"
                       Text="{Binding [WindowRule.CaptureHint], Source={x:Static loc:Strings.Current}}" />

            <Border Grid.Row="2" Background="{DynamicResource AppField}" CornerRadius="5" Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock Name="Status" FontSize="12.5" Foreground="#8FC7F0" TextWrapping="Wrap" />
                    <TextBlock Name="HandleText" FontSize="11.5" Foreground="{DynamicResource AppMuted}" />
                    <TextBlock Name="TitleText" FontSize="12" Foreground="{DynamicResource AppText}"
                               TextWrapping="Wrap" />
                    <TextBlock Name="ProcessText" FontSize="11.5" Foreground="{DynamicResource AppMuted}" />
                    <TextBlock Name="ClassText" FontSize="11.5" Foreground="{DynamicResource AppMuted}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Name="RuleFields" IsVisible="False" Spacing="8">
                <Grid ColumnDefinitions="180,*" ColumnSpacing="10">
                    <TextBlock VerticalAlignment="Center" FontSize="12.5"
                               Foreground="{DynamicResource AppMuted}"
                               Text="{Binding [WindowRule.How], Source={x:Static loc:Strings.Current}}" />
                    <ComboBox Grid.Column="1" Name="HowBox" />
                </Grid>
                <Grid ColumnDefinitions="180,*" ColumnSpacing="10">
                    <TextBlock VerticalAlignment="Center" FontSize="12.5"
                               Foreground="{DynamicResource AppMuted}"
                               Text="{Binding [WindowRule.MatchText], Source={x:Static loc:Strings.Current}}" />
                    <TextBox Grid.Column="1" Name="MatchBox" />
                </Grid>
                <WrapPanel Name="ComparisonSwitches">
                    <CheckBox Name="CaseBox" Margin="0,0,14,0"
                              Content="{Binding [WindowRule.CaseSensitive], Source={x:Static loc:Strings.Current}}" />
                    <CheckBox Name="TrimBox" Margin="0,0,14,0"
                              Content="{Binding [WindowRule.Trim], Source={x:Static loc:Strings.Current}}" />
                    <CheckBox Name="MultilineBox"
                              Content="{Binding [WindowRule.Multiline], Source={x:Static loc:Strings.Current}}" />
                </WrapPanel>
                <TextBlock Name="HandleHint" IsVisible="False" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppMuted}"
                           Text="{Binding [WindowRule.HandleHint], Source={x:Static loc:Strings.Current}}" />
                <TextBlock Name="PreviewText" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppMuted}" />
            </StackPanel>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Name="AgainButton" Width="110" Height="34" IsVisible="False"
                        Content="{Binding [WindowRule.GetAgain], Source={x:Static loc:Strings.Current}}" />
                <Button Name="CancelButton" Width="90" Height="34"
                        Content="{Binding [WindowRule.Cancel], Source={x:Static loc:Strings.Current}}" />
                <Button Name="UseButton" Width="120" Height="34" IsVisible="False"
                        Content="{Binding [WindowRule.Use], Source={x:Static loc:Strings.Current}}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
