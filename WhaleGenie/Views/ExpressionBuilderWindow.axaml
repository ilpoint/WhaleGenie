<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:conv="using:WhaleGenie.Converters"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1140" d:DesignHeight="720"
        x:Class="WhaleGenie.Views.ExpressionBuilderWindow"
        x:DataType="vm:ExpressionBuilderViewModel"
        Title="WhaleGenie"
        Width="1140" Height="720"
        MinWidth="960" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource AppBackdrop}">

    <Design.DataContext>
        <vm:ExpressionBuilderViewModel />
    </Design.DataContext>

    <Window.Resources>
        <conv:FunctionGroupBrushConverter x:Key="FnGroup" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.Muted">
            <Setter Property="Foreground" Value="{DynamicResource AppMuted}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <!-- One part of the palette, and the box the whole palette stands in: reading what can go
             into a formula means seeing where one kind of thing stops and the next begins. -->
        <Style Selector="TextBox.ExprInput">
            <Setter Property="Background" Value="{DynamicResource AppBackdrop}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="9,7" />
        </Style>

        <!-- A box that only narrows what is under it: smaller than the box a formula is written in,
             because it holds a word at a time rather than a formula. -->
        <Style Selector="TextBox.Filter">
            <Setter Property="Background" Value="{DynamicResource AppBackdrop}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- One thing that can be put into the formula: an operator, a plain value, or a function.
             They are all one size, so the palette reads as a wall of things to point at rather than
             as a handful of different walls. -->
        <Style Selector="Button.ExprOption">
            <Setter Property="Background" Value="{DynamicResource AppField}" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ExprOption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>

        <!-- A function is a thing to pick up and put down, not a colour swatch: it reads like the
             action buttons in the macro editor, so the words stay dark and the group colour does not compete
             with them. -->
        <Style Selector="Button.FnCard">
            <Setter Property="Background" Value="{DynamicResource AppField}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.FnCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>

        <!-- Which page of the builder is in front. The two read as a switch rather than as a pair
             of buttons, because the left half of the window changes the moment one is pressed. -->
        <Style Selector="Button.Tab">
            <Setter Property="Background" Value="{DynamicResource AppField}" />
            <Setter Property="Foreground" Value="{DynamicResource AppMuted}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.Tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Button.Tab.on">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.Tab.on /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccent}" />
        </Style>

        <!-- One line of the formula. Picking is what a click does, so the line says when it is the
             one the next click from the palette goes into. -->
        <Style Selector="Border.Row">
            <Setter Property="Background" Value="{DynamicResource AppSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppSurface}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style Selector="Border.Row.picked">
            <Setter Property="Background" Value="{DynamicResource AppInfoSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppInfo}" />
        </Style>
        <Style Selector="Border.Row.drop">
            <Setter Property="Background" Value="{DynamicResource AppSelected}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
        </Style>

        <Style Selector="TextBlock.ArgLabel">
            <Setter Property="Foreground" Value="{DynamicResource AppLabel}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <!-- What is typed into a place. It is a box rather than a label because filling a place in
             is what the page is for, and it looks empty on purpose until something is typed. -->
        <Style Selector="Button.RowButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.RowButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>

        <Style Selector="Button.PrimaryButton">
            <Setter Property="Background" Value="{DynamicResource AppAccent}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.PrimaryButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentHover}" />
        </Style>
        <Style Selector="Button.PrimaryButton:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoft}" />
        </Style>

        <Style Selector="Button.TitleBarButton">
            <Setter Property="Background" Value="{DynamicResource AppControl}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.TitleBarButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="38,*,Auto">
        <Grid Grid.Row="0" Background="{DynamicResource AppChrome}" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                <Image Source="/Assets/WhaleGenie.png" Width="22" Height="22" Stretch="Uniform" />
                <TextBlock Text="{Binding Header}" Foreground="{DynamicResource AppText}" FontSize="13"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0"
                        VerticalAlignment="Center">
                <Button Classes="TitleBarButton" Name="CloseButton">
                    <views:IconView Width="10" Height="10" Stroke="{DynamicResource AppText}" StrokeThickness="1.2" FitToBounds="True" Data="{x:Static vm:AppIcons.X}" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,18,450" Margin="16,12,16,0">
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                    <Button Classes="Tab" Classes.on="{Binding IsTreePage}"
                            Content="{Binding TreeTab}" Click="OnShowTree" />
                    <Button Classes="Tab" Classes.on="{Binding IsTextPage}"
                            Content="{Binding TextTab}" Click="OnShowText" />
                </StackPanel>

                <TextBlock Grid.Row="1" Classes="Muted" Margin="2,10,0,0" TextWrapping="Wrap"
                           Text="{Binding TreeHelp}" IsVisible="{Binding IsTreePage}" />

                <!-- The structure page: one line to a piece of the formula, moved across by how deep
                     it sits. Nothing under it needs brackets, which is the point of building a
                     formula here rather than typing one. -->
                <ScrollViewer Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding IsTreePage}">
                    <StackPanel>
                        <TextBlock Classes="Muted" Foreground="{DynamicResource AppWarning}" TextWrapping="Wrap"
                                   Margin="2,0,0,6" Text="{Binding TreeCannotRead}"
                                   IsVisible="{Binding TextUnreadable}" />
                        <ItemsControl Name="TreeRows" ItemsSource="{Binding Rows}"
                                      IsVisible="{Binding !TextUnreadable}"
                                      DragDrop.AllowDrop="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExpressionItemViewModel">
                                    <Border Classes="Row"
                                            Classes.picked="{Binding IsSelected}"
                                            Classes.drop="{Binding IsDropTarget}"
                                            Margin="{Binding Indent}"
                                            DragDrop.AllowDrop="True"
                                            PointerPressed="OnRowPressed">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Classes="ArgLabel" VerticalAlignment="Center"
                                                       Text="{Binding Label}"
                                                       IsVisible="{Binding HasLabel}"
                                                       ToolTip.Tip="{Binding LabelHint}" />
                                            <TextBox Classes="Field Cell" Width="{Binding CellWidth}"
                                                     Text="{Binding Literal}"
                                                     PlaceholderText="{Binding HoleHint}"
                                                     IsVisible="{Binding IsTextBox}" />
                                            <!-- A yes or a no is ticked, a comparison is picked from
                                                 the words it may hold: one text line for all of them
                                                 made compare() read as six numbers to type. -->
                                            <CheckBox IsVisible="{Binding IsFlag}"
                                                      IsChecked="{Binding FlagValue}"
                                                      ToolTip.Tip="{Binding LabelHint}" />
                                            <ComboBox Classes="Field Cell" Width="{Binding CellWidth}"
                                                      ItemsSource="{Binding Choices}"
                                                      SelectedItem="{Binding ChosenWord}"
                                                      PlaceholderText="{Binding HoleHint}"
                                                      IsVisible="{Binding IsChoice}" />
                                            <Border Classes="Tag" IsVisible="{Binding ShowsToken}">
                                                <TextBlock Text="{Binding Token}"
                                                           ToolTip.Tip="{Binding LabelHint}" />
                                            </Border>
                                            <Button Classes="RowButton" Content="+"
                                                    IsVisible="{Binding CanAddChild}"
                                                    ToolTip.Tip="{Binding AddHint}"
                                                    Click="OnAddChild" />
                                            <Button Classes="RowButton" Content="−"
                                                    IsVisible="{Binding CanDropChild}"
                                                    ToolTip.Tip="{Binding DropHint}"
                                                    Click="OnDropChild" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- The page written out by hand: the way back in for a formula that is easier to type
                     than to build. What is typed here changes nothing until the button under it is
                     pressed, so a hand-built structure can never be lost to a stray keystroke. -->
                <Grid Grid.Row="2" Margin="0,8,0,0" RowDefinitions="Auto,Auto,*,Auto"
                      IsVisible="{Binding IsTextPage}">
                    <TextBlock Classes="Muted" TextWrapping="Wrap" Text="{Binding Help}" />
                    <TextBlock Grid.Row="1" Classes="FieldLabel" Margin="2,14,0,6"
                               Text="{Binding ExpressionHeader}" />
                    <TextBox Grid.Row="2" Name="ExpressionBox" Classes="ExprInput"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                             VerticalAlignment="Stretch"
                             PlaceholderText="{Binding Placeholder}"
                             Text="{Binding Written}" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Classes="Secondary" Height="30" Name="RebuildButton"
                                Content="{Binding [ExprBuilder.Rebuild], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [ExprBuilder.RebuildHint], Source={x:Static loc:Strings.Current}}"
                                Command="{Binding RebuildCommand}" />
                        <TextBlock Classes="Muted" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding WrittenMessage}" />
                    </StackPanel>
                </Grid>

                <!-- The cards that build a formula: names, plain values and operators, along the
                     bottom of the page they are dragged onto, which leaves the tree the full height
                     of the window. -->
                <Border Grid.Row="3" Name="BuildPanel" Classes="Panel" Margin="0,10,0,0" MaxHeight="260">
                    <Grid ColumnDefinitions="*,16,*">
                        <!-- What is written into a formula: operators, and the plain values they can
                             be applied to. -->
                        <ScrollViewer Grid.Column="0" Name="BuildLeft" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Classes="FieldLabel" Text="{Binding OperatorsHeader}" />
                                <!-- An operator is dragged onto the line it should wrap; a click only
                                     says so. -->
                                <ItemsControl ItemsSource="{Binding TreeOperators}"
                                              IsVisible="{Binding IsTreePage}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TreeOperator">
                                            <Button Classes="ExprOption" Content="{Binding Token}"
                                                    ToolTip.Tip="{Binding Hint}" Click="OnWrapWithOperator" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel IsVisible="{Binding IsTreePage}">
                                    <Border Classes="Divider" />
                                    <TextBlock Classes="FieldLabel" Text="{Binding ValuesHeader}" />
                                    <ItemsControl ItemsSource="{Binding Values}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ValueChoice">
                                                <Button Classes="ExprOption" Content="{Binding Label}"
                                                        ToolTip.Tip="{Binding Hint}" Click="OnPickValue" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- And the names they can be made of, on the other half. -->
                        <ScrollViewer Grid.Column="2" Name="BuildRight" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Classes="FieldLabel" Text="{Binding VariablesHeader}" />
                                <!-- The variables read as the same wall of buttons the picker beside
                                     a field shows, and hovering one says what it is. -->
                                <views:VariableWall DataContext="{Binding Wall}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- The right side: what the page has to say at the top right, the functions along the
                 bottom. A card goes where it is let go, so the line that says so sits above both
                 walls rather than inside either. -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">

                <StackPanel Name="HintBlock" Spacing="3" Margin="2,0,0,10">
                    <TextBlock Classes="Muted" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppWarning}"
                               Text="{Binding PaletteNotice}"
                               IsVisible="{Binding HasPaletteNotice}" />
                    <TextBlock Classes="Muted" TextWrapping="Wrap" Text="{Binding PaletteHint}" />
                </StackPanel>

                <!-- What the formula comes to: what is picked and how the formula is written on the
                     left, what it means and what the page has to say on the right. -->
                <Border Grid.Row="1" Name="FormulaPanel" Classes="Panel">
                    <Grid ColumnDefinitions="*,14,*">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="Muted" TextWrapping="Wrap" Text="{Binding Picked}"
                                           IsVisible="{Binding IsTreePage}" />
                                <TextBlock Classes="Muted" TextWrapping="Wrap"
                                           Text="{Binding TreePreviewHeader}"
                                           IsVisible="{Binding IsTreePage}" />
                                <TextBlock Classes="Muted" TextWrapping="Wrap" Foreground="{DynamicResource AppText}"
                                           Text="{Binding Preview}" IsVisible="{Binding IsTreePage}" />
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" MaxHeight="120">
                            <StackPanel Spacing="4">
                                <!-- The formula said in plain Chinese: a reader who does not follow
                                     the formula can still check the logic against it. -->
                                <TextBlock Name="SayingLine" Classes="Muted" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppInfo}" Text="{Binding Saying}"
                                           IsVisible="{Binding ShowsSaying}" />
                                <TextBlock Classes="Muted" TextWrapping="Wrap" Text="{Binding TreeMessage}"
                                           IsVisible="{Binding ShowTreeNote}" />
                                <TextBlock Classes="Muted" TextWrapping="Wrap" Foreground="{DynamicResource AppDanger}"
                                           Text="{Binding TreeMessage}" IsVisible="{Binding ShowTreeProblem}" />
                                <TextBlock Classes="Muted" TextWrapping="Wrap" Foreground="{DynamicResource AppSuccess}"
                                           Text="{Binding TreeMessage}" IsVisible="{Binding ShowTreeOk}" />
                                <!-- What the page written out by hand has to say about the text. -->
                                <TextBlock Classes="Muted" TextWrapping="Wrap" Foreground="{DynamicResource AppDanger}"
                                           Text="{Binding Message}" IsVisible="{Binding ShowError}" />
                                <TextBlock Classes="Muted" TextWrapping="Wrap" Foreground="{DynamicResource AppSuccess}"
                                           Text="{Binding Message}" IsVisible="{Binding ShowOk}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- What the language can already do, so a formula is not written from memory. The
                     dock narrows the wall to one group, and each card is painted in the colour of its
                     group: the dock and the colour are what tell the groups apart, so no heading has
                     to. How the call is written and what each argument is for are one hover away. -->
                <Border Grid.Row="2" Name="FunctionPanel" Classes="Panel" Margin="0,10,0,0">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                        <TextBlock Classes="FieldLabel" Text="{Binding FunctionsHeader}" />
                        <ListBox Grid.Row="1" Classes="Dock" ItemsSource="{Binding FunctionFilters}"
                                 SelectedItem="{Binding SelectedFunctionFilter}" SelectionMode="Single"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Margin="0,0,0,8">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExpressionFunctionFilter">
                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                               Foreground="{DynamicResource AppText}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBox Grid.Row="2" Classes="Filter"
                                 PlaceholderText="{Binding FunctionsFilterHint}"
                                 Text="{Binding FunctionFilter}" />
                        <ScrollViewer Grid.Row="3" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Classes="Muted" Margin="2,0,0,8" TextWrapping="Wrap"
                                           IsVisible="{Binding HasNoFunctionMatch}"
                                           Text="{Binding [ExprBuilder.NoFunctionFound], Source={x:Static loc:Strings.Current}}" />
                                <ItemsControl ItemsSource="{Binding Functions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExpressionFunctionChoice">
                                            <Button Classes="ExprOption FnCard"
                                                    BorderBrush="{Binding Group, Converter={StaticResource FnGroup}, ConverterParameter=line}"
                                                    Click="OnInsertFunction">
                                                <TextBlock Text="{Binding Heading}"
                                                           Foreground="{DynamicResource AppTextStrong}" />
                                                <!-- What a card cannot say: how the call is written in
                                                     the reader's own language, how many places it asks
                                                     for, one line saying what it does, and one line
                                                     for each argument it takes. -->
                                                <ToolTip.Tip>
                                                    <StackPanel MaxWidth="360" Spacing="4">
                                                        <TextBlock Text="{Binding Heading}" FontSize="12.5"
                                                                   Foreground="{DynamicResource AppText}" />
                                                        <TextBlock Text="{Binding WrittenAs}" FontSize="12"
                                                                   Foreground="{DynamicResource AppInfo}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding ArityNote}" FontSize="11.5"
                                                                   Foreground="{DynamicResource AppInfo}" />
                                                        <TextBlock Text="{Binding Hint}" FontSize="12"
                                                                   Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" />
                                                        <ItemsControl ItemsSource="{Binding Arguments}"
                                                                      Margin="0,2,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:FunctionArgument">
                                                                    <Grid ColumnDefinitions="Auto,*"
                                                                          ColumnSpacing="6" Margin="0,3,0,0">
                                                                        <TextBlock Text="{Binding Label}"
                                                                                   FontSize="11.5"
                                                                                   Foreground="{DynamicResource AppLabel}" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Hint}"
                                                                                   FontSize="11.5"
                                                                                   Foreground="{DynamicResource AppMuted}"
                                                                                   TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </ToolTip.Tip>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="16,10,16,14">
            <Button Grid.Column="1" Classes="Secondary" Height="36" MinWidth="92"
                    Content="{Binding [Add.Cancel], Source={x:Static loc:Strings.Current}}"
                    Command="{Binding CancelCommand}" />
            <Button Grid.Column="2" Classes="PrimaryButton" Height="36" MinWidth="110"
                    Margin="8,0,0,0"
                    IsEnabled="{Binding CanConfirm}"
                    Content="{Binding [Common.Ok], Source={x:Static loc:Strings.Current}}"
                    Command="{Binding ConfirmCommand}" />
        </Grid>
    </Grid>
</Window>
