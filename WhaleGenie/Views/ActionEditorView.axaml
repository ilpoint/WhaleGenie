<!-- What this opens at is up to the desktop that holds it, and so is whether it stands beside the
     macro editor or over it: see DialogSize. MinWidth is the narrowest that leaves those fields
     readable, which is narrower than the size it opens at on a desktop with less room than it
     would like — standing beside the editor is worth the tighter columns. -->
<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:conv="using:WhaleGenie.Converters"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="800"
        x:Class="WhaleGenie.Views.ActionEditorView"
        x:DataType="vm:AddActionViewModel"
        Background="Transparent">

    <Design.DataContext>
        <vm:AddActionViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <!-- Paints the swatch beside a colour parameter. -->
        <conv:HexColorToBrushConverter x:Key="HexBrush" />

        <!-- One length of time in the step settings: the number plus the unit it is written in. -->
        <DataTemplate x:Key="DurationSetting" x:DataType="vm:DurationSettingViewModel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <views:NumberBox Value="{Binding Value}"
                               Minimum="{Binding Minimum}"
                               Maximum="{Binding Maximum}"
                               Increment="1" FormatString="0.###"
                               HorizontalAlignment="Stretch" />
                <ComboBox Grid.Column="1" Classes="Field"
                          ItemsSource="{Binding Units}"
                          SelectedItem="{Binding Unit}"
                          Width="118" HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:DurationUnit">
                            <TextBlock Text="{Binding Label}"
                                       FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </DataTemplate>

        <!-- One number of a place to look: dialled in with the spinner, or written as an
             expression the engine works out while the macro runs. It stands in a grid of two
             columns, so the four numbers of a rectangle read as two pairs rather than a column. -->
        <DataTemplate x:Key="NumberCell" x:DataType="vm:NumberCellViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <TextBlock Classes="Hint" VerticalAlignment="Center"
                           Text="{Binding Label}"
                           ToolTip.Tip="{Binding Hint}" />

                <views:NumberBox Grid.Column="1" FormatString="0"
                               IsVisible="{Binding IsPlain}"
                               HorizontalAlignment="Stretch"
                               Value="{Binding Number}" />

                <AutoCompleteBox Grid.Column="1" Classes="Field"
                                 IsVisible="{Binding IsFormula}"
                                 ItemsSource="{Binding Suggestions}"
                                 Text="{Binding Text}"
                                 PlaceholderText="{Binding Placeholder}"
                                 MinimumPrefixLength="1"
                                 FilterMode="Contains" />

                <Button Grid.Column="2" Classes="Secondary" Height="33" Padding="11,0"
                        Tag="{Binding}"
                        Content="{Binding [Add.ExpressionBuilder], Source={x:Static loc:Strings.Current}}"
                        ToolTip.Tip="{Binding [Add.ExpressionBuilderHint], Source={x:Static loc:Strings.Current}}"
                        Click="OnOpenCellExpression" />
            </Grid>
        </DataTemplate>

        <!-- One parameter's editor, shared by every line of the parameter list. -->
        <DataTemplate x:Key="ParameterEditor" x:DataType="vm:StepParameterViewModel">
            <StackPanel>
                <!-- What is written in this box is read as one value, so an expression may be
                     written in it. The box looks the same either way, which is why the mark is
                     there rather than left to the hint under it. -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="FormulaMark" Text="ƒ"
                               IsVisible="{Binding TakesFormula}"
                               ToolTip.Tip="{Binding [Add.FieldTakesFormula], Source={x:Static loc:Strings.Current}}" />
                    <TextBlock Classes="FieldLabel" Text="{Binding Label}" />
                </StackPanel>

                <Grid IsVisible="{Binding IsPlainText}" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Classes="Field" Text="{Binding Text}"
                             PlaceholderText="{Binding Placeholder}" />
                    <!-- A path is the one value the machine can offer a list of. -->
                    <Button Grid.Column="1" Classes="Secondary" Height="33" Padding="11,0"
                            IsVisible="{Binding IsPath}"
                            Content="{Binding PathButton}"
                            ToolTip.Tip="{Binding [Add.BrowsePathHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnBrowsePath" />
                </Grid>

                <!-- A key is chosen as a character button: the field itself opens the keyboard
                     laid out on screen, while capture takes the key pressed on the physical
                     keyboard instead of hunting for it on the drawing. -->
                <Grid IsVisible="{Binding IsKey}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <Button Classes="Field"
                            Content="{Binding KeyFieldDisplay}"
                            ToolTip.Tip="{Binding [Add.OpenKeyPadHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnOpenKeyPad" />
                    <Button Grid.Column="1" Classes="Secondary" Height="34" Padding="9,0"
                            Content="{Binding KeyCaptureLabel}"
                            ToolTip.Tip="{Binding [Add.CaptureKeyHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnCaptureKey" />
                    <!-- The same question the element picker answers with its test: is this the
                         thing I meant? For a key that is answered by pressing it once. -->
                    <Button Grid.Column="2" Classes="Secondary" Height="34" Padding="11,0"
                            Content="{Binding [Add.TestField], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.TestKeyHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnTestStep" />
                </Grid>

                <!-- A combination is built the same way the keyboard drawn on screen builds it:
                     one key at a time, so the keys pressed are joined to what is already there. -->
                <Grid IsVisible="{Binding IsKeys}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <Button Classes="Field"
                            Content="{Binding KeyFieldDisplay}"
                            ToolTip.Tip="{Binding [Add.OpenKeyPadHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnOpenKeyPad" />
                    <Button Grid.Column="1" Classes="Secondary" Height="34" Padding="9,0"
                            Content="{Binding KeyCaptureLabel}"
                            ToolTip.Tip="{Binding [Add.CaptureComboHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnCaptureKey" />
                    <Button Grid.Column="2" Classes="Secondary" Height="34" Padding="11,0"
                            Content="{Binding [Add.TestField], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.TestKeyHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnTestStep" />
                </Grid>

                <!-- A window is one field even though it remembers several things. The button
                     captures the window in front after F1 and edits the matching rule there. -->
                <Border IsVisible="{Binding IsWindowRule}" Background="{DynamicResource SurfaceField}"
                        BorderBrush="{DynamicResource BorderControl}" BorderThickness="1"
                        CornerRadius="5" Padding="10,8">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding WindowRuleSummary}" FontSize="12.5"
                                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                            <TextBlock Classes="Hint" TextWrapping="Wrap"
                                       Text="{Binding [WindowRule.FieldHint], Source={x:Static loc:Strings.Current}}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="Secondary" Height="33" Padding="11,0"
                                Content="{Binding [Add.PickWindow], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [Add.PickWindowHint], Source={x:Static loc:Strings.Current}}"
                                Click="OnPickWindowRule" />
                        <Button Grid.Column="2" Classes="Secondary" Height="33" Padding="11,0"
                                Content="{Binding [Add.VariablePicker], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [Add.VariablePickerHint], Source={x:Static loc:Strings.Current}}"
                                Click="OnPickWindowVariable" />
                        <Button Grid.Column="3" Classes="Secondary" Height="33" Padding="10,0"
                                Content="{Binding [WindowRule.Clear], Source={x:Static loc:Strings.Current}}"
                                Click="OnClearWindowRule" />
                    </Grid>
                </Border>

                <!-- A value that may name variables: the names are offered while it is typed in,
                     and a whole value may be built with the expression editor. A window is written
                     here like anything else, with the picker beside it that fills in one of the
                     windows that are open right now. -->
                <Grid IsVisible="{Binding OffersVariables}" ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                      ColumnSpacing="6">
                    <AutoCompleteBox Classes="Field"
                                     ItemsSource="{Binding ExpressionSuggestions}"
                                     Text="{Binding Text}"
                                     PlaceholderText="{Binding Placeholder}"
                                     MinimumPrefixLength="1"
                                     FilterMode="Contains" />
                    <Button Grid.Column="1" Classes="Secondary" Height="33" Padding="11,0"
                            IsVisible="{Binding IsPath}"
                            Content="{Binding PathButton}"
                            ToolTip.Tip="{Binding [Add.BrowsePathHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnBrowsePath" />
                    <Button Grid.Column="2" Classes="Secondary" Height="33" Padding="11,0"
                            IsVisible="{Binding IsWindow}"
                            Content="{Binding [Add.PickWindow], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.PickWindowHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnPickWindow" />
                    <Button Grid.Column="3" Classes="Secondary" Height="33" Padding="11,0"
                            IsVisible="{Binding OffersFormula}"
                            Content="{Binding [Add.ExpressionBuilder], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.ExpressionBuilderHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnOpenExpressionBuilder" />
                    <Button Grid.Column="4" Classes="Secondary" Height="33" Padding="11,0"
                            Content="{Binding [Add.VariablePicker], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.VariablePickerHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnPickVariable" />
                </Grid>

                <!-- A UI Automation selector: written out by hand, or taken off the screen by
                     pointing at the control. -->
                <Grid IsVisible="{Binding IsSelector}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <TextBox Classes="Field" Text="{Binding Text}"
                             PlaceholderText="{Binding Placeholder}" />
                    <Button Grid.Column="1" Classes="Secondary" Height="33" Padding="11,0"
                            Content="{Binding [Add.PickElement], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.PickElementHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnPickElement" />
                    <Button Grid.Column="2" Classes="Secondary" Height="33" Padding="11,0"
                            Content="{Binding [Add.TestElement], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.TestElementHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnTestElement" />
                </Grid>

                <!-- An element of a page: written out by hand, or taken off the page by pointing
                     at it in the browser. The box is several lines tall because a page that has
                     been redesigned is met by writing a second way of naming the element under the
                     first, and the other ways a pick found are offered under the box to add. -->
                <StackPanel IsVisible="{Binding IsBrowserTarget}" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBox Classes="Field" Text="{Binding Text}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                                 PlaceholderText="{Binding Placeholder}" />
                        <Button Grid.Column="1" Classes="Secondary" Height="33" Padding="11,0"
                                VerticalAlignment="Top"
                                Content="{Binding [Add.PickBrowserElement], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [Add.PickBrowserElementHint], Source={x:Static loc:Strings.Current}}"
                                Click="OnPickBrowserElement" />
                        <Button Grid.Column="2" Classes="Secondary" Height="33" Padding="11,0"
                                VerticalAlignment="Top"
                                Content="{Binding [Add.TestElement], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [Add.TestElementHint], Source={x:Static loc:Strings.Current}}"
                                Click="OnTestBrowserElement" />
                        <Button Grid.Column="3" Classes="Secondary" Height="33" Padding="11,0"
                                VerticalAlignment="Top"
                                IsVisible="{Binding OffersPageVariables}"
                                Content="{Binding [Add.VariablePicker], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [Add.VariablePickerHint], Source={x:Static loc:Strings.Current}}"
                                Click="OnPickBrowserVariable" />
                    </Grid>

                    <StackPanel IsVisible="{Binding HasCandidates}" Spacing="5">
                        <TextBlock Classes="Hint" TextWrapping="Wrap"
                                   Text="{Binding [Add.BrowserWayMore], Source={x:Static loc:Strings.Current}}" />
                        <ItemsControl ItemsSource="{Binding Candidates}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BrowserWayViewModel">
                                    <Button Classes="Secondary" Height="30" Padding="10,0"
                                            Margin="0,0,6,6" Content="{Binding Text}"
                                            ToolTip.Tip="{Binding [Add.BrowserWayAdd], Source={x:Static loc:Strings.Current}}"
                                            Click="OnAddBrowserWay" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- A stretch of text that is handed over whole — what gets typed, written or put on
                     the clipboard — may be built with the expression editor like any other value:
                     what it makes there is what the step hands over. A box holding a script is
                     taller than one holding a sentence, because a program of a dozen lines is not
                     read through a window four lines high. -->
                <Grid IsVisible="{Binding IsMultiline}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <TextBox Classes="Field" Text="{Binding Text}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Height="{Binding MultilineHeight}"
                             PlaceholderText="{Binding Placeholder}" />
                    <Button Grid.Column="1" Classes="Secondary" Height="33" Padding="11,0"
                            VerticalAlignment="Top"
                            IsVisible="{Binding IsPath}"
                            Content="{Binding PathButton}"
                            ToolTip.Tip="{Binding [Add.BrowsePathHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnBrowsePath" />
                    <Button Grid.Column="2" Classes="Secondary" Height="33" Padding="11,0"
                            VerticalAlignment="Top"
                            IsVisible="{Binding OffersFormula}"
                            Content="{Binding [Add.ExpressionBuilder], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.ExpressionBuilderHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnOpenExpressionBuilder" />
                </Grid>

                <!-- A number is dialled in with the spinner or written as an expression. -->
                <Grid IsVisible="{Binding IsNumber}" ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                      ColumnSpacing="6">
                    <views:NumberBox IsVisible="{Binding IsNumberValue}"
                                   Value="{Binding NumberValue}"
                                   Minimum="{Binding Minimum}"
                                   Maximum="{Binding Maximum}"
                                   Increment="{Binding Increment}"
                                   FormatString="0.###"
                                   HorizontalAlignment="Stretch" />

                    <AutoCompleteBox Grid.Column="0" Classes="Field"
                                     IsVisible="{Binding IsNumberFormula}"
                                     ItemsSource="{Binding ExpressionSuggestions}"
                                     Text="{Binding Text}"
                                     PlaceholderText="{Binding FormulaPlaceholder}"
                                     MinimumPrefixLength="1"
                                     FilterMode="Contains" />

                    <!-- A length of time also says which unit the number is written in. -->
                    <ComboBox Grid.Column="1" Classes="Field"
                              ItemsSource="{Binding DurationUnits}"
                              SelectedItem="{Binding Unit}"
                              IsVisible="{Binding IsDurationEditor}"
                              Width="118" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:DurationUnit">
                                <TextBlock Text="{Binding Label}"
                                           FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- A length of time can be given some give, so a wait is never the same
                         number twice. It lives beside the box rather than behind the fold: it is
                         part of how long the step waits, not a tuning knob. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"
                                IsVisible="{Binding IsDuration}"
                                ToolTip.Tip="{Binding [Add.JitterHint], Source={x:Static loc:Strings.Current}}">
                        <TextBlock Classes="Caption" VerticalAlignment="Center"
                                   Text="{Binding [Add.JitterSign], Source={x:Static loc:Strings.Current}}" />
                        <views:NumberBox Name="JitterBox" Width="76" Increment="5" FormatString="0.##"
                                       Minimum="0" Maximum="100" VerticalAlignment="Center"
                                       Value="{Binding JitterPercent}" />
                        <TextBlock Classes="Caption" VerticalAlignment="Center"
                                   Text="{Binding [Add.JitterUnit], Source={x:Static loc:Strings.Current}}" />
                    </StackPanel>

                    <!-- A number can always be written as an expression instead, so the box that
                         builds one is there from the start rather than behind a switch: what the
                         builder hands back is what the field holds, and a plain number written that
                         way puts the spinner back. -->
                    <Button Grid.Column="3" Classes="Secondary" Height="33" Padding="11,0"
                            Content="{Binding [Add.ExpressionBuilder], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.ExpressionBuilderHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnOpenExpressionBuilder" />
                </Grid>

                <TextBlock Classes="Hint" Margin="2,5,0,0" TextWrapping="Wrap"
                           IsVisible="{Binding HasJitterRange}"
                           Text="{Binding JitterRange}" />

                <StackPanel IsVisible="{Binding IsNumberFormula}">
                    <TextBlock Classes="Hint" Margin="2,5,0,0" TextWrapping="Wrap"
                               Text="{Binding FormulaNote}"
                               IsVisible="{Binding IsNumberFormula}" />
                    <TextBlock Classes="Hint" Margin="2,5,0,0" TextWrapping="Wrap"
                               Text="{Binding [Add.FormulaMilliseconds], Source={x:Static loc:Strings.Current}}"
                               IsVisible="{Binding IsDurationFormula}" />
                    <TextBlock Classes="Hint" Margin="2,5,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Danger}"
                               Text="{Binding ExpressionMessage}"
                               IsVisible="{Binding ShowExpressionError}" />
                    <TextBlock Classes="Hint" Margin="2,5,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Success}"
                               Text="{Binding ExpressionMessage}"
                               IsVisible="{Binding ShowExpressionSuccess}" />
                </StackPanel>

                <!-- Colour parameters open the screen magnifier, and may be a variable holding one. -->
                <Grid IsVisible="{Binding IsColor}"
                      ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                    <TextBox Classes="Field" Text="{Binding Text}"
                             PlaceholderText="{Binding Placeholder}" />
                    <Border Grid.Column="1" Width="33" Height="33" CornerRadius="5"
                            Background="{Binding Text, Converter={StaticResource HexBrush}}"
                            BorderBrush="{DynamicResource BorderControl}" BorderThickness="1" />
                    <Button Grid.Column="2" Classes="Secondary" Name="PickColourButton"
                            Width="38" Height="33" Padding="0"
                            ToolTip.Tip="{Binding [Editor.PickColor], Source={x:Static loc:Strings.Current}}"
                            Click="OnPickParameterColor">
                        <views:IconView Width="17" Height="17" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.5" FitToBounds="True" Data="{x:Static vm:AppIcons.Dropper}" />
                    </Button>
                    <Button Grid.Column="3" Classes="Secondary" Height="33" Padding="11,0"
                            IsVisible="{Binding OffersFormula}"
                            Content="{Binding [Add.ExpressionBuilder], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.ExpressionBuilderHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnOpenExpressionBuilder" />
                </Grid>

                <!-- A picture the action looks for: taken from a file, or straight off the
                     screen, and shown underneath so it is clear which one is meant. -->
                <StackPanel IsVisible="{Binding IsImage}">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                        <!-- A picture is a file or the picture an earlier Capture saved under a
                             name, so the names are offered over the box the same way they are over
                             any other box that takes one. -->
                        <AutoCompleteBox Classes="Field"
                                         ItemsSource="{Binding NameChoices}"
                                         Text="{Binding Text}"
                                         PlaceholderText="{Binding Placeholder}"
                                         MinimumPrefixLength="{Binding NamePrefix}"
                                         FilterMode="Contains" />
                        <Button Grid.Column="1" Classes="Secondary" Height="33" Padding="11,0"
                                Content="{Binding [Add.BrowseImage], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [Add.BrowseImageHint], Source={x:Static loc:Strings.Current}}"
                                Click="OnBrowseImage" />
                        <Button Grid.Column="2" Classes="Secondary" Height="33" Padding="11,0"
                                Content="{Binding [Add.CaptureImage], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [Add.CaptureImageHint], Source={x:Static loc:Strings.Current}}"
                                Click="OnCaptureImage" />
                        <Button Grid.Column="3" Classes="Secondary" Height="33" Padding="11,0"
                                Content="{Binding [Add.ClearImage], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [Add.ClearImageHint], Source={x:Static loc:Strings.Current}}"
                                Click="OnClearImage" />
                    </Grid>

                    <Border IsVisible="{Binding HasThumbnail}" Margin="0,8,0,0"
                            Background="{DynamicResource SurfaceWindow}" BorderBrush="{DynamicResource BorderControl}" BorderThickness="1"
                            CornerRadius="5" Padding="4" HorizontalAlignment="Left">
                        <Image Source="{Binding Thumbnail}" MaxWidth="240" MaxHeight="110"
                               Stretch="Uniform" />
                    </Border>
                </StackPanel>

                <!-- The pictures a search looks for: one row each, tried in the order they are
                     listed. A thing that is drawn differently from one screen to the next is
                     several pictures rather than several branches. -->
                <StackPanel IsVisible="{Binding IsImageList}" Spacing="7">
                    <ItemsControl ItemsSource="{Binding Pictures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImageRowViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6"
                                      Margin="0,0,0,4">
                                    <Border Grid.Column="0" Width="54" Height="34"
                                            Background="{DynamicResource SurfaceWindow}" BorderBrush="{DynamicResource BorderControl}"
                                            BorderThickness="1" CornerRadius="4" Padding="2">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                    </Border>
                                    <AutoCompleteBox Grid.Column="1" Classes="Field"
                                                     ItemsSource="{Binding Suggestions}"
                                                     Text="{Binding Text}"
                                                     PlaceholderText="{Binding Placeholder}"
                                                     MinimumPrefixLength="1"
                                                     FilterMode="Contains" />
                                    <Button Grid.Column="2" Classes="Secondary" Height="33"
                                            Padding="11,0"
                                            Content="{Binding [Add.BrowseImage], Source={x:Static loc:Strings.Current}}"
                                            ToolTip.Tip="{Binding [Add.BrowseImageHint], Source={x:Static loc:Strings.Current}}"
                                            Click="OnBrowseImageRow" />
                                    <Button Grid.Column="3" Classes="Secondary" Height="33"
                                            Padding="11,0"
                                            Content="{Binding [Add.CaptureImage], Source={x:Static loc:Strings.Current}}"
                                            ToolTip.Tip="{Binding [Add.CaptureImageHint], Source={x:Static loc:Strings.Current}}"
                                            Click="OnCaptureImageRow" />
                                    <Button Grid.Column="4" Classes="Secondary" Height="33"
                                            Padding="9,0"
                                            Content="{Binding [Add.ImageMoveUp], Source={x:Static loc:Strings.Current}}"
                                            ToolTip.Tip="{Binding [Add.ImageMoveUpHint], Source={x:Static loc:Strings.Current}}"
                                            Command="{Binding MoveUpCommand}" />
                                    <Button Grid.Column="5" Classes="Secondary" Height="33"
                                            Padding="9,0"
                                            Content="{Binding [Add.ImageMoveDown], Source={x:Static loc:Strings.Current}}"
                                            ToolTip.Tip="{Binding [Add.ImageMoveDownHint], Source={x:Static loc:Strings.Current}}"
                                            Command="{Binding MoveDownCommand}" />
                                    <Button Grid.Column="6" Classes="Secondary" Height="33"
                                            Padding="11,0"
                                            Content="{Binding [Add.ImageRemove], Source={x:Static loc:Strings.Current}}"
                                            ToolTip.Tip="{Binding [Add.ImageRemoveHint], Source={x:Static loc:Strings.Current}}"
                                            Command="{Binding RemoveCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Button Classes="Secondary" Height="30" Padding="10,0"
                                Content="{Binding [Add.ImageAdd], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [Add.ImageAddHint], Source={x:Static loc:Strings.Current}}"
                                Click="OnAddImageRow" />
                        <TextBlock Grid.Column="1" Classes="Hint" VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="{Binding [Add.ImageEmpty], Source={x:Static loc:Strings.Current}}"
                                   IsVisible="{Binding !HasPictures}" />
                    </Grid>
                </StackPanel>

                <!-- Whether the step recognises the right window is otherwise only visible by
                     running the macro, so the windows this rule picks out right now are listed
                     under the fields that make up the rule. -->
                <StackPanel IsVisible="{Binding ShowsWindowPreview}" Margin="0,8,0,0" Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Classes="Hint" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding WindowPreview.Summary}" />
                        <Button Grid.Column="1" Classes="Secondary" Height="28" Padding="10,0"
                                Content="{Binding [WindowPicker.Refresh], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [WindowPicker.RefreshHint], Source={x:Static loc:Strings.Current}}"
                                Command="{Binding WindowPreview.RefreshCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding WindowPreview.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WindowPreviewRow">
                                <StackPanel Margin="2,0,0,0">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Title}" />
                                    <StackPanel Orientation="Horizontal" Spacing="5"
                                                IsVisible="{Binding HasPart}">
                                        <TextBlock Classes="Note" FontSize="11"
                                                   Text="{Binding PartLabel}" />
                                        <TextBlock Classes="Note" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Part}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="Hint" TextWrapping="Wrap" Text="{Binding WindowPreview.More}"
                               IsVisible="{Binding WindowPreview.HasMore}" />
                    <TextBlock Classes="Hint" TextWrapping="Wrap" Text="{Binding WindowPreview.Note}"
                               IsVisible="{Binding WindowPreview.HasNote}" />
                </StackPanel>

                <!-- Where a step looks: one row per rectangle, so looking at two halves of a
                     screen reads as two things. A row says its rectangle as four numbers — each of
                     them an ordinary number field, which may be written as an expression — or names
                     one variable that says where to look. -->
                <StackPanel IsVisible="{Binding IsRegion}" Spacing="9">
                    <ItemsControl ItemsSource="{Binding Regions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RegionRowViewModel">
                                <StackPanel Margin="0,0,0,9" Spacing="5">
                                    <!-- The four numbers of the rectangle, two to a line: X and Y
                                         say where the corner is and width and height say how far it
                                         reaches, so each pair reads as one thing. -->
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                                          ColumnSpacing="14" RowSpacing="6">
                                        <ContentControl Grid.Row="0" Grid.Column="0"
                                                        Content="{Binding X}"
                                                        ContentTemplate="{StaticResource NumberCell}" />
                                        <ContentControl Grid.Row="0" Grid.Column="1"
                                                        Content="{Binding Y}"
                                                        ContentTemplate="{StaticResource NumberCell}" />
                                        <ContentControl Grid.Row="1" Grid.Column="0"
                                                        Content="{Binding Width}"
                                                        ContentTemplate="{StaticResource NumberCell}" />
                                        <ContentControl Grid.Row="1" Grid.Column="1"
                                                        Content="{Binding Height}"
                                                        ContentTemplate="{StaticResource NumberCell}" />
                                    </Grid>

                                    <TextBlock Classes="Hint" Margin="2,0,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Danger}"
                                               Text="{Binding CellMessage}"
                                               IsVisible="{Binding ShowCellError}" />
                                    <TextBlock Classes="Hint" Margin="2,0,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Success}"
                                               Text="{Binding CellMessage}"
                                               IsVisible="{Binding ShowCellResult}" />

                                    <!-- One variable instead of the four numbers: what says where to
                                         look may be a picture taken earlier, or a rectangle some
                                         earlier step worked out. -->
                                    <WrapPanel>
                                        <TextBlock Classes="Note" VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   Text="{Binding [Add.RegionOrVariable], Source={x:Static loc:Strings.Current}}"
                                                   ToolTip.Tip="{Binding VariableHint}" />
                                        <TextBox Width="190" Classes="Field" Margin="0,0,6,0"
                                                 Text="{Binding OrVariable}"
                                                 PlaceholderText="{Binding VariablePlaceholder}"
                                                 ToolTip.Tip="{Binding VariableHint}" />
                                        <Button Classes="Secondary" Height="33" Padding="11,0"
                                                Margin="0,0,6,0"
                                                Content="{Binding [Add.VariablePicker], Source={x:Static loc:Strings.Current}}"
                                                ToolTip.Tip="{Binding [Add.VariablePickerHint], Source={x:Static loc:Strings.Current}}"
                                                Click="OnPickRegionVariable" />
                                        <Button Classes="Secondary" Height="33" Padding="11,0"
                                                Margin="0,0,6,0"
                                                Content="{Binding [Add.PickRegion], Source={x:Static loc:Strings.Current}}"
                                                ToolTip.Tip="{Binding [Add.PickRegionHint], Source={x:Static loc:Strings.Current}}"
                                                Click="OnPickRegionRow" />
                                        <Button Classes="Secondary" Height="26" Padding="9,0"
                                                Content="{Binding [Add.RegionRemove], Source={x:Static loc:Strings.Current}}"
                                                ToolTip.Tip="{Binding [Add.RegionRemoveHint], Source={x:Static loc:Strings.Current}}"
                                                Command="{Binding RemoveCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Button Classes="Secondary" Height="30" Padding="10,0"
                                Content="{Binding [Add.RegionAdd], Source={x:Static loc:Strings.Current}}"
                                Click="OnAddRegionRow" />
                        <TextBlock Grid.Column="1" Classes="Hint" VerticalAlignment="Center"
                                   Text="{Binding [Add.RegionEmpty], Source={x:Static loc:Strings.Current}}"
                                   IsVisible="{Binding !HasRegions}" />
                    </Grid>

                    <!-- Where the four numbers of every row are counted from, said once for the
                         whole list: the same numbers mean somewhere else depending on it. -->
                    <TextBlock Classes="Hint" Margin="2,4,0,0" TextWrapping="Wrap"
                               IsVisible="{Binding HasBasisNote}" Text="{Binding BasisNote}" />
                </StackPanel>

                <!-- A run of key combinations: one row per press, in the order they are sent. A
                     combo is a sequence of presses whose beat is part of what it is, so the run is
                     a list rather than one long line of keys. -->
                <StackPanel IsVisible="{Binding IsKeySequence}" Spacing="7">
                    <ItemsControl ItemsSource="{Binding KeyRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:KeyRowViewModel">
                                <!-- The combination takes the whole first line; its beat and the
                                     button that takes it out sit under it, so a long chord never
                                     pushes the numbers off the side. -->
                                <StackPanel Margin="0,0,0,8" Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Button Classes="Field"
                                                Content="{Binding KeysDisplay}"
                                                ToolTip.Tip="{Binding [Add.KeyRunKeyHint], Source={x:Static loc:Strings.Current}}"
                                                Click="OnPickKeyRow" />
                                        <Button Grid.Column="1" Classes="Secondary"
                                                Height="34" Padding="9,0"
                                                Content="{Binding CaptureLabel}"
                                                ToolTip.Tip="{Binding [Add.CaptureKeyRunHint], Source={x:Static loc:Strings.Current}}"
                                                Click="OnCaptureKeyRow" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="Hint" VerticalAlignment="Center"
                                                   Text="{Binding [Add.KeyRunHold], Source={x:Static loc:Strings.Current}}" />
                                        <views:NumberBox Width="84" FormatString="0" PlaceholderText="50"
                                                       Value="{Binding HoldMs}"
                                                       ToolTip.Tip="{Binding [Add.KeyRunHoldHint], Source={x:Static loc:Strings.Current}}" />
                                        <TextBlock Classes="Caption" Margin="0,0,8,0" VerticalAlignment="Center"
                                                   Text="{Binding [Add.KeyRunMilliseconds], Source={x:Static loc:Strings.Current}}" />
                                        <TextBlock Classes="Caption" VerticalAlignment="Center"
                                                   Text="{Binding [Add.KeyRunGap], Source={x:Static loc:Strings.Current}}" />
                                        <views:NumberBox Width="84" FormatString="0" PlaceholderText="120"
                                                       Value="{Binding GapMs}"
                                                       ToolTip.Tip="{Binding [Add.KeyRunGapHint], Source={x:Static loc:Strings.Current}}" />
                                        <TextBlock Classes="Caption" Margin="0,0,8,0" VerticalAlignment="Center"
                                                   Text="{Binding [Add.KeyRunMilliseconds], Source={x:Static loc:Strings.Current}}" />
                                        <Button Classes="Secondary"
                                                Height="26" Padding="9,0" VerticalAlignment="Center"
                                                Content="{Binding [Add.KeyRunRemove], Source={x:Static loc:Strings.Current}}"
                                                ToolTip.Tip="{Binding [Add.KeyRunRemoveHint], Source={x:Static loc:Strings.Current}}"
                                                Command="{Binding RemoveCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Button Classes="Secondary" Height="30" Padding="10,0"
                                Content="{Binding [Add.KeyRunAdd], Source={x:Static loc:Strings.Current}}"
                                Click="OnAddKeyRow" />
                        <TextBlock Grid.Column="1" Classes="Hint" VerticalAlignment="Center"
                                   Text="{Binding [Add.KeyRunEmpty], Source={x:Static loc:Strings.Current}}"
                                   IsVisible="{Binding !HasKeyRows}" />
                    </Grid>
                </StackPanel>

                <!-- What a page step says the element it means has to be like, one row each, all of
                     them holding at once. It is what tells one of several elements that a selector
                     names from the others: a page that shows the same button twice is told apart by
                     what the one that is meant says, which is not something a person can read off
                     the page and count. -->
                <StackPanel IsVisible="{Binding IsNarrow}" Spacing="7">
                    <ItemsControl ItemsSource="{Binding NarrowRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NarrowRowViewModel">
                                <StackPanel Margin="0,0,0,8" Spacing="5">
                                    <!-- The way of narrowing, then what to look for by it: reading
                                         them together is the sentence the row says. Each row can be
                                         looked at on the page on its own, which is how a person
                                         sees whether adding it helped. -->
                                    <Grid ColumnDefinitions="210,*,Auto,Auto,Auto" ColumnSpacing="6">
                                        <ComboBox Classes="Field"
                                                  ItemsSource="{Binding Choices}"
                                                  SelectedItem="{Binding Way}"
                                                  Width="210" HorizontalAlignment="Left">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:ActionParameterOption">
                                                    <TextBlock Text="{Binding Display}"
                                                               FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox Grid.Column="1" Classes="Field"
                                                 IsVisible="{Binding NeedsValue}"
                                                 Text="{Binding Value}"
                                                 PlaceholderText="{Binding ValueHint}" />
                                        <Button Grid.Column="2" Classes="Secondary" Height="33"
                                                Padding="11,0" IsVisible="{Binding NeedsValue}"
                                                Content="{Binding [Add.NarrowPick], Source={x:Static loc:Strings.Current}}"
                                                ToolTip.Tip="{Binding [Add.NarrowPickHint], Source={x:Static loc:Strings.Current}}"
                                                Click="OnPickNarrowValue" />
                                        <Button Grid.Column="3" Classes="Secondary" Height="33"
                                                Padding="11,0"
                                                Content="{Binding [Add.NarrowLook], Source={x:Static loc:Strings.Current}}"
                                                ToolTip.Tip="{Binding [Add.NarrowLookHint], Source={x:Static loc:Strings.Current}}"
                                                Click="OnLookNarrowRow" />
                                        <Button Grid.Column="4" Classes="Secondary" Height="33"
                                                Padding="11,0"
                                                Content="{Binding [Add.NarrowRemove], Source={x:Static loc:Strings.Current}}"
                                                ToolTip.Tip="{Binding [Add.NarrowRemoveHint], Source={x:Static loc:Strings.Current}}"
                                                Command="{Binding RemoveCommand}" />
                                    </Grid>
                                    <TextBlock Classes="Note" Margin="2,0,0,0" TextWrapping="Wrap"
                                               Text="{Binding Count}"
                                               IsVisible="{Binding HasCount}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Button Classes="Secondary" Height="30" Padding="10,0"
                                Content="{Binding [Add.NarrowAdd], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [Add.NarrowAddHint], Source={x:Static loc:Strings.Current}}"
                                Click="OnAddNarrowRow" />
                        <TextBlock Grid.Column="1" Classes="Hint" VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="{Binding [Add.NarrowEmpty], Source={x:Static loc:Strings.Current}}"
                                   IsVisible="{Binding !HasNarrowRows}" />
                    </Grid>
                </StackPanel>

                <ToggleSwitch IsVisible="{Binding IsBool}"
                              IsChecked="{Binding Flag}"
                              OnContent="" OffContent="" />

                <Grid IsVisible="{Binding IsChoice}" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6"
                      HorizontalAlignment="Left">
                    <ComboBox Classes="Field"
                              ItemsSource="{Binding Choices}"
                              SelectedItem="{Binding Option}"
                              IsEnabled="{Binding IsEnabled}"
                              Width="240" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ActionParameterOption">
                                <TextBlock Text="{Binding Display}"
                                           FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- A control of the virtual controller says which one it is on a pad drawn
                         on screen, where the button that is meant is in the place the hand
                         already knows it in. -->
                    <Button Grid.Column="1" Classes="Secondary" Height="33" Padding="11,0"
                            IsVisible="{Binding IsGamepadPad}"
                            Content="{Binding [Add.OpenGamepad], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.OpenGamepadHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnOpenGamepadPad" />
                    <Button Grid.Column="2" Classes="Secondary" Height="33" Padding="11,0"
                            IsVisible="{Binding IsGamepadPad}"
                            Content="{Binding [Add.TestField], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.TestGamepadHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnTestStep" />
                </Grid>

                <!-- A variable, which may also be a whole value of its own: an operand of a
                     calculation is written here, and may be built with the expression editor. -->
                <!-- A step of this macro, which is picked out of the steps that are in it: the name
                     is four characters that nobody should have to copy by eye, and the note and the
                     action beside it are how the user tells one step from another. -->
                <ComboBox Classes="Field" IsVisible="{Binding IsStepChoice}"
                          ItemsSource="{Binding Choices}"
                          SelectedItem="{Binding Option}"
                          Width="360" HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ActionParameterOption">
                            <TextBlock Text="{Binding Display}"
                                       FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Grid IsVisible="{Binding IsVariable}" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <AutoCompleteBox Classes="Field"
                                     ItemsSource="{Binding NameChoices}"
                                     Text="{Binding Text}"
                                     PlaceholderText="{Binding Placeholder}"
                                     MinimumPrefixLength="{Binding NamePrefix}"
                                     FilterMode="Contains" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Classes="Secondary" Height="33" Padding="11,0"
                                IsVisible="{Binding OffersFormula}"
                                Content="{Binding [Add.ExpressionBuilder], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [Add.ExpressionBuilderHint], Source={x:Static loc:Strings.Current}}"
                                Click="OnOpenExpressionBuilder" />
                        <Button Classes="Secondary" Height="33" Padding="11,0"
                                IsVisible="{Binding IsPath}"
                                Content="{Binding PathButton}"
                                ToolTip.Tip="{Binding [Add.BrowsePathHint], Source={x:Static loc:Strings.Current}}"
                                Click="OnBrowsePath" />
                        <Button Classes="Secondary" Height="33" Padding="11,0"
                                Content="{Binding [Add.VariablePicker], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [Add.VariablePickerHint], Source={x:Static loc:Strings.Current}}"
                                Click="OnPickVariable" />
                    </StackPanel>
                </Grid>

                <AutoCompleteBox Classes="Field" IsVisible="{Binding IsMacro}"
                                 ItemsSource="{Binding Macros}"
                                 Text="{Binding Text}"
                                 PlaceholderText="{Binding Placeholder}"
                                 MinimumPrefixLength="0"
                                 FilterMode="Contains" />

                <StackPanel IsVisible="{Binding IsExpression}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <AutoCompleteBox Classes="Field"
                                         ItemsSource="{Binding ExpressionSuggestions}"
                                         Text="{Binding Text}"
                                         PlaceholderText="{Binding Placeholder}"
                                         MinimumPrefixLength="1"
                                         FilterMode="Contains" />
                        <Button Grid.Column="1" Classes="Secondary" Height="33" Padding="11,0"
                                Content="{Binding [Add.ExpressionBuilder], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [Add.ExpressionBuilderHint], Source={x:Static loc:Strings.Current}}"
                                Click="OnOpenExpressionBuilder" />
                    </Grid>
                    <TextBlock Classes="Hint" Margin="2,5,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Danger}"
                               Text="{Binding ExpressionMessage}"
                               IsVisible="{Binding ShowExpressionError}" />
                    <TextBlock Classes="Hint" Margin="2,5,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Success}"
                               Text="{Binding ExpressionMessage}"
                               IsVisible="{Binding ShowExpressionSuccess}" />
                </StackPanel>

                <TextBlock Classes="Hint" Text="{Binding Hint}"
                           IsVisible="{Binding HasHint}"
                           TextWrapping="Wrap" Margin="2,5,0,0" />

            </StackPanel>
        </DataTemplate>

        <!-- One argument a call passes: the name the called macro declares, the value going into
             it, and the box that says the empty value is meant rather than left out. A name the
             macro no longer declares keeps its row and says so, because a save that deletes a value
             the author typed is a loss nobody notices until the macro behaves differently. -->
        <DataTemplate x:Key="CallArgumentRowEditor" x:DataType="vm:CallArgumentRowViewModel">
            <StackPanel Margin="0,0,0,14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding Given}"
                              Content="{Binding [Add.CallArgumentGiven], Source={x:Static loc:Strings.Current}}"
                              ToolTip.Tip="{Binding [Add.CallArgumentGivenHint], Source={x:Static loc:Strings.Current}}" />
                </Grid>
                <TextBox Classes="Field" Text="{Binding Value}" Margin="0,4,0,0"
                         IsEnabled="{Binding !Given}" />
                <TextBlock Classes="Hint" Text="{Binding Hint}" IsVisible="{Binding HasHint}"
                           TextWrapping="Wrap" Margin="0,3,0,0" />
                <TextBlock Classes="Hint" TextWrapping="Wrap" Foreground="#D8B36A"
                           Margin="0,3,0,0" IsVisible="{Binding IsUndeclared}"
                           Text="{Binding [Add.CallArgumentUndeclared], Source={x:Static loc:Strings.Current}}" />
            </StackPanel>
        </DataTemplate>

        <!-- One result a step may hand over: the box that says whether the macro keeps it, what it
             is, and the name it goes by. The name follows the step's note until it is typed in by
             hand, and a name something else already holds is said out loud rather than left to be
             discovered when two steps write into one variable. -->
        <DataTemplate x:Key="ReturnsRowEditor" x:DataType="vm:ReturnsRowViewModel">
            <StackPanel Margin="0,0,0,14">
                <CheckBox IsChecked="{Binding Ticked}" Content="{Binding Label}" />
                <TextBlock Classes="Hint" Text="{Binding Hint}" IsVisible="{Binding HasHint}"
                           TextWrapping="Wrap" Margin="26,3,0,0" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="26,6,0,0"
                      IsVisible="{Binding ShowsName}">
                    <TextBox Classes="Field" Text="{Binding Name}"
                             IsEnabled="{Binding Ticked}" />
                    <Button Grid.Column="1" Classes="Secondary" Height="30" Padding="9,0"
                            IsVisible="{Binding IsNameTaken}"
                            Content="{Binding [Add.NameMakeUnique], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.NameMakeUniqueHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnMakeReturnNameUnique" />
                </Grid>
                <TextBlock Classes="Hint" Text="{Binding NameWarning}" TextWrapping="Wrap"
                           Foreground="#D8B36A" Margin="26,4,0,0"
                           IsVisible="{Binding IsNameTaken}" />
            </StackPanel>
        </DataTemplate>

        <!-- One line of the parameter list. The two halves of a position share a line, and both
             the ordinary parameters and the folded-away ones are laid out with it. -->
        <DataTemplate x:Key="ParameterRowEditor" x:DataType="vm:ParameterRowViewModel">
            <!-- A line whose question the step's own settings do not ask is not drawn: a field
                 that is there and does nothing is worse than one that is not there. -->
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*,Auto"
                  IsVisible="{Binding IsApplicable}"
                  ColumnSpacing="16" Margin="0,0,0,14">
                <!-- What fills the whole rectangle stands above the pair of numbers it fills,
                     because it is one button for both of them rather than an answer to one. -->
                <Button Grid.Row="0" Grid.ColumnSpan="2" Classes="Secondary"
                        Width="150" Margin="0,0,0,6"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding IsPointAnchor}"
                        ToolTip.Tip="{Binding [Add.PickCoordinateHint], Source={x:Static loc:Strings.Current}}"
                        Content="{Binding [Add.PickCoordinate], Source={x:Static loc:Strings.Current}}"
                        Click="OnPickPoint" />
                <Button Grid.Row="0" Grid.ColumnSpan="2" Classes="Secondary"
                        Width="150" Margin="0,0,0,6"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding IsWindowBoundsAnchor}"
                        ToolTip.Tip="{Binding [Add.PickWindowBoundsHint], Source={x:Static loc:Strings.Current}}"
                        Content="{Binding [Add.PickWindowBounds], Source={x:Static loc:Strings.Current}}"
                        Click="OnPickWindowBounds" />
                <Button Grid.Row="0" Grid.ColumnSpan="2" Classes="Secondary"
                        Height="30" Padding="10,0" Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding IsRegionAnchor}"
                        ToolTip.Tip="{Binding RegionPickerHint}"
                        Content="{Binding RegionPickerLabel}"
                        Click="OnPickRegion" />
                <ContentControl Grid.Row="1" Grid.Column="0"
                                Grid.ColumnSpan="{Binding FirstSpan}"
                                Content="{Binding First}"
                                ContentTemplate="{StaticResource ParameterEditor}" />
                <ContentControl Grid.Row="1" Grid.Column="1"
                                Content="{Binding Second}"
                                ContentTemplate="{StaticResource ParameterEditor}"
                                IsVisible="{Binding HasSecond}" />
                <!-- A field that belongs beside the line rather than under it: the switch that
                     takes a mouse step's place from the pointer stands at the end of the row of
                     the button it belongs to. It is held to a width of its own, because this
                     column is measured before the two beside it: a wordy explanation would
                     otherwise ask for as much room as it has words and leave the fields it stands
                     beside with none. -->
                <ContentControl Grid.Row="1" Grid.Column="2" MaxWidth="260"
                                Content="{Binding Third}"
                                ContentTemplate="{StaticResource ParameterEditor}"
                                IsVisible="{Binding HasThird}" />
                <!-- A position is taken from the pointer with Alt + X, and a click point from the
                     reference picture itself. -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="2,6,0,0" Spacing="6">
                    <TextBlock Classes="Hint" TextWrapping="Wrap"
                               IsVisible="{Binding ShowsPositionHint}"
                               Text="{Binding [Add.SharedPositionHint], Source={x:Static loc:Strings.Current}}" />
                    <Button Classes="Secondary" Height="30" Padding="10,0"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding ShowsOffsetPick}"
                            ToolTip.Tip="{Binding [Add.PickOffsetHint], Source={x:Static loc:Strings.Current}}"
                            Content="{Binding [Add.PickOffset], Source={x:Static loc:Strings.Current}}"
                            Click="OnPickOffset" />
                </StackPanel>

                <!-- Where these numbers are counted from, said once for the line they are on. -->
                <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Classes="Hint" Margin="2,6,0,0"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasBasisNote}" Text="{Binding BasisNote}" />
            </Grid>
        </DataTemplate>

        <!-- One group of the action picker: a heading that opens and closes, and the actions
             under it, laid out as a grid of cards. -->
        <DataTemplate x:Key="ActionGroup" x:DataType="vm:ActionGroupViewModel">
            <StackPanel Margin="0,0,0,2">
                <!-- A heading that only divides the picker into parts: it says what the parts are
                     for and holds nothing itself. -->
                <TextBlock Classes="SectionHeader" Text="{Binding Title}"
                           IsVisible="{Binding IsSection}" />

                <Button Classes="GroupToggle" Click="OnToggleActionGroup"
                        IsVisible="{Binding HasActions}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <views:IconView Width="10" Height="8" VerticalAlignment="Center" Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.2" FitToBounds="True" Data="{Binding Caret}" />
                        <views:IconView Width="15" Height="15" Stroke="{DynamicResource TextTertiary}"
                                        StrokeThickness="1.4" FitToBounds="True" Data="{Binding Icon}"
                                        VerticalAlignment="Center" IsVisible="{Binding HasIcon}" />
                        <TextBlock Text="{Binding Header}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Classes="Hint" Margin="22,3,10,0"
                           TextWrapping="Wrap" Text="{Binding Note}"
                           IsVisible="{Binding HasNote}" />

                <ItemsControl ItemsSource="{Binding Actions}" IsVisible="{Binding IsOpen}"
                              Margin="22,7,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActionCardViewModel">
                            <Button Classes="Secondary" Margin="0,0,6,6" Classes.selected="{Binding IsSelected}"
                                    Click="OnPickAction"
                                    ToolTip.Tip="{Binding Definition.LocalDescription}">
                                <TextBlock Text="{Binding Definition.LocalName}" FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>

        <!--
          表单前后缀：`±`、`%`、`按住`、`毫秒`、`间隔`。它们不是"次要文字"——单位要紧贴控件，
          附注可以离远，排版要求不同，所以不进库、留在这个窗口里。
        -->
        <!-- A heading that divides the picker in two, rather than a group of actions: it is read
             on the way past, so it is quieter and smaller than a group heading. -->
        <!-- The mark on a field that is read as one value: small, and in the colour the interface
             already uses for a name it made itself. -->
        <!--
          公式标记：`ƒ` 字形自己表意（"这个值由程序算出"），颜色只需**比正文弱**。
          原来那个蓝会被读成"语法高亮"，而这套界面没有语法高亮。
        -->
        <Style Selector="TextBlock.FormulaMark">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="FontSize" Value="{DynamicResource UiBodySmallSize}" />
            <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
            <Setter Property="Margin" Value="2,3,5,6" />
        </Style>

        <!-- The fold that keeps the settings an action can live without out of the way. -->

        <!-- The heading of one group in the action picker: quiet, and the whole width of the list. -->
        <Style Selector="Button.GroupToggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.GroupToggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceField}" />
        </Style>

        <!-- One action in the picker: a card holding its name, laid out a grid to a group. -->
        <!-- The one the dialog is about reads as chosen, so the list on the left always says what
             the fields on the right are fields of. -->
        <!-- 被选中的次按钮**不是危险态**：`#3A2A22` 与 `DangerSurface` 值接近，语义完全不同。
             选中态全仓只有一种表达——底 `AccentSurface`、边 `AccentFill`。 -->
        <Style Selector="Button.Secondary.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFill}" />
        </Style>

        <!-- One page of a step's settings. -->
        <Style Selector="Button.PageTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="32" />
        </Style>
        <Style Selector="Button.PageTab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceField}" />
        </Style>
        <Style Selector="Button.PageTab.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderControl}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFill}" />
        </Style>


        <!-- Variable name: free text with the known variables offered as suggestions. -->
        <!-- A named button in the title bar, for the one thing the dialog can do besides hand the
             step back: run it. It is wider than the window buttons because it says what it is. -->
    </UserControl.Styles>

    <Grid Name="FormRoot" RowDefinitions="38,*">

        <!-- Title bar -->
        <Grid Name="FormHeader" Grid.Row="0" Background="{DynamicResource SurfaceChrome}" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                <Image Source="/Assets/WhaleGenie.png" Width="22" Height="22" Stretch="Uniform" />
                <TextBlock Text="{Binding Header}" Foreground="{DynamicResource TextPrimary}" FontSize="13"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
                <!-- Runs the step being written, without leaving the macro and going into a run:
                     that is the question the dialog is open to answer, and closing it to ask loses
                     the half-written step on the way. -->
                <Button Classes="Chrome Icon" Name="MinimizeButton">
                    <views:IconView Width="10" Height="10" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.2" FitToBounds="True" Data="{x:Static vm:AppIcons.Minus}" />
                </Button>
                <Button Classes="Chrome Icon" Name="CloseButton">
                    <views:IconView Width="10" Height="10" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.2" FitToBounds="True" Data="{x:Static vm:AppIcons.X}" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="14">
            <Grid Name="FormBody" Grid.Row="0" ColumnDefinitions="320,*">

                <!-- Which action. Always on screen rather than folded away once one is chosen:
                 changing one's mind is then a click, and the fields beside it never move. -->
                <Grid Name="PickerColumn" Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="0,0,6,0">
                    <TextBlock Classes="FieldLabel"
                               Text="{Binding [Add.SelectAction], Source={x:Static loc:Strings.Current}}" />

                    <!-- The catalogue is well over a hundred actions, so it is read as a search box
                         over short groups rather than one long dropdown. -->
                    <TextBox Grid.Row="1" Classes="Field" Text="{Binding ActionSearch}"
                             AutomationProperties.Name="Search actions"
                             PlaceholderText="{Binding [Add.SearchAction], Source={x:Static loc:Strings.Current}}" />

                    <ScrollViewer Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Classes="Hint" Margin="2,0,0,6" TextWrapping="Wrap"
                                       IsVisible="{Binding HasNoActionMatch}"
                                       Text="{Binding [Add.NoActionFound], Source={x:Static loc:Strings.Current}}" />

                            <ItemsControl ItemsSource="{Binding ActionGroups}"
                                          ItemTemplate="{StaticResource ActionGroup}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- What the step is, and how it is set up: a page at a time, so a form of a dozen
                     fields is not one wall of them. -->
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="16,0,0,0">
                    <StackPanel Grid.Row="0" Spacing="3" Margin="2,0,0,12">
                        <TextBlock Text="{Binding SelectedActionName}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Classes="Hint" Text="{Binding Description}" TextWrapping="Wrap" />
                    </StackPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Pages}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActionPageViewModel">
                                <!-- A page holding something that is not the value it starts on
                                     carries a mark, so a step that behaves unusually says so from
                                     the tab rather than only on the page it is on. -->
                                <Button Classes="PageTab" Classes.selected="{Binding IsOpen}"
                                        IsVisible="{Binding IsPresent}" Click="OnSelectPage">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                        <Ellipse Width="6" Height="6" Fill="#E0A030"
                                                 VerticalAlignment="Center"
                                                 IsVisible="{Binding HasDot}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ScrollViewer Grid.Row="2" Padding="4,2,10,8" VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                    <!-- What the step is: what it looks for, where, how soon, and what it does. -->
                    <Border Classes="Sunken" IsVisible="{Binding OnBase}" Margin="0,16,0,0">
                        <StackPanel>
                            <!-- Every step may carry a note, and a note is part of what the step
                                 is, so it is the first line here rather than something to go
                                 looking for. -->
                            <StackPanel Margin="0,0,0,12" IsVisible="{Binding HasSelection}">
                                <TextBlock Classes="FieldLabel"
                                           Text="{Binding [Add.StepComment], Source={x:Static loc:Strings.Current}}" />
                                <TextBox Classes="Field" Text="{Binding MetaComment}"
                                         PlaceholderText="{Binding [Add.StepCommentHint], Source={x:Static loc:Strings.Current}}" />
                            </StackPanel>

                            <!-- A block's settings are about the block, not about one thing the run
                                 does, and the two levels are what make a failure answerable at the
                                 level it belongs to. -->
                            <TextBlock Classes="Hint" TextWrapping="Wrap" Margin="2,0,0,8"
                                       IsVisible="{Binding IsBlock}"
                                       Text="{Binding [Add.BlockStepsInList], Source={x:Static loc:Strings.Current}}" />

                            <ItemsControl ItemsSource="{Binding Rows}"
                                          ItemTemplate="{StaticResource ParameterRowEditor}" />

                            <!-- What a call passes belongs right under the macro it names, because
                                 every row here exists because of that name. -->
                            <StackPanel IsVisible="{Binding HasCallArguments}" Margin="0,4,0,0">
                                <TextBlock Classes="FieldLabel"
                                           Text="{Binding [Add.CallArguments], Source={x:Static loc:Strings.Current}}" />
                                <ItemsControl ItemsSource="{Binding CallArgumentRows}"
                                              ItemTemplate="{StaticResource CallArgumentRowEditor}" />
                            </StackPanel>

                            <Border IsVisible="{Binding ShowsGlobalPersistence}"
                                    Background="{DynamicResource SurfaceSunken}" CornerRadius="5"
                                    Padding="10" Margin="2,4,0,8">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="{Binding [GlobalVariables.Definition], Source={x:Static loc:Strings.Current}}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <Grid ColumnDefinitions="130,*" ColumnSpacing="8">
                                        <TextBlock Text="{Binding [Variable.Type], Source={x:Static loc:Strings.Current}}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding GlobalVariableDraft.TypeOptions}"
                                                  SelectedItem="{Binding GlobalVariableDraft.SelectedType}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:ActionParameterOption">
                                                    <TextBlock Text="{Binding Display}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnDefinitions="130,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{Binding [Variable.Default], Source={x:Static loc:Strings.Current}}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding GlobalVariableDraft.DefaultValue}" />
                                        <Button Grid.Column="2" Classes="Secondary"
                                                Content="{Binding [Add.UseExpression], Source={x:Static loc:Strings.Current}}"
                                                Click="OnBuildGlobalDefaultExpression" />
                                    </Grid>
                                    <TextBlock Margin="138,0,0,0"
                                               Text="{Binding GlobalVariableDraft.DefaultPreview}"
                                               TextWrapping="Wrap" FontSize="11.5"
                                               Foreground="{DynamicResource TextTertiary}" />
                                    <Grid ColumnDefinitions="130,*" ColumnSpacing="8">
                                        <TextBlock Text="{Binding [Variable.Description], Source={x:Static loc:Strings.Current}}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding GlobalVariableDraft.Description}" />
                                    </Grid>
                                    <CheckBox IsChecked="{Binding GlobalVariableDraft.PersistValue}"
                                              Content="{Binding [Variable.Persist], Source={x:Static loc:Strings.Current}}"
                                              ToolTip.Tip="{Binding [Variable.PersistHint], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Text="{Binding GlobalVariableProblem}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Danger}"
                                               IsVisible="{Binding HasGlobalVariableProblem}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Classes="Hint" IsVisible="{Binding !HasParameters}"
                                       Text="{Binding [Add.NoParameters], Source={x:Static loc:Strings.Current}}" />
                        </StackPanel>
                    </Border>

                    <!-- How the step does it: the ways of recognising things, the tuning, the
                         format. Nothing here is needed to say what the step is, so it is on a page
                         of its own rather than in the way of the usual few fields. -->
                    <Border Classes="Sunken" IsVisible="{Binding OnAdvanced}" Margin="0,16,0,0">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding AdvancedRows}"
                                          ItemTemplate="{StaticResource ParameterRowEditor}" />
                        </StackPanel>
                    </Border>

                    <!-- What the step hands over. These are the results the engine works out while
                         it runs: tick the ones the macro should keep, and each becomes a variable of
                         its own for a later step to read. -->
                    <Border Classes="Sunken" IsVisible="{Binding OnReturns}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Classes="Hint" TextWrapping="Wrap" Margin="2,0,0,8"
                                       Text="{Binding [Add.Page.ReturnsHint], Source={x:Static loc:Strings.Current}}" />
                            <ItemsControl ItemsSource="{Binding ReturnsRows}"
                                          ItemTemplate="{StaticResource ReturnsRowEditor}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="Sunken" IsVisible="{Binding OnOther}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Classes="Hint" TextWrapping="Wrap" Margin="2,0,0,12"
                                       IsVisible="{Binding IsBlock}"
                                       Text="{Binding [Add.BlockSettings], Source={x:Static loc:Strings.Current}}" />

                            <!-- The name this step goes by. It is what a condition and a result
                                 variable point at, so it is shown where the step is edited rather
                                 than only in the file. -->
                            <StackPanel IsVisible="{Binding HasStepId}">
                                <TextBlock Classes="FieldLabel"
                                           Text="{Binding [Add.StepId], Source={x:Static loc:Strings.Current}}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding StepId}" VerticalAlignment="Center"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="13"
                                               Foreground="#8FB3D9" />
                                    <Button Classes="Secondary" Padding="10,2"
                                            Click="OnCopyStepId"
                                            Content="{Binding [Add.StepIdCopy], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <TextBlock Classes="Hint" Margin="0,5,0,0" TextWrapping="Wrap"
                                           Text="{Binding [Add.StepIdHint], Source={x:Static loc:Strings.Current}}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Add.StepTimeout], Source={x:Static loc:Strings.Current}}" />
                                    <ContentControl Content="{Binding MetaTimeout}"
                                                    ContentTemplate="{StaticResource DurationSetting}" />
                                    <TextBlock Classes="Hint" Margin="0,5,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Add.StepTimeoutHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Add.StepRetry], Source={x:Static loc:Strings.Current}}" />
                                    <views:NumberBox Value="{Binding MetaRetryCount}" Minimum="0" Maximum="20"
                                                   Increment="1" FormatString="0"
                                                   Width="150" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Add.StepRetryDelay], Source={x:Static loc:Strings.Current}}" />
                                    <ContentControl Content="{Binding MetaRetryDelay}"
                                                    ContentTemplate="{StaticResource DurationSetting}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Add.StepOnError], Source={x:Static loc:Strings.Current}}" />
                                    <ComboBox Classes="Field" ItemsSource="{Binding ErrorChoices}"
                                              SelectedItem="{Binding MetaOnError}"
                                              Width="170" HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ActionParameterOption">
                                                <TextBlock Text="{Binding Display}"
                                                           FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Classes="FieldLabel"
                                           Text="{Binding [Add.StepBackoff], Source={x:Static loc:Strings.Current}}" />
                                <ComboBox Classes="Field" ItemsSource="{Binding BackoffChoices}"
                                          SelectedItem="{Binding MetaRetryBackoff}"
                                          Width="220" HorizontalAlignment="Left">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ActionParameterOption">
                                            <TextBlock Text="{Binding Display}"
                                                       FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Classes="Hint" Margin="0,5,0,0" TextWrapping="Wrap"
                                           Text="{Binding [Add.StepBackoffHint], Source={x:Static loc:Strings.Current}}" />
                                <TextBlock Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="#C8A165" Text="{Binding RetryPlan}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Add.StepDelayBefore], Source={x:Static loc:Strings.Current}}" />
                                    <ContentControl Content="{Binding MetaDelayBefore}"
                                                    ContentTemplate="{StaticResource DurationSetting}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Add.StepDelayAfter], Source={x:Static loc:Strings.Current}}" />
                                    <ContentControl Content="{Binding MetaDelayAfter}"
                                                    ContentTemplate="{StaticResource DurationSetting}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                                <ToggleSwitch IsChecked="{Binding MetaEnabled}" OnContent="" OffContent="" />
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="{Binding [Add.StepEnabled], Source={x:Static loc:Strings.Current}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="Sunken" IsVisible="{Binding OnOther}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Classes="GroupHeader" HorizontalAlignment="Center" Margin="0,12,0,10"
                                       Text="{Binding [Add.JsonNode], Source={x:Static loc:Strings.Current}}" />
                            <TextBox Classes="Code ReadOnly" Text="{Binding JsonPreview, Mode=OneWay}"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     MinHeight="150" MaxHeight="360"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Save / cancel -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="4,12,4,0">
                <!-- Nothing picked yet is not a mistake, so it stays quiet; anything else is a
                     reason the step cannot be saved and is said in red, where it is hard to miss. -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Classes="Hint" TextWrapping="Wrap"
                               Text="{Binding ValidationMessage}"
                               IsVisible="{Binding !ValidationIsProblem}" />
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Danger}"
                               FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="{Binding ValidationMessage}"
                               IsVisible="{Binding ValidationIsProblem}" />
                    <!-- What just happened: what a run did, so a step that is meant to do something
                         visible and a step that did nothing can be told apart, or why a step did not
                         go where it was being put. -->
                    <TextBlock Foreground="{DynamicResource Success}" TextWrapping="Wrap"
                               Text="{Binding Notice}"
                               IsVisible="{Binding ShowsNotice}" />
                    <TextBlock Foreground="{DynamicResource Warning}" TextWrapping="Wrap"
                               Text="{Binding Notice}"
                               IsVisible="{Binding ShowsWarning}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="Secondary" Height="38" MinWidth="92"
                        Margin="8,0,0,0" Content="{Binding RunLabel}"
                        IsVisible="{Binding ShowsRun}" IsEnabled="{Binding CanRun}"
                        ToolTip.Tip="{Binding [Add.RunStepHint], Source={x:Static loc:Strings.Current}}"
                        Click="OnRunStep" />
                <Button Grid.Column="2" Classes="Secondary" Height="38" MinWidth="92"
                        Content="{Binding CancelLabel}"
                        Margin="8,0,0,0" Command="{Binding CancelCommand}" />
                <Button Grid.Column="3" Classes="Primary" Content="{Binding CommitLabel}" MinWidth="110"
                        Margin="8,0,0,0" Command="{Binding SaveCommand}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
