<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WhaleGenie.ViewModels"
             xmlns:models="using:WhaleGenie.Models"
             xmlns:loc="using:WhaleGenie.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="240"
             x:Class="WhaleGenie.Views.VariableWall"
             x:DataType="vm:VariableWallViewModel">

    <Design.DataContext>
        <vm:VariableWallViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- One variable to point at. It stands the same size and shape as every other card in the
             palettes around it, so the wall reads as one wall rather than as a list apart. -->
        <Style Selector="Button.VarButton">
            <Setter Property="Background" Value="#2E2E2E" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.VarButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3C3C3C" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="8">
        <!-- Which group of variables is on show: painted like a switch rather than a menu, because
             the list under it changes as soon as one is pressed. -->
        <ListBox Classes="Dock" ItemsSource="{Binding Filters}"
                 SelectedItem="{Binding SelectedFilter}" SelectionMode="Single"
                 Background="Transparent" BorderThickness="0" Padding="0">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:VariableFilter">
                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#E8E8E8"
                               ToolTip.Tip="{Binding Hint}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- The variables themselves: one button each, so the wall is something to point at rather
             than a name to type. Hovering one puts everything about it on the line below. -->
        <ScrollViewer MaxHeight="196" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Shown}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:VariableChoice">
                        <Button Classes="VarButton" Margin="0,0,6,6" Content="{Binding Display}"
                                Click="OnChoose"
                                PointerEntered="OnLooking" PointerExited="OnUnlooked">
                            <ToolTip.Tip>
                                <TextBlock Text="{Binding Details}" TextWrapping="Wrap"
                                           MaxWidth="340" FontSize="12" />
                            </ToolTip.Tip>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="11.5"
                   Foreground="#9A9A9A" MinHeight="32" MaxHeight="60" />

        <!-- Which steps read the one under the pointer. A name on a button says nothing about who
             wants it, and this is the line that answers it; pressing one asks the place the wall
             stands in to show that step. -->
        <StackPanel Spacing="4" IsVisible="{Binding HasUses}">
            <TextBlock FontSize="11.5" Foreground="#8A8A8A"
                       Text="{Binding [VarWall.UsedBy], Source={x:Static loc:Strings.Current}}" />
            <ItemsControl ItemsSource="{Binding Uses}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:VariableUse">
                        <Button Classes="VarButton" Height="24" FontSize="11.5" Margin="0,0,6,6"
                                Content="{Binding Label}"
                                ToolTip.Tip="{Binding [VarWall.JumpHint], Source={x:Static loc:Strings.Current}}"
                                Command="{Binding $parent[ItemsControl].((vm:VariableWallViewModel)DataContext).JumpCommand}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
