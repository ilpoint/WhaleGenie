<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WhaleGenie.ViewModels"
             xmlns:models="using:WhaleGenie.Models"
             xmlns:loc="using:WhaleGenie.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="240"
             x:Class="WhaleGenie.Views.VariableWall"
             x:DataType="vm:VariableWallViewModel">

    <Design.DataContext>
        <vm:VariableWallViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- One variable to point at. It stands the same size and shape as every other card in the
             palettes around it, so the wall reads as one wall rather than as a list apart. -->
        <Style Selector="Button.VarButton">
            <Setter Property="Background" Value="{DynamicResource AppField}" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.VarButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="ScrollViewer.VariableList /template/ ScrollBar#PART_VerticalScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">
        <TextBox Grid.Row="0" Name="VariableSearch" Text="{Binding SearchText}"
                 PlaceholderText="{Binding [VarWall.Search], Source={x:Static loc:Strings.Current}}" />

        <!-- Which group of variables is on show: painted like a switch rather than a menu, because
             the list under it changes as soon as one is pressed. -->
        <ListBox Grid.Row="1" Classes="Dock" ItemsSource="{Binding Filters}"
                 SelectedItem="{Binding SelectedFilter}" SelectionMode="Single"
                 Background="Transparent" BorderThickness="0" Padding="0">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:VariableFilter">
                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource AppText}"
                               ToolTip.Tip="{Binding Hint}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- The variables themselves: one button each, so the wall is something to point at rather
             than a name to type. Hovering one puts everything about it on the line below. -->
        <ScrollViewer Grid.Row="2" Name="VariableList" Classes="VariableList"
                      MaxHeight="{Binding ListMaxHeight}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Shown}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:VariableChoice">
                        <Button Classes="VarButton" Margin="0,0,6,6"
                                Click="OnChoose"
                                PointerPressed="OnPressed"
                                PointerMoved="OnMoved"
                                PointerReleased="OnReleased"
                                PointerCaptureLost="OnCaptureLost"
                                DoubleTapped="OnDoubleTapped"
                                PointerEntered="OnLooking" PointerExited="OnUnlooked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                <Border IsVisible="{Binding IsPersistent}"
                                        Background="{DynamicResource AppDock}" CornerRadius="3"
                                        Padding="5,1">
                                    <TextBlock Text="{Binding PersistenceBadge}" FontSize="10.5"
                                               Foreground="#D6C08A" />
                                </Border>
                            </StackPanel>
                            <ToolTip.Tip>
                                <Border MaxWidth="380" MaxHeight="260"
                                        Background="{DynamicResource AppSurface}"
                                        BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <SelectableTextBlock Text="{Binding HoverText}"
                                                             TextWrapping="Wrap" FontSize="12" />
                                    </ScrollViewer>
                                </Border>
                            </ToolTip.Tip>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding Details}" TextWrapping="Wrap" FontSize="11.5"
                   Foreground="{DynamicResource AppMuted}" MinHeight="32" MaxHeight="60" />

        <!-- Which steps read the one under the pointer. A name on a button says nothing about who
             wants it, and this is the line that answers it; pressing one asks the place the wall
             stands in to show that step. -->
        <StackPanel Grid.Row="4" Spacing="4" IsVisible="{Binding HasUses}">
            <TextBlock FontSize="11.5" Foreground="#8A8A8A"
                       Text="{Binding [VarWall.UsedBy], Source={x:Static loc:Strings.Current}}" />
            <ItemsControl ItemsSource="{Binding Uses}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:VariableUse">
                        <Button Classes="VarButton" Height="24" FontSize="11.5" Margin="0,0,6,6"
                                Content="{Binding Label}"
                                ToolTip.Tip="{Binding [VarWall.JumpHint], Source={x:Static loc:Strings.Current}}"
                                Command="{Binding $parent[ItemsControl].((vm:VariableWallViewModel)DataContext).JumpCommand}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
