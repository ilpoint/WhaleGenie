<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WhaleGenie.ViewModels"
             xmlns:models="using:WhaleGenie.Models"
             xmlns:loc="using:WhaleGenie.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="240"
             x:Class="WhaleGenie.Views.VariableWall"
             x:DataType="vm:VariableWallViewModel">

    <Design.DataContext>
        <vm:VariableWallViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- One variable to point at. It stands the same size and shape as every other card in the
             palettes around it, so the wall reads as one wall rather than as a list apart. -->
        <Style Selector="ScrollViewer.VarWallScroll /template/ ScrollBar#PART_VerticalScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
        </Style>

        <!-- The group chips, a touch smaller than the same dock in the expression builder: this one
             shares a 360-pixel column with the wall under it and has five names to fit on a line. -->
        <Style Selector="ListBox.VariableFilters ListBoxItem">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="0,0,3,3" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <TextBox Grid.Row="0" Name="VariableSearch" Text="{Binding SearchText}"
                 PlaceholderText="{Binding [VarWall.Search], Source={x:Static loc:Strings.Current}}" />

        <!-- Which group of variables is on show: painted like a switch rather than a menu, because
             the list under it changes as soon as one is pressed. It stays on one line — a second
             line of chips costs the list a whole row of variables and reads as a break between the
             wall and what it is filtered by. English names are the short ones, because "Local
             variables" is what made the row wrap; the hint on each says the rest. -->
        <ListBox Grid.Row="1" Name="VariableGroups" Classes="Dock VariableFilters" ItemsSource="{Binding Filters}"
                 SelectedItem="{Binding SelectedFilter}" SelectionMode="Single"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:VariableFilter">
                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource TextPrimary}"
                               ToolTip.Tip="{Binding Hint}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- The variables themselves: one button each, so the wall is something to point at rather
             than a name to type. Hovering one puts everything about it on the line below. -->
        <ScrollViewer Grid.Row="2" Name="VariableList" Classes="VarWallScroll"
                      MaxHeight="{Binding ListMaxHeight}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Shown}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:VariableChoice">
                        <Button Classes="Secondary Block Chip"
                                Click="OnChoose"
                                PointerPressed="OnPressed"
                                PointerMoved="OnMoved"
                                PointerReleased="OnReleased"
                                PointerCaptureLost="OnCaptureLost"
                                DoubleTapped="OnDoubleTapped"
                                PointerEntered="OnLooking" PointerExited="OnUnlooked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                <Border IsVisible="{Binding IsPersistent}"
                                        Background="{DynamicResource SurfacePanel}" CornerRadius="3"
                                        Padding="5,1">
                                    <TextBlock Text="{Binding PersistenceBadge}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </Border>
                            </StackPanel>
                            <ToolTip.Placement>Right</ToolTip.Placement>
                            <ToolTip.Tip>
                                <Border MaxWidth="380" MaxHeight="260"
                                        Background="{DynamicResource SurfacePanel}"
                                        BorderBrush="{DynamicResource BorderControl}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <SelectableTextBlock Text="{Binding HoverText}"
                                                             TextWrapping="Wrap" FontSize="12" />
                                    </ScrollViewer>
                                </Border>
                            </ToolTip.Tip>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- What the one under the pointer is, and which steps read it. It has a height of its own
             rather than growing into the list above: a panel whose size depends on hover steals
             rows from the list, the cards reflow, the pointer ends up somewhere else, the hover is
             lost, the space comes back, and the card returns under the pointer — a bubble that
             flickers for as long as the pointer stays put. Overflow scrolls inside this box. -->
        <ScrollViewer Grid.Row="3" Name="VariableDetails" Height="72"
                      IsVisible="{Binding ShowsDetails}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="11.5"
                           Foreground="{DynamicResource TextTertiary}" />

                <!-- Pressing one of those steps asks the place the wall stands in to show it. -->
                <StackPanel Spacing="4" IsVisible="{Binding HasUses}">
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextTertiary}"
                               Text="{Binding [VarWall.UsedBy], Source={x:Static loc:Strings.Current}}" />
                    <ItemsControl ItemsSource="{Binding Uses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:VariableUse">
                                <Button Classes="Secondary" Height="24" FontSize="11.5"
                                        Margin="0,0,6,6"
                                        Content="{Binding Label}"
                                        ToolTip.Tip="{Binding [VarWall.JumpHint], Source={x:Static loc:Strings.Current}}"
                                        Command="{Binding $parent[ItemsControl].((vm:VariableWallViewModel)DataContext).JumpCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
