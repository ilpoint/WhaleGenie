<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:views="using:WhaleGenie.Views"
        x:Class="WhaleGenie.Views.HotstringKeyboardWindow"
        Title=""
        Width="900" Height="500"
        MinWidth="820" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource AppBackdrop}">

    <Window.Styles>
        <Style Selector="Button.CharKey">
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{DynamicResource AppField}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.CharKey:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Button.CharKey.ShiftOn /template/ ContentPresenter">
            <Setter Property="Background" Value="#2E5F8A" />
        </Style>
        <Style Selector="Button.TitleBarButton">
            <Setter Property="Background" Value="{DynamicResource AppControl}" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="38,*">
        <Grid Grid.Row="0" Background="{DynamicResource AppChrome}" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                <Image Source="/Assets/WhaleGenie.png" Width="22" Height="22" Stretch="Uniform" />
                <TextBlock Foreground="{DynamicResource AppText}" FontSize="13"
                           VerticalAlignment="Center"
                           Text="{Binding [HotstringKeyboard.Title], Source={x:Static loc:Strings.Current}}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="TitleBarButton" Name="CloseButton"
                    Margin="8,0" VerticalAlignment="Center">
                <views:IconView Width="10" Height="10" Stroke="{DynamicResource AppText}"
                                StrokeThickness="1.2" FitToBounds="True"
                                Data="{x:Static models:AppIcons.X}" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,14" Spacing="12">
                <Border Background="{DynamicResource AppDock}" CornerRadius="6" Padding="12">
                    <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock FontSize="12" Foreground="{DynamicResource AppMuted}"
                                       Text="{Binding [HotstringKeyboard.Preview], Source={x:Static loc:Strings.Current}}" />
                            <TextBlock Grid.Column="1" Name="CountText" FontSize="12"
                                       Foreground="{DynamicResource AppMuted}" />
                        </Grid>
                        <TextBlock Name="PreviewText" FontFamily="Consolas" FontSize="16"
                                   Foreground="{DynamicResource AppText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock FontSize="12" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"
                           Text="{Binding [HotstringKeyboard.Hint], Source={x:Static loc:Strings.Current}}" />
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#8FC7F0" TextWrapping="Wrap"
                           Text="{Binding [Editor.HotstringMouseResetHint], Source={x:Static loc:Strings.Current}}" />

                <StackPanel Name="KeyRows" Spacing="7" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4,0,0">
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppMuted}"
                               TextWrapping="Wrap"
                               Text="{Binding [HotstringKeyboard.Selected], Source={x:Static loc:Strings.Current}}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Name="BackspaceButton" Classes="CharKey" MinWidth="104"
                                Content="{Binding [HotstringKeyboard.Backspace], Source={x:Static loc:Strings.Current}}" />
                        <Button Name="ClearButton" Classes="CharKey" MinWidth="80"
                                Content="{Binding [HotstringKeyboard.Clear], Source={x:Static loc:Strings.Current}}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
