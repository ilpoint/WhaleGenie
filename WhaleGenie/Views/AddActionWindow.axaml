<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:conv="using:WhaleGenie.Converters"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="700"
        x:Class="WhaleGenie.Views.AddActionWindow"
        x:DataType="vm:AddActionViewModel"
        Title="Add Action"
        Width="600" Height="700"
        MinWidth="540" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="#232323">

    <Design.DataContext>
        <vm:AddActionViewModel />
    </Design.DataContext>

    <Window.Resources>
        <!-- Paints the swatch beside a colour parameter. -->
        <conv:HexColorToBrushConverter x:Key="HexBrush" />

        <!-- One length of time in the step settings: the number plus the unit it is written in. -->
        <DataTemplate x:Key="DurationSetting" x:DataType="vm:DurationSettingViewModel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <NumericUpDown Value="{Binding Value}"
                               Minimum="{Binding Minimum}"
                               Maximum="{Binding Maximum}"
                               Increment="1" FormatString="0.###"
                               HorizontalAlignment="Stretch" />
                <ComboBox Grid.Column="1" Classes="ActionSelect"
                          ItemsSource="{Binding Units}"
                          SelectedItem="{Binding Unit}"
                          Width="118" HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:DurationUnit">
                            <TextBlock Text="{Binding Label}"
                                       FontSize="12.5" Foreground="#E8E8E8" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </DataTemplate>

        <!-- One parameter's editor, shared by every line of the parameter list. -->
        <DataTemplate x:Key="ParameterEditor" x:DataType="vm:StepParameterViewModel">
            <StackPanel>
                <TextBlock Classes="FieldLabel" Text="{Binding Label}" />

                <TextBox Classes="ParamInput" Text="{Binding Text}"
                         IsVisible="{Binding IsPlainText}"
                         PlaceholderText="{Binding Placeholder}" />

                <!-- A key: the names are offered from a list so one does not have to be
                     remembered, and the box stays editable so any of them can still be typed.
                     Beside it the key can be pointed at instead, on a keyboard laid out on
                     screen — a key is found by where it sits, not by what it is called. -->
                <Grid IsVisible="{Binding IsKey}" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <AutoCompleteBox Classes="VarInput"
                                     ItemsSource="{Binding KeyChoices}"
                                     Text="{Binding Text}"
                                     PlaceholderText="{Binding Placeholder}"
                                     MinimumPrefixLength="0"
                                     FilterMode="Contains" />
                    <Button Grid.Column="1" Classes="FlatButton" Height="33" Padding="11,0"
                            Content="{Binding [Add.OpenKeyPad], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.OpenKeyPadHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnOpenKeyPad" />
                </Grid>

                <!-- A value that may name variables: the names are offered while it is typed in,
                     and a whole value may be built with the expression editor. -->
                <Grid IsVisible="{Binding OffersVariables}" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <AutoCompleteBox Classes="VarInput"
                                     ItemsSource="{Binding ExpressionSuggestions}"
                                     Text="{Binding Text}"
                                     PlaceholderText="{Binding Placeholder}"
                                     MinimumPrefixLength="1"
                                     FilterMode="Contains" />
                    <Button Grid.Column="1" Classes="FlatButton" Height="33" Padding="11,0"
                            IsVisible="{Binding OffersFormula}"
                            Content="{Binding [Add.ExpressionBuilder], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.ExpressionBuilderHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnOpenExpressionBuilder" />
                </Grid>

                <!-- A UI Automation selector: written out by hand, or taken off the screen by
                     pointing at the control. -->
                <Grid IsVisible="{Binding IsSelector}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <TextBox Classes="ParamInput" Text="{Binding Text}"
                             PlaceholderText="{Binding Placeholder}" />
                    <Button Grid.Column="1" Classes="FlatButton" Height="33" Padding="11,0"
                            Content="{Binding [Add.PickElement], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.PickElementHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnPickElement" />
                    <Button Grid.Column="2" Classes="FlatButton" Height="33" Padding="11,0"
                            Content="{Binding [Add.TestElement], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.TestElementHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnTestElement" />
                </Grid>

                <!-- An element of a page: written out by hand, or taken off the page by pointing
                     at it in the browser. -->
                <Grid IsVisible="{Binding IsBrowserTarget}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <TextBox Classes="ParamInput" Text="{Binding Text}"
                             PlaceholderText="{Binding Placeholder}" />
                    <Button Grid.Column="1" Classes="FlatButton" Height="33" Padding="11,0"
                            Content="{Binding [Add.PickBrowserElement], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.PickBrowserElementHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnPickBrowserElement" />
                    <Button Grid.Column="2" Classes="FlatButton" Height="33" Padding="11,0"
                            Content="{Binding [Add.TestElement], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.TestElementHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnTestBrowserElement" />
                </Grid>

                <TextBox Classes="ParamInput" Text="{Binding Text}"
                         IsVisible="{Binding IsMultiline}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="76"
                         PlaceholderText="{Binding Placeholder}" />

                <!-- A number is dialled in with the spinner or written as an expression. -->
                <Grid IsVisible="{Binding IsNumber}" ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                      ColumnSpacing="6">
                    <NumericUpDown IsVisible="{Binding IsNumberValue}"
                                   Value="{Binding NumberValue}"
                                   Minimum="{Binding Minimum}"
                                   Maximum="{Binding Maximum}"
                                   Increment="{Binding Increment}"
                                   FormatString="0.###"
                                   HorizontalAlignment="Stretch" />

                    <AutoCompleteBox Grid.Column="0" Classes="VarInput"
                                     IsVisible="{Binding IsNumberFormula}"
                                     ItemsSource="{Binding ExpressionSuggestions}"
                                     Text="{Binding Text}"
                                     PlaceholderText="{Binding FormulaPlaceholder}"
                                     MinimumPrefixLength="1"
                                     FilterMode="Contains" />

                    <!-- A length of time also says which unit the number is written in. -->
                    <ComboBox Grid.Column="1" Classes="ActionSelect"
                              ItemsSource="{Binding DurationUnits}"
                              SelectedItem="{Binding Unit}"
                              IsVisible="{Binding IsDurationEditor}"
                              Width="118" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:DurationUnit">
                                <TextBlock Text="{Binding Label}"
                                           FontSize="12.5" Foreground="#E8E8E8" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- A length of time can be given some give, so a wait is never the same
                         number twice. It lives beside the box rather than behind the fold: it is
                         part of how long the step waits, not a tuning knob. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"
                                IsVisible="{Binding IsDuration}"
                                ToolTip.Tip="{Binding [Add.JitterHint], Source={x:Static loc:Strings.Current}}">
                        <TextBlock Classes="Muted" VerticalAlignment="Center"
                                   Text="{Binding [Add.JitterSign], Source={x:Static loc:Strings.Current}}" />
                        <NumericUpDown Name="JitterBox" Width="76" Increment="5" FormatString="0.##"
                                       Minimum="0" Maximum="100" VerticalAlignment="Center"
                                       Value="{Binding JitterPercent}" />
                        <TextBlock Classes="Muted" VerticalAlignment="Center"
                                   Text="{Binding [Add.JitterUnit], Source={x:Static loc:Strings.Current}}" />
                    </StackPanel>

                    <Button Grid.Column="3" Classes="FlatButton" Width="38" Height="33" Padding="0"
                            IsEnabled="{Binding CanToggleFormula}"
                            ToolTip.Tip="{Binding FormulaTip}"
                            Click="OnToggleNumberFormula">
                        <TextBlock Text="ƒx" FontSize="14" FontStyle="Italic" />
                    </Button>

                    <!-- A number written as an expression gets the same helper the expression
                         fields do, so there is one place to reach for operators and variables. -->
                    <Button Grid.Column="4" Classes="FlatButton" Height="33" Padding="11,0"
                            IsVisible="{Binding IsNumberFormula}"
                            Content="{Binding [Add.ExpressionBuilder], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.ExpressionBuilderHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnOpenExpressionBuilder" />
                </Grid>

                <TextBlock Classes="Muted" Margin="2,5,0,0" TextWrapping="Wrap"
                           IsVisible="{Binding HasJitterRange}"
                           Text="{Binding JitterRange}" />

                <StackPanel IsVisible="{Binding IsNumberFormula}">
                    <TextBlock Classes="Muted" Margin="2,5,0,0" TextWrapping="Wrap"
                               Text="{Binding [Add.FormulaMilliseconds], Source={x:Static loc:Strings.Current}}"
                               IsVisible="{Binding IsDurationFormula}" />
                    <TextBlock Classes="Muted" Margin="2,5,0,0"
                               TextWrapping="Wrap"
                               Foreground="#E06C75"
                               Text="{Binding ExpressionMessage}"
                               IsVisible="{Binding ShowExpressionError}" />
                    <TextBlock Classes="Muted" Margin="2,5,0,0"
                               TextWrapping="Wrap"
                               Foreground="#7FC97F"
                               Text="{Binding ExpressionMessage}"
                               IsVisible="{Binding ShowExpressionSuccess}" />
                </StackPanel>

                <!-- Colour parameters open the screen magnifier -->
                <Grid IsVisible="{Binding IsColor}"
                      ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <TextBox Classes="ParamInput" Text="{Binding Text}"
                             PlaceholderText="{Binding Placeholder}" />
                    <Border Grid.Column="1" Width="33" Height="33" CornerRadius="5"
                            Background="{Binding Text, Converter={StaticResource HexBrush}}"
                            BorderBrush="#3A3A3A" BorderThickness="1" />
                    <Button Grid.Column="2" Classes="FlatButton" Name="PickColourButton"
                            Width="38" Height="33" Padding="0"
                            ToolTip.Tip="{Binding [Editor.PickColor], Source={x:Static loc:Strings.Current}}"
                            Click="OnPickParameterColor">
                        <Path Width="17" Height="17" Stretch="Uniform"
                              Stroke="#E4E4E4" StrokeThickness="1.7"
                              Data="M 2,22 L 3,21 H 6 L 15,12 M 3,21 V 18 L 12,9 M 15,6 L 18.4,2.6 A 2.1,2.1 0 1 1 21.4,5.6 L 18,9 L 18.9,9.9 A 2.1,2.1 0 1 1 15.9,12.9 L 9.3,6.3 A 2.1,2.1 0 1 1 12.3,3.3 L 13.1,4 Z" />
                    </Button>
                </Grid>

                <!-- A picture the action looks for: taken from a file, or straight off the
                     screen, and shown underneath so it is clear which one is meant. -->
                <StackPanel IsVisible="{Binding IsImage}">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBox Classes="ParamInput" Text="{Binding Text}"
                                 PlaceholderText="{Binding Placeholder}" />
                        <Button Grid.Column="1" Classes="FlatButton" Height="33" Padding="11,0"
                                Content="{Binding [Add.BrowseImage], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [Add.BrowseImageHint], Source={x:Static loc:Strings.Current}}"
                                Click="OnBrowseImage" />
                        <Button Grid.Column="2" Classes="FlatButton" Height="33" Padding="11,0"
                                Content="{Binding [Add.CaptureImage], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [Add.CaptureImageHint], Source={x:Static loc:Strings.Current}}"
                                Click="OnCaptureImage" />
                        <Button Grid.Column="3" Classes="FlatButton" Height="33" Padding="11,0"
                                Content="{Binding [Add.ClearImage], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [Add.ClearImageHint], Source={x:Static loc:Strings.Current}}"
                                Click="OnClearImage" />
                    </Grid>

                    <Border IsVisible="{Binding HasThumbnail}" Margin="0,8,0,0"
                            Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="1"
                            CornerRadius="5" Padding="4" HorizontalAlignment="Left">
                        <Image Source="{Binding Thumbnail}" MaxWidth="240" MaxHeight="110"
                               Stretch="Uniform" />
                    </Border>
                </StackPanel>

                <!-- A window, which the picker fills in from what is open right now. -->
                <Grid IsVisible="{Binding IsWindow}" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Classes="ParamInput" Text="{Binding Text}"
                             PlaceholderText="{Binding Placeholder}" />
                    <Button Grid.Column="1" Classes="FlatButton" Height="33" Padding="11,0"
                            Content="{Binding [Add.PickWindow], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.PickWindowHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnPickWindow" />
                </Grid>

                <ToggleSwitch IsVisible="{Binding IsBool}"
                              IsChecked="{Binding Flag}"
                              OnContent="" OffContent="" />

                <Grid IsVisible="{Binding IsChoice}" ColumnDefinitions="Auto,Auto" ColumnSpacing="6"
                      HorizontalAlignment="Left">
                    <ComboBox Classes="ActionSelect"
                              ItemsSource="{Binding Choices}"
                              SelectedItem="{Binding Option}"
                              IsEnabled="{Binding IsEnabled}"
                              Width="240" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ActionParameterOption">
                                <TextBlock Text="{Binding Display}"
                                           FontSize="12.5" Foreground="#E8E8E8" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- A control of the virtual controller says which one it is on a pad drawn
                         on screen, where the button that is meant is in the place the hand
                         already knows it in. -->
                    <Button Grid.Column="1" Classes="FlatButton" Height="33" Padding="11,0"
                            IsVisible="{Binding IsGamepadPad}"
                            Content="{Binding [Add.OpenGamepad], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.OpenGamepadHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnOpenGamepadPad" />
                </Grid>

                <!-- A variable, which may also be a whole value of its own: an operand of a
                     calculation is written here, and may be built with the expression editor. -->
                <Grid IsVisible="{Binding IsVariable}" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <AutoCompleteBox Classes="VarInput"
                                     ItemsSource="{Binding Variables}"
                                     Text="{Binding Text}"
                                     PlaceholderText="{Binding Placeholder}"
                                     MinimumPrefixLength="0"
                                     FilterMode="Contains" />
                    <Button Grid.Column="1" Classes="FlatButton" Height="33" Padding="11,0"
                            IsVisible="{Binding OffersFormula}"
                            Content="{Binding [Add.ExpressionBuilder], Source={x:Static loc:Strings.Current}}"
                            ToolTip.Tip="{Binding [Add.ExpressionBuilderHint], Source={x:Static loc:Strings.Current}}"
                            Click="OnOpenExpressionBuilder" />
                </Grid>

                <AutoCompleteBox Classes="VarInput" IsVisible="{Binding IsMacro}"
                                 ItemsSource="{Binding Macros}"
                                 Text="{Binding Text}"
                                 PlaceholderText="{Binding Placeholder}"
                                 MinimumPrefixLength="0"
                                 FilterMode="Contains" />

                <StackPanel IsVisible="{Binding IsExpression}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <AutoCompleteBox Classes="VarInput"
                                         ItemsSource="{Binding ExpressionSuggestions}"
                                         Text="{Binding Text}"
                                         PlaceholderText="{Binding Placeholder}"
                                         MinimumPrefixLength="1"
                                         FilterMode="Contains" />
                        <Button Grid.Column="1" Classes="FlatButton" Height="33" Padding="11,0"
                                Content="{Binding [Add.ExpressionBuilder], Source={x:Static loc:Strings.Current}}"
                                ToolTip.Tip="{Binding [Add.ExpressionBuilderHint], Source={x:Static loc:Strings.Current}}"
                                Click="OnOpenExpressionBuilder" />
                    </Grid>
                    <TextBlock Classes="Muted" Margin="2,5,0,0"
                               TextWrapping="Wrap"
                               Foreground="#E06C75"
                               Text="{Binding ExpressionMessage}"
                               IsVisible="{Binding ShowExpressionError}" />
                    <TextBlock Classes="Muted" Margin="2,5,0,0"
                               TextWrapping="Wrap"
                               Foreground="#7FC97F"
                               Text="{Binding ExpressionMessage}"
                               IsVisible="{Binding ShowExpressionSuccess}" />
                </StackPanel>

                <!-- The condition of the step, or the conditions a logic group combines. It stays
                     in the dialog because a condition is what the step needs rather than a step
                     of the macro; the steps inside a block are edited in the editor's own list,
                     where the block's shape can be seen. -->
                <Border Classes="NestedBox" IsVisible="{Binding IsConditionList}">
                    <StackPanel>
                        <ListBox Classes="NestedList" Height="128"
                                 ItemsSource="{Binding List.Steps}"
                                 SelectedItem="{Binding List.SelectedStep}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:MacroStep">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="12" Foreground="#E4E4E4" />
                                        <TextBlock Text="{Binding Detail}"
                                                   FontSize="11" Foreground="#9A9A9A"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,7,0,0">
                            <Button Classes="FlatButton" Height="30" Padding="10,0"
                                    Content="{Binding List.AddLabel}"
                                    Command="{Binding List.AddCommand}" />
                            <Button Classes="FlatButton" Height="30" Padding="10,0"
                                    Content="{Binding [Add.NestedEdit], Source={x:Static loc:Strings.Current}}"
                                    IsEnabled="{Binding List.CanEdit}"
                                    Command="{Binding List.EditCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- A block keeps its steps in the editor's list, where the shape they make can
                     be seen, so this dialog does not show them — but it still adds one, because
                     "this block needs another step in it" is a thing to want while its settings
                     are open. -->
                <StackPanel IsVisible="{Binding IsStepList}" Margin="2,8,0,0">
                    <TextBlock Classes="Muted" TextWrapping="Wrap" Text="{Binding StepsNote}" />
                    <Button Classes="FlatButton" Height="30" Padding="10,0" Margin="0,7,0,0"
                            HorizontalAlignment="Left"
                            Content="{Binding List.AddLabel}"
                            ToolTip.Tip="{Binding [Add.AddStepToBlockHint], Source={x:Static loc:Strings.Current}}"
                            Command="{Binding List.AddCommand}" />
                </StackPanel>

                <TextBlock Classes="Muted" Text="{Binding Hint}"
                           IsVisible="{Binding HasHint}"
                           TextWrapping="Wrap" Margin="2,5,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- One line of the parameter list. The two halves of a position share a line, and both
             the ordinary parameters and the folded-away ones are laid out with it. -->
        <DataTemplate x:Key="ParameterRowEditor" x:DataType="vm:ParameterRowViewModel">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*"
                  ColumnSpacing="16" Margin="0,0,0,14">
                <ContentControl Grid.Row="0" Grid.Column="0"
                                Grid.ColumnSpan="{Binding FirstSpan}"
                                Content="{Binding First}"
                                ContentTemplate="{StaticResource ParameterEditor}" />
                <ContentControl Grid.Row="0" Grid.Column="1"
                                Content="{Binding Second}"
                                ContentTemplate="{StaticResource ParameterEditor}"
                                IsVisible="{Binding HasSecond}" />
                <!-- A position is taken from the pointer with Alt + X, and a whole rectangle with
                     the region picker. -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="2,6,0,0" Spacing="6">
                    <TextBlock Classes="Muted" TextWrapping="Wrap"
                               IsVisible="{Binding ShowsPositionHint}"
                               Text="{Binding [Add.SharedPositionHint], Source={x:Static loc:Strings.Current}}" />
                    <Button Classes="FlatButton" Height="30" Padding="10,0"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding IsRegionAnchor}"
                            ToolTip.Tip="{Binding [Add.PickRegionHint], Source={x:Static loc:Strings.Current}}"
                            Content="{Binding [Add.PickRegion], Source={x:Static loc:Strings.Current}}"
                            Click="OnPickRegion" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- One group of the action picker: a heading that opens and closes, and the actions
             under it, laid out as a grid of cards. -->
        <DataTemplate x:Key="ActionGroup" x:DataType="vm:ActionGroupViewModel">
            <StackPanel Margin="0,0,0,2">
                <Button Classes="GroupToggle" Click="OnToggleActionGroup">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Width="10" Height="8" Stretch="Uniform" Stroke="#9A9A9A"
                              StrokeThickness="1.6" Data="{Binding Caret}" VerticalAlignment="Center" />
                        <Path Width="15" Height="15" Stretch="Uniform" Stroke="#C0C0C0"
                              StrokeThickness="1.4" Data="{Binding Icon}" VerticalAlignment="Center"
                              IsVisible="{Binding HasIcon}" />
                        <TextBlock Text="{Binding Header}" FontSize="12.5" Foreground="#E8E8E8"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Classes="Muted" Margin="22,3,10,0"
                           TextWrapping="Wrap" Text="{Binding Note}"
                           IsVisible="{Binding HasNote}" />

                <ItemsControl ItemsSource="{Binding Actions}" IsVisible="{Binding IsOpen}"
                              Margin="22,7,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ActionDefinition">
                            <Button Classes="ActionCard" Click="OnPickAction"
                                    ToolTip.Tip="{Binding LocalDescription}">
                                <TextBlock Text="{Binding LocalName}" FontSize="12" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.GroupHeader">
            <Setter Property="Foreground" Value="#C0C0C0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,16,0,9" />
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="#C8C8C8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="2,2,0,6" />
        </Style>
        <Style Selector="TextBlock.Muted">
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style Selector="Border.GroupBox">
            <Setter Property="Background" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,4,12,14" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>

        <Style Selector="ComboBox.ActionSelect">
            <Setter Property="Background" Value="#2E2E2E" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="#E4E4E4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- The fold that keeps the settings an action can live without out of the way. -->
        <Style Selector="Button.Disclosure">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#4A4A4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="#C8A165" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="30" />
        </Style>
        <Style Selector="Button.Disclosure:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2E2E2E" />
        </Style>

        <!-- The heading of one group in the action picker: quiet, and the whole width of the list. -->
        <Style Selector="Button.GroupToggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.GroupToggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2E2E2E" />
        </Style>

        <!-- One action in the picker: a card holding its name, laid out a grid to a group. -->
        <Style Selector="Button.ActionCard">
            <Setter Property="Background" Value="#2E2E2E" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="#E4E4E4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ActionCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3C3C3C" />
        </Style>

        <Style Selector="TextBox.ParamInput">
            <Setter Property="Background" Value="#2E2E2E" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="9,7" />
        </Style>

        <Style Selector="TextBox.JsonPreview">
            <Setter Property="Background" Value="#1A1A1A" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="#A9D6A9" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <!-- Nested step list shown inside structural actions such as repeat or if. -->
        <Style Selector="Border.NestedBox">
            <Setter Property="Background" Value="#242424" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="ListBox.NestedList">
            <Setter Property="Background" Value="#1C1C1C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <!-- Variable name: free text with the known variables offered as suggestions. -->
        <Style Selector="AutoCompleteBox.VarInput">
            <Setter Property="Background" Value="#2E2E2E" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="AutoCompleteBox.VarInput TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style Selector="Button.FlatButton">
            <Setter Property="Background" Value="#404040" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.FlatButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4C4C4C" />
        </Style>

        <Style Selector="Button.AddButton">
            <Setter Property="Background" Value="#C8401C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.AddButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#D9502A" />
        </Style>
        <Style Selector="Button.AddButton:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#5A3226" />
        </Style>

        <Style Selector="Button.TitleBarButton">
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.TitleBarButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A4A4A" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="38,*">

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="#202020" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                <Image Source="/Assets/WhaleGenie.png" Width="22" Height="22" Stretch="Uniform" />
                <TextBlock Text="{Binding Header}" Foreground="#E8E8E8" FontSize="13"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
                <Button Classes="TitleBarButton" Name="MinimizeButton">
                    <Path Width="10" Height="10" Stroke="White" StrokeThickness="1.6" Data="M 0,5 H 8" />
                </Button>
                <Button Classes="TitleBarButton" Name="CloseButton">
                    <Path Width="10" Height="10" Stroke="White" StrokeThickness="1.6" Data="M 1,1 L 7,7 M 1,7 L 7,1" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="14">
            <ScrollViewer Grid.Row="0" Padding="4,2,10,8" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Classes="FieldLabel"
                               Text="{Binding [Add.SelectAction], Source={x:Static loc:Strings.Current}}" />

                    <!-- The catalogue is well over a hundred actions, so it is read as a search box
                         over short groups rather than one long dropdown. -->
                    <StackPanel IsVisible="{Binding IsPickerOpen}">
                        <TextBox Classes="ParamInput" Text="{Binding ActionSearch}"
                                 AutomationProperties.Name="Search actions"
                                 PlaceholderText="{Binding [Add.SearchAction], Source={x:Static loc:Strings.Current}}" />

                        <TextBlock Classes="Muted" Margin="2,8,0,0" TextWrapping="Wrap"
                                   IsVisible="{Binding HasNoActionMatch}"
                                   Text="{Binding [Add.NoActionFound], Source={x:Static loc:Strings.Current}}" />

                        <ScrollViewer MaxHeight="196" Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ActionGroups}"
                                          ItemTemplate="{StaticResource ActionGroup}" />
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Once an action is chosen the picker folds down to the one line that names
                         it, which gives the fields the room they need. -->
                    <Grid IsVisible="{Binding !IsPickerOpen}" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding SelectedActionTitle}" FontSize="12.5"
                                   Foreground="#E8E8E8" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Classes="FlatButton" Height="30" Padding="12,0"
                                Command="{Binding OpenPickerCommand}"
                                Content="{Binding [Add.ChangeAction], Source={x:Static loc:Strings.Current}}" />
                    </Grid>

                    <StackPanel Margin="2,10,0,0" Spacing="3">
                        <!-- The key is worth reading while the picker is open; once it is folded the
                             line above already names the action, and saying it twice is noise. -->
                        <TextBlock Text="{Binding SelectedKey}" FontSize="12.5" Foreground="#E8E8E8"
                                   IsVisible="{Binding IsPickerOpen}" />
                        <TextBlock Classes="Muted" Text="{Binding Description}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Classes="GroupBox" IsVisible="{Binding HasSelection}">
                        <StackPanel>
                            <!-- Settings worth having but not worth showing on every step: where the
                                 input is sent, what a position is measured from. They stay folded
                                 so an action with a dozen parameters is not a wall of fields. The fold
                                 sits on the heading, not under the fields, because an action with that
                                 many parameters pushes anything below the list out of sight. -->
                            <Grid MinHeight="30" Margin="0,10,0,10" ColumnDefinitions="*,Auto">
                                <TextBlock Classes="GroupHeader" Margin="0"
                                           VerticalAlignment="Center"
                                           Text="{Binding [Add.Parameters], Source={x:Static loc:Strings.Current}}" />
                                <Button Grid.Column="1" Classes="Disclosure" VerticalAlignment="Center"
                                        IsVisible="{Binding HasAdvanced}"
                                        Command="{Binding ToggleAdvancedCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.6"
                                              Stroke="#C8A165" Data="{Binding AdvancedCaret}"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding AdvancedLabel}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- A block's settings are about the block, not about one thing the run
                                 does, and the two levels are what make a failure answerable at the
                                 level it belongs to. -->
                            <TextBlock Classes="Muted" TextWrapping="Wrap" Margin="2,0,0,8"
                                       IsVisible="{Binding IsBlock}"
                                       Text="{Binding [Add.BlockSettings], Source={x:Static loc:Strings.Current}}" />

                            <ItemsControl ItemsSource="{Binding Rows}"
                                          ItemTemplate="{StaticResource ParameterRowEditor}" />

                            <ItemsControl ItemsSource="{Binding AdvancedRows}"
                                          IsVisible="{Binding ShowAdvanced}"
                                          ItemTemplate="{StaticResource ParameterRowEditor}" />

                            <TextBlock Classes="Muted" IsVisible="{Binding !HasParameters}"
                                       Text="{Binding [Add.NoParameters], Source={x:Static loc:Strings.Current}}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="GroupBox">
                        <StackPanel>
                            <TextBlock Classes="GroupHeader" Margin="0,12,0,10"
                                       Text="{Binding [Add.StepSettings], Source={x:Static loc:Strings.Current}}" />

                            <TextBlock Classes="FieldLabel"
                                       Text="{Binding [Add.StepComment], Source={x:Static loc:Strings.Current}}" />
                            <TextBox Classes="ParamInput" Text="{Binding MetaComment}"
                                     PlaceholderText="{Binding [Add.StepCommentHint], Source={x:Static loc:Strings.Current}}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Add.StepTimeout], Source={x:Static loc:Strings.Current}}" />
                                    <ContentControl Content="{Binding MetaTimeout}"
                                                    ContentTemplate="{StaticResource DurationSetting}" />
                                    <TextBlock Classes="Muted" Margin="0,5,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Add.StepTimeoutHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Add.StepRetry], Source={x:Static loc:Strings.Current}}" />
                                    <NumericUpDown Value="{Binding MetaRetryCount}" Minimum="0" Maximum="20"
                                                   Increment="1" FormatString="0"
                                                   Width="150" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Add.StepRetryDelay], Source={x:Static loc:Strings.Current}}" />
                                    <ContentControl Content="{Binding MetaRetryDelay}"
                                                    ContentTemplate="{StaticResource DurationSetting}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Add.StepOnError], Source={x:Static loc:Strings.Current}}" />
                                    <ComboBox Classes="ActionSelect" ItemsSource="{Binding ErrorChoices}"
                                              SelectedItem="{Binding MetaOnError}"
                                              Width="170" HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ActionParameterOption">
                                                <TextBlock Text="{Binding Display}"
                                                           FontSize="12.5" Foreground="#E8E8E8" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Classes="FieldLabel"
                                           Text="{Binding [Add.StepBackoff], Source={x:Static loc:Strings.Current}}" />
                                <ComboBox Classes="ActionSelect" ItemsSource="{Binding BackoffChoices}"
                                          SelectedItem="{Binding MetaRetryBackoff}"
                                          Width="220" HorizontalAlignment="Left">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ActionParameterOption">
                                            <TextBlock Text="{Binding Display}"
                                                       FontSize="12.5" Foreground="#E8E8E8" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Classes="Muted" Margin="0,5,0,0" TextWrapping="Wrap"
                                           Text="{Binding [Add.StepBackoffHint], Source={x:Static loc:Strings.Current}}" />
                                <TextBlock Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="#C8A165" Text="{Binding RetryPlan}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Add.StepDelayBefore], Source={x:Static loc:Strings.Current}}" />
                                    <ContentControl Content="{Binding MetaDelayBefore}"
                                                    ContentTemplate="{StaticResource DurationSetting}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Add.StepDelayAfter], Source={x:Static loc:Strings.Current}}" />
                                    <ContentControl Content="{Binding MetaDelayAfter}"
                                                    ContentTemplate="{StaticResource DurationSetting}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                                <ToggleSwitch IsChecked="{Binding MetaEnabled}" OnContent="" OffContent="" />
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="{Binding [Add.StepEnabled], Source={x:Static loc:Strings.Current}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="GroupBox">
                        <StackPanel>
                            <TextBlock Classes="GroupHeader" Margin="0,12,0,10"
                                       Text="{Binding [Add.JsonNode], Source={x:Static loc:Strings.Current}}" />
                            <TextBox Classes="JsonPreview" Text="{Binding JsonPreview, Mode=OneWay}"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     Height="150"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Save / cancel -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="4,12,4,0">
                <!-- Nothing picked yet is not a mistake, so it stays quiet; anything else is a
                     reason the step cannot be saved and is said in red, where it is hard to miss. -->
                <TextBlock Grid.Column="0" Classes="Muted" VerticalAlignment="Center"
                           TextWrapping="Wrap" Text="{Binding ValidationMessage}"
                           IsVisible="{Binding !ValidationIsProblem}" />
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#E06C75"
                           FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="{Binding ValidationMessage}"
                           IsVisible="{Binding ValidationIsProblem}" />
                <Button Grid.Column="1" Classes="FlatButton" Height="38" MinWidth="92"
                        Content="{Binding [Add.Cancel], Source={x:Static loc:Strings.Current}}"
                        Margin="8,0,0,0" Command="{Binding CancelCommand}" />
                <Button Grid.Column="2" Classes="AddButton" Content="{Binding CommitLabel}" Height="38" MinWidth="110"
                        Margin="8,0,0,0" Command="{Binding SaveCommand}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
