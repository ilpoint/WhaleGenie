<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WhaleGenie.ViewModels"
             xmlns:loc="using:WhaleGenie.Localization"
             x:Class="WhaleGenie.Views.ActionPaletteView"
             x:DataType="vm:AddActionViewModel">


    <UserControl.Styles>
        <Style Selector="TextBlock.Muted">
            <Setter Property="Foreground" Value="{DynamicResource AppMuted}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="Button.GroupToggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.GroupToggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppField}" />
        </Style>
        <Style Selector="Button.ActionCard">
            <Setter Property="Background" Value="{DynamicResource AppField}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,5,5" />
        </Style>
        <Style Selector="Button.ActionCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Button.ActionCard.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSelected}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
        </Style>
        <Style Selector="Button.Category">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.Category:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppField}" />
        </Style>
        <Style Selector="ListBox.CategoryDock">
            <Setter Property="Background" Value="{DynamicResource AppChrome}" />
            <Setter Property="Padding" Value="3,8" />
        </Style>
        <Style Selector="ListBox.CategoryDock ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ListBox.CategoryDock ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSelected}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="54,*" Background="{DynamicResource AppSurface}">
        <Border Grid.Column="0" Background="{DynamicResource AppChrome}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Categories}" Margin="3,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActionCategoryChoice">
                            <Button Classes="Category" ToolTip.Tip="{Binding Label}"
                                    Click="OnPickCategory">
                                <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{Binding Icon}" Width="16" Height="16"
                                          Stretch="Uniform" Stroke="{Binding Accent}"
                                          StrokeThickness="1.4" />
                                    <TextBlock Text="{Binding Short}" FontSize="11"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="8,8,8,8">
            <TextBox Grid.Row="0" Text="{Binding ActionSearch}"
                     PlaceholderText="{Binding [Add.SearchAction], Source={x:Static loc:Strings.Current}}" />
            <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding VisibleActions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActionCardViewModel">
                            <Button Classes="ActionCard" Classes.selected="{Binding IsSelected}"
                                    BorderBrush="{Binding Accent}" BorderThickness="1"
                                    Click="OnPickAction"
                                    ToolTip.Tip="{Binding Definition.LocalDescription}">
                                <TextBlock Text="{Binding Definition.LocalName}" FontSize="12"
                                           HorizontalAlignment="Center" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
