<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WhaleGenie.ViewModels"
             xmlns:loc="using:WhaleGenie.Localization"
             xmlns:views="using:WhaleGenie.Views"
             x:Class="WhaleGenie.Views.ActionPaletteView"
             x:DataType="vm:ActionPaletteViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="PaletteCardButton" x:DataType="vm:ActionPaletteCardViewModel">
            <Button Classes="Secondary" Margin="0,0,6,6"
                    BorderBrush="{Binding Accent}"
                    ToolTip.Tip="{Binding Description}">
                <TextBlock Text="{Binding Title}" FontSize="13"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ListBox.List ListBoxItem">
            <Setter Property="Padding" Value="3,4" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SurfacePanel}">
        <ListBox Grid.Row="0" Name="SourceDock" Classes="List"
                 ItemsSource="{Binding Tabs}"
                 SelectedItem="{Binding SelectedTab}" SelectionMode="Single"
                 Margin="4,4,4,2">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="4" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ActionPaletteTab">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <views:IconView Width="13" Height="13" Data="{Binding Icon}"
                                        HorizontalAlignment="Center"
                                        Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.4" />
                        <TextBlock Text="{Binding Label}" FontSize="10.5" TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Name="BasicCategoryDock" Width="66"
                    IsVisible="{Binding IsBasicDock}"
                    Background="{DynamicResource SurfaceChrome}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Categories}" Margin="3,8,12,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActionCategoryChoice">
                                <Button Classes="Rail" ToolTip.Tip="{Binding Label}"
                                        Click="OnPickCategory">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <views:IconView Width="16" Height="16"
                                                        Data="{Binding Icon}"
                                                        Stroke="{Binding Accent}"
                                                        StrokeThickness="1.4" />
                                        <TextBlock Text="{Binding Short}" FontSize="11"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="8,2,8,6">
                <TextBox Grid.Row="0" Name="PaletteSearch" Margin="0,4,0,6" Text="{Binding Search}"
                         PlaceholderText="{Binding [Add.SearchAction], Source={x:Static loc:Strings.Current}}" />

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ActionPaletteSection">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Title}" FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   Margin="2,2,0,6"
                                                   IsVisible="{Binding HasTitle}" />
                                        <ItemsControl ItemsSource="{Binding Cards}"
                                                      ItemTemplate="{StaticResource PaletteCardButton}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock IsVisible="{Binding HasNoCards}" Text="{Binding EmptyText}"
                               Foreground="{DynamicResource TextTertiary}" FontSize="12"
                               TextWrapping="Wrap" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="6" Margin="8,2,8,8">
            <Button Grid.Column="0" Classes="Secondary" Height="32"
                    Grid.ColumnSpan="2"
                    IsVisible="{Binding IsSubMacroDock}"
                    Content="{Binding [Editor.AddSubMacro], Source={x:Static loc:Strings.Current}}">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="{Binding [Editor.NewSubMacro], Source={x:Static loc:Strings.Current}}"
                                  Click="OnAddBlankSubMacro" />
                        <MenuItem Header="{Binding [Editor.CopyProjectMacro], Source={x:Static loc:Strings.Current}}"
                                  Click="OnCopyProjectMacro" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button Grid.Column="1" Classes="Secondary" Height="32"
                    Grid.ColumnSpan="2"
                    IsVisible="{Binding IsPublicMacroDock}"
                    Content="{Binding [Editor.ManagePublicMacros], Source={x:Static loc:Strings.Current}}"
                    Click="OnManagePublicMacros" />
            <TextBlock Grid.ColumnSpan="2" Classes="Hint" VerticalAlignment="Center"
                       IsVisible="{Binding IsBasicDock}"
                       Text="{Binding [Editor.DragActionHint], Source={x:Static loc:Strings.Current}}"
                       TextWrapping="Wrap" />
            <TextBlock Grid.ColumnSpan="2" Classes="Hint" VerticalAlignment="Center"
                       IsVisible="{Binding IsFlowDock}"
                       Text="{Binding [Editor.DragActionHint], Source={x:Static loc:Strings.Current}}"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>
