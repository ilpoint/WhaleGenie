<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:conv="using:WhaleGenie.Converters"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
        x:Class="WhaleGenie.Views.MacroSettingsSpecificView"
        x:DataType="vm:MacroEditorViewModel">

    <Design.DataContext>
        <vm:MacroEditorViewModel />
    </Design.DataContext>

        <StackPanel Name="SpecificSettingsPage"
            IsVisible="{Binding IsSpecificSettingsPage}">
            <TextBlock Classes="Hint" TextWrapping="Wrap"
                Text="{Binding [Editor.SpecificHint], Source={x:Static loc:Strings.Current}}" />

            <Border Classes="Sunken" Margin="0,10,0,0" IsVisible="{Binding !IsSubMacro}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="FieldLabel"
                            Text="{Binding [Editor.InputLimit], Source={x:Static loc:Strings.Current}}" />
                        <views:HintInfo Text="{Binding [Common.InputLimitInfo], Source={x:Static loc:Strings.Current}}" />
                    </StackPanel>
                    <CheckBox Classes="Field" Margin="2,2,0,8"
                        Content="{Binding [Editor.InputLimitFollow], Source={x:Static loc:Strings.Current}}"
                        IsChecked="{Binding FollowProgramInputRate}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <fa:FANumberBox Name="MacroInputLimitBox" Width="120" Height="30"
                            Minimum="0" Maximum="999" SmallChange="10"
                            SimpleNumberFormat="0"
                            IsEnabled="{Binding !FollowProgramInputRate}"
                            Value="{Binding InputLimitValue}" />
                        <TextBlock Classes="Hint" VerticalAlignment="Center"
                            Text="{Binding [Settings.InputLimitUnit], Source={x:Static loc:Strings.Current}}" />
                    </StackPanel>
                    <TextBlock Classes="Hint" Margin="2,6,0,0" TextWrapping="Wrap"
                        Text="{Binding [Editor.InputLimitHint], Source={x:Static loc:Strings.Current}}" />
                </StackPanel>
            </Border>

            <Border Classes="Sunken" Margin="0,10,0,0" IsVisible="{Binding !IsSubMacro}">
                <StackPanel>
                    <TextBlock Classes="FieldLabel"
                        Text="{Binding [Editor.ToggleKey], Source={x:Static loc:Strings.Current}}" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,6,0,0">
                        <Border Background="{DynamicResource SurfaceField}"
                            BorderBrush="{DynamicResource BorderControl}"
                            BorderThickness="1" CornerRadius="5" Padding="10,7">
                            <TextBlock Classes="Note"
                                Foreground="{DynamicResource TextPrimary}"
                                TextTrimming="CharacterEllipsis"
                                Text="{Binding ToggleKeyDisplay}" />
                        </Border>
                        <Button Grid.Column="1" Classes="Secondary" Height="32" Padding="10,0"
                            Click="OnSetToggleKey"
                            Content="{Binding ToggleKeyButton}" />
                        <Button Grid.Column="2" Classes="Secondary" Height="32" Padding="10,0"
                            Command="{Binding ClearToggleKeyCommand}"
                            Content="{Binding [Settings.HotkeyClear], Source={x:Static loc:Strings.Current}}" />
                    </Grid>
                    <TextBlock Classes="Hint" Margin="2,6,0,0" TextWrapping="Wrap"
                        Text="{Binding [Editor.ToggleKeyHint], Source={x:Static loc:Strings.Current}}" />
                    <TextBlock Classes="Problem" Margin="2,4,0,0" TextWrapping="Wrap"
                        Text="{Binding ToggleKeyProblem}"
                        IsVisible="{Binding HasToggleKeyProblem}" />
                </StackPanel>
            </Border>

            <TextBlock Classes="GroupHeader" HorizontalAlignment="Center" Margin="0,16,0,9"
                Text="{Binding [Editor.MacroInterface], Source={x:Static loc:Strings.Current}}" />
            <ContentControl Name="MacroInterfaceHost" />
        </StackPanel>
</UserControl>
