<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="660"
        x:Class="WhaleGenie.Views.VariableCenterWindow"
        x:DataType="vm:VariableCenterViewModel"
        Title="Variables"
        Width="880" Height="660"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="#232323">

    <Design.DataContext>
        <vm:VariableCenterViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.Muted">
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="TextBlock.ColumnHeader">
            <Setter Property="Foreground" Value="#8A8A8A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="10,0,0,4" />
        </Style>

        <Style Selector="Border.VarRow">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <!-- Dock bar across the top of the window. -->
        <Style Selector="Button.Tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B0B0B0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.Tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2E2E2E" />
        </Style>
        <Style Selector="Button.Tab.active /template/ ContentPresenter">
            <Setter Property="Background" Value="#C8401C" />
        </Style>
        <Style Selector="Button.Tab.active">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="TextBox.VarInput">
            <Setter Property="Background" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="30" />
        </Style>

        <Style Selector="ComboBox.VarSelect">
            <Setter Property="Background" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="#E4E4E4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="30" />
        </Style>

        <Style Selector="Button.FlatButton">
            <Setter Property="Background" Value="#404040" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.FlatButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4C4C4C" />
        </Style>

        <Style Selector="Button.AddButton">
            <Setter Property="Background" Value="#C8401C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.AddButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#D9502A" />
        </Style>
        <Style Selector="Button.AddButton:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#5A3226" />
        </Style>

        <Style Selector="Button.RemoveButton">
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.RemoveButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B03A1A" />
        </Style>

        <Style Selector="Button.TitleBarButton">
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.TitleBarButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A4A4A" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="38,Auto,*,Auto">
        <!-- Title bar -->
        <Grid Grid.Row="0" Background="#202020" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                <Image Source="/Assets/WhaleGenie.png" Width="22" Height="22" Stretch="Uniform" />
                <TextBlock Text="{Binding [Variable.Title], Source={x:Static loc:Strings.Current}}"
                           Foreground="#E8E8E8" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="2" Classes="TitleBarButton" Name="CloseButton"
                    Margin="8,0" VerticalAlignment="Center">
                <Path Width="10" Height="10" Stroke="White" StrokeThickness="1.6"
                      Data="M 1,1 L 7,7 M 1,7 L 7,1" />
            </Button>
        </Grid>

        <!-- Dock bar: pick which set of variables to show -->
        <Border Grid.Row="1" Background="#1E1E1E" Padding="10,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="Tab" Classes.active="{Binding IsCurrentTab}"
                            Command="{Binding SelectTabCommand}" CommandParameter="Current"
                            Content="{Binding [Variable.Tab.Current], Source={x:Static loc:Strings.Current}}" />
                    <Button Classes="Tab" Classes.active="{Binding IsLocalTab}"
                            Command="{Binding SelectTabCommand}" CommandParameter="Local"
                            Content="{Binding [Variable.Tab.Local], Source={x:Static loc:Strings.Current}}" />
                    <Button Classes="Tab" Classes.active="{Binding IsGlobalTab}"
                            Command="{Binding SelectTabCommand}" CommandParameter="Global"
                            Content="{Binding [Variable.Tab.Global], Source={x:Static loc:Strings.Current}}" />
                    <Button Classes="Tab" Classes.active="{Binding IsSystemTab}"
                            Command="{Binding SelectTabCommand}" CommandParameter="System"
                            Content="{Binding [Variable.Tab.System], Source={x:Static loc:Strings.Current}}" />
                </StackPanel>

                <Button Grid.Column="2" Classes="FlatButton" Height="28" Padding="12,0"
                        VerticalAlignment="Center"
                        Content="{Binding [Variable.Refresh], Source={x:Static loc:Strings.Current}}"
                        Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" Padding="18,6,18,10" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Classes="Muted" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="{Binding [Variable.Note], Source={x:Static loc:Strings.Current}}" />

                <!-- ===================== Variables in use ===================== -->
                <StackPanel IsVisible="{Binding IsCurrentTab}">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                        <TextBlock Classes="Muted" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="{Binding [Variable.CurrentHint], Source={x:Static loc:Strings.Current}}" />
                        <CheckBox Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                  Foreground="#C8C8C8" FontSize="12"
                                  IsChecked="{Binding ShowSystemVariables}"
                                  Content="{Binding [Variable.ShowSystem], Source={x:Static loc:Strings.Current}}" />
                    </Grid>
                    <TextBlock Classes="Muted" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="{Binding [Variable.NoneUsed], Source={x:Static loc:Strings.Current}}"
                               IsVisible="{Binding !HasCurrentVariables}" />
                    <Grid ColumnDefinitions="170,64,110,150,*" Margin="0,10,0,0">
                        <TextBlock Classes="ColumnHeader"
                                   Text="{Binding [Variable.Name], Source={x:Static loc:Strings.Current}}" />
                        <TextBlock Grid.Column="1" Classes="ColumnHeader"
                                   Text="{Binding [Variable.Scope], Source={x:Static loc:Strings.Current}}" />
                        <TextBlock Grid.Column="2" Classes="ColumnHeader"
                                   Text="{Binding [Variable.UsedBy], Source={x:Static loc:Strings.Current}}" />
                        <TextBlock Grid.Column="3" Classes="ColumnHeader"
                                   Text="{Binding [Variable.Value], Source={x:Static loc:Strings.Current}}" />
                        <TextBlock Grid.Column="4" Classes="ColumnHeader"
                                   Text="{Binding [Variable.Description], Source={x:Static loc:Strings.Current}}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding CurrentVariables}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:VariableDefinition">
                                <Border Classes="VarRow">
                                    <Grid ColumnDefinitions="170,64,110,150,*">
                                        <TextBlock Text="{Binding Name}" Foreground="#BFE3BF"
                                                   FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                        <Border Grid.Column="1" Background="#333333" CornerRadius="3"
                                                Padding="6,2" HorizontalAlignment="Left"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding LocalScope}" Foreground="#D6C08A"
                                                       FontSize="11" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding LocalOwner}"
                                                   Foreground="#9A9A9A" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="3" Text="{Binding CurrentValue}"
                                                   Foreground="#E4C48A" FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="4" Text="{Binding LocalDescription}"
                                                   Foreground="#C8C8C8" FontSize="12" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ===================== Local variables ===================== -->
                <StackPanel IsVisible="{Binding IsLocalTab}">
                    <TextBlock Classes="Muted" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="{Binding [Variable.LocalsHint], Source={x:Static loc:Strings.Current}}" />

                    <TextBlock Classes="Muted" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="{Binding [Variable.NoLocals], Source={x:Static loc:Strings.Current}}"
                               IsVisible="{Binding !HasMacroVariables}" />

                    <ItemsControl ItemsSource="{Binding MacroVariables}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MacroVariableGroup">
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,5">
                                        <TextBlock Text="{Binding MacroName}" Foreground="#E8E8E8"
                                                   FontSize="12.5" FontWeight="SemiBold" />
                                        <Border Background="#333333" CornerRadius="3" Padding="6,2">
                                            <TextBlock Foreground="#D6C08A" FontSize="11"
                                                       Text="{Binding [Variable.Scope.Local], Source={x:Static loc:Strings.Current}}" />
                                        </Border>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Variables}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:VariableDefinition">
                                                <Border Classes="VarRow">
                                                    <Grid ColumnDefinitions="230,110,*">
                                                        <TextBlock Text="{Binding Name}" Foreground="#BFE3BF"
                                                                   FontFamily="Consolas" FontSize="12"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1" Text="{Binding CurrentValue}"
                                                                   Foreground="#9A9A9A" FontSize="12" />
                                                        <TextBlock Grid.Column="2" Text="{Binding LocalDescription}"
                                                                   Foreground="#C8C8C8" FontSize="12"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ===================== Global variables ===================== -->
                <StackPanel IsVisible="{Binding IsGlobalTab}">
                    <TextBlock Classes="Muted" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="{Binding [Variable.GlobalsHint], Source={x:Static loc:Strings.Current}}" />

                    <ItemsControl ItemsSource="{Binding Globals}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:VariableDefinition">
                               <Border Classes="VarRow">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="200,110,150,*,Auto" ColumnSpacing="8">
                                            <TextBox Classes="VarInput" Text="{Binding Name}" />
                                            <ComboBox Grid.Column="1" Classes="VarSelect"
                                                      ItemsSource="{Binding TypeOptions}"
                                                      SelectedItem="{Binding SelectedType}"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ActionParameterOption">
                                                        <TextBlock Text="{Binding Display}"
                                                                   FontSize="12.5" Foreground="#E8E8E8" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBox Grid.Column="2" Classes="VarInput" Text="{Binding DefaultValue}"
                                                     PlaceholderText="{Binding [Variable.Default], Source={x:Static loc:Strings.Current}}" />
                                            <TextBox Grid.Column="3" Classes="VarInput" Text="{Binding Description}"
                                                     PlaceholderText="{Binding [Variable.Description], Source={x:Static loc:Strings.Current}}" />
                                            <Button Grid.Column="4" Classes="RemoveButton"
                                                    Command="{Binding $parent[ItemsControl].((vm:VariableCenterViewModel)DataContext).RemoveGlobalCommand}"
                                                    CommandParameter="{Binding}">
                                                <Path Width="12" Height="12" Stroke="#E8E8E8" StrokeThickness="1.3"
                                                      Data="M 1,1 L 11,11 M 11,1 L 1,11" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Classes="Muted" Margin="2,5,0,0" TextWrapping="Wrap"
                                                   Foreground="#E06C75" Text="{Binding DefaultPreview}"
                                                   IsVisible="{Binding DefaultHasError}" />
                                        <TextBlock Classes="Muted" Margin="2,5,0,0" TextWrapping="Wrap"
                                                   Text="{Binding DefaultPreview}"
                                                   IsVisible="{Binding ShowDefaultSummary}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="Muted" Margin="0,8,0,0"
                               Text="{Binding [Variable.NoGlobals], Source={x:Static loc:Strings.Current}}"
                               IsVisible="{Binding !HasGlobals}" />

                    <StackPanel Margin="0,10,0,0">
                        <Grid ColumnDefinitions="200,110,150,*,Auto" ColumnSpacing="8">
                            <TextBox Classes="VarInput" Text="{Binding NewName}"
                                     PlaceholderText="{Binding [Variable.Name], Source={x:Static loc:Strings.Current}}" />
                            <ComboBox Grid.Column="1" Classes="VarSelect"
                                      ItemsSource="{Binding Types}" SelectedItem="{Binding NewType}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ActionParameterOption">
                                        <TextBlock Text="{Binding Display}"
                                                   FontSize="12.5" Foreground="#E8E8E8" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Grid.Column="2" Classes="VarInput" Text="{Binding NewDefault}"
                                     PlaceholderText="{Binding [Variable.Default], Source={x:Static loc:Strings.Current}}" />
                            <TextBox Grid.Column="3" Classes="VarInput" Text="{Binding NewDescription}"
                                     PlaceholderText="{Binding [Variable.Description], Source={x:Static loc:Strings.Current}}" />
                            <Button Grid.Column="4" Classes="AddButton" Height="30"
                                    Content="{Binding [Variable.Add], Source={x:Static loc:Strings.Current}}"
                                    Command="{Binding AddGlobalCommand}" />
                        </Grid>
                        <TextBlock Classes="Muted" Margin="2,5,0,0" TextWrapping="Wrap"
                                   Foreground="#E06C75" Text="{Binding NewDefaultPreview}"
                                   IsVisible="{Binding NewDefaultHasError}" />
                        <TextBlock Classes="Muted" Margin="2,5,0,0" TextWrapping="Wrap"
                                   Text="{Binding NewDefaultPreview}"
                                   IsVisible="{Binding ShowNewDefaultSummary}" />
                    </StackPanel>
                    <TextBlock Classes="Muted" Margin="2,6,0,0" TextWrapping="Wrap"
                               Text="{Binding ValidationMessage}" />
                </StackPanel>

                <!-- ===================== System variables ===================== -->
                <StackPanel IsVisible="{Binding IsSystemTab}">
                    <TextBlock Classes="Muted" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="{Binding [Variable.SystemHint], Source={x:Static loc:Strings.Current}}" />
                    <Grid ColumnDefinitions="210,70,170,*" Margin="0,10,0,0">
                        <TextBlock Classes="ColumnHeader"
                                   Text="{Binding [Variable.Name], Source={x:Static loc:Strings.Current}}" />
                        <TextBlock Grid.Column="1" Classes="ColumnHeader"
                                   Text="{Binding [Variable.Type], Source={x:Static loc:Strings.Current}}" />
                        <TextBlock Grid.Column="2" Classes="ColumnHeader"
                                   Text="{Binding [Variable.Value], Source={x:Static loc:Strings.Current}}" />
                        <TextBlock Grid.Column="3" Classes="ColumnHeader"
                                   Text="{Binding [Variable.Description], Source={x:Static loc:Strings.Current}}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding SystemVariables}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:VariableDefinition">
                                <Border Classes="VarRow">
                                    <Grid ColumnDefinitions="210,70,170,*">
                                        <TextBlock Text="{Binding Name}" Foreground="#BFE3BF"
                                                   FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding LocalType}"
                                                   Foreground="#9A9A9A" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="{Binding CurrentValue}"
                                                   Foreground="#E4C48A" FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="3" Text="{Binding LocalDescription}"
                                                   Foreground="#C8C8C8" FontSize="12" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="3" Classes="FlatButton" Height="36" MinWidth="92"
                HorizontalAlignment="Right" Margin="18,0,18,16" Name="DoneButton"
                Content="{Binding [Variable.Close], Source={x:Static loc:Strings.Current}}" />
    </Grid>
</Window>
