<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:conv="using:WhaleGenie.Converters"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="680"
        x:Class="WhaleGenie.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/WhaleGenie.ico"
        Title="{Binding WindowTitle}"
        Width="480" Height="680"
        MinWidth="360" MinHeight="480"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource AppBackdrop}">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <!-- Switched-off macros fade their details, while the status dot stays readable. -->
        <conv:BoolToOpacityConverter x:Key="CardOpacity" On="1" Off="0.45" />
        <!-- Paints the colour chip a colour-triggered macro shows on its card. -->
        <conv:HexColorToBrushConverter x:Key="HexBrush" />
    </Window.Resources>

    <Window.Styles>
        <!-- Custom title bar buttons -->
        <Style Selector="Button.TitleBarButton">
            <Setter Property="Background" Value="{DynamicResource AppControl}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.TitleBarButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Button.TitleBarButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppMuted}" />
        </Style>
        <Style Selector="Button.TitleBarButton.Active /template/ ContentPresenter">
            <Setter Property="Background" Value="#2E7D5A" />
        </Style>

        <!-- Top-right round tool buttons -->
        <Style Selector="Button.ToolButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppMuted}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ToolButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppBorder}" />
        </Style>

        <!-- Tool button that carries a label next to its icon -->
        <Style Selector="Button.LabeledToolButton">
            <Setter Property="Background" Value="{DynamicResource AppControl}" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.LabeledToolButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppBorder}" />
        </Style>
        <Style Selector="Button.LabeledToolButton.Active /template/ ContentPresenter">
            <Setter Property="Background" Value="#2E7D5A" />
        </Style>

        <!-- The always-on-top switch lights up while it is holding the window above the rest. -->
        <Style Selector="Button.TitleBarButton.Pinned /template/ ContentPresenter">
            <Setter Property="Background" Value="#2E5F8A" />
        </Style>
        <Style Selector="Button.TitleBarButton.Pinned:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A719E" />
        </Style>

        <!-- Bottom buttons -->
        <Style Selector="Button.BottomButton">
            <Setter Property="Background" Value="{DynamicResource AppControl}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.BottomButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppBorder}" />
        </Style>

        <!-- Macro card action buttons -->
        <Style Selector="Button.CardButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppMuted}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.CardButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppBorder}" />
        </Style>

        <Style Selector="Button.DockButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppMuted}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="4,7" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.DockButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Button.DockButton.On">
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="BorderBrush" Value="#4EA4E8" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="36,30,*,Auto">

        <!-- ============ Custom title bar ============ -->
        <Grid Grid.Row="0" Background="{DynamicResource AppChrome}" ColumnDefinitions="Auto,*,Auto">
            <Image Source="/Assets/WhaleGenie.png" Width="22" Height="22" Stretch="Uniform"
                   Margin="8,5" VerticalAlignment="Center" HorizontalAlignment="Left" />

            <TextBlock Grid.Column="1" Foreground="{DynamicResource AppText}" FontSize="13"
                       Text="{Binding WindowTitle}"
                       VerticalAlignment="Center" Margin="4,0" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
                <Button Classes="TitleBarButton" Name="ThemeButton"
                        ToolTip.Tip="{Binding [Main.Theme], Source={x:Static loc:Strings.Current}}"
                        Click="OnToggleTheme">
                    <views:IconView Width="12" Height="12" Stroke="{DynamicResource AppText}" StrokeThickness="1.3" FitToBounds="True" Data="{x:Static models:AppIcons.Sun}" />
                </Button>                <Button Classes="TitleBarButton" Name="AlwaysOnTopButton"
                        ToolTip.Tip="{Binding [Main.AlwaysOnTop], Source={x:Static loc:Strings.Current}}">
                    <!-- Pushpin: outline so the needle shows, unlike the filled PathIcon glyphs. -->
                    <views:IconView Width="11" Height="11" Stroke="{DynamicResource AppText}" StrokeThickness="1.2" FitToBounds="True" Data="{x:Static models:AppIcons.Pin}" />
                </Button>
                <Button Classes="TitleBarButton" Name="HelpButton" Content="?" FontWeight="Bold"
                        FontSize="13"
                        ToolTip.Tip="{Binding [Main.About], Source={x:Static loc:Strings.Current}}"
                        Click="OnAboutClicked" />
                <Button Classes="TitleBarButton" Name="MinimizeButton">
                    <views:IconView Width="10" Height="10" Stroke="{DynamicResource AppText}" StrokeThickness="1.2" FitToBounds="True" Data="{x:Static models:AppIcons.Minus}" />
                </Button>
                <Button Classes="TitleBarButton" Name="CloseButton">
                    <views:IconView Width="10" Height="10" Stroke="{DynamicResource AppText}" StrokeThickness="1.2" FitToBounds="True" Data="{x:Static models:AppIcons.X}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ Menu bar ============ -->
        <Grid Grid.Row="1" Background="{DynamicResource AppBackdrop}" ColumnDefinitions="Auto,Auto,*,Auto">
            <Menu Background="Transparent" VerticalAlignment="Center" Margin="4,0">
                <MenuItem Header="{Binding [Main.File], Source={x:Static loc:Strings.Current}}"
                          FontSize="13" Foreground="{DynamicResource AppText}" Padding="10,4">
                    <MenuItem Header="{Binding [Main.OpenProject], Source={x:Static loc:Strings.Current}}"
                              Click="OnOpenProjectClicked">
                        <MenuItem.Icon>
                            <views:IconView Width="15" Height="15" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.Folder}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding [Main.SaveProject], Source={x:Static loc:Strings.Current}}"
                              Click="OnSaveProjectClicked">
                        <MenuItem.Icon>
                            <views:IconView Width="15" Height="15" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.Save}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding [Main.SaveProjectAs], Source={x:Static loc:Strings.Current}}"
                              Click="OnSaveProjectAsClicked">
                        <MenuItem.Icon>
                            <views:IconView Width="15" Height="15" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.FilePlus}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding [Main.ImportProject], Source={x:Static loc:Strings.Current}}"
                              Click="OnImportProjectClicked">
                        <MenuItem.Icon>
                            <views:IconView Width="15" Height="15" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.Download}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding [Main.OpenCurrentLocation], Source={x:Static loc:Strings.Current}}"
                              Click="OnOpenLocationClicked">
                        <MenuItem.Icon>
                            <views:IconView Width="15" Height="15" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.Search}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding [Main.ReloadCurrent], Source={x:Static loc:Strings.Current}}"
                              Click="OnReloadCurrentClicked">
                        <MenuItem.Icon>
                            <views:IconView Width="15" Height="15" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.Reload}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding [Main.OpenDirectory], Source={x:Static loc:Strings.Current}}"
                              Click="OnOpenDirectoryClicked">
                        <MenuItem.Icon>
                            <views:IconView Width="15" Height="15" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.FolderOpen}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding [Main.CloseAll], Source={x:Static loc:Strings.Current}}"
                              Click="OnCloseAllClicked">
                        <MenuItem.Icon>
                            <views:IconView Width="15" Height="15" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.Trash}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{Binding [Main.Exit], Source={x:Static loc:Strings.Current}}"
                              Click="OnExitClicked">
                        <MenuItem.Icon>
                            <views:IconView Width="15" Height="15" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.X}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="{Binding [Main.Help], Source={x:Static loc:Strings.Current}}"
                          FontSize="13" Foreground="{DynamicResource AppText}" Padding="10,4">
                    <MenuItem Header="{Binding [Main.Settings], Source={x:Static loc:Strings.Current}}"
                              Click="OnSettingsClicked">
                        <MenuItem.Icon>
                            <views:IconView Width="15" Height="15" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.Settings}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding [Main.WhatsNew], Source={x:Static loc:Strings.Current}}"
                              Click="OnWhatsNewClicked">
                        <MenuItem.Icon>
                            <views:IconView Width="15" Height="15" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.Sparkle}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding [Main.Updates], Source={x:Static loc:Strings.Current}}"
                              Click="OnUpdatesClicked">
                        <MenuItem.Icon>
                            <views:IconView Width="15" Height="15" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.Reload}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding [Main.Feedback], Source={x:Static loc:Strings.Current}}"
                              Click="OnFeedbackClicked">
                        <MenuItem.Icon>
                            <views:IconView Width="15" Height="15" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.Message}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding [Main.GetStarted], Source={x:Static loc:Strings.Current}}"
                              Click="OnGetStartedClicked">
                        <MenuItem.Icon>
                            <views:IconView Width="15" Height="15" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.QuestionMark}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding [Main.About], Source={x:Static loc:Strings.Current}}"
                              Click="OnAboutClicked">
                        <MenuItem.Icon>
                            <views:IconView Width="15" Height="15" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.Info}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </Menu>

            <StackPanel Grid.Column="1" Spacing="8" Orientation="Horizontal" Margin="8,0"
                        VerticalAlignment="Center">
                <Border Width="1" Height="14" Background="{DynamicResource AppBorder}" />
                <TextBlock Name="VersionText" Text="{Binding Version}"
                           Foreground="{DynamicResource AppMuted}" FontSize="12"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" Margin="12,0" VerticalAlignment="Center">
                <Button Classes="LabeledToolButton" Name="McpButton"
                        Classes.Active="{Binding Mcp.IsRunning}"
                        Click="OnMcpClicked"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{Binding [Main.McpHint], Source={x:Static loc:Strings.Current}}">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <Border Background="{DynamicResource AppSurface}" CornerRadius="6"
                                    Padding="12" Width="360">
                                <StackPanel Spacing="8">
                                    <TextBlock FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppText}"
                                               Text="{Binding [Mcp.Title], Source={x:Static loc:Strings.Current}}" />
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock FontSize="12.5" Foreground="{DynamicResource AppText}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding [Mcp.Enable], Source={x:Static loc:Strings.Current}}" />
                                        <ToggleSwitch Name="McpToggle"
                                                      IsChecked="{Binding Mcp.IsRunning, Mode=OneWay}"
                                                      Command="{Binding Mcp.ToggleCommand}"
                                                      OnContent="{Binding [Mcp.SwitchOn], Source={x:Static loc:Strings.Current}}"
                                                      OffContent="{Binding [Mcp.SwitchOff], Source={x:Static loc:Strings.Current}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                                IsEnabled="{Binding Mcp.IsRunning}">
                                        <TextBlock FontSize="12.5" Foreground="{DynamicResource AppText}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding [Mcp.Control], Source={x:Static loc:Strings.Current}}" />
                                        <ToggleSwitch Name="McpControlToggle"
                                                      IsChecked="{Binding Mcp.AllowControl, Mode=OneWay}"
                                                      Command="{Binding Mcp.ToggleControlCommand}"
                                                      OnContent="{Binding [Mcp.SwitchOn], Source={x:Static loc:Strings.Current}}"
                                                      OffContent="{Binding [Mcp.SwitchOff], Source={x:Static loc:Strings.Current}}" />
                                    </StackPanel>
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource AppMuted}"
                                               TextWrapping="Wrap"
                                               Text="{Binding [Mcp.ControlHint], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource AppMuted}"
                                               Text="{Binding Mcp.Status}" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource AppText}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding [Mcp.Port], Source={x:Static loc:Strings.Current}}" />
                                        <views:NumberBox Grid.Column="1" Width="110" Height="30"
                                                         Value="{Binding Mcp.Port}"
                                                         Minimum="1024" Maximum="65535" Increment="1"
                                                         FormatString="0"
                                                         IsEnabled="{Binding !Mcp.IsRunning}" />
                                    </Grid>
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource AppMuted}"
                                               TextWrapping="Wrap"
                                               Text="{Binding [Mcp.PortHint], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource AppMuted}"
                                               Text="{Binding [Mcp.Endpoint], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock FontFamily="Consolas" FontSize="11.5"
                                               Foreground="{DynamicResource AppText}"
                                               TextWrapping="Wrap"
                                               Text="{Binding Mcp.Endpoint}" />
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource AppMuted}"
                                               TextWrapping="Wrap"
                                               Text="{Binding [Mcp.Note], Source={x:Static loc:Strings.Current}}" />
                                    <Button Classes="FlatButton" Height="28" Padding="10,0"
                                            HorizontalAlignment="Left"
                                            Click="OnCopyMcpConfig"
                                            Content="{Binding [Mcp.CopyConfig], Source={x:Static loc:Strings.Current}}" />
                                    <!-- What the client did to this machine is a question the person
                                         asks afterwards, so the record is one click away rather than
                                         something to go looking for in a folder. -->
                                    <Button Classes="FlatButton" Height="28" Padding="10,0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding Mcp.OpenAuditCommand}"
                                            ToolTip.Tip="{Binding [Mcp.OpenAuditHint], Source={x:Static loc:Strings.Current}}"
                                            Content="{Binding [Mcp.OpenAudit], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <views:IconView Width="14" Height="14" Stroke="{DynamicResource AppMuted}"
                                        StrokeThickness="1.4" FitToBounds="True"
                                        Data="{x:Static models:AppIcons.Sparkle}" />
                        <TextBlock FontSize="12.5" Foreground="{DynamicResource AppText}"
                                   VerticalAlignment="Center"
                                   Text="{Binding [Main.Mcp], Source={x:Static loc:Strings.Current}}" />
                    </StackPanel>
                </Button>
                <Button Classes="LabeledToolButton" Name="RunDebugButton"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{Binding [Main.RunDebug], Source={x:Static loc:Strings.Current}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <views:IconView Width="14" Height="14" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.BugPlay}" />
                        <TextBlock FontSize="12.5" Foreground="{DynamicResource AppText}" VerticalAlignment="Center"
                                   Text="{Binding [Main.RunDebug], Source={x:Static loc:Strings.Current}}" />
                    </StackPanel>
                </Button>
                <Button Classes="ToolButton" Name="SettingsButton"
                        ToolTip.Tip="{Binding [Main.Settings], Source={x:Static loc:Strings.Current}}">
                    <views:IconView Width="14" Height="14" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.Settings}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ Main content ============ -->
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" Margin="14,10">
            <!-- Trigger dock -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="2"
                  Margin="0,0,0,8">
                <Button Grid.Column="0" Classes="DockButton" Classes.On="{Binding IsKeysDock}"
                        Command="{Binding SelectDockCommand}" CommandParameter="Keys"
                        Content="{Binding [Main.Dock.Keys], Source={x:Static loc:Strings.Current}}" />
                <Button Grid.Column="1" Classes="DockButton" Classes.On="{Binding IsInterfaceDock}"
                        Command="{Binding SelectDockCommand}" CommandParameter="Interface"
                        Content="{Binding [Main.Dock.Interface], Source={x:Static loc:Strings.Current}}" />
                <Button Grid.Column="2" Classes="DockButton" Classes.On="{Binding IsHotstringDock}"
                        Command="{Binding SelectDockCommand}" CommandParameter="Hotstring"
                        Content="{Binding [Main.Dock.Hotstring], Source={x:Static loc:Strings.Current}}" />
                <Button Grid.Column="3" Classes="DockButton" Classes.On="{Binding IsMenuDock}"
                        Command="{Binding SelectDockCommand}" CommandParameter="Menu"
                        Content="{Binding [Main.Dock.Menu], Source={x:Static loc:Strings.Current}}" />
                <Button Grid.Column="4" Classes="DockButton" Classes.On="{Binding IsOtherDock}"
                        Command="{Binding SelectDockCommand}" CommandParameter="Other"
                        Content="{Binding [Main.Dock.Other], Source={x:Static loc:Strings.Current}}" />
            </Grid>

            <!-- Search box -->
            <TextBox Grid.Row="1" Text="{Binding SearchText}"
                     PlaceholderText="{Binding [Main.SearchPlaceholder], Source={x:Static loc:Strings.Current}}"
                     Background="{DynamicResource AppDock}" BorderBrush="{DynamicResource AppDock}"
                     Foreground="{DynamicResource AppText}" FontSize="13"
                     CornerRadius="4" Padding="10,7" />

            <!-- Macro list -->
            <ScrollViewer Grid.Row="2" Name="MacroListScroll" Margin="0,10,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl Name="MacroList" ItemsSource="{Binding VisibleMacros}"
                              VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="0" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:MacroItem">
                        <Border Background="{DynamicResource AppDock}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <!-- The same three things the card's own buttons do, where a right click
                                 goes looking for them. -->
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding [Main.RunDebug], Source={x:Static loc:Strings.Current}}"
                                              Click="OnDebugMacroClicked" />
                                    <MenuItem Header="{Binding [Main.EditTip], Source={x:Static loc:Strings.Current}}"
                                              Click="OnEditMacroClicked" />
                                    <MenuItem Header="{Binding [Main.DeleteTip], Source={x:Static loc:Strings.Current}}"
                                              Click="OnDeleteMacroClicked" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid RowDefinitions="Auto,Auto">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Panel Width="9" Height="9" VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" Fill="#3FBF57"
                                                     IsVisible="{Binding IsEnabled}" />
                                            <Ellipse Width="9" Height="9" Fill="#D8451B"
                                                     IsVisible="{Binding !IsEnabled}" />
                                        </Panel>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppText}" FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <!-- Shows while a trigger is running this macro -->
                                        <Border IsVisible="{Binding IsRunning}" Background="#1E4529"
                                                BorderBrush="#3FBF57" BorderThickness="1"
                                                CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock FontSize="10.5" Foreground="#8CE7A3"
                                                       Text="{Binding [Main.MacroRunning], Source={x:Static loc:Strings.Current}}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Name="MacroRunDebugButton" Classes="CardButton"
                                                ToolTip.Tip="{Binding [Main.RunDebug], Source={x:Static loc:Strings.Current}}"
                                                Click="OnDebugMacroClicked">
                                            <views:IconView Width="12" Height="13" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.3" FitToBounds="True" Data="{x:Static models:AppIcons.BugPlay}" />
                                        </Button>
                                        <Button Classes="CardButton"
                                                ToolTip.Tip="{Binding [Main.EditTip], Source={x:Static loc:Strings.Current}}"
                                                Click="OnEditMacroClicked">
                                            <views:IconView Width="13" Height="13" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.3" FitToBounds="True" Data="{x:Static models:AppIcons.Pencil}" />
                                        </Button>
                                        <Button Classes="CardButton"
                                                ToolTip.Tip="{Binding [Main.DeleteTip], Source={x:Static loc:Strings.Current}}"
                                                Click="OnDeleteMacroClicked">
                                            <views:IconView Width="13" Height="13" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.3" FitToBounds="True" Data="{x:Static models:AppIcons.Trash}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1" Background="{DynamicResource AppDock}" CornerRadius="4" Margin="0,8,0,0"
                                        Padding="12,9"
                                        Opacity="{Binding IsEnabled, Converter={StaticResource CardOpacity}}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <!-- One badge for the entry set: a macro may now have several. -->
                                        <Border Grid.Column="0" Background="{DynamicResource AppHover}" CornerRadius="4"
                                                Width="28" Height="28" VerticalAlignment="Center">
                                            <Panel>
                                                <views:IconView Width="15" Height="15" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.GridFour}" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock FontSize="12.5" Foreground="{DynamicResource AppText}"
                                                       TextWrapping="Wrap" MaxLines="2"
                                                       Text="{Binding TriggerSummaries}" />
                                            <TextBlock FontSize="11.5" Foreground="{DynamicResource AppMuted}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Action}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state, shown until the first macro is added -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="5"
                        IsVisible="{Binding !HasMacros}" IsHitTestVisible="False">
                <TextBlock Text="{Binding [Main.EmptyTitle], Source={x:Static loc:Strings.Current}}"
                           Foreground="{DynamicResource AppMuted}" FontSize="13" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding [Main.EmptyHint], Source={x:Static loc:Strings.Current}}"
                           Foreground="{DynamicResource AppMuted}" FontSize="11.5" HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>

            <!-- What the search box did, when there are macros but none of them match -->
            <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                       IsVisible="{Binding HasNoMatch}"
                       IsHitTestVisible="False"
                       Text="{Binding [Main.NoMatch], Source={x:Static loc:Strings.Current}}"
                       Foreground="{DynamicResource AppMuted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
        </Grid>

        <!-- ============ Bottom buttons ============ -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="24,0,24,18">
            <Button Grid.Column="0" Classes="BottomButton" Height="52"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding ToggleRunCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SystemLabel}" FontSize="12" Foreground="White" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource AppMuted}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Text="{Binding SystemHint}" />
                    </StackPanel>
                    <Border BorderBrush="White" BorderThickness="2" CornerRadius="6" Padding="5,3" VerticalAlignment="Center">
                        <Panel Width="14" Height="14">
                            <views:IconView Width="14" Height="14" IsVisible="{Binding !IsRunning}" Stroke="White" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.Play}" />
                            <views:IconView Width="14" Height="14" IsVisible="{Binding IsRunning}" Stroke="White" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.Pause}" />
                        </Panel>
                    </Border>
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Classes="BottomButton" Height="52" Name="AddMacroButton"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock FontSize="13" Foreground="White" VerticalAlignment="Center"
                               Text="{Binding [Main.AddMacro], Source={x:Static loc:Strings.Current}}" />
                    <!-- Same outlined badge as the run button beside it, so the two read as a pair. -->
                    <Border BorderBrush="White" BorderThickness="2" CornerRadius="6" Padding="5,3"
                            VerticalAlignment="Center">
                        <views:IconView Width="14" Height="14" Stroke="White" StrokeThickness="1.4" FitToBounds="True" Data="{x:Static models:AppIcons.Plus}" />
                    </Border>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
