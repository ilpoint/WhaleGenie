<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="230"
        x:Class="WhaleGenie.Views.TextPromptDialog"
        x:DataType="vm:TextPromptViewModel"
        Title="WhaleGenie"
        Width="460" Height="{Binding WindowHeight}"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource SurfaceWindow}">

    <Design.DataContext>
        <vm:TextPromptViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="38,*">
        <Grid Grid.Row="0" Background="{DynamicResource SurfaceChrome}" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                <Image Source="/Assets/WhaleGenie.png" Width="22" Height="22" Stretch="Uniform" />
                <TextBlock Classes="Title" Text="{Binding Header}" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="2" Classes="Caption Close" Name="CloseButton"
                    Margin="8,0" VerticalAlignment="Center">
                <views:IconView Width="10" Height="10" StrokeThickness="1.2" FitToBounds="True" Data="{x:Static vm:AppIcons.X}" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Margin="20,16,20,20">
            <ScrollViewer Grid.Row="0" MaxHeight="140" VerticalScrollBarVisibility="Auto">
                <TextBlock Classes="Body" Text="{Binding Question}" />
            </ScrollViewer>

            <TextBox Grid.Row="1" Name="AnswerBox" Classes="Field" Margin="0,12,0,0"
                     VerticalAlignment="Top" Text="{Binding Answer}" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Classes="Primary" Content="{Binding OkText}" MinWidth="92"
                        Command="{Binding OkCommand}" />
                <Button Classes="Secondary" Content="{Binding CancelText}" MinWidth="92"
                        Command="{Binding CancelCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
