<views:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="520"
        x:Class="WhaleGenie.Views.WindowPickerWindow"
        x:DataType="vm:WindowPickerViewModel"
        Title="WhaleGenie"
        Width="560" Height="520"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceWindow}">

    <Window.Styles>

        <!-- 选中用实心强调底（`#C8401C` 就是 `AccentFill` 本身，零变化），压过 `List` 的
             `AccentSurface`：这一列是"挑一个窗口"，选中的那一条要一眼认出来。 -->
        <Style Selector="ListBox.List.Boxed ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFill}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Title bar -->
        <!-- What the list is narrowed down to -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="16,14,16,0">
            <TextBox Classes="Field" Name="FilterBox"
                     Text="{Binding Filter}"
                     PlaceholderText="{Binding [WindowPicker.Filter], Source={x:Static loc:Strings.Current}}" />
            <Button Grid.Column="1" Classes="Secondary" Height="34" MinWidth="76"
                    Content="{Binding [WindowPicker.Refresh], Source={x:Static loc:Strings.Current}}"
                    ToolTip.Tip="{Binding [WindowPicker.RefreshHint], Source={x:Static loc:Strings.Current}}"
                    Command="{Binding ReloadCommand}" />
        </Grid>

        <!-- The windows that are open -->
        <Grid Grid.Row="1" Margin="16,10,16,0">
            <ListBox Classes="List Boxed" Name="WindowList"
                     ItemsSource="{Binding Windows}"
                     SelectedItem="{Binding Selected}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:WindowEntry">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{Binding EmptyMessage}" FontSize="12.5" Foreground="{DynamicResource TextTertiary}"
                       TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                       IsVisible="{Binding !HasWindows}" />
        </Grid>

        <!-- What the choice means, then the buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="16,12,16,16" ColumnSpacing="8">
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11.5"
                       Foreground="{DynamicResource TextTertiary}" MaxWidth="280"
                       Text="{Binding MatchHint}" />
            <Button Grid.Column="1" Classes="Secondary" Height="36" MinWidth="92"
                    Content="{Binding [Add.Cancel], Source={x:Static loc:Strings.Current}}"
                    Command="{Binding CancelCommand}" />
            <Button Grid.Column="2" Classes="Primary" Height="36" MinWidth="120"
                    Content="{Binding [WindowPicker.Choose], Source={x:Static loc:Strings.Current}}"
                    Command="{Binding ChooseCommand}" />
        </Grid>
    </Grid>
</views:AppWindow>
