<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="560"
        x:Class="WhaleGenie.Views.OffsetPickerWindow"
        Title="WhaleGenie"
        Width="600" Height="560"
        MinWidth="440" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource SurfaceWindow}">

    <Window.Styles>
    </Window.Styles>

    <Border Background="{DynamicResource SurfaceWindow}" CornerRadius="8">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- title bar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="14,8,10,8">
                <Image Source="/Assets/WhaleGenie.png" Width="22" Height="22" Stretch="Uniform"
                       VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="13" Foreground="{DynamicResource TextPrimary}"
                           Text="{Binding [Offset.Title], Source={x:Static loc:Strings.Current}}" />
                <Button Grid.Column="2" Classes="Chrome Icon Wide Quiet" Content="✕" Click="OnCancel" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="16,0,16,10" Spacing="3">
                <TextBlock Classes="Hint" TextWrapping="Wrap"
                           Text="{Binding [Offset.Hint], Source={x:Static loc:Strings.Current}}" />
                <TextBlock Name="PointText" FontSize="12" Foreground="#E0B080" />
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceWindow}" CornerRadius="6" Margin="16,0,16,10"
                    ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Canvas Name="Board" Background="{DynamicResource SurfaceWindow}" HorizontalAlignment="Left"
                            VerticalAlignment="Top" PointerPressed="OnPickPoint" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="16,0,16,14">
                <TextBlock Name="Status" VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" />
                <Button Grid.Column="1" Classes="Primary" IsEnabled="False" Name="Confirm"
                        Content="{Binding [Common.Ok], Source={x:Static loc:Strings.Current}}"
                        Click="OnConfirm" />
            </Grid>
        </Grid>
    </Border>
</Window>
