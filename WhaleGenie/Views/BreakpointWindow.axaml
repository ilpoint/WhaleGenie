<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:loc="using:WhaleGenie.Localization"
        x:Class="WhaleGenie.Views.BreakpointWindow"
        x:DataType="vm:BreakpointViewModel"
        Title="{Binding [Run.BreakpointTitle], Source={x:Static loc:Strings.Current}}"
        Width="460" SizeToContent="Height"
        MinWidth="380"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource AppBackdrop}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly">

    <Window.Styles>
        <Style Selector="TextBlock.Field">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
        </Style>
        <Style Selector="TextBlock.Muted">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource AppMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource AppBackdrop}" CornerRadius="8">
        <StackPanel Margin="18,14,18,16" Spacing="12">

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding [Run.BreakpointTitle], Source={x:Static loc:Strings.Current}}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppText}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="FlatButton" Height="26" Padding="10,0" FontSize="11.5"
                        Content="{Binding [Run.BreakpointClear], Source={x:Static loc:Strings.Current}}"
                        Command="{Binding ClearCommand}" />
            </Grid>

            <StackPanel Spacing="6">
                <TextBlock Classes="Field"
                           Text="{Binding [Run.BreakpointWhenLabel], Source={x:Static loc:Strings.Current}}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Name="ExpressionBox" Text="{Binding Expression}" FontSize="12.5"
                             Watermark="{Binding [Run.BreakpointExpressionWatermark], Source={x:Static loc:Strings.Current}}" />
                    <ComboBox Grid.Column="1" Name="VariablePicker" MinWidth="130" FontSize="12"
                              ItemsSource="{Binding Variables}"
                              SelectedItem="{Binding ChosenVariable}"
                              PlaceholderText="{Binding [Run.BreakpointInsertVariable], Source={x:Static loc:Strings.Current}}" />
                </Grid>
                <TextBlock Classes="Muted"
                           Text="{Binding [Run.BreakpointExpressionHint], Source={x:Static loc:Strings.Current}}" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Classes="Field"
                           Text="{Binding [Run.BreakpointHitsLabel], Source={x:Static loc:Strings.Current}}" />
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                    <NumericUpDown Name="HitsBox" Value="{Binding HitTimes}" Minimum="1" Maximum="1000000"
                                   Increment="1" FormatString="0" FontSize="12.5" Width="130" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource AppMuted}"
                               Text="{Binding [Run.BreakpointHitsUnit], Source={x:Static loc:Strings.Current}}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="Muted"
                               Margin="4,0,0,0"
                               Text="{Binding [Run.BreakpointHitsHint], Source={x:Static loc:Strings.Current}}" />
                </Grid>
            </StackPanel>

            <TextBlock Classes="Muted"
                       Text="{Binding [Run.BreakpointNote], Source={x:Static loc:Strings.Current}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="FlatButton" Height="30"
                        Content="{Binding [Run.BreakpointCancel], Source={x:Static loc:Strings.Current}}"
                        Command="{Binding CancelCommand}" />
                <Button Classes="PrimaryButton" Height="30"
                        Content="{Binding [Run.BreakpointSave], Source={x:Static loc:Strings.Current}}"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
