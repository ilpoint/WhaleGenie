<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="670"
        x:Class="WhaleGenie.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="480" Height="720"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="#232323">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="#C8C8C8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="2,2,0,6" />
        </Style>
        <Style Selector="TextBlock.Muted">
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="ComboBox.LanguageSelect">
            <Setter Property="Background" Value="#2E2E2E" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="#E4E4E4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Width" Value="200" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.FlatButton">
            <Setter Property="Background" Value="#404040" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.FlatButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4C4C4C" />
        </Style>
        <Style Selector="Button.TitleBarButton">
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.TitleBarButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A4A4A" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="38,*,Auto">
        <Grid Grid.Row="0" Background="#202020" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                <Image Source="/Assets/WhaleGenie.png" Width="22" Height="22" Stretch="Uniform" />
                <TextBlock Text="{Binding [Settings.Title], Source={x:Static loc:Strings.Current}}"
                           Foreground="#E8E8E8" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="2" Classes="TitleBarButton" Name="CloseButton"
                    Margin="8,0" VerticalAlignment="Center">
                <Path Width="10" Height="10" Stroke="White" StrokeThickness="1.6"
                      Data="M 1,1 L 7,7 M 1,7 L 7,1" />
            </Button>
        </Grid>

        <!--
          The settings grew a block at a time into a window that is sized by hand, and the wording
          is longer in one language than in the other. The column scrolls instead: what is below the
          edge and cannot be scrolled to is text nobody can read.
        -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Name="SettingsPanel" Margin="20,18,20,0">
                <TextBlock Classes="FieldLabel"
                           Text="{Binding [Settings.Language], Source={x:Static loc:Strings.Current}}" />
                <ComboBox Classes="LanguageSelect"
                          ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage}" />
                <TextBlock Classes="Muted" Margin="2,7,0,0"
                           Text="{Binding [Settings.LanguageHint], Source={x:Static loc:Strings.Current}}" />

                <CheckBox Margin="2,18,0,0" Foreground="#C8C8C8" FontSize="12.5"
                          IsChecked="{Binding FailureScreenshot}"
                          Content="{Binding [Settings.FailureScreenshot], Source={x:Static loc:Strings.Current}}" />
                <TextBlock Classes="Muted" Margin="2,7,0,0" TextWrapping="Wrap"
                           Text="{Binding [Settings.FailureScreenshotHint], Source={x:Static loc:Strings.Current}}" />

                <TextBlock Classes="FieldLabel" Margin="2,18,0,6"
                           Text="{Binding [Settings.Driver], Source={x:Static loc:Strings.Current}}" />
                <TextBlock Classes="Muted" Margin="2,0,0,0" TextWrapping="Wrap" Foreground="#E0A84A"
                           Text="{Binding DriverStatus}" IsVisible="{Binding !DriverReady}" />
                <TextBlock Classes="Muted" Margin="2,0,0,0" TextWrapping="Wrap" Foreground="#7BC17B"
                           Text="{Binding DriverStatus}" IsVisible="{Binding DriverReady}" />
                <Button Classes="FlatButton" Name="DriverInstallButton" Height="32"
                        HorizontalAlignment="Left" Margin="2,10,0,0"
                        Click="OnInstallDriverClicked"
                        Content="{Binding [Settings.DriverInstall], Source={x:Static loc:Strings.Current}}" />
                <TextBlock Classes="Muted" Margin="2,8,0,0" TextWrapping="Wrap"
                           Text="{Binding [Settings.DriverHint], Source={x:Static loc:Strings.Current}}" />

                <TextBlock Classes="FieldLabel" Margin="2,18,0,6"
                           Text="{Binding [Settings.Server], Source={x:Static loc:Strings.Current}}" />
                <TextBlock Classes="Muted" Margin="2,0,0,0" TextWrapping="Wrap" Foreground="#E0A84A"
                           Text="{Binding ServerStatus}" IsVisible="{Binding !ServerAnswering}" />
                <TextBlock Classes="Muted" Margin="2,0,0,0" TextWrapping="Wrap" Foreground="#7BC17B"
                           Text="{Binding ServerStatus}" IsVisible="{Binding ServerAnswering}" />
                <TextBlock Classes="Muted" Margin="2,4,0,0" TextWrapping="Wrap" Foreground="#A8C8E8"
                           Text="{Binding ViiperPath}" IsVisible="{Binding HasViiperPath}" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,10,0,0">
                    <Button Classes="FlatButton" Name="ServerDownloadButton" Height="32"
                            Click="OnDownloadViiperClicked"
                            Content="{Binding [Settings.ServerDownload], Source={x:Static loc:Strings.Current}}" />
                    <Button Classes="FlatButton" Name="ServerChooseButton" Height="32"
                            Click="OnChooseViiperClicked"
                            Content="{Binding [Settings.ServerChoose], Source={x:Static loc:Strings.Current}}" />
                </StackPanel>
                <TextBlock Classes="Muted" Margin="2,8,0,0" TextWrapping="Wrap"
                           Text="{Binding [Settings.ServerHint], Source={x:Static loc:Strings.Current}}" />

                <TextBlock Classes="Muted" Margin="2,16,0,0" TextWrapping="Wrap"
                           Text="{Binding [Settings.Note], Source={x:Static loc:Strings.Current}}" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Classes="FlatButton" Height="36" MinWidth="92"
                HorizontalAlignment="Right" Margin="20,0,20,18" Name="DoneButton"
                Content="{Binding [Settings.Close], Source={x:Static loc:Strings.Current}}" />
    </Grid>
</Window>
