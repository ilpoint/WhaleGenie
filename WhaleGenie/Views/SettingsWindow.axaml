<views:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        x:Class="WhaleGenie.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="940" Height="740"
        MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceWindow}">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <!--
      Three groups named at the top of the window, and the pages of the one that is open listed on
      the left, the way Windows 11 settings are laid out. The groups used to be headings inside the
      one list, which left the reader working out which heading a page was under; a tab says it
      before the list is read. Page panels switch on IsVisible because they share one scroll area,
      which keeps a page's scroll position while another is looked at.
    -->
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2" Margin="20,10,20,0">
            <Button Classes="Tab Root" Tag="System" Click="OnRootTabClicked"
                    Classes.selected="{Binding IsSystemRoot}"
                    Content="{Binding [Settings.Root.System], Source={x:Static loc:Strings.Current}}" />
            <Button Classes="Tab Root" Tag="Triggers" Click="OnRootTabClicked"
                    Classes.selected="{Binding IsTriggersRoot}"
                    Content="{Binding [Settings.Root.Triggers], Source={x:Static loc:Strings.Current}}" />
            <Button Classes="Tab Root" Tag="Appearance" Click="OnRootTabClicked"
                    Classes.selected="{Binding IsAppearanceRoot}"
                    Content="{Binding [Settings.Root.Appearance], Source={x:Static loc:Strings.Current}}" />
        </StackPanel>

        <fa:FANavigationView Grid.Row="1" Name="Nav" Margin="6,0,6,0"
                            PaneDisplayMode="Left"
                            ExpandedModeThresholdWidth="0"
                            CompactModeThresholdWidth="0"
                            OpenPaneLength="212"
                            IsPaneToggleButtonVisible="False"
                            IsBackButtonVisible="False"
                            IsSettingsVisible="False"
                            SelectionChanged="OnNavSelectionChanged">
            <!--
              Every page is listed here and the window shows the ones that belong to the open group.
              The list itself is never rebuilt: taking items out of it leaves the panel's selection
              pointing at an item it no longer holds.
            -->
            <fa:FANavigationView.MenuItems>
                <fa:FANavigationViewItem Name="GeneralNavItem" Tag="General"
                                        Content="{Binding [Settings.Nav.General], Source={x:Static loc:Strings.Current}}" />
                <fa:FANavigationViewItem Name="HotkeysNavItem" Tag="Hotkeys"
                                        Content="{Binding [Settings.Nav.Hotkeys], Source={x:Static loc:Strings.Current}}" />
                <fa:FANavigationViewItem Name="ScreenNavItem" Tag="Screen"
                                        Content="{Binding [Settings.Nav.Screen], Source={x:Static loc:Strings.Current}}" />
                <fa:FANavigationViewItem Name="InputNavItem" Tag="Input"
                                        Content="{Binding [Settings.Nav.Input], Source={x:Static loc:Strings.Current}}" />
                <fa:FANavigationViewItem Name="DevicesNavItem" Tag="Devices"
                                        Content="{Binding [Settings.Nav.Devices], Source={x:Static loc:Strings.Current}}" />
                <fa:FANavigationViewItem Name="MenuLauncherNavItem" Tag="MenuLauncher"
                                        Content="{Binding [Settings.Nav.MenuLauncher], Source={x:Static loc:Strings.Current}}" />
                <fa:FANavigationViewItem Name="WindowRulesNavItem" Tag="WindowRules"
                                        Content="{Binding [Settings.Nav.WindowRules], Source={x:Static loc:Strings.Current}}" />
                <fa:FANavigationViewItem Name="WheelMenuNavItem" Tag="WheelMenu"
                                        Content="{Binding [Settings.Nav.WheelMenu], Source={x:Static loc:Strings.Current}}" />
                <fa:FANavigationViewItem Name="WheelActionsNavItem" Tag="WheelActions"
                                        Content="{Binding [Settings.Nav.WheelActions], Source={x:Static loc:Strings.Current}}" />
                <fa:FANavigationViewItem Name="ThemeNavItem" Tag="Theme"
                                        Content="{Binding [Settings.Nav.Theme], Source={x:Static loc:Strings.Current}}" />
            </fa:FANavigationView.MenuItems>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,2">
                <StackPanel Name="SettingsPanel" Margin="4,6,16,18" Spacing="10">

                    <!-- ── 通用 ─────────────────────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsGeneralPage}" Spacing="10">
                        <fa:FASettingsExpander Header="{Binding [Settings.GeneralCard], Source={x:Static loc:Strings.Current}}"
                                               IsExpanded="True">
                            <fa:FASettingsExpanderItem>
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Settings.Language], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.LanguageHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <ComboBox Classes="Field" Width="180" ItemsSource="{Binding Languages}"
                                              SelectedItem="{Binding SelectedLanguage}" />
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>

                            <fa:FASettingsExpanderItem Name="LoadLastProjectCheck">
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Settings.LoadLastProject], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.LoadLastProjectHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch OnContent="" OffContent=""
                                                  IsChecked="{Binding LoadLastProjectAtStart}" />
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>

                            <fa:FASettingsExpanderItem Name="SystemAtStartCheck">
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Settings.SystemAtStart], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.SystemAtStartHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch OnContent="" OffContent=""
                                                  IsChecked="{Binding SystemAtStart}" />
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>

                            <fa:FASettingsExpanderItem Name="EnabledFirstCheck">
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Settings.EnabledFirst], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.EnabledFirstHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch OnContent="" OffContent=""
                                                  IsChecked="{Binding EnabledFirst}" />
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>
                        </fa:FASettingsExpander>

                        <!-- 东西都放在哪儿：写在窗口里而不是只写在手册里，"我的 macros.assets 去哪了"
                             是这扇窗该直接回答的问题。每一行都能打开所在文件夹。 -->
                        <fa:FASettingsExpander Header="{Binding [Settings.Storage], Source={x:Static loc:Strings.Current}}"
                                               IsExpanded="True">
                            <fa:FASettingsExpanderItem>
                                <StackPanel>
                                    <TextBlock Classes="Hint" TextWrapping="Wrap"
                                               Text="{Binding [Settings.StorageHint], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Name="StorageProblem" Classes="Hint" Margin="0,6,0,0"
                                               IsVisible="False" TextWrapping="Wrap"
                                               Text="{Binding [Settings.StorageProblem], Source={x:Static loc:Strings.Current}}"
                                               Foreground="{DynamicResource Warning}" />

                                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding StorageRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StorageRow">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <TextBlock FontSize="12.5" Foreground="{DynamicResource TextPrimary}"
                                                                   Text="{Binding Name}" />
                                                        <TextBlock Classes="Hint" Margin="0,2,0,0" TextWrapping="Wrap"
                                                                   Text="{Binding What}" />
                                                        <TextBlock Classes="Mono" FontSize="11.5" Margin="0,3,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextTertiary}"
                                                                   Text="{Binding Where}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Classes="Secondary" Height="28"
                                                            Padding="10,0" VerticalAlignment="Center"
                                                            Tag="{Binding Folder}"
                                                            Click="OnOpenStorage"
                                                            Content="{Binding [Settings.OpenFolder], Source={x:Static loc:Strings.Current}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </fa:FASettingsExpanderItem>

                            <!-- 日志只留最近的那些：一个文件一次失败、一天一次 MCP，攒上一年谁也不会翻。 -->
                            <fa:FASettingsExpanderItem Name="LogCountBox">
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Settings.LogCount], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.LogCountHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <fa:FANumberBox Width="120" Minimum="1" Maximum="999" SmallChange="10"
                                                        SimpleNumberFormat="0" Value="{Binding LogCount}" />
                                        <TextBlock Classes="Hint" VerticalAlignment="Center"
                                                   Text="{Binding [Settings.LogCountUnit], Source={x:Static loc:Strings.Current}}" />
                                    </StackPanel>
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>
                        </fa:FASettingsExpander>
                    </StackPanel>

                    <!-- ── 快捷键与声音 ─────────────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsHotkeysPage}" Spacing="10">
                        <fa:FASettingsExpander Header="{Binding [Settings.Hotkeys], Source={x:Static loc:Strings.Current}}"
                                               IsExpanded="True">
                            <fa:FASettingsExpanderItem>
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Settings.SystemHotkey], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.HotkeyHint], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Warning}"
                                               Text="{Binding SystemHotkeyProblem}"
                                               IsVisible="{Binding SystemHotkeyProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="Note" MinWidth="90" VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   Text="{Binding SystemHotkeyDisplay}" />
                                        <Button Classes="Secondary" Height="30" Name="CaptureSystemHotkeyButton"
                                                Content="{Binding SystemHotkeyButton}" />
                                        <Button Classes="Secondary" Height="30" Name="ClearSystemHotkeyButton"
                                                Content="{Binding [Settings.HotkeyClear], Source={x:Static loc:Strings.Current}}" />
                                    </StackPanel>
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>

                            <fa:FASettingsExpanderItem>
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Settings.RecordStopKey], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.RecordStopHint], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Warning}"
                                               Text="{Binding RecordStopProblem}"
                                               IsVisible="{Binding RecordStopProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="Note" MinWidth="90" VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   Text="{Binding RecordStopDisplay}" />
                                        <Button Name="CaptureRecordStopButton" Classes="Secondary" Height="30"
                                                Content="{Binding RecordStopButton}" />
                                    </StackPanel>
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>
                        </fa:FASettingsExpander>

                        <fa:FASettingsExpander Header="{Binding [Settings.Sounds], Source={x:Static loc:Strings.Current}}"
                                               IsExpanded="True">
                            <fa:FASettingsExpanderItem Name="SoundSystemCheck">
                                <TextBlock Classes="FieldLabel"
                                           Text="{Binding [Settings.SoundSystem], Source={x:Static loc:Strings.Current}}" />
                                <fa:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch OnContent="" OffContent=""
                                                  IsChecked="{Binding SoundSystem}" />
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>

                            <fa:FASettingsExpanderItem Name="SoundMacroCheck">
                                <TextBlock Classes="FieldLabel"
                                           Text="{Binding [Settings.SoundMacro], Source={x:Static loc:Strings.Current}}" />
                                <fa:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch OnContent="" OffContent=""
                                                  IsChecked="{Binding SoundMacro}" />
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>
                        </fa:FASettingsExpander>
                    </StackPanel>

                    <!-- ── 屏幕捕获 ─────────────────────────────────────────── -->
                    <!-- 「怎么看」与「多久看一次」在同一页：调取帧频率时要看的是同一张画面。 -->
                    <StackPanel IsVisible="{Binding IsScreenPage}" Spacing="10">
                        <fa:FASettingsExpander Header="{Binding [Settings.Reading], Source={x:Static loc:Strings.Current}}"
                                               IsExpanded="True">
                            <fa:FASettingsExpanderItem>
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Settings.CaptureWindow], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.CaptureWindowHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <ComboBox Classes="Field" Width="200" ItemsSource="{Binding WindowWays}"
                                              SelectedItem="{Binding SelectedWindowWay}" />
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>

                            <fa:FASettingsExpanderItem>
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Settings.CaptureScreen], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.CaptureScreenHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <ComboBox Classes="Field" Width="200" ItemsSource="{Binding ScreenWays}"
                                              SelectedItem="{Binding SelectedScreenWay}" />
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>

                            <fa:FASettingsExpanderItem>
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Settings.PreloadOcr], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.PreloadOcrHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch Name="PreloadOcrCheck" OnContent="" OffContent=""
                                                  IsChecked="{Binding PreloadOcr}" />
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>
                        </fa:FASettingsExpander>

                        <fa:FASettingsExpander Header="{Binding [Settings.FramesCard], Source={x:Static loc:Strings.Current}}"
                                               IsExpanded="True">
                            <fa:FASettingsExpanderItem Name="FrameRateFollowCheck">
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Settings.FrameRate], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.FrameRateHint], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Note" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Text="{Binding FrameRateNote}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <StackPanel Spacing="8" HorizontalAlignment="Right">
                                        <ToggleSwitch OnContent="" OffContent=""
                                                      Content="{Binding [Settings.FrameRateFollow], Source={x:Static loc:Strings.Current}}"
                                                      IsChecked="{Binding FrameRateFollow}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsEnabled="{Binding FrameRateEnabled}">
                                            <fa:FANumberBox Name="FrameRateBox" Width="110"
                                                            Minimum="1" Maximum="{Binding FastestRate}"
                                                            SmallChange="5" SimpleNumberFormat="0"
                                                            Value="{Binding FrameRate}" />
                                            <TextBlock Classes="Hint" VerticalAlignment="Center"
                                                       Text="{Binding [Settings.FrameRateUnit], Source={x:Static loc:Strings.Current}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>

                            <fa:FASettingsExpanderItem Name="FrameCacheCheck">
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Settings.FrameCache], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.FrameCacheHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch OnContent="" OffContent=""
                                                  IsChecked="{Binding FrameCache}" />
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>

                            <fa:FASettingsExpanderItem Name="FrameCacheAgeRow">
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Settings.FrameCacheAge], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.FrameCacheAgeHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                IsEnabled="{Binding FrameCacheAgeEnabled}">
                                        <fa:FANumberBox Name="FrameCacheAgeBoxValue" Width="110"
                                                        Minimum="0" Maximum="1000" SmallChange="50"
                                                        SimpleNumberFormat="0" Value="{Binding FrameCacheAge}" />
                                        <TextBlock Classes="Hint" VerticalAlignment="Center"
                                                   Text="{Binding [Settings.FrameCacheAgeUnit], Source={x:Static loc:Strings.Current}}" />
                                    </StackPanel>
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>
                        </fa:FASettingsExpander>
                    </StackPanel>

                    <!-- ── 输入 ─────────────────────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsInputPage}" Spacing="10">
                        <fa:FASettingsExpander Header="{Binding [Settings.InputCard], Source={x:Static loc:Strings.Current}}"
                                               IsExpanded="True">
                            <fa:FASettingsExpanderItem Name="InputLimitBox">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="FieldLabel"
                                                   Text="{Binding [Settings.InputLimit], Source={x:Static loc:Strings.Current}}" />
                                        <views:HintInfo Text="{Binding [Common.InputLimitInfo], Source={x:Static loc:Strings.Current}}" />
                                    </StackPanel>
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.InputLimitHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <fa:FANumberBox Width="120" Minimum="0" Maximum="999" SmallChange="10"
                                                        SimpleNumberFormat="0" Value="{Binding InputRate}" />
                                        <TextBlock Classes="Hint" VerticalAlignment="Center"
                                                   Text="{Binding [Settings.InputLimitUnit], Source={x:Static loc:Strings.Current}}" />
                                    </StackPanel>
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>

                            <fa:FASettingsExpanderItem Name="IgnoreOwnInputCheck">
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Settings.IgnoreOwnInput], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.IgnoreOwnInputHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch OnContent="" OffContent=""
                                                  IsChecked="{Binding IgnoreOwnInput}" />
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>
                        </fa:FASettingsExpander>
                    </StackPanel>

                    <!-- ── 设备与权限 ───────────────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsDevicesPage}" Spacing="10">
                        <fa:FASettingsExpander Header="{Binding [Settings.Driver], Source={x:Static loc:Strings.Current}}"
                                               IsExpanded="True">
                            <fa:FASettingsExpanderItem>
                                <StackPanel>
                                    <TextBlock Classes="Hint" TextWrapping="Wrap"
                                               Text="{Binding DriverStatus}" IsVisible="{Binding !DriverReady}" />
                                    <TextBlock Classes="Hint" TextWrapping="Wrap" Foreground="{DynamicResource Success}"
                                               Text="{Binding DriverStatus}" IsVisible="{Binding DriverReady}" />
                                    <TextBlock Classes="Hint" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.DriverHint], Source={x:Static loc:Strings.Current}}" />
                                    <Button Classes="Secondary" Name="DriverInstallButton" Height="32"
                                            HorizontalAlignment="Left" Margin="0,10,0,0"
                                            Click="OnInstallDriverClicked"
                                            Content="{Binding [Settings.DriverInstall], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                            </fa:FASettingsExpanderItem>

                            <fa:FASettingsExpanderItem Name="DriverAttachCheck">
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Settings.DriverAttachAtStart], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.DriverAttachAtStartHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch OnContent="" OffContent=""
                                                  IsChecked="{Binding AttachDriverAtStart}" />
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>
                        </fa:FASettingsExpander>

                        <fa:FASettingsExpander Header="{Binding [Settings.Admin], Source={x:Static loc:Strings.Current}}"
                                               IsExpanded="True">
                            <fa:FASettingsExpanderItem>
                                <StackPanel>
                                    <TextBlock Classes="Hint" TextWrapping="Wrap"
                                               Text="{Binding AdminStatus}" IsVisible="{Binding !IsElevated}" />
                                    <TextBlock Classes="Hint" TextWrapping="Wrap" Foreground="{DynamicResource Success}"
                                               Text="{Binding AdminStatus}" IsVisible="{Binding IsElevated}" />
                                </StackPanel>
                            </fa:FASettingsExpanderItem>

                            <fa:FASettingsExpanderItem Name="RunAsAdminCheck">
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Settings.RunAsAdmin], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.RunAsAdminHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch OnContent="" OffContent=""
                                                  IsChecked="{Binding RunAsAdmin}" />
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>

                            <fa:FASettingsExpanderItem>
                                <Button Classes="Secondary" Name="AdminRestartButton" Height="32"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding !IsElevated}"
                                        Click="OnRestartElevatedClicked"
                                        Content="{Binding [Settings.AdminRestart], Source={x:Static loc:Strings.Current}}" />
                            </fa:FASettingsExpanderItem>
                        </fa:FASettingsExpander>
                    </StackPanel>

                    <!-- ── 菜单呼出 ─────────────────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsMenuLauncherPage}" Spacing="10">
                        <fa:FASettingsExpander Header="{Binding [Settings.MenuLauncher], Source={x:Static loc:Strings.Current}}"
                                               IsExpanded="True">
                            <fa:FASettingsExpanderItem>
                                <StackPanel>
                                    <TextBlock Classes="Hint" TextWrapping="Wrap"
                                               Text="{Binding MenuLauncherStatus}" />
                <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding [Settings.MenuLauncherHint], Source={x:Static loc:Strings.Current}}" />
                <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,8,0,0">
                    <CheckBox Classes="Field" IsChecked="{Binding MenuLauncherMiddle}"
                              Content="{Binding [Settings.MiddleButton], Source={x:Static loc:Strings.Current}}" />
                    <CheckBox Classes="Field" IsChecked="{Binding MenuLauncherCustom}"
                              Content="{Binding [Settings.CustomKey], Source={x:Static loc:Strings.Current}}" />
                </StackPanel>
            </StackPanel>
            <fa:FASettingsExpanderItem.Footer>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="Note" MinWidth="90" VerticalAlignment="Center"
                               TextAlignment="Right" Text="{Binding MenuLauncherDisplay}" />
                                        <Button Name="CaptureMenuLauncherButton" Classes="Secondary" Height="30"
                                                Content="{Binding MenuLauncherButton}" />
                                        <Button Name="ClearMenuLauncherButton" Classes="Secondary" Height="30"
                                                Content="{Binding [Settings.HotkeyClear], Source={x:Static loc:Strings.Current}}" />
                                    </StackPanel>
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>
                        </fa:FASettingsExpander>
                    </StackPanel>

                    <!-- ── 窗口规则 ─────────────────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsWindowRulesPage}" Spacing="10">
                        <fa:FASettingsExpander Header="{Binding [Settings.MenuWindowRules], Source={x:Static loc:Strings.Current}}"
                                               IsExpanded="True">
                            <fa:FASettingsExpanderItem IsEnabled="{Binding HasProject}">
                                <StackPanel>
                                    <ListBox Name="MenuRuleList" ItemsSource="{Binding MenuRules}" Height="230">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MenuRuleRow">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="4,3">
                                                    <TextBlock Text="{Binding Summary}" FontSize="12.5"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding PageCountLabel}"
                                                               FontSize="10.5" Foreground="{DynamicResource TextTertiary}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding [Settings.MenuRuleDefault], Source={x:Static loc:Strings.Current}}"
                                                               FontSize="10.5" Foreground="{DynamicResource TextTertiary}"
                                                               IsVisible="{Binding IsDefault}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                                        <Button Name="AddMenuRuleButton" Classes="Secondary" Height="30"
                                                Click="OnAddMenuRule"
                                                Content="{Binding [Settings.MenuRuleAdd], Source={x:Static loc:Strings.Current}}" />
                                        <Button Name="EditMenuRuleButton" Classes="Secondary" Height="30"
                                                Click="OnEditMenuRule"
                                                Content="{Binding [Settings.MenuRuleEdit], Source={x:Static loc:Strings.Current}}" />
                                        <Button Name="RemoveMenuRuleButton" Classes="Secondary" Height="30"
                                                Click="OnRemoveMenuRule"
                                                Content="{Binding [Settings.MenuRuleRemove], Source={x:Static loc:Strings.Current}}" />
                                        <Button Name="AddMenuRulePageButton" Classes="Secondary" Height="30"
                                                Click="OnAddMenuRulePage"
                                                Content="{Binding [Settings.MenuRuleAddPage], Source={x:Static loc:Strings.Current}}" />
                                        <Button Classes="Secondary" Height="30" Click="OnMoveMenuRuleUp"
                                                Content="{Binding [Settings.MenuRuleUp], Source={x:Static loc:Strings.Current}}" />
                                        <Button Classes="Secondary" Height="30" Click="OnMoveMenuRuleDown"
                                                Content="{Binding [Settings.MenuRuleDown], Source={x:Static loc:Strings.Current}}" />
                                    </StackPanel>
                                    <TextBlock Classes="Hint" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Warning}"
                                               Text="{Binding MenuRuleProblem}" />
                                    <TextBlock Classes="Hint" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.MenuRuleHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                            </fa:FASettingsExpanderItem>
                        </fa:FASettingsExpander>
                    </StackPanel>

                    <!-- ── 轮盘菜单 ─────────────────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsWheelMenuPage}" Spacing="10">
                        <fa:FASettingsExpander Header="{Binding [Settings.WheelTitle], Source={x:Static loc:Strings.Current}}"
                                               IsExpanded="True">
                            <fa:FASettingsExpanderItem>
                                <StackPanel>
                                    <TextBlock Classes="Hint" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Warning}"
                                               Text="{Binding WheelLauncherStatus}" />
                                    <Button Name="EnableSystemButton" Classes="Secondary" Height="30"
                                            HorizontalAlignment="Left" Margin="0,8,0,0"
                                            IsVisible="{Binding IsSystemOff}" Click="OnEnableSystem"
                                            Content="{Binding [Settings.WheelEnableSystem], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="FieldLabel" Margin="0,10,0,0"
                                               Text="{Binding [Settings.WheelLauncher], Source={x:Static loc:Strings.Current}}" />
                                    <ComboBox Classes="Field" Width="200" Margin="0,6,0,0"
                                              HorizontalAlignment="Left"
                                              ItemsSource="{Binding WheelLauncherChoices}"
                                              SelectedItem="{Binding SelectedWheelLauncher}" />
                                    <TextBlock Classes="Hint" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.WheelGestureHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                            </fa:FASettingsExpanderItem>

                            <fa:FASettingsExpanderItem>
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Settings.WheelEnabled], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.WheelEnabledHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding WheelEnabled}" />
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>

                            <fa:FASettingsExpanderItem>
                                <StackPanel>
                                    <CheckBox Name="OnlyInProgramsCheck" Classes="Field"
                                              IsChecked="{Binding OnlyInPrograms}"
                                              Content="{Binding [Settings.WheelOnlyInPrograms], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.WheelOnlyInProgramsHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                            </fa:FASettingsExpanderItem>

                            <fa:FASettingsExpanderItem>
                                <StackPanel>
                                    <TextBlock Classes="FieldLabel"
                                               Text="{Binding [Settings.WheelSize], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding [Settings.WheelSizeHint], Source={x:Static loc:Strings.Current}}" />
                                </StackPanel>
                                <fa:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <fa:FANumberBox Width="120" Minimum="150" Maximum="600" SmallChange="10"
                                                        SimpleNumberFormat="0" Value="{Binding WheelDiameter}" />
                                        <TextBlock Classes="Hint" VerticalAlignment="Center"
                                                   Text="{Binding [Settings.WheelSizeUnit], Source={x:Static loc:Strings.Current}}" />
                                    </StackPanel>
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>

        <fa:FASettingsExpanderItem>
            <StackPanel>
                <TextBlock Classes="FieldLabel"
                           Text="{Binding [Settings.WheelTextSize], Source={x:Static loc:Strings.Current}}" />
                <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding [Settings.WheelTextSizeHint], Source={x:Static loc:Strings.Current}}" />
            </StackPanel>
            <fa:FASettingsExpanderItem.Footer>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <fa:FANumberBox Width="120" Minimum="8" Maximum="24" SmallChange="1"
                                    SimpleNumberFormat="0" Value="{Binding WheelFontSize}" />
                    <TextBlock Classes="Hint" VerticalAlignment="Center"
                               Text="{Binding [Settings.WheelSizeUnit], Source={x:Static loc:Strings.Current}}" />
                </StackPanel>
            </fa:FASettingsExpanderItem.Footer>
        </fa:FASettingsExpanderItem>

        <fa:FASettingsExpanderItem>
            <StackPanel>
                <TextBlock Classes="FieldLabel"
                           Text="{Binding [Settings.WheelThird], Source={x:Static loc:Strings.Current}}" />
                <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding [Settings.WheelThirdHint], Source={x:Static loc:Strings.Current}}" />
            </StackPanel>
            <fa:FASettingsExpanderItem.Footer>
                <ComboBox Classes="Field" Width="180" ItemsSource="{Binding ThirdCapacityOptions}"
                          SelectedItem="{Binding SelectedThirdCapacity}" />
            </fa:FASettingsExpanderItem.Footer>
        </fa:FASettingsExpanderItem>

        <fa:FASettingsExpanderItem>
            <StackPanel>
                <TextBlock Classes="FieldLabel"
                           Text="{Binding [Settings.WheelLayout], Source={x:Static loc:Strings.Current}}" />
                <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding [Settings.WheelLayoutHint], Source={x:Static loc:Strings.Current}}" />
                <WrapPanel Margin="0,8,0,0" ItemWidth="220" ItemHeight="30">
                    <CheckBox Classes="Field" IsChecked="{Binding WideOuter}"
                              Content="{Binding [Settings.WheelWideOuter], Source={x:Static loc:Strings.Current}}" />
                    <CheckBox Classes="Field" IsChecked="{Binding HideEmptyOuter}"
                              Content="{Binding [Settings.WheelHideEmptyOuter], Source={x:Static loc:Strings.Current}}" />
                    <CheckBox Classes="Field" IsChecked="{Binding HideWheelLabelWithIcon}"
                              Content="{Binding [Settings.WheelIconOnly], Source={x:Static loc:Strings.Current}}" />
                    <CheckBox Classes="Field" IsChecked="{Binding CenterName}"
                              Content="{Binding [Settings.WheelCenterName], Source={x:Static loc:Strings.Current}}" />
                </WrapPanel>
            </StackPanel>
        </fa:FASettingsExpanderItem>

        <fa:FASettingsExpanderItem>
            <StackPanel>
                <TextBlock Classes="FieldLabel"
                           Text="{Binding [Settings.WheelTimeout], Source={x:Static loc:Strings.Current}}" />
                <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding [Settings.WheelTimeoutHint], Source={x:Static loc:Strings.Current}}" />
            </StackPanel>
            <fa:FASettingsExpanderItem.Footer>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <fa:FANumberBox Width="140" Minimum="0" Maximum="120000" SmallChange="1000"
                                    SimpleNumberFormat="0" Value="{Binding WheelTimeoutMs}" />
                    <TextBlock Classes="Hint" VerticalAlignment="Center"
                               Text="{Binding [Settings.WheelTimeoutUnit], Source={x:Static loc:Strings.Current}}" />
                </StackPanel>
            </fa:FASettingsExpanderItem.Footer>
        </fa:FASettingsExpanderItem>

        <fa:FASettingsExpanderItem>
            <StackPanel>
                <TextBlock Classes="FieldLabel"
                           Text="{Binding [Settings.WheelRepeat], Source={x:Static loc:Strings.Current}}" />
                <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding [Settings.WheelRepeatHint], Source={x:Static loc:Strings.Current}}" />
            </StackPanel>
            <fa:FASettingsExpanderItem.Footer>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="Note" MinWidth="70" VerticalAlignment="Center"
                               TextAlignment="Right" Text="{Binding WheelRepeatKey}" />
                    <Button Tag="HotkeyButton" Classes="Secondary" Height="30"
                            Click="OnCaptureWheelRepeat"
                            Content="{Binding WheelRepeatButton}" />
                </StackPanel>
            </fa:FASettingsExpanderItem.Footer>
        </fa:FASettingsExpanderItem>

        <fa:FASettingsExpanderItem>
            <StackPanel>
                <TextBlock Classes="FieldLabel"
                           Text="{Binding [Settings.WheelBehaviour], Source={x:Static loc:Strings.Current}}" />
                <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding [Settings.WheelBehaviourHint], Source={x:Static loc:Strings.Current}}" />
                <WrapPanel Margin="0,8,0,0" ItemWidth="220" ItemHeight="30">
                    <CheckBox Classes="Field" IsChecked="{Binding ClampToScreen}"
                              Content="{Binding [Settings.WheelClamp], Source={x:Static loc:Strings.Current}}" />
                    <CheckBox Classes="Field" IsChecked="{Binding MovePointerToCenter}"
                              Content="{Binding [Settings.WheelMovePointer], Source={x:Static loc:Strings.Current}}" />
                    <CheckBox Classes="Field" IsChecked="{Binding ShowGuide}"
                              Content="{Binding [Settings.WheelGuide], Source={x:Static loc:Strings.Current}}" />
                    <CheckBox Classes="Field" IsChecked="{Binding ExtendedHint}"
                              Content="{Binding [Settings.WheelExtendedHint], Source={x:Static loc:Strings.Current}}" />
                </WrapPanel>
            </StackPanel>
        </fa:FASettingsExpanderItem>

        <fa:FASettingsExpanderItem>
            <StackPanel>
                <TextBlock Classes="FieldLabel"
                           Text="{Binding [Settings.WheelAppearance], Source={x:Static loc:Strings.Current}}" />
                <TextBlock Classes="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding [Settings.WheelAppearanceHint], Source={x:Static loc:Strings.Current}}" />
                <WrapPanel Margin="0,8,0,0" ItemWidth="220" ItemHeight="30">
                    <CheckBox Classes="Field" IsChecked="{Binding FollowTheme}"
                              Content="{Binding [Settings.WheelFollowTheme], Source={x:Static loc:Strings.Current}}" />
                    <CheckBox Classes="Field" IsChecked="{Binding Gloss}"
                              Content="{Binding [Settings.WheelGloss], Source={x:Static loc:Strings.Current}}" />
                    <CheckBox Classes="Field" IsChecked="{Binding HoverBorder}"
                              Content="{Binding [Settings.WheelHoverBorder], Source={x:Static loc:Strings.Current}}" />
                    <CheckBox Classes="Field" IsChecked="{Binding PopAnimation}"
                              Content="{Binding [Settings.WheelPopAnimation], Source={x:Static loc:Strings.Current}}" />
                </WrapPanel>
            </StackPanel>
        </fa:FASettingsExpanderItem>

        <fa:FASettingsExpanderItem>
            <StackPanel>
                <TextBlock Classes="Hint" TextWrapping="Wrap"
                           Text="{Binding [Settings.WheelPreviewHint], Source={x:Static loc:Strings.Current}}" />
                <Button Name="PreviewWheelButton" Classes="Secondary" Height="32"
                        HorizontalAlignment="Left" Margin="0,10,0,0"
                        Click="OnPreviewWheel"
                        Content="{Binding [Settings.WheelPreview], Source={x:Static loc:Strings.Current}}" />
            </StackPanel>
        </fa:FASettingsExpanderItem>
    </fa:FASettingsExpander>
</StackPanel>

<!-- ── 轮盘动作管理 ─────────────────────────────────────────── -->
<StackPanel IsVisible="{Binding IsWheelActionsPage}" Spacing="10">
    <fa:FASettingsExpander Header="{Binding [Settings.WheelActions], Source={x:Static loc:Strings.Current}}"
                           IsExpanded="True">
        <fa:FASettingsExpanderItem IsEnabled="{Binding HasProject}">
            <StackPanel>
                <ContentControl Name="WheelEditorHost" />
                <TextBlock Classes="Hint" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="{Binding [Settings.WheelActionsHint], Source={x:Static loc:Strings.Current}}" />
            </StackPanel>
        </fa:FASettingsExpanderItem>
    </fa:FASettingsExpander>
</StackPanel>

                    <!-- ── 主题 ─────────────────────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsThemePage}" Spacing="10">
                        <fa:FASettingsExpander Header="{Binding [Settings.Colors], Source={x:Static loc:Strings.Current}}"
                                               IsExpanded="True">
                            <fa:FASettingsExpanderItem>
                                <TextBlock Classes="Hint" TextWrapping="Wrap"
                                           Text="{Binding [Settings.ThemeHint], Source={x:Static loc:Strings.Current}}" />
                                <fa:FASettingsExpanderItem.Footer>
                                    <ComboBox Name="ThemeSelect" Classes="Field" Width="200"
                                              ItemsSource="{Binding ThemeOptions}"
                                              SelectedItem="{Binding SelectedTheme}" />
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>

                            <fa:FASettingsExpanderItem IsVisible="{Binding IsCustomTheme}">
                                <TextBlock Classes="Hint" TextWrapping="Wrap"
                                           Text="{Binding [Settings.CustomizeThemeHint], Source={x:Static loc:Strings.Current}}" />
                                <fa:FASettingsExpanderItem.Footer>
                                    <Button Name="CustomizeThemeButton" Classes="Secondary" Height="32"
                                            Click="OnCustomizeThemeClicked"
                                            Content="{Binding [Settings.CustomizeTheme], Source={x:Static loc:Strings.Current}}" />
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>
                        </fa:FASettingsExpander>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </fa:FANavigationView>

        <Button Grid.Row="2" Classes="Secondary" Height="36" MinWidth="92"
                HorizontalAlignment="Right" Margin="20,6,20,16" Name="DoneButton"
                Content="{Binding [Settings.Close], Source={x:Static loc:Strings.Current}}" />
    </Grid>
</views:AppWindow>
