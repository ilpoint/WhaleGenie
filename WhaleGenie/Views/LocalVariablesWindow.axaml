<views:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:vm="using:WhaleGenie.ViewModels"
        x:Class="WhaleGenie.Views.LocalVariablesWindow"
        x:DataType="vm:LocalVariablesViewModel"
        Title="WhaleGenie"
        Width="900" Height="620" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceWindow}">
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <!-- 字段级错误：与全局变量窗口同一档，`Danger` 才是"必须改"。 -->
        <Style Selector="TextBlock.FieldProblem">
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="ListBox.List > ListBoxItem">
            <!-- 一行一个名字，需要分隔线才看得出这是列表而不是一团字。 -->
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        </Style>
    </Window.Styles>

    <Grid Margin="18,14,18,14" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Classes="Hint" Text="{Binding Help}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="300,12,*">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                <TextBox Name="SearchBox" Text="{Binding SearchText}"
                         PlaceholderText="{Binding [LocalVariables.Search], Source={x:Static loc:Strings.Current}}" />

                <Border Grid.Row="1" Classes="Card" Padding="4">
                    <ListBox Name="VariableList" Classes="List"
                             ItemsSource="{Binding Shown}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             SelectionMode="Single" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LocalVariableDraft">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <views:IconView Width="13" Height="13" Margin="0,2,0,0"
                                                   Stroke="{DynamicResource Danger}" StrokeThickness="1.4"
                                                   FitToBounds="True"
                                                   IsVisible="{Binding HasProblem}"
                                                   Data="{x:Static vm:AppIcons.WarningTriangle}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding DisplayName}" FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="{Binding Source}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextTertiary}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding LocalType}" FontSize="11.5"
                                               VerticalAlignment="Top" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextTertiary}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock Grid.Row="1" Classes="Hint" IsVisible="{Binding IsEmpty}"
                           TextWrapping="Wrap" Margin="6,8"
                           Text="{Binding EmptyMessage}" />

                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                    <Button Name="NewButton" Classes="Secondary" Height="32"
                            Content="{Binding NewLabel}" Command="{Binding NewCommand}" />
                    <Button Grid.Column="1" Name="RemoveButton" Classes="Secondary" Height="32"
                            Content="{Binding RemoveLabel}" Click="OnRemove" />
                </Grid>
            </Grid>

            <Border Grid.Column="2" Classes="Card" Padding="16">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel IsVisible="{Binding HasSelection}" Spacing="10">
                            <Grid ColumnDefinitions="120,*" ColumnSpacing="10">
                                <TextBlock Text="{Binding [Variable.Name], Source={x:Static loc:Strings.Current}}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBox Name="NameBox" Text="{Binding Selected.Name}" />
                                    <TextBlock Classes="Hint" TextWrapping="Wrap"
                                               Text="{Binding [LocalVariables.RenameHint], Source={x:Static loc:Strings.Current}}" />
                                    <TextBlock Text="{Binding Selected.NameProblem}" Classes="FieldProblem"
                                               IsVisible="{Binding Selected.HasNameProblem}" />
                                </StackPanel>
                            </Grid>

                            <!-- 声明的变量：类型、初始值、说明都是它自己的。 -->
                            <StackPanel Spacing="10" IsVisible="{Binding ShowsDeclaration}">
                                <Grid ColumnDefinitions="120,*" ColumnSpacing="10">
                                    <TextBlock Text="{Binding [Variable.Type], Source={x:Static loc:Strings.Current}}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Selected.TypeOptions}"
                                              SelectedItem="{Binding Selected.SelectedType}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ActionParameterOption">
                                                <TextBlock Text="{Binding Display}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="120,*" ColumnSpacing="10">
                                    <TextBlock Text="{Binding [LocalVariables.Initial], Source={x:Static loc:Strings.Current}}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBox Name="InitialBox" Classes="HasChip"
                                                 Text="{Binding Selected.Initial}"
                                                 PlaceholderText="{Binding [LocalVariables.InitialPlaceholder], Source={x:Static loc:Strings.Current}}">
                                            <TextBox.InnerRightContent>
                                                <Button Classes="ValueChip" Click="OnOpenInitialExpression"
                                                        Content="{Binding [Add.Value], Source={x:Static loc:Strings.Current}}"
                                                        ToolTip.Tip="{Binding [Add.ValueHint], Source={x:Static loc:Strings.Current}}" />
                                            </TextBox.InnerRightContent>
                                        </TextBox>
                                        <TextBlock Classes="Hint"
                                                   Text="{Binding [LocalVariables.InitialHint], Source={x:Static loc:Strings.Current}}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Classes="Hint" Text="{Binding Selected.InitialPreview}"
                                                   IsVisible="{Binding !Selected.HasInitialError}" />
                                        <TextBlock Classes="FieldProblem" Text="{Binding Selected.InitialProblem}"
                                                   IsVisible="{Binding Selected.HasInitialProblem}" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="120,*" ColumnSpacing="10">
                                    <TextBlock Text="{Binding [Variable.Description], Source={x:Static loc:Strings.Current}}"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding Selected.Description}" />
                                </Grid>
                            </StackPanel>

                            <!-- 步骤写出来的名字：装着什么由那一步决定，这里只改名字。 -->
                            <StackPanel Spacing="8" IsVisible="{Binding ShowsStep}">
                                <Grid ColumnDefinitions="120,*" ColumnSpacing="10">
                                    <TextBlock Text="{Binding [Variable.Type], Source={x:Static loc:Strings.Current}}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Selected.LocalType}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </Grid>
                                <Grid ColumnDefinitions="120,*" ColumnSpacing="10">
                                    <TextBlock Text="{Binding [LocalVariables.Source], Source={x:Static loc:Strings.Current}}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Selected.Source}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </Grid>
                                <TextBlock Classes="Hint" TextWrapping="Wrap"
                                           Text="{Binding [LocalVariables.StepHint], Source={x:Static loc:Strings.Current}}" />
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource BorderSubtle}" />

                            <TextBlock Classes="SectionHeader"
                                       Text="{Binding [LocalVariables.UsedBy], Source={x:Static loc:Strings.Current}}" />
                            <TextBlock Classes="Hint" IsVisible="{Binding !HasUses}"
                                       Text="{Binding [LocalVariables.NoUses], Source={x:Static loc:Strings.Current}}" />
                            <ItemsControl ItemsSource="{Binding SelectedUses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:VariableUse">
                                        <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                   TextWrapping="Wrap" Margin="0,0,0,2"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock IsVisible="{Binding !HasSelection}" Margin="6,8"
                               TextWrapping="Wrap" MaxWidth="360"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiary}"
                               Text="{Binding [LocalVariables.Pick], Source={x:Static loc:Strings.Current}}" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Name="ProblemStatus" Text="{Binding ValidationMessage}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Foreground="{DynamicResource Danger}"
                       IsVisible="{Binding HasValidationProblem}" />
            <Button Grid.Column="1" Name="CancelButton" Classes="Secondary"
                    Height="36" MinWidth="92"
                    Content="{Binding [Common.Cancel], Source={x:Static loc:Strings.Current}}"
                    Command="{Binding CancelCommand}" />
            <Button Grid.Column="2" Name="SaveButton" Classes="Primary"
                    Height="36" MinWidth="110"
                    Content="{Binding [Common.Save], Source={x:Static loc:Strings.Current}}"
                    Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</views:AppWindow>
