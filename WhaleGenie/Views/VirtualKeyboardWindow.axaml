<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="520"
        x:Class="WhaleGenie.Views.VirtualKeyboardWindow"
        Title="WhaleGenie"
        Width="1024" Height="520"
        MinWidth="1000" MinHeight="470"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource AppBackdrop}">

    <Window.Styles>
        <!-- One key of the keyboard. The cap shows the name the step will carry, which is how a
             key reads everywhere else in the program, and it is sized to be read at a glance
             rather than hunted for. -->
        <Style Selector="Button.Key">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource AppField}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- The keys to the side of the letters, where the cap has a long word on it and no room
             to grow into: one step down in size, still readable. -->
        <Style Selector="Button.Key.Small">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <!-- A key that takes the whole cell it stands in. The blocks at the side of the letters are
             grids whose cells are the keys; a key of its own width would float in the middle of its
             column instead of lining up with the keys above and below it. -->
        <Style Selector="Button.Key.Cell">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.Key:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Button.Key:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#C8401C" />
        </Style>

        <!-- A named button in the title bar, for finishing rather than dismissing. -->
    </Window.Styles>

    <Grid RowDefinitions="38,*">

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="{DynamicResource AppChrome}" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                <Image Source="/Assets/WhaleGenie.png" Width="22" Height="22" Stretch="Uniform" />
                <TextBlock Text="{Binding [KeyPad.Title], Source={x:Static loc:Strings.Current}}"
                           Foreground="{DynamicResource AppText}" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0"
                        VerticalAlignment="Center">
                <!-- The keyboard stays up while a combination is built, so it needs a word for
                     "this is the combination I meant", which is not the same as closing it away. -->
                <Button Classes="Chrome Labeled" Name="DoneButton"
                        Content="{Binding [KeyPad.Done], Source={x:Static loc:Strings.Current}}" />
                <!-- Each window is put away on its own: the keyboard covers whatever the keys are
                     being read off, and putting it away leaves the add-action window as it was. -->
                <Button Classes="Chrome Icon" Name="MinimizeButton"
                        Width="30" Height="24" Padding="0" VerticalAlignment="Center">
                    <views:IconView Width="10" Height="10" Stroke="{DynamicResource AppText}" StrokeThickness="1.2" FitToBounds="True" Data="{x:Static vm:AppIcons.Minus}" />
                </Button>
                <Button Classes="Chrome Icon" Name="CloseButton"
                        Width="30" Height="24" Padding="0" VerticalAlignment="Center">
                    <views:IconView Width="10" Height="10" Stroke="{DynamicResource AppText}" StrokeThickness="1.2" FitToBounds="True" Data="{x:Static vm:AppIcons.X}" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,16" Spacing="12" HorizontalAlignment="Center">
                <!-- What the keys are being written into, and how the window is used. Both wrap
                     inside a width of their own, so a long sentence never widens the keyboard it is
                     sitting above. -->
                <StackPanel Spacing="4" MaxWidth="900">
                    <TextBlock Name="FillingLine" Foreground="#7FC97F" FontSize="12.5"
                               TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource AppMuted}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [KeyPad.Hint], Source={x:Static loc:Strings.Current}}" />
                </StackPanel>

                <!-- The two blocks sit the distance apart they do on a keyboard, by a fixed gap
                     rather than by the width of the window: a hand that has finished with
                     Backspace should not have to travel to find Insert. -->
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="22">

                    <!-- The main block, laid out the way a keyboard is: the function keys above the
                         numbers, then the letters, with the shifting keys at the edges they take on
                         a real keyboard. Every one of those pairs is named with its side, because
                         that is how a key is written where the side is what matters. -->
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                            <Button Classes="Key" Content="Esc" Tag="Esc" Width="44" />
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                <Button Classes="Key" Content="F1" Tag="F1" />
                                <Button Classes="Key" Content="F2" Tag="F2" />
                                <Button Classes="Key" Content="F3" Tag="F3" />
                                <Button Classes="Key" Content="F4" Tag="F4" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                <Button Classes="Key" Content="F5" Tag="F5" />
                                <Button Classes="Key" Content="F6" Tag="F6" />
                                <Button Classes="Key" Content="F7" Tag="F7" />
                                <Button Classes="Key" Content="F8" Tag="F8" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                <Button Classes="Key" Content="F9" Tag="F9" />
                                <Button Classes="Key" Content="F10" Tag="F10" />
                                <Button Classes="Key" Content="F11" Tag="F11" />
                                <Button Classes="Key" Content="F12" Tag="F12" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="Key" Content="`" Tag="`" />
                            <Button Classes="Key" Content="1" Tag="1" />
                            <Button Classes="Key" Content="2" Tag="2" />
                            <Button Classes="Key" Content="3" Tag="3" />
                            <Button Classes="Key" Content="4" Tag="4" />
                            <Button Classes="Key" Content="5" Tag="5" />
                            <Button Classes="Key" Content="6" Tag="6" />
                            <Button Classes="Key" Content="7" Tag="7" />
                            <Button Classes="Key" Content="8" Tag="8" />
                            <Button Classes="Key" Content="9" Tag="9" />
                            <Button Classes="Key" Content="0" Tag="0" />
                            <Button Classes="Key" Content="-" Tag="-" />
                            <Button Classes="Key" Content="=" Tag="=" />
                            <Button Classes="Key" Content="Backspace" Tag="Backspace" Width="66" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="Key" Content="Tab" Tag="Tab" Width="50" />
                            <Button Classes="Key" Content="Q" Tag="Q" />
                            <Button Classes="Key" Content="W" Tag="W" />
                            <Button Classes="Key" Content="E" Tag="E" />
                            <Button Classes="Key" Content="R" Tag="R" />
                            <Button Classes="Key" Content="T" Tag="T" />
                            <Button Classes="Key" Content="Y" Tag="Y" />
                            <Button Classes="Key" Content="U" Tag="U" />
                            <Button Classes="Key" Content="I" Tag="I" />
                            <Button Classes="Key" Content="O" Tag="O" />
                            <Button Classes="Key" Content="P" Tag="P" />
                            <Button Classes="Key" Content="[" Tag="[" />
                            <Button Classes="Key" Content="]" Tag="]" />
                            <Button Classes="Key" Content="\" Tag="\" Width="50" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="Key Small" Content="CapsLock" Tag="CapsLock" Width="58" />
                            <Button Classes="Key" Content="A" Tag="A" />
                            <Button Classes="Key" Content="S" Tag="S" />
                            <Button Classes="Key" Content="D" Tag="D" />
                            <Button Classes="Key" Content="F" Tag="F" />
                            <Button Classes="Key" Content="G" Tag="G" />
                            <Button Classes="Key" Content="H" Tag="H" />
                            <Button Classes="Key" Content="J" Tag="J" />
                            <Button Classes="Key" Content="K" Tag="K" />
                            <Button Classes="Key" Content="L" Tag="L" />
                            <Button Classes="Key" Content=";" Tag=";" />
                            <Button Classes="Key" Content="'" Tag="'" />
                            <Button Classes="Key" Content="Enter" Tag="Enter" Width="74" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="Key Small" Content="左Shift" Tag="左Shift" Width="72" />
                            <Button Classes="Key" Content="Z" Tag="Z" />
                            <Button Classes="Key" Content="X" Tag="X" />
                            <Button Classes="Key" Content="C" Tag="C" />
                            <Button Classes="Key" Content="V" Tag="V" />
                            <Button Classes="Key" Content="B" Tag="B" />
                            <Button Classes="Key" Content="N" Tag="N" />
                            <Button Classes="Key" Content="M" Tag="M" />
                            <Button Classes="Key" Content="," Tag="," />
                            <Button Classes="Key" Content="." Tag="." />
                            <Button Classes="Key" Content="/" Tag="/" />
                            <Button Classes="Key Small" Content="右Shift" Tag="右Shift" Width="92" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="Key Small" Content="左Ctrl" Tag="左Ctrl" Width="58" />
                            <Button Classes="Key Small" Content="左Win" Tag="左Win" Width="44" />
                            <Button Classes="Key Small" Content="左Alt" Tag="左Alt" Width="44" />
                            <Button Classes="Key" Content="Space" Tag="Space" Width="172" />
                            <Button Classes="Key Small" Content="右Alt" Tag="右Alt" Width="44" />
                            <Button Classes="Key Small" Content="右Win" Tag="右Win" Width="44" />
                            <Button Classes="Key Small" Content="Menu" Tag="ContextMenu" Width="44" />
                            <Button Classes="Key Small" Content="右Ctrl" Tag="右Ctrl" Width="58" />
                        </StackPanel>
                    </StackPanel>

                    <!-- The keys a keyboard keeps to the side: the lock row above the navigation
                         block, the arrows under it, and then the number pad. Each block is a grid
                         of cells that the keys fill, so a row starts where the row above it does
                         and every gap between two keys is the same. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16"
                                VerticalAlignment="Top" Margin="0,40,0,0">
                        <!-- The lock row sits above the navigation keys and the arrows under them,
                             all in the same three columns, which is where a hand looks for each of
                             them. The columns are as wide as the widest cap each of them holds,
                             because those caps are the names the step stores and are written out
                             in full. The empty row between the navigation keys and the arrows is
                             the gap a keyboard leaves between the two. -->
                        <Grid ColumnDefinitions="64,58,60" RowDefinitions="32,32,32,32,32,32"
                              ColumnSpacing="4" RowSpacing="4">
                            <Button Classes="Key Small Cell" Content="PrintScreen" Tag="PrintScreen" />
                            <Button Grid.Column="1" Classes="Key Small Cell" Content="ScrollLock" Tag="ScrollLock" />
                            <Button Grid.Column="2" Classes="Key Small Cell" Content="Pause" Tag="Pause" />
                            <Button Grid.Row="1" Classes="Key Small Cell" Content="Insert" Tag="Insert" />
                            <Button Grid.Row="1" Grid.Column="1" Classes="Key Small Cell" Content="Home" Tag="Home" />
                            <Button Grid.Row="1" Grid.Column="2" Classes="Key Small Cell" Content="PageUp" Tag="PageUp" />
                            <Button Grid.Row="2" Classes="Key Small Cell" Content="Delete" Tag="Delete" />
                            <Button Grid.Row="2" Grid.Column="1" Classes="Key Small Cell" Content="End" Tag="End" />
                            <Button Grid.Row="2" Grid.Column="2" Classes="Key Small Cell" Content="PageDown" Tag="PageDown" />
                            <Button Grid.Row="4" Grid.Column="1" Classes="Key Cell" FontSize="14"
                                    Content="↑" Tag="Up" />
                            <Button Grid.Row="5" Classes="Key Cell" FontSize="14" Content="←" Tag="Left" />
                            <Button Grid.Row="5" Grid.Column="1" Classes="Key Cell" FontSize="14"
                                    Content="↓" Tag="Down" />
                            <Button Grid.Row="5" Grid.Column="2" Classes="Key Cell" FontSize="14"
                                    Content="→" Tag="Right" />
                        </Grid>

                        <!-- Four equal columns, with the tall + and Enter and the wide 0 where a
                             number pad has them. -->
                        <Grid ColumnDefinitions="52,52,52,52" RowDefinitions="32,32,32,32,32"
                              ColumnSpacing="4" RowSpacing="4">
                            <Button Classes="Key Small Cell" Content="NumLock" Tag="NumLock" />
                            <Button Grid.Column="1" Classes="Key Cell" Content="/" Tag="NumPadDivide" />
                            <Button Grid.Column="2" Classes="Key Cell" Content="*" Tag="NumPadMultiply" />
                            <Button Grid.Column="3" Classes="Key Cell" Content="-" Tag="NumPadSubtract" />
                            <Button Grid.Row="1" Classes="Key Cell" Content="7" Tag="NumPad7" />
                            <Button Grid.Row="1" Grid.Column="1" Classes="Key Cell" Content="8" Tag="NumPad8" />
                            <Button Grid.Row="1" Grid.Column="2" Classes="Key Cell" Content="9" Tag="NumPad9" />
                            <Button Grid.Row="1" Grid.Column="3" Grid.RowSpan="2" Classes="Key Cell"
                                    Content="+" Tag="NumPadAdd" Height="68" />
                            <Button Grid.Row="2" Classes="Key Cell" Content="4" Tag="NumPad4" />
                            <Button Grid.Row="2" Grid.Column="1" Classes="Key Cell" Content="5" Tag="NumPad5" />
                            <Button Grid.Row="2" Grid.Column="2" Classes="Key Cell" Content="6" Tag="NumPad6" />
                            <Button Grid.Row="3" Classes="Key Cell" Content="1" Tag="NumPad1" />
                            <Button Grid.Row="3" Grid.Column="1" Classes="Key Cell" Content="2" Tag="NumPad2" />
                            <Button Grid.Row="3" Grid.Column="2" Classes="Key Cell" Content="3" Tag="NumPad3" />
                            <Button Grid.Row="3" Grid.Column="3" Grid.RowSpan="2" Classes="Key Small Cell"
                                    Content="Enter" Tag="NumPadEnter" Height="68" />
                            <Button Grid.Row="4" Grid.ColumnSpan="2" Classes="Key Cell" Content="0" Tag="NumPad0" />
                            <Button Grid.Row="4" Grid.Column="2" Classes="Key Cell" Content="." Tag="NumPadDecimal" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- The rest of the keys a keyboard may have. They are laid out in blocks of what
                     they are for, because these are the ones nobody has a hand-memory of. -->
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="Key" Content="F13" Tag="F13" Width="38" />
                        <Button Classes="Key" Content="F14" Tag="F14" Width="38" />
                        <Button Classes="Key" Content="F15" Tag="F15" Width="38" />
                        <Button Classes="Key" Content="F16" Tag="F16" Width="38" />
                        <Button Classes="Key" Content="F17" Tag="F17" Width="38" />
                        <Button Classes="Key" Content="F18" Tag="F18" Width="38" />
                        <Button Classes="Key" Content="F19" Tag="F19" Width="38" />
                        <Button Classes="Key" Content="F20" Tag="F20" Width="38" />
                        <Button Classes="Key" Content="F21" Tag="F21" Width="38" />
                        <Button Classes="Key" Content="F22" Tag="F22" Width="38" />
                        <Button Classes="Key" Content="F23" Tag="F23" Width="38" />
                        <Button Classes="Key" Content="F24" Tag="F24" Width="38" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="Key" Content="MediaPrevious" Tag="MediaPrevious" Width="96" />
                        <Button Classes="Key" Content="MediaPlay" Tag="MediaPlay" Width="76" />
                        <Button Classes="Key" Content="MediaStop" Tag="MediaStop" Width="76" />
                        <Button Classes="Key" Content="MediaNext" Tag="MediaNext" Width="76" />
                        <Button Classes="Key" Content="MediaSelect" Tag="MediaSelect" Width="92" />
                        <Button Classes="Key" Content="MediaEject" Tag="MediaEject" Width="84" />
                        <Border Width="16" />
                        <Button Classes="Key" Content="VolumeMute" Tag="VolumeMute" Width="92" />
                        <Button Classes="Key" Content="VolumeDown" Tag="VolumeDown" Width="92" />
                        <Button Classes="Key" Content="VolumeUp" Tag="VolumeUp" Width="76" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="Key" Content="BrowserBack" Tag="BrowserBack" Width="90" />
                        <Button Classes="Key" Content="BrowserForward" Tag="BrowserForward" Width="100" />
                        <Button Classes="Key" Content="BrowserRefresh" Tag="BrowserRefresh" Width="96" />
                        <Button Classes="Key" Content="BrowserStop" Tag="BrowserStop" Width="90" />
                        <Button Classes="Key" Content="BrowserSearch" Tag="BrowserSearch" Width="96" />
                        <Button Classes="Key" Content="BrowserHome" Tag="BrowserHome" Width="92" />
                        <Button Classes="Key" Content="BrowserFavorites" Tag="BrowserFavorites" Width="110" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="Key" Content="AppBrowser" Tag="AppBrowser" Width="90" />
                        <Button Classes="Key" Content="AppCalculator" Tag="AppCalculator" Width="102" />
                        <Button Classes="Key" Content="AppMail" Tag="AppMail" Width="70" />
                        <Border Width="14" />
                        <Button Classes="Key" Content="Help" Tag="Help" Width="50" />
                        <Button Classes="Key" Content="Cancel" Tag="Cancel" Width="62" />
                        <Button Classes="Key" Content="Function" Tag="Function" Width="74" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
