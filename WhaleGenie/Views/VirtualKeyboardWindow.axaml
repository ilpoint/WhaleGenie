<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="360"
        x:Class="WhaleGenie.Views.VirtualKeyboardWindow"
        Title="WhaleGenie"
        Width="860" Height="360"
        MinWidth="760" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="#232323">

    <Window.Styles>
        <!-- One key of the keyboard. The cap shows the name the step will carry, which is how a
             key reads everywhere else in the program. -->
        <Style Selector="Button.Key">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#2E2E2E" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.Key:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4C4C4C" />
        </Style>
        <Style Selector="Button.Key:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#C8401C" />
        </Style>

        <Style Selector="Button.TitleBarButton">
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.TitleBarButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A4A4A" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="38,*">

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="#202020" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                <Image Source="/Assets/WhaleGenie.png" Width="22" Height="22" Stretch="Uniform" />
                <TextBlock Text="{Binding [KeyPad.Title], Source={x:Static loc:Strings.Current}}"
                           Foreground="#E8E8E8" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="2" Classes="TitleBarButton" Name="CloseButton"
                    Width="30" Height="24" Padding="0" Margin="8,0" VerticalAlignment="Center">
                <Path Width="10" Height="10" Stroke="White" StrokeThickness="1.6"
                      Data="M 1,1 L 7,7 M 1,7 L 7,1" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,16" Spacing="12">
                <TextBlock Foreground="#A0A0A0" FontSize="12" TextWrapping="Wrap"
                           Text="{Binding [KeyPad.Hint], Source={x:Static loc:Strings.Current}}" />

                <StackPanel Orientation="Horizontal" Spacing="18"
                            HorizontalAlignment="Center">

                    <!-- The main block, laid out the way a keyboard is: the function keys above the
                         numbers, then the letters, with the shifting keys at the edges they take on
                         a real keyboard. -->
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,5">
                            <Button Classes="Key" Content="Esc" Tag="Esc" Width="44" />
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0,0,0">
                                <Button Classes="Key" Content="F1" Tag="F1" />
                                <Button Classes="Key" Content="F2" Tag="F2" />
                                <Button Classes="Key" Content="F3" Tag="F3" />
                                <Button Classes="Key" Content="F4" Tag="F4" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0,0,0">
                                <Button Classes="Key" Content="F5" Tag="F5" />
                                <Button Classes="Key" Content="F6" Tag="F6" />
                                <Button Classes="Key" Content="F7" Tag="F7" />
                                <Button Classes="Key" Content="F8" Tag="F8" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0,0,0">
                                <Button Classes="Key" Content="F9" Tag="F9" />
                                <Button Classes="Key" Content="F10" Tag="F10" />
                                <Button Classes="Key" Content="F11" Tag="F11" />
                                <Button Classes="Key" Content="F12" Tag="F12" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0,0,0">
                                <Button Classes="Key" Content="PrtSc" Tag="PrintScreen" Width="46" />
                                <Button Classes="Key" Content="ScrLk" Tag="ScrollLock" Width="46" />
                                <Button Classes="Key" Content="Pause" Tag="Pause" Width="46" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="Key" Content="`" Tag="`" />
                            <Button Classes="Key" Content="1" Tag="1" />
                            <Button Classes="Key" Content="2" Tag="2" />
                            <Button Classes="Key" Content="3" Tag="3" />
                            <Button Classes="Key" Content="4" Tag="4" />
                            <Button Classes="Key" Content="5" Tag="5" />
                            <Button Classes="Key" Content="6" Tag="6" />
                            <Button Classes="Key" Content="7" Tag="7" />
                            <Button Classes="Key" Content="8" Tag="8" />
                            <Button Classes="Key" Content="9" Tag="9" />
                            <Button Classes="Key" Content="0" Tag="0" />
                            <Button Classes="Key" Content="-" Tag="-" />
                            <Button Classes="Key" Content="=" Tag="=" />
                            <Button Classes="Key" Content="Backspace" Tag="Backspace" Width="70" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="Key" Content="Tab" Tag="Tab" Width="46" />
                            <Button Classes="Key" Content="Q" Tag="Q" />
                            <Button Classes="Key" Content="W" Tag="W" />
                            <Button Classes="Key" Content="E" Tag="E" />
                            <Button Classes="Key" Content="R" Tag="R" />
                            <Button Classes="Key" Content="T" Tag="T" />
                            <Button Classes="Key" Content="Y" Tag="Y" />
                            <Button Classes="Key" Content="U" Tag="U" />
                            <Button Classes="Key" Content="I" Tag="I" />
                            <Button Classes="Key" Content="O" Tag="O" />
                            <Button Classes="Key" Content="P" Tag="P" />
                            <Button Classes="Key" Content="[" Tag="[" />
                            <Button Classes="Key" Content="]" Tag="]" />
                            <Button Classes="Key" Content="\" Tag="\" Width="46" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="Key" Content="CapsLock" Tag="CapsLock" Width="60" />
                            <Button Classes="Key" Content="A" Tag="A" />
                            <Button Classes="Key" Content="S" Tag="S" />
                            <Button Classes="Key" Content="D" Tag="D" />
                            <Button Classes="Key" Content="F" Tag="F" />
                            <Button Classes="Key" Content="G" Tag="G" />
                            <Button Classes="Key" Content="H" Tag="H" />
                            <Button Classes="Key" Content="J" Tag="J" />
                            <Button Classes="Key" Content="K" Tag="K" />
                            <Button Classes="Key" Content="L" Tag="L" />
                            <Button Classes="Key" Content=";" Tag=";" />
                            <Button Classes="Key" Content="'" Tag="'" />
                            <Button Classes="Key" Content="Enter" Tag="Enter" Width="74" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="Key" Content="Shift" Tag="Shift" Width="70" />
                            <Button Classes="Key" Content="Z" Tag="Z" />
                            <Button Classes="Key" Content="X" Tag="X" />
                            <Button Classes="Key" Content="C" Tag="C" />
                            <Button Classes="Key" Content="V" Tag="V" />
                            <Button Classes="Key" Content="B" Tag="B" />
                            <Button Classes="Key" Content="N" Tag="N" />
                            <Button Classes="Key" Content="M" Tag="M" />
                            <Button Classes="Key" Content="," Tag="," />
                            <Button Classes="Key" Content="." Tag="." />
                            <Button Classes="Key" Content="/" Tag="/" />
                            <Button Classes="Key" Content="Shift" Tag="Shift" Width="86" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="Key" Content="Ctrl" Tag="Ctrl" Width="56" />
                            <Button Classes="Key" Content="Win" Tag="Win" Width="44" />
                            <Button Classes="Key" Content="Alt" Tag="Alt" Width="44" />
                            <Button Classes="Key" Content="Space" Tag="Space" Width="196" />
                            <Button Classes="Key" Content="Alt" Tag="Alt" Width="44" />
                            <Button Classes="Key" Content="Win" Tag="Win" Width="44" />
                            <Button Classes="Key" Content="Menu" Tag="ContextMenu" Width="44" />
                            <Button Classes="Key" Content="Ctrl" Tag="Ctrl" Width="56" />
                        </StackPanel>
                    </StackPanel>

                    <!-- The keys a keyboard keeps off to the side: the navigation block and the
                         number pad, which are the ones a bare text field is worst at. -->
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Top"
                                Margin="0,35,0,0">
                        <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="4" RowSpacing="4">
                            <Button Classes="Key" Content="Insert" Tag="Insert" Width="42" />
                            <Button Grid.Column="1" Classes="Key" Content="Home" Tag="Home" Width="42" />
                            <Button Grid.Column="2" Classes="Key" Content="PgUp" Tag="PageUp" Width="42" />
                            <Button Grid.Row="1" Classes="Key" Content="Delete" Tag="Delete" Width="42" />
                            <Button Grid.Row="1" Grid.Column="1" Classes="Key" Content="End" Tag="End" Width="42" />
                            <Button Grid.Row="1" Grid.Column="2" Classes="Key" Content="PgDn" Tag="PageDown" Width="42" />
                            <Button Grid.Row="3" Grid.Column="1" Classes="Key" Content="↑" Tag="Up" Width="42" />
                            <Button Grid.Row="4" Classes="Key" Content="←" Tag="Left" Width="42" />
                            <Button Grid.Row="4" Grid.Column="1" Classes="Key" Content="↓" Tag="Down" Width="42" />
                            <Button Grid.Row="4" Grid.Column="2" Classes="Key" Content="→" Tag="Right" Width="42" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="4" RowSpacing="4">
                            <Button Classes="Key" Content="NumLock" Tag="NumLock" Width="42" />
                            <Button Grid.Column="1" Classes="Key" Content="/" Tag="NumPadDivide" Width="42" />
                            <Button Grid.Column="2" Classes="Key" Content="*" Tag="NumPadMultiply" Width="42" />
                            <Button Grid.Column="3" Classes="Key" Content="-" Tag="NumPadSubtract" Width="42" />
                            <Button Grid.Row="1" Classes="Key" Content="7" Tag="NumPad7" Width="42" />
                            <Button Grid.Row="1" Grid.Column="1" Classes="Key" Content="8" Tag="NumPad8" Width="42" />
                            <Button Grid.Row="1" Grid.Column="2" Classes="Key" Content="9" Tag="NumPad9" Width="42" />
                            <Button Grid.Row="1" Grid.Column="3" Grid.RowSpan="2" Classes="Key"
                                    Content="+" Tag="NumPadAdd" Width="42" Height="64" />
                            <Button Grid.Row="2" Classes="Key" Content="4" Tag="NumPad4" Width="42" />
                            <Button Grid.Row="2" Grid.Column="1" Classes="Key" Content="5" Tag="NumPad5" Width="42" />
                            <Button Grid.Row="2" Grid.Column="2" Classes="Key" Content="6" Tag="NumPad6" Width="42" />
                            <Button Grid.Row="3" Classes="Key" Content="1" Tag="NumPad1" Width="42" />
                            <Button Grid.Row="3" Grid.Column="1" Classes="Key" Content="2" Tag="NumPad2" Width="42" />
                            <Button Grid.Row="3" Grid.Column="2" Classes="Key" Content="3" Tag="NumPad3" Width="42" />
                            <Button Grid.Row="3" Grid.Column="3" Grid.RowSpan="2" Classes="Key"
                                    Content="↵" Tag="NumPadEnter" Width="42" Height="64" />
                            <Button Grid.Row="4" Grid.ColumnSpan="2" Classes="Key" Content="0" Tag="NumPad0" Width="88" />
                            <Button Grid.Row="4" Grid.Column="2" Classes="Key" Content="." Tag="NumPadDecimal" Width="42" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
