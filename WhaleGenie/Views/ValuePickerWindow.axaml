<views:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:conv="using:WhaleGenie.Converters"
        xmlns:system="using:System"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1140" d:DesignHeight="720"
        x:Class="WhaleGenie.Views.ValuePickerWindow"
        x:DataType="vm:ValuePickerViewModel"
        Title="WhaleGenie"
        Width="1140" Height="720"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnWindowKeyDown"
        Background="{DynamicResource SurfaceWindow}">

    <!--
      取值。左列是公式的结构，右上是一条横着的符号与值，右下才是名字和函数。结构竖着放，因为它
      越深越长；符号横着放，因为它们是短词。三样都在一页上，不切页签。
    -->
    <Window.Resources>
        <conv:FunctionGroupBrushConverter x:Key="Tone" />
    </Window.Resources>

    <Window.Styles>
        <!-- 旧表达式页面的胶囊：28 高、12.5 号字、10/0 内边距、圆角 6、缝 6。 -->
        <Style Selector="Button.ExprChip">
            <Setter Property="Background" Value="{DynamicResource SurfaceField}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.ExprChip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <!-- 分类词：只是一行字，点一下换列表。 -->
        <Style Selector="Button.ChipWord">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0,0,4,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        </Style>
        <Style Selector="Button.ChipWord:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="Button.Op">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceField}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.Op:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="Border.TreeBlock">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0,1,0,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style Selector="GridSplitter.Split">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="GridSplitter.Split:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="TextBlock.Note.problem">
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16,12,16,12" RowSpacing="8">
        <!-- 标志在标题栏左上角；这里只说填给哪一格。 -->
        <TextBlock Grid.Row="0" Text="{Binding TargetLine}" FontSize="12.5"
                   IsVisible="{Binding HasTarget}" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextSecondary}" />

        <Grid Grid.Row="1" IsVisible="{Binding CanCompute}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- 左列：结构占满，公式在它下面。 -->
            <Border Grid.Column="0" Background="{DynamicResource SurfacePanel}" CornerRadius="6" Padding="8">
                <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiary}"
                               Text="{Binding [ValuePicker.Structure], Source={x:Static loc:Strings.Current}}" />

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceField}" CornerRadius="5" Padding="4"
                            ClipToBounds="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ListBox ItemsSource="{Binding Blocks}"
                                     SelectedItem="{Binding SelectedBlock, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BlockRow">
                                        <StackPanel Orientation="Horizontal">
                                            <ItemsControl ItemsSource="{Binding Guides}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="system:Int32">
                                                        <Border Width="14"
                                                                BorderBrush="{DynamicResource BorderControl}"
                                                                BorderThickness="1,0,0,0" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Classes="TreeBlock"
                                                    BorderBrush="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=line}"
                                                    Background="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=fill}">
                                                <TextBlock Text="{Binding Text}" FontSize="11.5"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Grid.Row="2" FontSize="11" Foreground="{DynamicResource TextTertiary}"
                               Text="{Binding [ValuePicker.Formula], Source={x:Static loc:Strings.Current}}" />
                    <TextBox Grid.Row="3" Name="FormulaBox" Classes="Formula"
                             Text="{Binding Text, Mode=TwoWay}"
                             Height="66"
                             AcceptsReturn="False" TextWrapping="Wrap"
                             FontFamily="{DynamicResource UiCodeFont}" FontSize="12.5"
                             PlaceholderText="{Binding [ValuePicker.FormulaPlaceholder], Source={x:Static loc:Strings.Current}}" />
                    <StackPanel Grid.Row="4" Spacing="2">
                        <TextBlock Text="{Binding Saying}" IsVisible="{Binding HasSaying}"
                                   FontSize="11.5" TextWrapping="Wrap" MaxLines="2"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Classes="Note" Classes.problem="{Binding NoteIsProblem}"
                                   Text="{Binding Note}" TextWrapping="Wrap" FontSize="11" />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Classes="Split" />

            <!-- 右列：符号与值一条横带，名字与函数并排。 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="120" MinHeight="64" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" MinHeight="160" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource SurfacePanel}" CornerRadius="6" Padding="8,6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding [ValuePicker.Panel.Operators], Source={x:Static loc:Strings.Current}}"
                                       FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ItemsControl ItemsSource="{Binding Operators}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ExpressionOperator">
                                        <Button Classes="Op" Margin="0,0,4,4" Content="{Binding Token}"
                                                BorderBrush="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=line}"
                                                Background="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=fill}"
                                                ToolTip.Tip="{Binding Hint}" Click="OnOperator" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>

                        <!-- 值靠右自成一条，运算符怎么换行都不会把它挤到下一行去。 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border Width="1" Background="{DynamicResource BorderSubtle}" Margin="0,1,10,5" />
                            <TextBlock Text="{Binding [ValuePicker.Panel.Values], Source={x:Static loc:Strings.Current}}"
                                       FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ItemsControl ItemsSource="{Binding Values}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ValueToken">
                                        <Button Classes="Op" Margin="0,0,6,0" Content="{Binding Text}"
                                                Click="OnValue" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Classes="Split" ResizeDirection="Rows" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="220" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" MinWidth="240" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource SurfacePanel}" CornerRadius="6" Padding="8">
                        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="6">
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                       Text="{Binding [ValuePicker.Panel.Variables], Source={x:Static loc:Strings.Current}}" />
                            <TextBox Grid.Row="1" Name="VariableSearch"
                                     Text="{Binding Wall.SearchText, Mode=TwoWay}"
                                     PlaceholderText="{Binding [VarWall.Search], Source={x:Static loc:Strings.Current}}" />
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Wall.Filters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VariableFilter">
                                        <Button Classes="ChipWord" Content="{Binding Label}"
                                                ToolTip.Tip="{Binding Hint}" Click="OnVariableFilter" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ListBox Grid.Row="3" Classes="Panel" ItemsSource="{Binding Wall.Shown}"
                                     SelectedItem="{Binding Wall.Looking, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:VariableChoice">
                                        <Button Classes="ExprChip" Click="OnVariablePill"
                                                BorderBrush="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=line}"
                                                Background="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=fill}"
                                                ToolTip.Tip="{Binding Details}">
                                            <TextBlock Text="{Binding Display}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Classes="Split" />

                    <Border Grid.Column="2" Background="{DynamicResource SurfacePanel}" CornerRadius="6" Padding="8">
                        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="6">
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                       Text="{Binding [ValuePicker.Panel.Functions], Source={x:Static loc:Strings.Current}}" />
                            <TextBox Grid.Row="1" Name="FunctionSearch"
                                     Text="{Binding FunctionQuery, Mode=TwoWay}"
                                     PlaceholderText="{Binding [ExprBuilder.FunctionsFilter], Source={x:Static loc:Strings.Current}}" />
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding FunctionGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ExpressionFunctionFilter">
                                        <Button Classes="ChipWord" Content="{Binding Label}"
                                                Click="OnFunctionFilter" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Grid.Row="3">
                                <ListBox Classes="Panel" ItemsSource="{Binding Functions}"
                                         SelectedItem="{Binding SelectedFunction, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExpressionFunctionChoice">
                                            <Button Classes="ExprChip" Click="OnFunctionPill"
                                                    BorderBrush="{Binding Group, Converter={StaticResource Tone}, ConverterParameter=line}"
                                                    Background="{Binding Group, Converter={StaticResource Tone}, ConverterParameter=fill}">
                                                <TextBlock Text="{Binding Tag}" FontSize="11.5"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <ToolTip.Tip>
                                                    <StackPanel MaxWidth="360" Spacing="4">
                                                        <TextBlock Text="{Binding Heading}" FontSize="12.5"
                                                                   Foreground="{DynamicResource TextPrimary}" />
                                                        <TextBlock Text="{Binding WrittenAs}" FontSize="12"
                                                                   Foreground="{DynamicResource Info}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding ArityNote}" FontSize="11.5"
                                                                   Foreground="{DynamicResource Info}" />
                                                        <TextBlock Text="{Binding Hint}" FontSize="12"
                                                                   Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" />
                                                        <ItemsControl ItemsSource="{Binding Arguments}" Margin="0,2,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:FunctionArgument">
                                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6"
                                                                          Margin="0,3,0,0">
                                                                        <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                                                   Foreground="{DynamicResource Warning}" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding Hint}"
                                                                                   FontSize="11.5"
                                                                                   Foreground="{DynamicResource TextTertiary}"
                                                                                   TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </ToolTip.Tip>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock IsVisible="{Binding IsFunctionsEmpty}" FontSize="11.5"
                                           Margin="4,2" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiary}"
                                           Text="{Binding [ValuePicker.Nothing], Source={x:Static loc:Strings.Current}}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- 只写名字的格子：没有结构，也没有符号和函数。 -->
        <Border Grid.Row="1" IsVisible="{Binding NamesOnly}"
                Background="{DynamicResource SurfacePanel}" CornerRadius="6" Padding="8">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                <TextBox Name="NameSearch" Text="{Binding Wall.SearchText, Mode=TwoWay}"
                         PlaceholderText="{Binding [VarWall.Search], Source={x:Static loc:Strings.Current}}" />
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Wall.Filters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VariableFilter">
                                        <Button Classes="ChipWord" Content="{Binding Label}"
                                                ToolTip.Tip="{Binding Hint}" Click="OnVariableFilter" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                <ListBox Grid.Row="2" Classes="Panel" ItemsSource="{Binding Wall.Shown}"
                         SelectedItem="{Binding Wall.Looking, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:VariableChoice">
                            <Button Classes="ExprChip" Click="OnVariablePill"
                                    BorderBrush="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=line}"
                                    Background="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=fill}"
                                    ToolTip.Tip="{Binding Details}">
                                <TextBlock Text="{Binding Display}" FontSize="11.5"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock VerticalAlignment="Center" FontSize="11.5" TextWrapping="Wrap" MaxLines="2"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextTertiary}"
                       Text="{Binding [ValuePicker.Hint], Source={x:Static loc:Strings.Current}}" />
            <Button Grid.Column="1" Classes="Secondary" Height="34" MinWidth="92"
                    Content="{Binding [Add.Cancel], Source={x:Static loc:Strings.Current}}"
                    Click="OnCancel" />
            <Button Grid.Column="2" Classes="Primary" Height="34" MinWidth="96"
                    IsEnabled="{Binding CanConfirm}"
                    Content="{Binding [ValuePicker.InsertButton], Source={x:Static loc:Strings.Current}}"
                    Click="OnInsert" />
        </Grid>
    </Grid>
</views:AppWindow>
