<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="720"
        x:Class="WhaleGenie.Views.LookWindow"
        Title="WhaleGenie"
        Width="1060" Height="720"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource AppBackdrop}">

    <Window.Styles>
        <Style Selector="Border.MarkRow">
            <Setter Property="Background" Value="{DynamicResource AppDock}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.MarkRow.chosen">
            <Setter Property="BorderBrush" Value="#3FBF5F" />
        </Style>

        <!-- The writing the step read, in a box it can be copied out of. -->
        <Style Selector="TextBox.ReadText">
            <Setter Property="Background" Value="{DynamicResource AppGroup}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="58" />
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource AppBackdrop}" CornerRadius="8">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- title bar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="14,8,10,8">
                <Image Source="/Assets/WhaleGenie.png" Width="22" Height="22" Stretch="Uniform"
                       VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource AppText}" TextWrapping="NoWrap"
                           Text="{Binding [Look.Title], Source={x:Static loc:Strings.Current}}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <!-- A reference picture is read at its own size, and a whole screen of hits does
                         not fit in a window; this is the answer to both. -->
                    <Button Name="FullScreen" Classes="Chrome Icon Wide Quiet" Padding="10,0"
                            Click="OnToggleFullScreen"
                            ToolTip.Tip="{Binding [Look.FullScreenHint], Source={x:Static loc:Strings.Current}}" />
                    <!-- Putting this one away leaves the screen behind it free, which is how what was
                         found is compared with what is really there. -->
                    <Button Classes="Chrome Icon Wide Quiet" Name="MinimizeButton" Click="OnMinimize">
                        <views:IconView Width="11" Height="11" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.2" FitToBounds="True" Data="{x:Static vm:AppIcons.Minus}" />
                    </Button>
                    <Button Classes="Chrome Icon Wide Quiet" Content="✕"
                        Click="OnClose" />
                </StackPanel>
            </Grid>

            <!-- what the step was after, and how it went -->
            <Border Grid.Row="1" Background="{DynamicResource AppBackdrop}" CornerRadius="6" Margin="14,0,14,10"
                    Padding="12,10">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" Background="{DynamicResource AppBackdrop}" CornerRadius="4" Padding="4"
                            Margin="0,0,12,0" VerticalAlignment="Center" IsVisible="False"
                            Name="NeedleFrame">
                        <Image Name="NeedleShot" MaxHeight="52" MaxWidth="140"
                               Stretch="Uniform"
                               RenderOptions.BitmapInterpolationMode="None" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Name="StepLine" FontSize="13" Foreground="{DynamicResource AppText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Name="LookingLine" FontSize="12" Foreground="{DynamicResource AppMuted}"
                                   TextWrapping="Wrap" />
                        <TextBlock Name="OutcomeLine" FontSize="12" Foreground="#E0B080"
                                   TextWrapping="Wrap" />
                        <TextBlock Name="NoteLine" FontSize="12" Foreground="#BFE3BF"
                                   TextWrapping="Wrap" IsVisible="False" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- the picture, and one row per mark -->
            <Grid Grid.Row="2" ColumnDefinitions="*,320" Margin="14,0,14,10">
                <Border Grid.Column="0" Classes="Panel" Padding="10">
                    <ScrollViewer Name="Scroll" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Canvas Name="Board" Background="{DynamicResource AppBackdrop}"
                                HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="1" Classes="Panel" Margin="10,0,0,0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0" Classes="SectionHeader"
                                   Text="{Binding [Look.Marks], Source={x:Static loc:Strings.Current}}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Name="Marks" Spacing="0" />
                        </ScrollViewer>
                        <!-- What was read, somewhere it can be taken away from: the marks on the
                             picture are for looking at, and a line of text read off the screen is
                             usually wanted for something else. -->
                        <StackPanel Grid.Row="2" Name="TextPanel" Spacing="5" Margin="0,8,0,0"
                                    IsVisible="False">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="SectionHeader" VerticalAlignment="Center"
                                           Text="{Binding [Look.ReadText], Source={x:Static loc:Strings.Current}}" />
                                <Button Grid.Column="1" Name="CopyText" Classes="Secondary"
                                        Click="OnCopyText"
                                        Content="{Binding [Look.CopyText], Source={x:Static loc:Strings.Current}}" />
                            </Grid>
                            <TextBox Name="ReadText" Classes="ReadText" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="150" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- zoom, and saving the picture -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto"
                  Margin="14,0,14,12">
                <Button Grid.Column="0" Classes="Secondary" Content="−" Width="34"
                        Click="OnZoomOut" />
                <TextBlock Grid.Column="1" Name="ZoomText" MinWidth="54" Margin="8,0"
                           VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppMuted}"
                           TextAlignment="Center" />
                <Button Grid.Column="2" Classes="Secondary" Content="+" Width="34"
                        Click="OnZoomIn" />
                <Button Grid.Column="3" Classes="Secondary" Margin="8,0,0,0"
                        Click="OnZoomFit"
                        Content="{Binding [Look.ZoomFit], Source={x:Static loc:Strings.Current}}" />
                <!-- Only the window opened on the step just written can look a second time: it was
                     handed that step, and the picture belongs to a reading that has just been asked
                     for. The one opened from a run shows a picture that belongs to that run. -->
                <Button Grid.Column="4" Name="Again" Classes="Secondary" Margin="8,0,0,0"
                        IsVisible="False" Click="OnLookAgain"
                        Content="{Binding [Look.Again], Source={x:Static loc:Strings.Current}}" />
                <CheckBox Grid.Column="5" Name="LabelsOnPicture" Margin="12,0,0,0" FontSize="12"
                          Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center" Click="OnToggleLabels"
                          Content="{Binding [Look.LabelsOnPicture], Source={x:Static loc:Strings.Current}}"
                          ToolTip.Tip="{Binding [Look.LabelsHint], Source={x:Static loc:Strings.Current}}" />
                <TextBlock Grid.Column="6" Name="Status" Margin="14,0,10,0"
                           VerticalAlignment="Center" FontSize="12" Foreground="#BFE3BF"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="7" Name="SaveRaw" Classes="Secondary" Margin="0,0,8,0"
                        Click="OnSaveRaw"
                        Content="{Binding [Look.SaveRaw], Source={x:Static loc:Strings.Current}}" />
                <Button Grid.Column="8" Name="SaveMarked" Classes="Primary"
                        Click="OnSave"
                        Content="{Binding [Look.Save], Source={x:Static loc:Strings.Current}}" />
            </Grid>
        </Grid>
    </Border>
</Window>
