<views:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="720"
        x:Class="WhaleGenie.Views.LookWindow"
        Title="WhaleGenie"
        Width="1060" Height="720"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceWindow}">

    <Window.Styles>
        <Style Selector="Border.MarkRow">
            <Setter Property="Background" Value="{DynamicResource SurfacePanel}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <!-- 已挑进这一批：绿认 `Success`。`#3FBF5F` 是另一支绿，而 `Card.Thin.chosen` 已经用
             `Success` 表达同一个状态——**同状态两个色，会让人以为有区别**。颜色会淡一点，这是
             有意的：语义一致优先于色相不变。 -->
        <Style Selector="Border.MarkRow.chosen">
            <Setter Property="BorderBrush" Value="{DynamicResource Success}" />
        </Style>

        <!-- The writing the step read, in a box it can be copied out of. -->
    </Window.Styles>

    <Border Background="{DynamicResource SurfaceWindow}" CornerRadius="8">
        <Grid RowDefinitions="Auto,*,Auto">



            <!-- what the step was after, and how it went -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceWindow}" CornerRadius="6" Margin="14,0,14,10"
                    Padding="12,10">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceWindow}" CornerRadius="4" Padding="4"
                            Margin="0,0,12,0" VerticalAlignment="Center" IsVisible="False"
                            Name="NeedleFrame">
                        <Image Name="NeedleShot" MaxHeight="52" MaxWidth="140"
                               Stretch="Uniform"
                               RenderOptions.BitmapInterpolationMode="None" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Name="StepLine" FontSize="13" Foreground="{DynamicResource TextPrimary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Name="LookingLine" FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Name="OutcomeLine" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                   TextWrapping="Wrap" />
                        <TextBox Name="NoteLine" Classes="Code" IsReadOnly="True" FontSize="12"
                                 TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="84"
                                 IsVisible="False"
                                 ToolTip.Tip="{Binding [Look.CopyHint], Source={x:Static loc:Strings.Current}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- the picture, and one row per mark -->
            <Grid Grid.Row="1" ColumnDefinitions="*,320" Margin="14,0,14,10">
                <Border Grid.Column="0" Classes="Panel" Padding="10">
                    <ScrollViewer Name="Scroll" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Canvas Name="Board" Background="{DynamicResource SurfaceWindow}"
                                HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="1" Classes="Panel" Margin="10,0,0,0">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <!-- 每一行标记已经写出它读到的那一行，右上角再列一遍同样的字就是同一件事说两遍；
                             要看全部、要带走，用这里的全选与复制。 -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                            <TextBlock Classes="SectionHeader" VerticalAlignment="Center"
                                       Text="{Binding [Look.Marks], Source={x:Static loc:Strings.Current}}" />
                            <Button Grid.Column="1" Name="SelectAllMarks" Classes="Secondary"
                                    Height="26" Padding="9,0"
                                    Click="OnSelectAllMarks"
                                    Content="{Binding [Look.SelectAll], Source={x:Static loc:Strings.Current}}" />
                            <Button Grid.Column="2" Name="InvertMarks" Classes="Secondary"
                                    Height="26" Padding="9,0"
                                    Click="OnInvertMarks"
                                    Content="{Binding [Look.Invert], Source={x:Static loc:Strings.Current}}" />
                            <Button Grid.Column="3" Name="CopyMarks" Classes="Secondary"
                                    Height="26" Padding="9,0"
                                    Click="OnCopyMarks"
                                    Content="{Binding [Look.CopyMarks], Source={x:Static loc:Strings.Current}}" />
                        </Grid>
                        <TextBox Grid.Row="1" Name="MarkFilter" Classes="Field" Height="30"
                                 Margin="0,8,0,8"
                                 PlaceholderText="{Binding [Look.FilterMarks], Source={x:Static loc:Strings.Current}}"
                                 TextChanged="OnMarkFilterChanged" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Name="Marks" Spacing="0" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- zoom, and saving the picture -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto"
                  Margin="14,0,14,12">
                <Button Grid.Column="0" Classes="Secondary" Content="−" Width="34"
                        Click="OnZoomOut" />
                <TextBlock Grid.Column="1" Name="ZoomText" MinWidth="54" Margin="8,0"
                           VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextTertiary}"
                           TextAlignment="Center" />
                <Button Grid.Column="2" Classes="Secondary" Content="+" Width="34"
                        Click="OnZoomIn" />
                <Button Grid.Column="3" Classes="Secondary" Margin="8,0,0,0"
                        Click="OnZoomFit"
                        Content="{Binding [Look.ZoomFit], Source={x:Static loc:Strings.Current}}" />
                <!-- Only the window opened on the step just written can look a second time: it was
                     handed that step, and the picture belongs to a reading that has just been asked
                     for. The one opened from a run shows a picture that belongs to that run. -->
                <Button Grid.Column="4" Name="Again" Classes="Secondary" Margin="8,0,0,0"
                        IsVisible="False" Click="OnLookAgain"
                        Content="{Binding [Look.Again], Source={x:Static loc:Strings.Current}}" />
                <TextBlock Grid.Column="5" Name="Status" Margin="14,0,10,0"
                           VerticalAlignment="Center" FontSize="12" Classes="Code"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="6" Name="SaveRaw" Classes="Secondary" Margin="0,0,8,0"
                        Click="OnSaveRaw"
                        Content="{Binding [Look.SaveRaw], Source={x:Static loc:Strings.Current}}" />
                <Button Grid.Column="7" Name="SaveMarked" Classes="Primary"
                        Click="OnSave"
                        Content="{Binding [Look.Save], Source={x:Static loc:Strings.Current}}" />
            </Grid>
        </Grid>
    </Border>
</views:AppWindow>
