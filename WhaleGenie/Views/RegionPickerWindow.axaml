<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="WhaleGenie.Views.RegionPickerWindow"
        Title="WhaleGenie"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Black">

    <!-- The desk as it was when this opened, with everything outside the rectangle pushed back and
         the rectangle itself left alone. A window is not a hole in the screen: what is behind it
         cannot be seen through it, so the desk is taken down as a picture and shown here — the same
         picture the rectangle's numbers are counted on. -->
    <Canvas Name="Surface" Background="Transparent" ClipToBounds="True">
        <Image Name="Desk" Canvas.Left="0" Canvas.Top="0" IsHitTestVisible="False" Stretch="Fill" />

        <!-- A window-based pick is limited to the target's client area. These bands leave the
             allowed area at full strength and push the rest of the desk back. -->
        <Border Name="TargetDimTop" IsHitTestVisible="False" Background="#55000000" />
        <Border Name="TargetDimBottom" IsHitTestVisible="False" Background="#55000000" />
        <Border Name="TargetDimLeft" IsHitTestVisible="False" Background="#55000000" />
        <Border Name="TargetDimRight" IsHitTestVisible="False" Background="#55000000" />

        <Border Name="AllowedArea" IsVisible="False" IsHitTestVisible="False"
                BorderBrush="#FF0A84FF" BorderThickness="2" />

        <!-- One band on each side of the rectangle, so that what is inside it stays as it is. -->
        <Border Name="DimTop" IsHitTestVisible="False" Background="#7F000000" />
        <Border Name="DimBottom" IsHitTestVisible="False" Background="#7F000000" />
        <Border Name="DimLeft" IsHitTestVisible="False" Background="#7F000000" />
        <Border Name="DimRight" IsHitTestVisible="False" Background="#7F000000" />

        <Border Name="Selection" IsVisible="False" IsHitTestVisible="False"
                BorderBrush="#FF3B30" BorderThickness="2" />

        <Border Name="Readout" IsHitTestVisible="False"
                Background="#E01E1E1E" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                CornerRadius="6" Padding="10,7">
            <StackPanel Spacing="3">
                <TextBlock Name="SizeText" FontSize="15" Foreground="#F0F0F0"
                           FontFamily="Consolas,Menlo,monospace" />
                <TextBlock Name="HintText" FontSize="12" Foreground="{DynamicResource AppMuted}" MaxWidth="260" TextWrapping="Wrap"
                           Text="{Binding [Region.Hint], Source={x:Static loc:Strings.Current}}" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
