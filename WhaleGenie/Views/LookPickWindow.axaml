<views:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="620"
        x:Class="WhaleGenie.Views.LookPickWindow"
        Title="WhaleGenie"
        Width="820" Height="620"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceWindow}">

    <Border Background="{DynamicResource SurfaceWindow}" CornerRadius="8">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- What this picker is for, and where the last point landed. -->
            <StackPanel Grid.Row="0" Margin="16,0,16,8" Spacing="3">
                <TextBlock Name="HintText" Classes="Hint" TextWrapping="Wrap" />
                <TextBlock Name="Readout" FontSize="12" Classes="Mono"
                           Foreground="{DynamicResource TextPrimary}" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="16,0,16,10">
                <Border Classes="Panel" Padding="8">
                    <ScrollViewer Name="Scroll" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Canvas Name="Board" HorizontalAlignment="Left" VerticalAlignment="Top"
                                PointerPressed="OnPickPoint" />
                    </ScrollViewer>
                </Border>
                <!-- The colours added so far, one to a line: what is being built is a list of
                     offsets and colours, and it is worth seeing while it is being built. -->
                <Border Grid.Column="1" Name="EntriesPanel" Classes="Panel" Width="240"
                        Margin="10,0,0,0" IsVisible="False">
                    <Grid RowDefinitions="Auto,*" RowSpacing="7">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                            <!-- 加号在标题左边：不点画面也能添一条得靠算出来的点位。 -->
                            <Button Name="AddEntry" Classes="Secondary" Height="24" Width="26"
                                    Padding="0" FontSize="14" Content="+"
                                    Click="OnAddEntry"
                                    ToolTip.Tip="{Binding [LookPick.AddHint], Source={x:Static loc:Strings.Current}}" />
                            <TextBlock Grid.Column="1" Classes="SectionHeader" VerticalAlignment="Center"
                                       Text="{Binding [LookPick.Added], Source={x:Static loc:Strings.Current}}" />
                        </Grid>
                        <Border Grid.Row="1" Classes="Sunken" Padding="5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="Entries" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="16,0,16,14">
                <Button Grid.Column="1" Classes="Secondary"
                        Content="{Binding [Common.Cancel], Source={x:Static loc:Strings.Current}}"
                        Click="OnCancel" />
                <Button Grid.Column="2" Classes="Primary" Name="Confirm" IsEnabled="False"
                        Content="{Binding [Common.Ok], Source={x:Static loc:Strings.Current}}"
                        Click="OnConfirm" />
            </Grid>
        </Grid>
    </Border>
</views:AppWindow>
