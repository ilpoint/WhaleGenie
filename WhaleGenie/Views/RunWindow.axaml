<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="700"
        x:Class="WhaleGenie.Views.RunWindow"
        x:DataType="vm:RunViewModel"
        Title="Run"
        Width="980" Height="700"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="#232323">

    <Window.Styles>
        <Style Selector="TextBlock.Muted">
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="#E4E4E4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style Selector="Button.TitleBarButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.TitleBarButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3A3A" />
        </Style>

        <Style Selector="Button.FlatButton">
            <Setter Property="Background" Value="#404040" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.FlatButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4C4C4C" />
        </Style>

        <Style Selector="Button.PrimaryButton">
            <Setter Property="Background" Value="#C8401C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.PrimaryButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#D94C25" />
        </Style>
        <Style Selector="Button.PrimaryButton:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A322A" />
        </Style>

        <Style Selector="Border.RunRow">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.RunRow.current">
            <Setter Property="Background" Value="#3A2A16" />
            <Setter Property="BorderBrush" Value="#C8A165" />
        </Style>

        <Style Selector="Button.Breakpoint">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#4A4A4A" />
        </Style>
        <Style Selector="Button.Breakpoint.on">
            <Setter Property="Background" Value="#E06C75" />
            <Setter Property="BorderBrush" Value="#E06C75" />
        </Style>

        <Style Selector="Border.Panel">
            <Setter Property="Background" Value="#292929" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Window.Styles>

    <Border Background="#232323" CornerRadius="8">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

            <!-- ===================== Title bar ===================== -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="14,10,10,8">
                <Border Background="#C8401C" CornerRadius="4" Padding="7,3" VerticalAlignment="Center">
                    <TextBlock Text="VIK" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                </Border>
                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="13" Foreground="#E8E8E8"
                           Text="{Binding [Run.Title], Source={x:Static loc:Strings.Current}}" />
                <Button Grid.Column="2" Classes="TitleBarButton" Name="CloseButton"
                        ToolTip.Tip="{Binding [Run.Close], Source={x:Static loc:Strings.Current}}">
                    <Path Width="11" Height="11" Stroke="#D0D0D0" StrokeThickness="1.3"
                          Data="M 1,1 L 10,10 M 10,1 L 1,10" />
                </Button>
            </Grid>

            <!-- ===================== Toolbar ===================== -->
            <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="6" Margin="14,0,14,10" Padding="12,10">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                    <Button Classes="PrimaryButton"
                            Content="{Binding [Run.Run], Source={x:Static loc:Strings.Current}}"
                            Command="{Binding RunCommand}" />
                    <Button Grid.Column="1" Classes="FlatButton" Margin="8,0,0,0"
                            Content="{Binding [Run.Step], Source={x:Static loc:Strings.Current}}"
                            Command="{Binding StepCommand}" />
                    <Button Grid.Column="2" Classes="FlatButton" Margin="8,0,0,0"
                            Content="{Binding [Run.Continue], Source={x:Static loc:Strings.Current}}"
                            Command="{Binding ContinueCommand}" />
                    <Button Grid.Column="3" Classes="FlatButton" Margin="8,0,0,0"
                            Content="{Binding [Run.Stop], Source={x:Static loc:Strings.Current}}"
                            Command="{Binding StopCommand}" />
                    <TextBlock Grid.Column="4" Margin="14,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#C8A165"
                               Text="{Binding Status}" />
                    <Border Grid.Column="5" Margin="10,0,0,0" Padding="8,3" CornerRadius="4"
                            Background="#3A2A10" BorderBrush="#8A6A2A" BorderThickness="1"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsSpeedAdjusted}"
                            ToolTip.Tip="{Binding [Run.SpeedTip], Source={x:Static loc:Strings.Current}}">
                        <TextBlock FontSize="11.5" Foreground="#E0B080" Text="{Binding SpeedNote}" />
                    </Border>
                </Grid>
            </Border>

            <!-- ===================== Steps, variables and log ===================== -->
            <Grid Grid.Row="2" ColumnDefinitions="340,*" Margin="14,0,14,0">
                <Border Classes="Panel">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Classes="SectionHeader"
                                   Text="{Binding [Run.Steps], Source={x:Static loc:Strings.Current}}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Classes="Muted" TextWrapping="Wrap"
                                           IsVisible="{Binding !HasSteps}"
                                           Text="{Binding [Run.Empty], Source={x:Static loc:Strings.Current}}" />
                                <ItemsControl ItemsSource="{Binding Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RunStepViewModel">
                                            <Border Classes="RunRow" Classes.current="{Binding IsCurrent}">
                                                <Grid ColumnDefinitions="24,*">
                                                    <Button Classes="Breakpoint" Classes.on="{Binding HasBreakpoint}"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="{Binding Label}"
                                                            Command="{Binding $parent[ItemsControl].((vm:RunViewModel)DataContext).ToggleBreakpointCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <StackPanel Grid.Column="1" Margin="{Binding Indent}">
                                                        <TextBlock Text="{Binding Label}" FontSize="12"
                                                                   Foreground="#E4E4E4" />
                                                        <TextBlock Text="{Binding Detail}" Classes="Muted"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="12,0,0,0" RowDefinitions="Auto,*,Auto,1.2*">
                    <TextBlock Classes="SectionHeader"
                               Text="{Binding [Run.Variables], Source={x:Static loc:Strings.Current}}" />
                    <Border Grid.Row="1" Classes="Panel" Padding="12,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Classes="Muted"
                                           IsVisible="{Binding !HasVariables}"
                                           Text="{Binding [Run.NoVariables], Source={x:Static loc:Strings.Current}}" />
                                <ItemsControl ItemsSource="{Binding Variables}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WatchedVariable">
                                            <Grid ColumnDefinitions="170,70,*" Margin="0,0,0,3">
                                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#BFE3BF" />
                                                <TextBlock Grid.Column="1" Text="{Binding Scope}" FontSize="11.5"
                                                           Foreground="#D6C08A" />
                                                <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="11.5"
                                                           Foreground="#DDDDDD" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Grid.Row="2" Classes="SectionHeader" Margin="0,12,0,8"
                               Text="{Binding [Run.Log], Source={x:Static loc:Strings.Current}}" />
                    <Border Grid.Row="3" Classes="Panel" Padding="12,10">
                        <ScrollViewer Name="LogScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RunLineViewModel">
                                        <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                            <TextBlock Text="{Binding Time}" FontSize="11" Foreground="#7A7A7A"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Text}" FontSize="11.5"
                                                       Foreground="{Binding Color}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===================== Question ===================== -->
            <Border Grid.Row="3" Background="#3A2A16" BorderBrush="#C8A165" BorderThickness="1"
                    CornerRadius="6" Margin="14,10,14,0" Padding="14,10"
                    IsVisible="{Binding IsAsking}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Question}" FontSize="12.5" Foreground="#F0D9A8"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="PrimaryButton" Content="{Binding [Run.AskRetry], Source={x:Static loc:Strings.Current}}"
                                Command="{Binding AnswerCommand}" CommandParameter="retry" />
                        <Button Classes="FlatButton" Content="{Binding [Run.AskSkip], Source={x:Static loc:Strings.Current}}"
                                Command="{Binding AnswerCommand}" CommandParameter="skip" />
                        <Button Classes="FlatButton" Content="{Binding [Run.AskStop], Source={x:Static loc:Strings.Current}}"
                                Command="{Binding AnswerCommand}" CommandParameter="stop" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== Footer ===================== -->
            <Button Grid.Row="4" Classes="FlatButton" HorizontalAlignment="Right" Margin="14,12,14,14"
                    Content="{Binding [Run.Close], Source={x:Static loc:Strings.Current}}"
                    Command="{Binding CloseCommand}" />
        </Grid>
    </Border>
</Window>
