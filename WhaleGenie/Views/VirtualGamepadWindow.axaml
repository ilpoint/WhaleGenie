<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="380"
        x:Class="WhaleGenie.Views.VirtualGamepadWindow"
        Title="WhaleGenie"
        Width="560" Height="380"
        MinWidth="480" MinHeight="330"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource AppBackdrop}">

    <Window.Styles>
        <!--
          手柄上的一个键：度量与四态并给 `Button.Secondary`（H30 一致、字号 12 → 13），
          这里只留三样它给不了的：`MinWidth` 是"窄键也要能看清字"的存量度量；按下那个橙与禁用态
          的底是这一族自己的表达，**等"按下＝强调"定案再收**。
        -->
        <!-- 只剩一条：`MinWidth` 是"窄键也要能看清字"的存量度量，宽度不在三档里，记缺变体。
             按下用 `AccentFillPressed`（品牌橙就是它，静息强调底是另一支），禁用态直接用
             `Secondary` 自带的 `TextDisabled` / `SurfaceControl`——窗口里那两处是临时值，不成档。 -->
        <Style Selector="Button.Secondary">
            <Setter Property="MinWidth" Value="40" />
        </Style>
        <Style Selector="Button.Secondary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillPressed}" />
        </Style>

    </Window.Styles>

    <Grid RowDefinitions="38,*">

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="{DynamicResource AppChrome}" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                <Image Source="/Assets/WhaleGenie.png" Width="22" Height="22" Stretch="Uniform" />
                <TextBlock Text="{Binding [GamepadPad.Title], Source={x:Static loc:Strings.Current}}"
                           Foreground="{DynamicResource AppText}" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="2" Classes="Chrome Icon" Name="CloseButton"
                    Width="30" Height="24" Padding="0" Margin="8,0" VerticalAlignment="Center">
                <views:IconView Width="10" Height="10" Stroke="{DynamicResource AppText}" StrokeThickness="1.2" FitToBounds="True" Data="{x:Static vm:AppIcons.X}" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="16,12,16,16" Spacing="10">
            <TextBlock Name="Hint" Foreground="{DynamicResource AppMuted}" FontSize="12" TextWrapping="Wrap" />

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20" Margin="0,4,0,0">

                <!-- Left hand: the trigger and bumper over the stick and the d-pad, the way they
                     sit under the fingers. -->
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="Secondary" Content="LT" Tag="lt" Width="84" />
                        <Button Classes="Secondary" Content="LB" Tag="lb" Width="84" />
                    </StackPanel>

                    <Button Classes="Secondary" Content="LS" Tag="ls" Width="120" Height="52" />

                    <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="4" RowSpacing="4" HorizontalAlignment="Center">
                        <Button Grid.Column="1" Classes="Secondary" Content="↑" Tag="up" Width="40" />
                        <Button Grid.Row="1" Classes="Secondary" Content="←" Tag="left" Width="40" />
                        <Button Grid.Row="1" Grid.Column="2" Classes="Secondary" Content="→" Tag="right" Width="40" />
                        <Button Grid.Row="2" Grid.Column="1" Classes="Secondary" Content="↓" Tag="down" Width="40" />
                    </Grid>
                </StackPanel>

                <!-- The middle of the pad: the two small buttons either side of the guide. -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <Button Classes="Secondary" Content="Back" Tag="back" Width="58" />
                        <Button Classes="Secondary" Content="Start" Tag="start" Width="58" />
                    </StackPanel>
                    <Button Classes="Secondary" Content="Guide" Tag="guide" Width="122"
                            HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Right hand: the same arrangement, with the four face buttons and the right
                     stick in place of the d-pad and the left one. -->
                <StackPanel Grid.Column="2" Spacing="8" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="Secondary" Content="RT" Tag="rt" Width="84" />
                        <Button Classes="Secondary" Content="RB" Tag="rb" Width="84" />
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="4" RowSpacing="4" HorizontalAlignment="Center">
                        <Button Grid.Column="1" Classes="Secondary" Content="Y" Tag="y" Width="40" />
                        <Button Grid.Row="1" Classes="Secondary" Content="X" Tag="x" Width="40" />
                        <Button Grid.Row="1" Grid.Column="2" Classes="Secondary" Content="B" Tag="b" Width="40" />
                        <Button Grid.Row="2" Grid.Column="1" Classes="Secondary" Content="A" Tag="a" Width="40" />
                    </Grid>

                    <Button Classes="Secondary" Content="RS" Tag="rs" Width="120" Height="52" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
