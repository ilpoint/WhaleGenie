<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="210"
        x:Class="WhaleGenie.Views.ConfirmDialog"
        x:DataType="vm:ConfirmDialogViewModel"
        Title="WhaleGenie"
        Width="460" Height="{Binding WindowHeight}"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource SurfaceWindow}">

    <Design.DataContext>
        <vm:ConfirmDialogViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="38,*,Auto">
        <Grid Grid.Row="0" Background="{DynamicResource SurfaceChrome}" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                <Image Source="/Assets/WhaleGenie.png" Width="22" Height="22" Stretch="Uniform" />
                <TextBlock Classes="Title" Text="{Binding Header}" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="2" Classes="Ghost" Name="CloseButton"
                    Margin="8,0" VerticalAlignment="Center">
                <views:IconView Width="10" Height="10" Stroke="{DynamicResource TextSecondary}"
                                StrokeThickness="1.2" FitToBounds="True" Data="{x:Static vm:AppIcons.X}" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="20,16,20,0" VerticalScrollBarVisibility="Auto">
            <TextBlock Classes="FieldLabel" Text="{Binding Message}" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="20,0,20,20">
            <Button Classes="Primary" Content="{Binding PrimaryLabel}" MinWidth="92"
                    Command="{Binding PrimaryCommand}" />
            <Button Classes="Secondary" Content="{Binding SecondaryLabel}" MinWidth="92"
                    IsVisible="{Binding HasSecondary}" Command="{Binding SecondaryCommand}" />
            <Button Classes="Secondary" MinWidth="92"
                    Content="{Binding CancelText}"
                    IsVisible="{Binding ShowCancel}"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
