<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:cp="using:Avalonia.Controls"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="620"
        x:Class="WhaleGenie.Views.ThemePaletteWindow"
        x:DataType="vm:ThemePaletteViewModel"
        Title="WhaleGenie"
        Width="780" Height="680"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource AppBackdrop}">

    <Design.DataContext>
        <vm:ThemePaletteViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.TitleBarButton">
            <Setter Property="Background" Value="{DynamicResource AppControl}" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.TitleBarButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Button.ColorRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.ColorRow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Button.ColorRow.selected">
            <Setter Property="Background" Value="{DynamicResource AppSelected}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
        </Style>
        <Style Selector="TextBlock.GroupName">
            <Setter Property="Foreground" Value="{DynamicResource AppMuted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,12,0,5" />
        </Style>
        <Style Selector="Button.FlatButton">
            <Setter Property="Background" Value="{DynamicResource AppControl}" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.FlatButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="38,*,Auto">
        <Grid Grid.Row="0" Background="{DynamicResource AppChrome}" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                <Image Source="/Assets/WhaleGenie.png" Width="22" Height="22" Stretch="Uniform" />
                <TextBlock Text="{Binding [Theme.Palette.Title], Source={x:Static loc:Strings.Current}}"
                           Foreground="{DynamicResource AppText}" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="2" Classes="TitleBarButton" Name="CloseButton"
                    Margin="8,0" VerticalAlignment="Center">
                <views:IconView Width="10" Height="10" Stroke="{DynamicResource AppText}"
                                StrokeThickness="1.2" FitToBounds="True" Data="{x:Static models:AppIcons.X}" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="270,16,*" Margin="16">
            <Border Background="{DynamicResource AppSurface}" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,4,6,8">
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThemeColorGroupViewModel">
                                    <StackPanel>
                                        <TextBlock Classes="GroupName" Text="{Binding Label}" />
                                        <ItemsControl ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ThemeColorEntryViewModel">
                                                    <Button Classes="ColorRow"
                                                            Classes.selected="{Binding IsSelected}"
                                                            Click="OnSelectColor">
                                                        <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="7">
                                                            <Border Width="18" Height="18" CornerRadius="4"
                                                                    Background="{Binding Swatch}"
                                                                    BorderBrush="{DynamicResource AppBorder}"
                                                                    BorderThickness="1" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                                       Foreground="{DynamicResource AppText}"
                                                                       FontSize="12.5" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Hex}"
                                                                       Foreground="{DynamicResource AppMuted}"
                                                                       FontSize="11.5" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource AppSurface}" CornerRadius="6" Padding="16">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                    <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock Text="{Binding SelectedEntry.Label}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextStrong}" />
                        <TextBlock Text="{Binding SelectedEntry.Hex}" FontSize="12"
                                   Foreground="{DynamicResource AppMuted}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding [Theme.Base], Source={x:Static loc:Strings.Current}}"
                                       Foreground="{DynamicResource AppMuted}" FontSize="12.5"
                                       VerticalAlignment="Center" />
                            <ToggleSwitch IsChecked="{Binding BaseLight}"
                                          OnContent="{Binding [Theme.Base.Light], Source={x:Static loc:Strings.Current}}"
                                          OffContent="{Binding [Theme.Base.Dark], Source={x:Static loc:Strings.Current}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding [Theme.Base.Hint], Source={x:Static loc:Strings.Current}}"
                                   Foreground="{DynamicResource AppMuted}" FontSize="11.5"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <cp:ColorView Grid.Row="2" Color="{Binding SelectedEntry.Color, Mode=TwoWay}"
                                  IsAlphaEnabled="False" IsAlphaVisible="False"
                                  IsColorPreviewVisible="True" IsColorPaletteVisible="True"
                                  IsColorSpectrumVisible="True" IsHexInputVisible="True"
                                  IsColorComponentsVisible="True" IsComponentSliderVisible="True"
                                  IsComponentTextInputVisible="True"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                        <Button Classes="FlatButton" Height="32"
                                Content="{Binding [Theme.ResetColor], Source={x:Static loc:Strings.Current}}"
                                Command="{Binding ResetSelectedCommand}" />
                        <Button Grid.Column="1" Classes="FlatButton" Height="32"
                                Content="{Binding [Theme.ResetAll], Source={x:Static loc:Strings.Current}}"
                                Command="{Binding ResetAllCommand}" />
                        <Button Grid.Column="3" Classes="FlatButton" Height="32"
                                Content="{Binding [Theme.Done], Source={x:Static loc:Strings.Current}}"
                                Click="OnDone" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Margin="18,0,18,14" TextWrapping="Wrap"
                   Foreground="{DynamicResource AppMuted}" FontSize="11.5"
                   Text="{Binding [Theme.Palette.Hint], Source={x:Static loc:Strings.Current}}" />
    </Grid>
</Window>
