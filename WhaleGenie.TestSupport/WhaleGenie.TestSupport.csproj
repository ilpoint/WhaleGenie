<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The pretend devices and the sample files every suite reaches for. It is a library rather than a
    test project so both suites can share one set: the engine's checks drive these fakes, and the
    adapter's checks drive the same engine through them before reaching a real device.
  -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!--
      It carries xunit for the trait that decides whether a sample file is there, so the test
      platform would otherwise try to run this library as a suite of its own and stop with a
      missing assembly. Nothing here is a test: there is no [Fact] to run and no host to start.
    -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The samples are checked by a trait, so the suite's vocabulary travels with them. -->
    <PackageReference Include="xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\WhaleGenie.Core\WhaleGenie.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fakes are the suite's own furniture: both test projects see inside them. -->
    <InternalsVisibleTo Include="WhaleGenie.Core.Tests" />
    <InternalsVisibleTo Include="WhaleGenie.Platform.Tests" />
  </ItemGroup>

</Project>
