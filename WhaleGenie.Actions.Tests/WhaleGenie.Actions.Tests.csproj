<Project Sdk="Microsoft.NET.Sdk">

  <!--
    动作表单与取值：动作对话框、页面归属、返回值与各种拾取器、试看。
  -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\WhaleGenie\WhaleGenie.csproj" />
    <ProjectReference Include="..\WhaleGenie.App.TestSupport\WhaleGenie.App.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="WhaleGenie.TestSupport" />
    <Using Include="WhaleGenie.Tests.Support" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The harness is compiled into each suite rather than shared as a library: the headless session
      belongs to the assembly that runs the checks, and a session borrowed from another assembly is
      a session that tears down under the wrong one. One source file, one copy per suite.
    -->
    <Compile Include="..\WhaleGenie.Tests\TestApp.cs" Link="Support\TestApp.cs" />
    <Compile Include="..\WhaleGenie.Tests\SharedState.cs" Link="Support\SharedState.cs" />
    <Compile Include="..\WhaleGenie.Tests\Ui.cs" Link="Support\Ui.cs" />
    <Compile Include="..\WhaleGenie.Tests\VariableChoicesForChecks.cs" Link="Support\VariableChoicesForChecks.cs" />
    <Compile Include="..\WhaleGenie.Tests\RunnerLedger.cs" Link="Support\RunnerLedger.cs" />
  </ItemGroup>

</Project>
