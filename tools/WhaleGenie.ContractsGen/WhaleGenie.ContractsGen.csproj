<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reads the [BridgeContract] records and writes one TypeScript module. The output is checked in:
    the web build uses it, and a C# case fails when the two drift apart. Runs on the base library,
    so it never pulls a window toolkit or the document model into the generator.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WhaleGenie.ContractsGen</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WhaleGenie.Contracts\WhaleGenie.Contracts.csproj" />
  </ItemGroup>

</Project>
