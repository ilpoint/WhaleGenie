<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reads a saved .wgmacro package without unpacking it and lists the row cells that no longer
    carry the shape they were written as: a region name stored as text, a formula flattened into a
    line, an argument that now reads as a literal. It only reports; nothing is rewritten.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <RootNamespace>WhaleGenie.ProjectScan</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WhaleGenie.Domain\WhaleGenie.Domain.csproj" />
  </ItemGroup>

</Project>
