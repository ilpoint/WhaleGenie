<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      The engine is plain .NET: nothing it does needs Windows, and saying so is what lets a headless
      run, a batch job or a test that only reads a macro use it without a desktop. The Windows work
      lives in the adapter and capture projects, which reference this one rather than the other way
      round.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Nothing native behind it, so the assembly stays platform-neutral. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!--
      The public surface is what this assembly is for, so it ships with its own documentation. The
      missing comments are suppressed rather than pretended away: the debt is written down in
      docs/architecture/core-api.md, and the warnings that do fire are the ones about wrong
      `<param>` names and dead `<see cref>`s, which are real defects in the text that is there.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The engine is the one part of the product that is a library in its own right. -->
    <IsPackable>true</IsPackable>
    <PackageId>WhaleGenie.Core</PackageId>
    <Description>鲸灵（WhaleGenie）的宏引擎：动作语义、表达式、变量、设备契约与录制翻译。</Description>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ilpoint/WhaleGenie</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ilpoint/WhaleGenie.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!--
      The package's own front page. It is the repository copy rather than a second text: a readme
      that only exists inside the package goes stale without anyone noticing.
    -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      Outside bin/ and obj/ on purpose: the package is a deliverable of the repository, not an
      intermediate of one build, and the delivery notes point at this directory.
    -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\dist\nuget</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The engine reads and writes CSV files itself: a table step is about the data, not about the
      machine, so the parser stays here rather than moving down with the Windows adapters.
    -->
    <PackageReference Include="CsvHelper" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine tests look at how a step's input is routed between the devices. -->
    <InternalsVisibleTo Include="WhaleGenie.Core.Tests" />
    <InternalsVisibleTo Include="WhaleGenie.TestSupport" />
    <InternalsVisibleTo Include="WhaleGenie.Platform.Tests" />
    <!-- The Windows adapters read the engine's key table; nothing else of Core is theirs to use. -->
    <InternalsVisibleTo Include="WhaleGenie.Platform.Windows" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The action facts travel with the engine: a headless run, a design-time check and the editor
      all read the same file, so none of them can answer from a different parameter declaration.
    -->
    <EmbeddedResource Include="Execution\ActionSemantics.json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
