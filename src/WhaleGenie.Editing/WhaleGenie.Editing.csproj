<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The editor without a window: document models and the headless sessions the page talks to.
    The base library, the contracts, the document model and the engine's device vocabulary belong
    here; Avalonia, windows and WebView stay in the UI project. The generator reads only Contracts,
    so this project can be tested without starting the application.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <RootNamespace>WhaleGenie.Editing</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WhaleGenie.Contracts\WhaleGenie.Contracts.csproj" />
    <ProjectReference Include="..\WhaleGenie.Domain\WhaleGenie.Domain.csproj" />
    <ProjectReference Include="..\WhaleGenie.Localization\WhaleGenie.Localization.csproj" />
    <ProjectReference Include="..\..\core\src\WhaleGenie.Core\WhaleGenie.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WhaleGenie" />
    <InternalsVisibleTo Include="WhaleGenie.App" />
    <InternalsVisibleTo Include="WhaleGenie.Tests" />
    <InternalsVisibleTo Include="WhaleGenie.Editor.Tests" />
    <InternalsVisibleTo Include="WhaleGenie.Actions.Tests" />
  </ItemGroup>

</Project>
