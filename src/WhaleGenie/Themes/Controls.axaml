<Styles xmlns="https://github.com/avaloniaui"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:conv="using:WhaleGenie.Converters"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!--
          步骤树的一行。这一族的模板要自己给，因为缩进那件事盖不住：主题把"层级 × 16"写死在
          模板的 Margin 里，外面改资源改不动（试过 App 级资源与样式，量出来仍然是 16）。既然
          层级要靠线读，缩进步长、展开钮、选中态就得在同一个模板里，改一处是一处。

          行本身不画底、不画边：选中与悬停由行里的卡片（`Border.StepLine`）表达，树再画一层就是
          两套高亮叠在一起。`SelectionIndicator` 那条小竖条因此不存在了。
        -->
        <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource SurfacePanel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusOverlay}" />
            <Setter Property="Padding" Value="{DynamicResource Space1}" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalAlignment}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            ItemsPanel="{TemplateBinding ItemsPanel}"
                                            KeyboardNavigation.TabNavigation="Continue"
                                            Grid.IsSharedSizeScope="True" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

    </Styles.Resources>

    <!--
      指针停在某样东西上时浮出来的那一块。它画在这里而不是某个窗口里：提示框不画在所属窗口
      内部，它站在自己的弹层里，窗口级的样式够不到它；应用级的样式才跟着弹层走。
    -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfacePanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusContainer}" />
        <Setter Property="Padding" Value="10,9" />
    </Style>

    <!--
      数字输入框没有上下按钮。它们原来折进取焦才开的弹层，为的是一行四个数字时不吃宽度；可弹层
      开在框的右端，正好压住框里的数字：76 宽的抖动框只剩两个数字的位置。带片的数字格现在把那
      一端留给「取值」片（见下面的 `HasChip`），数字照旧手打，要算式的走「取值」。
    -->
    <Style Selector="fa|FANumberBox">
        <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
    </Style>

    <!--
      带片的数字框：片浮在框的右端，字让开它。数字框的模板只有内嵌**左**内容的位置，右侧那一格
      被上下按钮占着，所以这里换一种让法——改内层输入框的右内边距，与 `TextBox.HasChip` 同一个数。
      片本身是这个框的兄弟（在同一个格子里右对齐），画在框的上面，读起来仍在框里。
    -->
    

    <!--
      层 3：我们自己画的族。颜色全部取自 Themes/Tokens.axaml，能由层 1（FluentKeys.axaml）给的
      外观一律不在这里重写——`Button.Secondary` / `TextBox.Field` / `ComboBox.Field` 的外观已经
      实测跟着层 1 走（见 LayerOneTests），这里只给它们度量。

      四条硬规则，写之前先看：
      1. **`Margin` 先归类，再决定怎么写。** 五种形态，只有第二、四、五种允许落在元素上：

         形态                                        写法
         兄弟之间的横向间隙（图标与文字、钮与钮）      父容器的 `Spacing`
         兄弟之间的纵向间隙（块与块之间）              元素级字面，两个以上窗口同值则升成 `Gap*`
         行/容器的左右内缩（标题栏那 12 与 8）         父容器的 `Padding`，不是元素 `Margin`
         块在列里的缩进（`8,0,0,0`，18 处 / 6 窗）     元素级字面：垂直栈给不了单个孩子的缩进
         推几个像素去对齐（`2,4,0,0`）                手调痕迹：记观察项，问它在修什么

         **横向间隙不升令牌。** 它是"两个孩子之间隔多少"，由父容器一个数字说了算；`Spacing` 改一次，
         同排所有间隙一起变，而令牌只能管到被写在元素上的那一处。`Margin="0,0,8,0"` 写在图标上，
         意思是"图标与后面的字隔 8"——那是 `Spacing="8"`，不是图标的边距。
         注意载体：`Spacing` 是 `StackPanel` 的，`ColumnSpacing` 是 `Grid` 的，不能互换着写。

         纵向那两条之所以留在元素上，是因为**没有父容器能承担**：区块之间不相邻，标签与控件之间
         隔着一层模板。**新增 `Gap*` 之前，先说明为什么 `Spacing` 做不到。**
         这条查的是"这个间隙有没有名字、该由谁承担"，不是"有没有写 Margin"。
         理由不是洁癖：`Margin="2,4,0,0"` 是"用间距调对齐"的症状，收样式前满地都是。
      2. 不写裸值——"裸值"指十六进制与数字。颜色、字号、圆角、内边距四类一律引令牌；`Transparent`
         是语言常量、不是我们定的颜色，可以直接写（它没有值可漂移，也不参与对比度核算）。高度与宽度允许字面值，但只能出现在
         本文件的族定义里、一族一次；`Views/` 里不给族成员写 `Height` / `Width`。
         **存量不硬删。** `Views/` 里现存的元素级尺寸是"缺一个变体"的证据，迁移时**一处都不删、只记录**：
         同值出现在三个以上窗口 = 该建类，进"缺变体"清单；只出现在一两处 = 例外，留在元素上。
         删掉它们等于把尺寸掉回类的默认值——那是二十二次临时改设计，不是一次设计决定。
      3. `Opacity` 只允许 `CardOpacity` 那一个例外——它是内容状态，不是造色。
      4. 每个自定义类**要么自己有一条 `:pointerover`，要么在下面「层 1 承担」清单里登记**。
         两份都不在 = 漏写，`ControlsRegistryTests` 会红。登记不是免死金牌：登记进去的类必须能在
         `FluentKeys.axaml` 里找到同族前缀的键（`Button.Secondary` → `Button*`），否则同样是红——
         写一句登记、什么都不做、看着还合规，比漏写更难发现。
         键盘：控件族不另写 `:focus-visible`，焦点环由模板的 `FocusAdorner` 给（层 1 的
         `SystemControlFocusVisual*` 两个刷子）；**自绘元素**（`Border.Card.Thin`、
         `Border.Card.Selectable`、`Ellipse.Dot`、`GridSplitter.Split`）不是控件、没有模板，必须
         自己 `Focusable="True"` + 同款 `FocusAdorner`，否则键盘走到那里就断了。

      5. **态只改颜色，不改尺寸。** 需要更粗的边，静息态就把同样粗细的 `Transparent` 占上；
         需要更大的内边距，静息态就留出来。态里改尺寸会让内容在切换的瞬间跳动，而跳动在截图里
         看不出来——只有并排对比或录屏才看得见。判据：**"某个态改了尺寸"本身就是一个信号**，
         要么静息态已经预留，要么这个态根本不该改尺寸。
      6. **两个状态抢同一个通道时，用 `:not()` 排掉一个，不要靠书写顺序。** 例如悬停与选中都改底：
         `Border.Card.Selectable:pointerover:not(.selected)`。写在后面的一方赢只是文件顺序的巧合，
         重排一下文件就变了；而"选中之后指针压上去还是选中的样子"本来就是要表达的意思。

      两张清单（`ControlsRegistryTests` 读它们，一行一个"类型.类"）：

      `LAYER1` 表示这一类的四态由 `FluentKeys.axaml` 的键给，这里只写度量。**必须带键家族前缀**
      ——Fluent 的键不总是照控件名走（输入框的键叫 `TextControl*`，不叫 `TextBox*`），猜错的登记
      等于什么都没登记。

      `STATIC` 表示这一类根本没有交互状态（文本、纯容器），不是"漏了 `:pointerover`"。

      `VARIANT` 是**变体词**：`Success` / `Warning` 这类颜色档位。它们和状态词一样可以被剥离，
      但**不进 `STATE`**——通用词进 `STATE` 会把别的族从检查范围里滤掉（`STATE Dot.Success` 那次）。

      `STATE` 表示这一类是**状态类**（选中、问题、占用），不自己定义四态，是所属类的修饰。

      窄化类**不需要登记**：`Button.Tab.Root.Compact` 这类靠前缀
      规则由父类覆盖（守卫里 `Covered` 那段），登记反而会把"它有自己的四态"和"它继承父类"混成
      一件事。

      LAYER1 Button.Secondary Button
      LAYER1 TextBox.Field TextControl
      LAYER1 ComboBox.Field ComboBox
      LAYER1 AutoCompleteBox.Field TextControl
      STATIC ListBox.Panel
      STATIC Border.Badge
      STATIC Border.Badge.Danger
      STATIC Border.Badge.Success
      STATIC Border.Badge.Warning
      STATIC Border.Panel
      STATIC Border.Readout
      STATIC Border.Sunken
      STATIC ListBox.List
      STATIC ListBox.List.Boxed
      STATIC CheckBox.Field
      STATIC Button.Square
      STATIC TextBlock.Mono
      STATIC TextBlock.Body
      STATIC TextBlock.Code
      STATIC TextBox.Code
      STATIC StackPanel.Empty
      STATIC TextBlock.Caption
      STATIC TextBlock.Hint
      STATIC TextBlock.Problem
      STATIC TextBlock.SectionHeader
      STATIC TextBlock.Title
      STATE Rejected
      STATE chosen
      STATE problem
      VARIANT Success
      VARIANT Warning
      VARIANT Danger
      VARIANT Info
      VARIANT Accent
      VARIANT Disabled
      STATE selected
      STATE Occupied
      STATE Picked
      STATE DropTarget
      STATE Current

      这份文件按批落：这一批只有 `ConfirmDialog` 用到的五个类，用来把"层 2 令牌 → 层 3 类 →
      窗口"这条链跑通。批量的族（`Tab.*`、`Border.*`、`ListBox.*`、`Picker*`）随后按规范表补。
    -->

    <Style Selector="TextBlock.Title">
        <Setter Property="FontSize" Value="{DynamicResource UiSubtitleSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource UiSubtitleLine}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
      两类 13px 的字分得很细，因为差别在**下边距**而不在字号：标签下面紧跟着就是它管着的控件，
      所以标签自己带 `Space2`；成段的说明与对话框正文下面不该多出一道空白，所以 `Body` 不带。
      借 `FieldLabel` 写正文会让每段正文底下多 8px，看着像排版松了，其实是类的语义用错了。
    -->
    

    <!--
      图标块与其余六类。修饰型（`Ghost.Tiny`）同样用类叠加写（`Classes="Ghost Tiny"`），
      样式里只写与父类不同的那几格。
    -->
    <!--
      The plain button's states. The theme paints its own three from the `ButtonBackground*` keys,
      but those setters live inside its ControlTheme: a style out here cannot reach into that
      template, and a check cannot drive them either. Writing the same three states here makes the
      token the one source — the control's Background changes, and the template's
      `{TemplateBinding Background}` carries it to the face.
    -->
    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceControlHover}" />
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource SurfaceControlPressed}" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Background" Value="{DynamicResource SurfaceControl}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
    </Style>

    
    
    
    

    <!--
      磁贴：`.Occupied` 只改底（这一格有人占了），`.Current` 只改描边（这一格是当前选择的）——
      又是"两个状态各走一个通道"，同 `.Card.Selectable` 的做法。
    -->
    <!--
      标题栏上的**图标**钮：固定 30×24、`Pad0`。图标宽度本来就不同（关窗 10、最小化 8），
      靠 `PadChrome` 自适应会让一排按钮参差不齐——图标钮是固定方形，不是文字钮的那一族。
    -->
    
    <!-- 大的工具钮：拾取器与运行窗里那种比图标大一圈的按钮。尺寸是一个维度，强度是另一个。 -->
    

    <!-- `Quiet` = 更弱的工具钮：前景降一档，悬停不再提亮到 `TextPrimary`。 -->
    
    

    
    

    <!--
      标题栏右端那颗关闭键，尺寸按 WinUI 的 caption 走（46×32），与左边那一排工具钮不是同一族：
      工具钮是"在这里做点什么"，关闭键是"离开这里"。`Close` 那一档只为它自己：悬停底换成
      `CaptionCloseHover`（WinUI 的关窗红），字形同时转白——红底上留深色字，浅色主题里会糊。
      图标用 `IconView` 画，笔画是它自己的属性，不是 `Foreground`，所以这里连它一起给。

      直角不是漏写圆角：系统画的 caption 按钮就是一块贴顶的直角热区（悬停时整块 46×32 变色），
      自绘的置顶钮挨着它们，圆角会让它看起来像浮在标题栏上的一张卡片。三档圆角管的是内容区里的
      控件，标题栏按钮跟系统同形，是这条契约唯一的例外。
    -->
    <Style Selector="Button.Caption">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="{DynamicResource Pad0}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.Caption views|IconView">
        <Setter Property="Stroke" Value="{DynamicResource TextPrimary}" />
    </Style>
    <!--
      标题栏上带状态的钮（目前是置顶）：尺寸、底色、悬停都和系统按钮一致，只有"开着"这一档多一笔强调色，
      图标本身在代码里换（`Pin` ↔ `PinOff`），所以认得出当前是哪一档。
    -->
    
    
    <Style Selector="Button.Caption:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceControlHover}" />
    </Style>
    <Style Selector="Button.Caption:pressed">
        <Setter Property="Background" Value="{DynamicResource SurfaceControlPressed}" />
    </Style>
    <Style Selector="Button.Caption:disabled">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
    </Style>

    <Style Selector="Button.Caption.Close:pointerover">
        <Setter Property="Background" Value="{DynamicResource CaptionCloseHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
    </Style>
    <Style Selector="Button.Caption.Close:pressed">
        <Setter Property="Background" Value="{DynamicResource CaptionCloseHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
    </Style>
    <!--
      这两笔必须落在模板里的 `ContentPresenter` 上：库把它这个态的底色写在自己的主题里，
      控件上的 `Background` 到了那个态带不进去（量过：只写在控件上，指针压上去是主题的灰
      `#3D3D3D`；写到 presenter 上才是 `#C42B1C`，深浅两套都是）。
    -->
    <Style Selector="Button.Caption.Close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CaptionCloseHover}" />
    </Style>
    <Style Selector="Button.Caption.Close:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CaptionCloseHover}" />
    </Style>
    <Style Selector="Button.Caption.Close:pointerover views|IconView">
        <Setter Property="Stroke" Value="{DynamicResource TextOnAccent}" />
    </Style>
    <Style Selector="Button.Caption.Close:pressed views|IconView">
        <Setter Property="Stroke" Value="{DynamicResource TextOnAccent}" />
    </Style>

    <!--
      16 平方的极小图标钮：卡片角落、行尾那些地方用它。尺寸自己给，底色与禁用态沿用 `Ghost`；
      悬停与按下只把前景转成 `AccentText`——16px 的钮上"暗一点→亮一点"几乎看不出来，转色才是
      唯一"这里能点"的信号。
    -->
    
    
    

    <!--
      空状态：图标 + 标题 + 说明竖着排。它是容器，`Spacing` 与上下留白由它给；里面三类文字各用
      `TextBlock.*` 的类，**不给 `StackPanel` 写 `Foreground`**——它没有这个属性，写了静默无效。
    -->
    <Style Selector="StackPanel.Empty">
        <Setter Property="Spacing" Value="{DynamicResource StackGap}" />
        <Setter Property="Margin" Value="{DynamicResource GapEmpty}" />
    </Style>

    <!--
      状态点：8 平方的圆，颜色由类给。`Fill` 是 `Shape` 的通道——给它写 `Foreground` 语法合法、
      静默无效（`dev.md` 第 4 条），所以五个档位各写一条 `Fill`。
    -->
    
    
    
    
    
    

    <!--
      输入族。三件输入框的外观四态全部由层 1 的 `TextControl*` / `ComboBox*` / `AutoCompleteList*`
      给（`LayerOneTests` 实测跟随），这里只给度量——**有类名、只是不写状态**，这两件事不一样：
      没有类名，窗口里就没有东西可挂。

      `TextBox.Code` 明说没有 hover：等宽代码块是只读的阅读区，指针压上去不该变。
    -->
    <Style Selector="TextBox.Field">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="{DynamicResource PadField}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{DynamicResource UiBodySize}" />
    </Style>

    <!-- 24 这一档必须留：公式行里用 30 会把整行撑高 6px。 -->
    

    <Style Selector="ComboBox.Field">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="{DynamicResource PadField}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{DynamicResource UiBodySize}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- 与 `TextBox.Field.Cell` 对称的 24 档：公式行里两种格子并排，差 6px 看得出来。 -->
    

    <!--
      自动补全里面也有一支 `TextBox`，格子该由它来画：外面这层只占 30 的高度，自己不再画边框。
      原来只清了内层的底、没管它的高度——内层按自己的最小高度排下来比 30 高，上下两条边被裁掉，
      界面上就剩一对"括号"（断点窗的条件框、动作表单的表达式框都是这样，截图里看得最清楚），
      而且内层的底被清成透明后连格子底色也没了。度量交给内层，边框就完整回来。
    -->
    <Style Selector="AutoCompleteBox.Field">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="AutoCompleteBox.Field TextBox">
        <Setter Property="Padding" Value="{DynamicResource PadField}" />
        <Setter Property="FontSize" Value="{DynamicResource UiBodySize}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!--
      嵌在输入框里的那枚按钮。格子里的按钮不能靠悬停才认得出，所以它带字、有边，像一枚小片；
      右端的空白由 `HasChip` 让出来，字才不会跑到它下面去。
    -->
    
    
    <!-- 值的读法：一个名字是一块，块里就是它的名字；文字是文字，不带框。
         一块与一行文字之间只留字距，让读的人先看见句子，再看见句子里的名字。 -->
    
    
    
    

    <!-- 一格值里的一段文字：只读显示，看起来只是字。名字各占一块，中间不需要空框来填。 -->
    
    
    
    

    <!-- 一块地方装着读法本身：它不像输入框，但点一下就是输入框。 -->
    
    

    
    

    <!-- 一列材料：行与行之间只为可读留一点缝，行自己不带内边距。 -->
    <Style Selector="ListBox.Panel > ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 一条分组芯片：几个词排一行，按下一个列表就换。 -->
    
    
    
    

    <Style Selector="TextBox.Code">
        <Setter Property="Padding" Value="{DynamicResource PadField}" />
        <Setter Property="MinHeight" Value="58" />
        <Setter Property="FontFamily" Value="{DynamicResource UiCodeFont}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>

    

    <!--
      勾选项是"字段族"的成员，不是新的字号档：它与 `TextBox.Field` / `ComboBox.Field` 常常同排、
      同在一个面板里，文字本来就该跟输入框一样是 `UiBody`(13)。之前这一族缺它，不是设计选择，是漏了。
      勾选框本身的几何交给 Fluent 模板，我们只给字号与前景；四态里只有禁用要写。
    -->
    <Style Selector="CheckBox.Field">
        <Setter Property="FontSize" Value="{DynamicResource UiBodySize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="CheckBox.Field:disabled">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
    </Style>

    <!-- 输入框形状的按钮：它没有层 1 可借，所以四态自己写。 -->
    <Style Selector="Button.Field">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="{DynamicResource PadField}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{DynamicResource UiBodySize}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceField}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.Field:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceControlHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlHover}" />
    </Style>
    <Style Selector="Button.Field:pressed">
        <Setter Property="Background" Value="{DynamicResource SurfaceControlPressed}" />
    </Style>
    <Style Selector="Button.Field:disabled">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    </Style>
    <StyleInclude Source="avares://WhaleGenie/Themes/Controls.Navigation.axaml" />
    <StyleInclude Source="avares://WhaleGenie/Themes/Controls.Badges.axaml" />
</Styles>
