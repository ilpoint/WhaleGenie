<Styles xmlns="https://github.com/avaloniaui"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:conv="using:WhaleGenie.Converters"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- 芯片：四态由层 1 的 `ToggleButton*` 给，这里只覆盖"选中"那一档。 -->
    
    


    <!-- 键位芯片：按下去要亮，所以四态自己写。 -->
    
    
    
    
    <!--
      键位芯片的选中态必须也写在**控件**这一层。模板把 presenter 的 `Background` 绑给控件自己的
      `Background`，那条绑定是"本地值"，样式写在 presenter 上会被它压掉——所以只写 presenter 的话，
      选中时屏幕上还是未选中的底色（实测读到 `#2A2A2A`，正是 `SurfaceField`）。
    -->
    
    

    <!--
      键帽：`Button` 侧的对应物。`ToggleButton.Chip.Key` 是同一个尺寸的开关版（键盘上的
      结束键用那个），而**按钮版一直缺着**——虚拟键盘那一族本来就有 138 处这样的键。
      尺寸 32×32 与开关版一致；按下走 `AccentFillPressed`（品牌橙就是它），不用 `AccentFill`
      ——后者是静息的强调底。
    -->
    
    
    
    

    <!-- 键帽的小字档：侧边那些长词的键，一格降字号，仍可读。 -->
    

    <!--
      文本族的其余七类。层次靠字号与字重，不靠亮度——`FieldLabel` + `FontWeight=600` 就是替掉原来那套
      "用更白的颜色表示强调"的做法。间距长在标题自己身上：上方与下方间隙不同，`Spacing` 给不了。

      `SectionHeader` 是 11px 的单行短标签，所以必须 `NoWrap`：这一类唯一的使用禁忌就是让它换行。
    -->
    

    

    <Style Selector="TextBlock.SectionHeader">
        <Setter Property="FontSize" Value="{DynamicResource UiCaptionSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource UiCaptionLine}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        <Setter Property="Margin" Value="{DynamicResource GapSectionHeader}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- 单行附注：与 `Hint` 同字号同色，只是不折行。用 `ColumnHeader` 顶替会让附注看起来像表头（那是 600 字重）。 -->
    

    <Style Selector="TextBlock.Problem">
        <Setter Property="FontSize" Value="{DynamicResource UiBodySmallSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource UiBodySmallLine}" />
        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
      说明性小字：11px、**400** 字重、三级灰。它和 `ColumnHeader` 同字号同颜色，差别就是字重——
      `ColumnHeader` 是"列的标题"（600），`Caption` 是"说明性的小字"（400）。中文里两个都叫小字，
      所以名字要能区分字重，`Caption` 比 `Small` 好。
      它立起来的依据是频次不是偏好：`10.5` 10 处 / 6 窗、`11px` 那 19 处 / 6 窗里有一部分是 400，
      这已经够"≥3 窗即常项"。
    -->
    <Style Selector="TextBlock.Caption">
        <Setter Property="FontSize" Value="{DynamicResource UiCaptionSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource UiCaptionLine}" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
    </Style>

    

    <!-- 等宽：数字要等比宽（`tnum`），否则表格里每行的小数点都会错开。 -->
    <Style Selector="TextBlock.Code">
        <Setter Property="FontFamily" Value="{DynamicResource UiCodeFont}" />
        <Setter Property="FontSize" Value="{DynamicResource UiBodySmallSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource UiBodySmallLine}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFeatures" Value="tnum" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!--
      拾取器的覆盖层。这一族的硬约束是**明暗同值、不跟随主题**：拾取器站着的时候，屏幕像素与它
      画出来的遮罩必须是同一件事，遮罩一跟着明暗变，取到的颜色与截出来的图就跟着变。令牌那边已经
      写在变体之外，用例钉住"切明暗后颜色相等"。

      读数条的双色描边（外 `PickerEdgeDark` + 内 `PickerEdgeLight`）一层 `Border` 画不出来——
      `Border` 只有一支 `BorderBrush`。按 `GridSplitter.Split` 的先例记成已知偏差：真要双色就得
      在窗口里叠两个元素，那是结构改动，迁移时再议。
    -->
    

    

    <Style Selector="Border.Readout">
        <Setter Property="Padding" Value="{DynamicResource PadChip}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="Background" Value="{DynamicResource PickerReadout}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBlock.Body">
        <Setter Property="FontSize" Value="{DynamicResource UiBodySize}" />
        <Setter Property="LineHeight" Value="{DynamicResource UiBodyLine}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.Hint">
        <Setter Property="FontSize" Value="{DynamicResource UiBodySmallSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource UiBodySmallLine}" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
      主按钮：层 1 给的是次按钮的样子，所以这一类必须把四个状态全部写满，漏一格就露 Fluent 默认。
      状态画在模板的 ContentPresenter 上（`Button:pointerover /template/` 那一条），只改控件自身的
      Background 在 hover 时不会有人读它。
    -->
    <!--
      **词表预留，无消费者**。等什么写成可判的：**等出现"可拖动的缩略图/比例手柄"时启用；
      否则它就是 `Ghost` 的重复**（4 条态，与 `Ghost` 同形但没有缩略图语义）。
    -->





    <Style Selector="Button.Primary">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="{DynamicResource PadControlWide}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="FontSize" Value="{DynamicResource UiBodySize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource AccentFill}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFill}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.Primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentFillHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillHover}" />
    </Style>
    <Style Selector="Button.Primary:pressed">
        <Setter Property="Background" Value="{DynamicResource AccentFillPressed}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillPressed}" />
    </Style>
    <Style Selector="Button.Primary:disabled">
        <Setter Property="Background" Value="{DynamicResource SurfaceControl}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    </Style>

    <!-- 次按钮：外观四个状态由层 1 的 Button* 键给，这里只给度量与字重。 -->
    <!--
      成块排列的次按钮（动作选择器里那一格一格的卡片）。
      **它只多一件事**：一格与下一格之间的缝（`Margin`）。标题色不用在这儿再给一遍——
      `Secondary` 那一族的四态前景色由层 1 给（`TextPrimary`），内层 `TextBlock` 继承它。
      原本这两件都写在元素上，同一个窗里就出现了"左栏写元素、右栏写类"的两套来源；
      搬到类里之后，尺寸的来源只剩一处。
      **缝保持 6，不改值**：先让"来源"统一，"值该多大"是另一件事，一次只改一件。
    -->
    

    <Style Selector="Button.Secondary">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="{DynamicResource PadControl}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="FontSize" Value="{DynamicResource UiBodySize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
      变量选择用的"片"：比动作卡片矮 2px。**28 是这一族的度量，不是这一处的例外**——
      它原本写在元素上，于是同一个窗里出现"左栏高度来自类、右栏写在元素"的两套来源。
      高度用 `Height`，并且**这一条必须排在 `Secondary` 之后**：Avalonia 对同是样式来源的 setter
      按"后写覆盖先写"决定，**不比类名个数**——写在前面时 `Secondary` 的 30 会赢，实测行距因此是 36 而不是 34。
    -->
    

    <!--
      更小的变量片：用在"这个变量被谁用过"那一列。**24 与 11.5 都保持原值**，
      只是从元素搬进类。**同样排在 `Chip` 之后**——它要压掉 `Chip` 的 28。
      类名用 `Dense` 而不是 `Compact`：`Compact` 是 `Tab.Root.Compact` 的词，**同一个词属于两族会让
      "这条选择器配不配得到元素"那条检查判错**（它按词匹配，分不清前缀链）。
    -->
    

    <!--
      分支还没填值：这一支现在谁都不应答，是一个该被看见的空缺。灰字说的和"值"是同一种语气，
      读的人会以为填好了；警示色说的是"这里还缺点东西"。
    -->
    


    <!-- 只有图标的动作钮（关窗、折叠）。底色透明，悬停靠叠层，所以它不必知道底下是什么颜色。 -->
    <!--
      圆形（药丸）修饰：只把圆角改成"半个高度"，形状与颜色分离。
      24 高的按钮配 12 的圆角正好是圆——**圆角是形状，不是值**，所以它单独一层，
      以后 32 高的按钮挂同一个类也还是圆的（值要跟着高度走，这里取 24 的一半）。
    -->
    

    <!--
      等宽修饰：**只设字体，不设前景色**。
      `TextBlock.Code` 把字体和颜色捆在一起，想要"等宽 + 主文字色"就得绕开它手写 `FontFamily`——
      本轮绕过三次之后把它单独拆出来。**等宽是字形，不该同时决定颜色。**
    -->
    <Style Selector="TextBlock.Mono">
        <Setter Property="FontFamily" Value="{DynamicResource UiCodeFont}" />
    </Style>

    <!--
      可点方块：图标砖。80×80 是族的度量，**图标 22、居中、无文字**，全名走 tooltip。

      **为什么没有文字**：砖上的标签是 Lucide 的枚举名（`CircleQuestionMark` 18 字符 ≈ 108px），
      而可用宽度只有 64px（80 − 8×2）。**那不是"标签挤了"，那是枚举名被截成残词**——
      `CircleQuestion…` / `…Mark` 对人没有意义。**要给文字，先得有给人看的短名**（见缺变体清单）。

      边是 1px `BorderSubtle`：**浅色主题下没有这道边，砖与底几乎同色**，一排砖会糊成一片。
    -->
    <Style Selector="Button.Square">
        <Setter Property="Width" Value="80" />
        <Setter Property="Height" Value="80" />
        <Setter Property="Padding" Value="{DynamicResource PadChip}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusContainer}" />
        <Setter Property="Background" Value="{DynamicResource SurfacePanel}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.Square:pointerover">
        <Setter Property="Background" Value="{DynamicResource OverlayHover}" />
    </Style>

    
    
    
    

    <!--
      标题栏上的动作钮，比 Ghost 宽一档、能带一个词。`Button*` 在层 1 是实心次按钮的样子，所以
      这一类必须显式把底改回透明，否则标题栏上会出现一排灰块。
    -->
    
    
    
    

    <!--
      页签三档。选中态用 `.selected` 类表达而不是伪类：这些是 `Button` 不是 `ToggleButton`，
      旧窗口本来就是用这个类标记当前页，换成伪类要先改调用点，而这一步只搬样式。

      下划线与左侧那条竖线的粗细是族的度量（2px / 3px），与高度同一类，按字面写；颜色才是令牌。
    -->
    
    
    
    
    

    <!-- 根页签的紧凑档：只改高度与字号，四态沿用 Root。`MinHeight` 而不是 `Height`，因为它要说几行。 -->
    

    <!--
      设置窗顶部三个分组页签的胶囊档。`Root` 的下划线选中留给主窗与宏设置，这里只做窄化。
      不叫 `Pill`：`Button.Pill` 已经是另一个东西，窄化规则会把它一起算进来。
    -->
    
    
    
    
    
    
    

    <!--
      设置窗左栏的图标跟着行的状态换色。不能绑 `FANavigationViewItem.Foreground`：库的选中态把
      颜色写在模板里的两个 ContentPresenter 上，item 自己的前景始终是静息色。
    -->
    <Style Selector="fa|FANavigationViewItem views|IconView">
        <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="fa|FANavigationViewItem:pointerover views|IconView">
        <Setter Property="Stroke" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="fa|FANavigationViewItem:selected views|IconView">
        <Setter Property="Stroke" Value="{DynamicResource TextOnAccent}" />
    </Style>

    <!-- 侧栏页签：选中时整行铺强调浅底，左侧一条竖线标位置。 -->
    
    
    
    
    

    <!--
      分类栏那一列方钮。规范注明它"不属 Tab 族"，但在同一个窗口里它和页签是同一个导航面，
      所以放一起比分成两处好找。48×50 是族的度量：图标 22 加一行 `UiCaption` 单行标题。
    -->
    
    
    
    
    

    <!--
      容器与卡片。`Border.Card.Selectable` 当初留了两处空白，现在都定了（"底表达选中、描边表达标记"），
      所以下面四态是写完的——这行注释以前写的是"留着没写"，那是旧状态，别照着它判断这一族空着。

      卡片都不碰焦点：`Views/` 里接点击的 `Border` 是 0 个，可点的卡片全是 `Button` 的替身，
      所以焦点环归外层控件。给纯容器加 `Focusable` 只会造出一个键盘停靠点。
    -->
    <Style Selector="Border.Panel">
        <Setter Property="Padding" Value="{DynamicResource Space4}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusContainer}" />
        <Setter Property="Background" Value="{DynamicResource SurfacePanel}" />
    </Style>
</Styles>
