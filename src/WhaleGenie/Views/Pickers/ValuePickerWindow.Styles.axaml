<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:WhaleGenie.Views">
        <!-- 旧表达式页面的胶囊：28 高、12.5 号字、10/0 内边距、圆角 6、缝 6。 -->
        <Style Selector="Button.ExprChip">
            <Setter Property="Background" Value="{DynamicResource SurfaceField}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.ExprChip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <!-- 分类词：只是一行字，点一下换列表。 -->
        <Style Selector="Button.ChipWord">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0,0,4,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        </Style>
        <Style Selector="Button.ChipWord:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>
        <!-- 当前那一类：底色与字色一起变。悬停那一条也压住，否则指上去就把选中态盖掉了。 -->
        <Style Selector="Button.ChipWord.on">
            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.ChipWord.on /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSurface}" />
        </Style>
        <Style Selector="Button.ChipWord.on:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSurface}" />
        </Style>

        <Style Selector="Button.Op">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceField}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.Op:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="GridSplitter.Split">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="GridSplitter.Split:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <!--
          横向分隔条中间的一小条把手：告诉人这里可以拖。只有横条带它——竖条本身只有 6 像素宽，
          再放一条就把可抓的地方挤没了。静息是控件描边色，指上去换成强调色。
          模板根铺满整条并绑底色，所以原来那条悬停底色与可抓范围都没变。
        -->
        <Style Selector="GridSplitter.BandGrip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Border Name="Grip" Width="40" Height="3" CornerRadius="1.5"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource BorderControl}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="GridSplitter.BandGrip:pointerover /template/ Border#Grip">
            <Setter Property="Background" Value="{DynamicResource AccentFill}" />
        </Style>

        <Style Selector="TextBlock.Note.problem">
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        </Style>

        <!--
          结构带里每一块的共同度量：28 高、12.5 号等宽字、8/3 内边距。块要大到点得中，
          小到一屏放得下一条嵌套式子。各类在它之后定义，只覆写自己的底色与描边。
        -->
        <Style Selector="Border.SlotToken">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!--
          表达式容器：二元、一元、括号、列表共用一套外框。底色按族取，运算符是容器里的一个小按钮，
          不是一块兄弟；容器的叉摘掉整条式子。
        -->
        <Style Selector="Border.SlotExpression">
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.SlotOperatorInline">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="Margin" Value="0,0,1,0" />
            <Setter Property="FontFamily" Value="{DynamicResource UiCodeFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Info}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.SlotOperatorInline:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>
        <Style Selector="TextBlock.SlotBracket">
            <Setter Property="FontFamily" Value="{DynamicResource UiCodeFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="1,0" />
        </Style>

        <!-- 结构带：一块一块都可以点，虚框就是还没填的地方。 -->
        <Style Selector="Border.SlotCall">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceField}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Border.SlotCall:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="Border.SlotRow">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="1,0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.SlotRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="Border.SlotGroup">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.SlotGroup:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="Border.SlotList">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.SlotList:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="Border.SlotValue">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceField}" />
        </Style>
        <Style Selector="Border.SlotValue:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>

        <Style Selector="Panel.SlotEmpty">
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Panel.SlotEmpty.ghost">
            <Setter Property="MinWidth" Value="32" />
        </Style>
        <Style Selector="Rectangle.SlotHole">
            <Setter Property="Stroke" Value="{DynamicResource BorderControl}" />
        </Style>
        <Style Selector="Rectangle.SlotHole.ghost">
            <Setter Property="StrokeDashArray" Value="2,2" />
            <Setter Property="Stroke" Value="{DynamicResource BorderControl}" />
        </Style>
        <Style Selector="Panel.SlotEmpty:pointerover Rectangle">
            <Setter Property="Stroke" Value="{DynamicResource AccentText}" />
        </Style>
        <!-- 必填而空着放在最后：它既有幽灵也有"必填"，颜色该由必填说了算。 -->
        <Style Selector="Rectangle.SlotHole.required">
            <Setter Property="Stroke" Value="{DynamicResource Danger}" />
            <Setter Property="StrokeDashArray" Value="3,2" />
        </Style>

        <!--
          每一块的删除：右上角一枚叉，指针落到这一块上才出现。位置由窗口用 Canvas 定，样式只管长相；
          红底写在模板的 ContentPresenter 上，只改 Button.Background 会被 Fluent 悬停那一条压住。
        -->
        <Style Selector="Button.SlotRemove">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.SlotRemove views|IconView">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{DynamicResource Danger}" />
        </Style>
        <Style Selector="Button.SlotRemove:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerSurface}" />
        </Style>

        <!--
          插入光标：2px 强调色，硬闪。与落点线一样宽，两根线靠「闪不闪」分开，不再靠粗细。
          闪烁写成样式动画而不是计时器：时钟自己推进，窗口不必持有 DispatcherTimer，也不用记得在关窗时停。
          四帧把切换压进 1% 的时长，所以是断的不是渐变——真文本框的光标就是一亮一灭，淡出会像在呼吸。
        -->
        <Style Selector="Border.Caret">
            <Setter Property="Width" Value="2" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Background" Value="{DynamicResource AccentText}" />
            <Style.Animations>
                <Animation Duration="0:0:1.06" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="49%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- 撤销/恢复那样的小方按钮：没有底，指上去才有一层。 -->
        <Style Selector="Button.SlotStep">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.SlotStep:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        </Style>
        <Style Selector="Button.SlotStep:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- 「参数为空」：一句话，不是框，别让人以为那里能点。 -->
        <Style Selector="TextBlock.SlotHint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>

        <!-- 逐行排版的参数名与必填可选：固定宽度让每一行的参数块左边对齐。 -->
        <Style Selector="TextBlock.SlotArgLabel">
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.SlotArgFlag">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.SlotArgFlag.optional">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        </Style>

        <!-- 一层嵌套的边界：递归模板每深一层自己再画一条。 -->
        <Style Selector="Border.SlotGuide">
            <Setter Property="Width" Value="1" />
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <!-- 悬停只叠一层很薄的透明色：底色归函数族，悬停不该把它换成另一块面。 -->
        <Style Selector="Border.HoverWash">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="-6,-2" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.SlotCall:pointerover Border.HoverWash">
            <Setter Property="Background" Value="{DynamicResource OverlayHover}" />
        </Style>
        <Style Selector="Border.SlotValue:pointerover Border.HoverWash">
            <Setter Property="Background" Value="{DynamicResource OverlayHover}" />
        </Style>
        <Style Selector="Border.SlotExpression:pointerover Border.HoverWash">
            <Setter Property="Background" Value="{DynamicResource OverlayHover}" />
        </Style>

        <!-- 字：括号与逗号是同一号窄字，名字与值用等宽字，读得出这是代码。 -->
        <Style Selector="TextBlock.SlotName">
            <Setter Property="FontFamily" Value="{DynamicResource UiCodeFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.SlotSign">
            <Setter Property="FontFamily" Value="{DynamicResource UiCodeFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.SlotComma">
            <Setter Property="FontFamily" Value="{DynamicResource UiCodeFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="-1,0,2,0" />
        </Style>
        <!-- 选中那一块：强调色覆盖层，和红边一样不占布局。 -->
        <Style Selector="Border.SlotSelectEdge">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentText}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="-5,-1,-5,-1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- 有问题的那一块：红边是覆盖层，不占布局，也不会把块撑大或挤动旁边的块。 -->
        <Style Selector="Border.SlotProblemEdge">
            <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="-6,-2,-6,-2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <!-- 小输入框里当前生效的那一枚模式按钮：只描一圈强调色，底不动，免得像按下去没弹回来。 -->
        <Style Selector="Button.Op.on">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentText}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
</Styles>
