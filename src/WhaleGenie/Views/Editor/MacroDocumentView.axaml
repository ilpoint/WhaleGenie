<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhaleGenie.ViewModels"
        xmlns:models="using:WhaleGenie.Models"
        xmlns:conv="using:WhaleGenie.Converters"
        xmlns:loc="using:WhaleGenie.Localization"
        xmlns:views="using:WhaleGenie.Views"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
        x:Class="WhaleGenie.Views.MacroDocumentView"
        x:DataType="vm:MacroEditorViewModel">

    <UserControl.Resources>
        <conv:BoolToOpacityConverter x:Key="RowOpacity" />
    </UserControl.Resources>

    <Design.DataContext>
        <vm:MacroEditorViewModel />
    </Design.DataContext>

    <Border Name="DocumentPanel"
        Background="{DynamicResource SurfacePanel}" CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="18,14">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <ListBox Name="DocumentTabs" ItemsSource="{Binding Documents}"
                    SelectionMode="Single" SelectionChanged="OnDocumentTabChanged"
                    Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MacroDocumentPageViewModel">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="4">
                                <TextBlock Classes="Note" Text="{Binding Title}" />
                                <!-- 有未保存的修改：一小枚实心点，悬停说明它是什么。 -->
                                <Ellipse Grid.Column="1" Width="6" Height="6" Margin="1,0,0,0"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsUnsaved}"
                                    Fill="{DynamicResource TextSecondary}"
                                    ToolTip.Tip="{Binding [Editor.Unsaved], Source={x:Static loc:Strings.Current}}" />
                                <views:IconView Grid.Column="2" Width="12" Height="12"
                                    IsVisible="{Binding HasProblem}"
                                    Stroke="{DynamicResource Danger}" StrokeThickness="1.4"
                                    Data="{x:Static vm:AppIcons.WarningTriangle}" />
                                <Button Grid.Column="3" Name="CloseDocumentButton"
                                    Classes="Ghost Tiny"
                                    IsVisible="{Binding !IsCurrent}"
                                    ToolTip.Tip="{Binding [Common.Close], Source={x:Static loc:Strings.Current}}"
                                    PointerPressed="OnDocumentTabClosePressed"
                                    Click="OnCloseDocumentTab">
                                    <views:IconView Width="9" Height="9"
                                        Stroke="{DynamicResource TextTertiary}"
                                        StrokeThickness="1.3" FitToBounds="True"
                                        Data="{x:Static vm:AppIcons.X}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- What is exported is the page that is showing: the macro itself, or the submacro
                    in front of you with the submacros it holds. -->
                <Button Grid.Column="1" Name="ExportDocumentButton" Classes="Secondary" Height="26"
                    Padding="9,0" VerticalAlignment="Center" Margin="8,0,0,0"
                    ToolTip.Tip="{Binding [Editor.ExportDocumentTip], Source={x:Static loc:Strings.Current}}"
                    Click="OnExportDocumentClicked">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <views:IconView Width="12" Height="12"
                            Stroke="{DynamicResource TextTertiary}"
                            StrokeThickness="1.4" FitToBounds="True"
                            Data="{x:Static vm:AppIcons.ExternalLink}" />
                        <TextBlock
                            Text="{Binding [Editor.ExportDocument], Source={x:Static loc:Strings.Current}}" />
                    </StackPanel>
                </Button>
            </Grid>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding ActionPalette}" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MacroAction">
                        <Button Classes="Icon" Margin="0,0,5,5" Classes.primary="{Binding IsPrimary}"
                            ToolTip.Tip="{Binding Label}"
                            ToolTip.ShowOnDisabled="True"
                            IsEnabled="{Binding IsEnabled}"
                            Command="{Binding $parent[ItemsControl].((vm:MacroEditorViewModel)DataContext).AddActionCommand}"
                            CommandParameter="{Binding}">
                            <views:IconView Width="16" Height="16" Data="{Binding Icon}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- What the design-time check made of the steps, so a problem is known while
                the macro is being written rather than when a trigger fires it. -->
            <StackPanel Grid.Row="2" Spacing="2">
                <TextBlock Classes="Problem" Margin="2,0,0,8" IsVisible="{Binding HasStepProblems}"
                    Text="{Binding ProblemSummary}" />
                <TextBlock Classes="Problem" Margin="2,0,0,8" IsVisible="{Binding HasDeclarationProblems}"
                    Text="{Binding DeclarationProblemSummary}" TextWrapping="Wrap" />
                <TextBlock Classes="Problem" Margin="2,0,0,8" IsVisible="{Binding HasCallImpact}"
                    Text="{Binding CallImpactSummary}" TextWrapping="Wrap" />
                <TextBlock Classes="Problem" Margin="2,0,0,8" IsVisible="{Binding HasNotice}"
                    Text="{Binding Notice}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Empty state -->
            <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4"
                IsVisible="{Binding !HasSteps}" IsHitTestVisible="False">
                <TextBlock Foreground="{DynamicResource TextTertiary}" FontSize="13"
                    Text="{Binding [Editor.NoSteps], Source={x:Static loc:Strings.Current}}"
                    HorizontalAlignment="Center" />
                <TextBlock Text="{Binding [Editor.NoStepsHint], Source={x:Static loc:Strings.Current}}"
                    Classes="Hint" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>

            <!-- Selection is restored after every edit. Following it would drag a long
                macro from the reader's place to whichever row the rebuild picked last.

                步骤是一棵树：块自己的子步骤挂在它下面，不再靠"行上写一个缩进数字"假装。
                `IsExpanded` 连着步骤自己的折叠状态，所以折叠是树控件的本分，不必重建行。 -->
            <TreeView Grid.Row="3" Name="StepList" Classes="Steps"
                ItemsSource="{Binding Roots}" SelectionMode="Multiple"
                AutoScrollToSelectedItem="False"
                Background="Transparent"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <TreeView.ItemContainerTheme>
                    <ControlTheme TargetType="TreeViewItem"
                        BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <!-- 折叠状态住在步骤节点上，树里的每一层都绑同一份，所以块和分节
                            都各自记得自己是开是合。这里用反射绑定：主题没有 `x:DataType`，
                            编译期绑定会拿窗口的 DataContext 去解析它。 -->
                        <Setter Property="IsExpanded"
                            Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </ControlTheme>
                </TreeView.ItemContainerTheme>
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding [Editor.Context.Edit], Source={x:Static loc:Strings.Current}}"
                            Click="OnStepContextEdit" />
                        <MenuItem Header="{Binding [Editor.Context.Copy], Source={x:Static loc:Strings.Current}}"
                            Click="OnStepContextCopy" />
                        <MenuItem Header="{Binding [Editor.Context.Cut], Source={x:Static loc:Strings.Current}}"
                            Click="OnStepContextCut" />
                        <MenuItem Header="{Binding [Editor.Context.Paste], Source={x:Static loc:Strings.Current}}"
                            Click="OnStepContextPaste" />
                        <MenuItem Header="{Binding [Editor.Context.Delete], Source={x:Static loc:Strings.Current}}"
                            Click="OnStepContextDelete" />
                        <Separator />
                        <MenuItem Header="{Binding [Editor.Context.MoveUp], Source={x:Static loc:Strings.Current}}"
                            Click="OnStepContextMoveUp" />
                        <MenuItem Header="{Binding [Editor.Context.MoveDown], Source={x:Static loc:Strings.Current}}"
                            Click="OnStepContextMoveDown" />
                        <MenuItem Header="{Binding [Editor.Context.Group], Source={x:Static loc:Strings.Current}}"
                            Click="OnStepContextGroup" />
                        <MenuItem Header="{Binding [Editor.Context.Lift], Source={x:Static loc:Strings.Current}}"
                            Click="OnStepContextLift" />
                        <Separator />
                        <MenuItem Header="{Binding [Editor.Context.ToggleEnabled], Source={x:Static loc:Strings.Current}}"
                            Click="OnStepContextToggleEnabled" />
                    </ContextMenu>
                </TreeView.ContextMenu>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:StepRow" ItemsSource="{Binding Items}">
                        <!-- 一排三选一：步骤卡片、分节标题、收尾线。放在同一个 `Panel` 里，
                            是为了让"这一行占多高"只有一个答案——拖动落点按它算。 -->
                        <Panel Name="RowHeader">
                            <!-- 引导线：每层一根虚线，走到这一行的中点就向右拐进这一行；
                                某个祖先后面没有兄弟时，那根线只画到拐弯处为止——这就是
                                经典的"├ / └"树形引导线，块结束的地方线也结束。
                                线是画出来的（`GuideLinesView`）：一格一格的矩形拼不出跨行的
                                虚线，每段各自从头数节奏，接起来就是一条毛边。 -->
                            <views:GuideLinesView Lines="{Binding Guides}"
                                Stroke="{DynamicResource TreeGuide}"
                                Thickness="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False" />
                            <!-- 一行一步：图标、名称与三枚徽标、一句摘要，最后是问题。
                                展开箭头归树控件；块里有几步写在块的右边。 -->
                            <Border Classes="StepLine" Classes.problem="{Binding HasProblem}"
                                Classes.selected="{Binding IsPicked}"
                                Classes.container="{Binding IsBlock}"
                                Classes.nested="{Binding IsNested}"
                                Opacity="{Binding RowOpacity}"
                                IsVisible="{Binding IsStep}">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                                        <views:IconView Grid.Column="0" Width="{Binding IconSize}" Height="{Binding IconSize}"
                                            Stroke="{DynamicResource TextPrimary}"
                                            StrokeThickness="1.5" Data="{Binding Icon}"
                                            VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <!-- 名称与徽标不换行：换行会把这一行撑成两行，正是要收掉的东西。
                                            名字太长时省略号截断，完整名字在详情里。 -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="{Binding NameSize}"
                                                FontWeight="{Binding NameWeight}"
                                                Foreground="{DynamicResource TextPrimary}"
                                                TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                            <!-- 跳过是**状态**，走 `Warning`；颜色由 `Badge.Warning` 给 -->
                                            <Border Classes="Badge Warning"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsSkipped}">
                                                <TextBlock Text="{Binding SkipLabel}" Classes="Caption" />
                                            </Border>
                                            <!-- id 是**标识**：用强调色，好在一条长步骤里一眼找到它。 -->
                                            <Border Classes="Badge Accent"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="{Binding IdHint}"
                                                IsVisible="{Binding HasId}">
                                                <TextBlock Text="{Binding Id}" Classes="Caption"
                                                    FontFamily="Consolas,Menlo,monospace" />
                                            </Border>
                                            <!-- Where this step's input goes. -->
                                            <Border Classes="Badge Info"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="{Binding InputMarkHint}"
                                                IsVisible="{Binding HasInputMark}">
                                                <TextBlock Text="{Binding InputMark}" Classes="Caption" />
                                            </Border>
                                        </StackPanel>
                                        <!-- 这一句是这一行里唯一会变长的东西：截断，完整的那句在详情里，
                                            也在悬停提示里。 -->
                                        <TextBlock Grid.Column="2" Classes="Hint" VerticalAlignment="Center"
                                            Text="{Binding Detail}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding Detail}"
                                            IsVisible="{Binding !ShowsDetail}" />
                                        <Border Grid.Column="3" Classes="ProblemTip" IsVisible="{Binding HasProblem}"
                                            ToolTip.Tip="{Binding Problem}">
                                            <views:IconView Classes="ProblemMark" StrokeThickness="1.4"
                                                FitToBounds="True"
                                                Data="{x:Static vm:AppIcons.WarningTriangle}" />
                                        </Border>
                                    </Grid>

                                    <!-- 点中这一行时才展开：截断的那句在这里完整说一遍，再把备注与
                                        执行节奏接上。别的行仍是一行，列表不因为看一步而变长。 -->
                                    <StackPanel Spacing="2" IsVisible="{Binding ShowsDetail}">
                                        <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                            Foreground="{DynamicResource TextPrimary}"
                                            TextWrapping="Wrap"
                                            IsVisible="{Binding HasDetail}" />
                                        <TextBlock Text="{Binding Comment}" FontSize="11.5"
                                            Foreground="{DynamicResource TextSecondary}"
                                            TextWrapping="Wrap"
                                            IsVisible="{Binding HasComment}" />
                                        <TextBlock Text="{Binding MetaSummary}" Classes="Caption"
                                            Foreground="{DynamicResource TextPrimary}"
                                            TextWrapping="Wrap"
                                            IsVisible="{Binding HasMetaSummary}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 块的"体"：这一块跑的是哪些步骤，从这一行往下都属于它。
                                单列表的块也有这一行——没有它，屏幕上就没有"循环体"可以拖进去。 -->
                            <Border Classes="StepBody" IsVisible="{Binding IsSection}">
                                <!-- 名字、步数、空的时候那句话挨着写：拉到行尾的提示在宽窗口里
                                    离标题太远，读起来像另一行的东西。 -->
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                                    <!-- 普通分节只是这一段的标题，点它等于点它上面那一块。 -->
                                    <TextBlock Classes="Note" FontSize="12"
                                        Text="{Binding HeadLabel}"
                                        IsVisible="{Binding IsRegularSection}" />
                                    <!-- 分支的名字是它接的值：值本身就是那一行唯一的内容，
                                        所以它是一枚能点的片——点开就在原地改，不必为一个字段
                                        打开整张表单，也不必先猜双击能改。 -->
                                    <Button Classes="Secondary Chip Dense"
                                        Classes.empty="{Binding !HasCaseValues}"
                                        IsVisible="{Binding ShowsCaseValues}"
                                        Content="{Binding HeadLabel}"
                                        Click="OnEditCaseValues"
                                        ToolTip.Tip="{Binding [Editor.CaseValuesHint], Source={x:Static loc:Strings.Current}}" />
                                    <!-- 一行值也是一格"写成文本、里面的 $名字 会被换掉"的字段，
                                        所以框里那一枚「取值」和步骤表单里的同一颗做同一件事：
                                        把名字放进光标处，或者在挑选窗口里改写成表达式。
                                        片不吃焦点（Focusable=False）：按下它时编辑框不该关掉。 -->
                                    <TextBox Name="CaseValueBox" Classes="Field HasChip" Height="24"
                                        MinWidth="200" MaxWidth="420"
                                        IsVisible="{Binding IsEditingValues}"
                                        Text="{Binding CaseValuesText, Mode=TwoWay}"
                                        PlaceholderText="{Binding [Editor.CaseValuesPlaceholder], Source={x:Static loc:Strings.Current}}"
                                        AttachedToVisualTree="OnCaseValueBoxAttached"
                                        KeyDown="OnCaseValuesKeyDown"
                                        LostFocus="OnCaseValuesLostFocus"
                                        ToolTip.Tip="{Binding [Editor.CaseValuesHint], Source={x:Static loc:Strings.Current}}">
                                        <TextBox.InnerRightContent>
                                            <Button Classes="ValueChip" Focusable="False"
                                                Click="OnPickCaseValuesVariable"
                                                Content="{Binding [Add.Value], Source={x:Static loc:Strings.Current}}"
                                                ToolTip.Tip="{Binding [Add.ValueHint], Source={x:Static loc:Strings.Current}}" />
                                        </TextBox.InnerRightContent>
                                    </TextBox>
                                    <!-- 值后面断开一下：'值 1, 2' 和 '1 个步骤' 挨在一起时会读成
                                        '值 1, 21 个步骤'。普通分节也用同一个断点：'其他情况 · 0 个步骤'
                                        与分支行读起来才是同一张表的两行。 -->
                                    <TextBlock Classes="Caption" VerticalAlignment="Center" Text="·" />
                                    <TextBlock Classes="Caption" VerticalAlignment="Center"
                                        Text="{Binding HeadCount}" />
                                    <TextBlock Classes="Hint" VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        IsVisible="{Binding ShowsEmptyListHint}"
                                        Text="{Binding EmptyListHint}" />
                                </StackPanel>
                            </Border>

                            <!-- 分支表的末尾：下一支从这里加。多分支是唯一的"子步骤没法从动作库里
                                拖进来"的块——库里没有分支这张卡片——所以它自己得给一条能点的行，
                                而不是让人先选中多分支、再点新建，才碰巧加出一支。 -->
                            <Border Classes="StepBody" IsVisible="{Binding IsAddRow}">
                                <Button Classes="Secondary Chip Dense" HorizontalAlignment="Left"
                                    Content="{Binding AddLabel}"
                                    ToolTip.Tip="{Binding AddHint}"
                                    Click="OnAddBranch" />
                            </Border>
                        </Panel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- The band a dragged action drops on. Sits in the same cell as the tree and
                is not hit-testable, so it never swallows the drag that draws it. -->
            <Canvas Grid.Row="3" Name="DropLayer" IsHitTestVisible="False">
                <Border Name="DropMarker" Classes="DropTarget" MinHeight="30" CornerRadius="4"
                    BorderThickness="3,0,0,0" IsVisible="False">
                    <TextBlock Name="DropHintText" Margin="10,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextPrimary}"
                        FontSize="12" TextWrapping="Wrap" />
                </Border>
            </Canvas>



        </Grid>
    </Border>
</UserControl>
