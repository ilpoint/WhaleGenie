<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The text tables, and nothing that needs a window: every string a person reads, the action names
    beside their keys, the words an expression or a run log line is phrased with. The project is
    here so the document model and, later, the MCP side can read the same table without referencing
    the WinExe. Desktop settings and the Avalonia language refresh stay in the interface project.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\core\src\WhaleGenie.Core\WhaleGenie.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The checks read the two language tables whole so a missing key is found before a release. -->
    <InternalsVisibleTo Include="WhaleGenie.Tests" />
    <InternalsVisibleTo Include="WhaleGenie.Editor.Tests" />
    <InternalsVisibleTo Include="WhaleGenie.Actions.Tests" />
    <InternalsVisibleTo Include="WhaleGenie.Domain.Tests" />
    <InternalsVisibleTo Include="WhaleGenie.Core.Tests" />
  </ItemGroup>

</Project>
