<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The protocol and the draft: the server over stdio, the tool surface that reads and writes a
    draft, the resources a client reads, the patch vocabulary and the gateway interface. Nothing
    here touches a window, a screen or a running macro. The tools that do — direct control, running
    a macro, reading its log — live in the interface project and are handed to the server as owners.
  -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WhaleGenie.Core\WhaleGenie.Core.csproj" />
    <ProjectReference Include="..\WhaleGenie.Domain\WhaleGenie.Domain.csproj" />
    <ProjectReference Include="..\WhaleGenie.Localization\WhaleGenie.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WhaleGenie" />
    <InternalsVisibleTo Include="WhaleGenie.App" />
    <InternalsVisibleTo Include="WhaleGenie.Tests" />
    <InternalsVisibleTo Include="WhaleGenie.Editor.Tests" />
    <InternalsVisibleTo Include="WhaleGenie.Actions.Tests" />
    <InternalsVisibleTo Include="WhaleGenie.Mcp.Tests" />
  </ItemGroup>

</Project>
