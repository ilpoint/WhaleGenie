<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Viktor.ViewModels"
        xmlns:loc="using:Viktor.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="740"
        x:Class="Viktor.Views.StepSettingsWindow"
        x:DataType="vm:StepSettingsViewModel"
        Title="Viktor"
        Width="520" Height="740"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="#232323">

    <Design.DataContext>
        <vm:StepSettingsViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="2,0,0,5" />
        </Style>

        <Style Selector="TextBlock.GroupHeader">
            <Setter Property="Foreground" Value="#C9C9C9" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.Hint">
            <Setter Property="Foreground" Value="#7F7F7F" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.Unit">
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#2E2E2E" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="#E4E4E4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#2E2E2E" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="#E4E4E4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style Selector="Button.FlatButton">
            <Setter Property="Background" Value="#404040" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.FlatButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4C4C4C" />
        </Style>

        <Style Selector="Button.PrimaryButton">
            <Setter Property="Background" Value="#C8401C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.PrimaryButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#D9502A" />
        </Style>

        <Style Selector="Button.TitleBarButton">
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.TitleBarButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A4A4A" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="38,Auto,*,Auto">
        <Grid Grid.Row="0" Background="#202020" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                <Border Background="#C8401C" CornerRadius="4" Padding="4,1" Width="30">
                    <TextBlock Text="VIK" Foreground="White" FontWeight="Bold" FontSize="9"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Header}" Foreground="#E8E8E8" FontSize="13"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="2" Classes="TitleBarButton" Name="CloseButton"
                    Margin="8,0" VerticalAlignment="Center">
                <Path Width="10" Height="10" Stroke="White" StrokeThickness="1.6"
                      Data="M 1,1 L 7,7 M 1,7 L 7,1" />
            </Button>
        </Grid>

        <TextBlock Grid.Row="1" Margin="20,14,20,0" TextWrapping="Wrap"
                   Foreground="#AFAFAF" FontSize="12" Text="{Binding Explanation}" />

        <ScrollViewer Grid.Row="2" Margin="20,14,20,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <StackPanel Spacing="0">
                    <TextBlock Classes="FieldLabel"
                               Text="{Binding [StepSettings.Comment], Source={x:Static loc:Strings.Current}}" />
                    <TextBox Text="{Binding Comment}" />
                    <TextBlock Classes="Hint" Margin="2,5,0,0"
                               Text="{Binding [StepSettings.CommentHint], Source={x:Static loc:Strings.Current}}" />

                    <CheckBox Margin="0,10,0,0" IsChecked="{Binding IsStepEnabled}"
                              Content="{Binding [StepSettings.Enabled], Source={x:Static loc:Strings.Current}}" />
                </StackPanel>

                <StackPanel Spacing="0">
                    <TextBlock Classes="GroupHeader" Margin="2,0,0,8"
                               Text="{Binding [StepSettings.Pauses], Source={x:Static loc:Strings.Current}}" />
                    <Grid ColumnDefinitions="Auto,120,Auto,Auto,120,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Classes="FieldLabel" VerticalAlignment="Center"
                                   Text="{Binding [StepSettings.DelayBefore], Source={x:Static loc:Strings.Current}}" />
                        <NumericUpDown Grid.Column="1" Value="{Binding DelayBeforeMs}"
                                       Minimum="0" Maximum="3600000" Increment="10" FormatString="0" />
                        <TextBlock Grid.Column="2" Classes="Unit"
                                   Text="{Binding [StepSettings.Milliseconds], Source={x:Static loc:Strings.Current}}" />
                        <TextBlock Grid.Column="3" Classes="FieldLabel" VerticalAlignment="Center"
                                   Text="{Binding [StepSettings.DelayAfter], Source={x:Static loc:Strings.Current}}" />
                        <NumericUpDown Grid.Column="4" Value="{Binding DelayAfterMs}"
                                       Minimum="0" Maximum="3600000" Increment="10" FormatString="0" />
                        <TextBlock Grid.Column="5" Classes="Unit"
                                   Text="{Binding [StepSettings.Milliseconds], Source={x:Static loc:Strings.Current}}" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="0">
                    <TextBlock Classes="FieldLabel"
                               Text="{Binding [StepSettings.Timeout], Source={x:Static loc:Strings.Current}}" />
                    <Grid ColumnDefinitions="120,Auto,*" ColumnSpacing="8">
                        <NumericUpDown Grid.Column="0" Value="{Binding TimeoutMs}"
                                       Minimum="0" Maximum="3600000" Increment="100" FormatString="0" />
                        <TextBlock Grid.Column="1" Classes="Unit"
                                   Text="{Binding [StepSettings.Milliseconds], Source={x:Static loc:Strings.Current}}" />
                    </Grid>
                    <TextBlock Classes="Hint" Margin="2,5,0,0"
                               Text="{Binding [StepSettings.TimeoutHint], Source={x:Static loc:Strings.Current}}" />
                </StackPanel>

                <StackPanel Spacing="0">
                    <TextBlock Classes="FieldLabel"
                               Text="{Binding [StepSettings.OnError], Source={x:Static loc:Strings.Current}}" />
                    <ComboBox ItemsSource="{Binding FailureOptions}" SelectedIndex="{Binding FailureIndex}" />
                </StackPanel>

                <StackPanel Spacing="0">
                    <TextBlock Classes="GroupHeader" Margin="2,0,0,8"
                               Text="{Binding [StepSettings.Retries], Source={x:Static loc:Strings.Current}}" />
                    <Grid ColumnDefinitions="120,Auto,Auto,120,*" ColumnSpacing="8">
                        <NumericUpDown Grid.Column="0" Value="{Binding RetryCount}"
                                       Minimum="0" Maximum="20" Increment="1" FormatString="0" />
                        <TextBlock Grid.Column="1" Classes="FieldLabel" Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding [StepSettings.RetryDelay], Source={x:Static loc:Strings.Current}}" />
                        <NumericUpDown Grid.Column="2" Value="{Binding RetryDelayMs}"
                                       Minimum="0" Maximum="30000" Increment="100" FormatString="0" />
                        <TextBlock Grid.Column="3" Classes="Unit" Margin="8,0,0,0"
                                   Text="{Binding [StepSettings.Milliseconds], Source={x:Static loc:Strings.Current}}" />
                    </Grid>
                    <TextBlock Classes="Hint" Margin="2,5,0,0"
                               Text="{Binding [StepSettings.RetriesHint], Source={x:Static loc:Strings.Current}}" />

                    <TextBlock Classes="FieldLabel" Margin="2,12,0,5"
                               Text="{Binding [StepSettings.Backoff], Source={x:Static loc:Strings.Current}}" />
                    <ComboBox ItemsSource="{Binding BackoffOptions}" SelectedIndex="{Binding BackoffIndex}" />
                    <TextBlock Classes="Hint" Margin="2,5,0,0"
                               Text="{Binding [StepSettings.BackoffHint], Source={x:Static loc:Strings.Current}}" />

                    <Border Background="#262626" BorderBrush="#333333" BorderThickness="1"
                            CornerRadius="5" Padding="10,8" Margin="0,10,0,0">
                        <TextBlock Foreground="#C8A165" FontSize="12" TextWrapping="Wrap"
                                   Text="{Binding RetryPlan}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="20,16,20,20">
            <Button Classes="PrimaryButton" Height="36" MinWidth="92"
                    Content="{Binding [Common.Ok], Source={x:Static loc:Strings.Current}}"
                    Command="{Binding ConfirmCommand}" />
            <Button Classes="FlatButton" Height="36" MinWidth="92"
                    Content="{Binding [Confirm.Cancel], Source={x:Static loc:Strings.Current}}"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
