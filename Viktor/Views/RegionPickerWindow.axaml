<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Viktor.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="Viktor.Views.RegionPickerWindow"
        Title="Viktor"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="#59000000"
        Cursor="Cross">

    <!-- The whole screen, dimmed, with the rectangle being dragged drawn on top of it. -->
    <Canvas Name="Surface" Background="Transparent" ClipToBounds="True">
        <Border Name="Selection" IsVisible="False" IsHitTestVisible="False"
                BorderBrush="#FF3B30" BorderThickness="2" Background="#22FF3B30" />

        <Border Name="Readout" IsHitTestVisible="False"
                Background="#E01E1E1E" BorderBrush="#3F3F3F" BorderThickness="1"
                CornerRadius="6" Padding="10,7">
            <StackPanel Spacing="3">
                <TextBlock Name="SizeText" FontSize="15" Foreground="#F0F0F0"
                           FontFamily="Consolas,Menlo,monospace" />
                <TextBlock FontSize="12" Foreground="#A0A0A0" MaxWidth="260" TextWrapping="Wrap"
                           Text="{Binding [Region.Hint], Source={x:Static loc:Strings.Current}}" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
