<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Viktor</RootNamespace>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      What the program is called where a person sees it. The projects and namespaces keep the name
      the code has always had; this is only the file people double-click and the name Windows shows
      beside it, so it does not collide with the other program of the old name.
    -->
    <AssemblyName>WhaleGenie</AssemblyName>
    <Product>WhaleGenie</Product>
    <AssemblyTitle>WhaleGenie</AssemblyTitle>
    <ApplicationIcon>Assets\WhaleGenie.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Viktor.Core\Viktor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The interface tests look at the view models and the trigger matching directly. -->
    <InternalsVisibleTo Include="Viktor.Tests" />
  </ItemGroup>
</Project>
