<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The document, the project and the things around a run that need no window: the macro file
    format, the design-time checks, the variables a project keeps, the triggers as values, and the
    services the application layer offers a run. The window suite keeps what drives the window; a
    check that never opens one belongs here, where it costs a second rather than a window toolkit.
  -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WhaleGenie.App\WhaleGenie.App.csproj" />
    <ProjectReference Include="..\..\core\src\WhaleGenie.Core\WhaleGenie.Core.csproj" />
    <ProjectReference Include="..\..\src\WhaleGenie.Domain\WhaleGenie.Domain.csproj" />
    <ProjectReference Include="..\..\src\WhaleGenie.Localization\WhaleGenie.Localization.csproj" />
    <ProjectReference Include="..\WhaleGenie.App.TestSupport\WhaleGenie.App.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="WhaleGenie.TestSupport" />
    <Using Include="WhaleGenie.Tests.Support" />
  </ItemGroup>

</Project>
