#!/usr/bin/env bash
# Reports oversized text files before they enter the repository. It reads the staged blob rather
# than the working tree so a file that is only partly staged is judged by what will be committed.
#
# The size is a signal, not a command: a cohesive file that changes rarely may stay large, while a
# file mixing independently changing concerns should be split by those concerns.

set -euo pipefail

signal_size=20000
root="$(git rev-parse --show-toplevel)"
inventory_file="$root/.githooks/large-file-inventory.tsv"
declare -A inventory_size=()
declare -A inventory_review=()

if [[ -f "$inventory_file" ]]; then
  while IFS=$'\t' read -r bytes path review || [[ -n "$bytes$path" ]]; do
    bytes="${bytes%$'\r'}"
    path="${path%$'\r'}"
    review="${review%$'\r'}"
    [[ -z "$bytes" || "$bytes" == \#* ]] && continue
    inventory_size["$path"]="$bytes"
    inventory_review["$path"]="${review:-pending review}"
  done < "$inventory_file"
fi

# These files are generated, lockfiles, build output, or external material. Their size says
# nothing about how a task reads this repository, so they are not reported.
skipped() {
  case "$1" in
    .githooks/large-file-inventory.tsv|*/.githooks/large-file-inventory.tsv) return 0 ;;
    .git/*|*/.git/*|bin/*|*/bin/*|obj/*|*/obj/*|dist/*|*/dist/*|_site/*|*/_site/*) return 0 ;;
    TestResults/*|*/TestResults/*|third_party/*|LICENSE.txt|NOTICE) return 0 ;;
    package-lock.json|*/package-lock.json|yarn.lock|*/yarn.lock|pnpm-lock.yaml|*/pnpm-lock.yaml) return 0 ;;
    *.lock|*.lock.json|*.g.cs|*.designer.cs|*.generated.*|*.min.js|*.min.css) return 0 ;;
  esac
  return 1
}

# Git already records whether a staged change is binary, so ask it rather than streaming a large
# blob through a pipe that would close early.
is_binary() {
  local stats added
  stats="$(git diff --cached --numstat -- "$1")" || return 1
  added="${stats%%$'\t'*}"
  [[ "$added" == "-" ]]
}

notices=()

while IFS= read -r -d '' status && IFS= read -r -d '' path; do
  if [[ "$status" == R* || "$status" == C* ]]; then
    IFS= read -r -d '' path || break
  fi

  skipped "$path" && continue
  size="$(git cat-file -s ":$path" 2>/dev/null)" || continue
  is_binary "$path" && continue
  (( size > signal_size )) || continue

  if [[ -n "${inventory_size["$path"]+set}" ]]; then
    previous="${inventory_size["$path"]}"
    review="${inventory_review["$path"]}"
    if [[ "$review" == pending* ]]; then
      notices+=("$path"$'\t'"$size"$'\t'"pending"$'\t'"$previous")
    elif (( size > previous )); then
      notices+=("$path"$'\t'"$size"$'\t'"grown"$'\t'"$previous")
    fi
  else
    notices+=("$path"$'\t'"$size"$'\t'"new"$'\t'"0")
  fi
done < <(git diff --cached --name-status -z --diff-filter=ACMR)

if (( ${#notices[@]} == 0 )); then
  exit 0
fi

printf '文件大小检查（提示，不阻止提交）：\n' >&2
printf '以下暂存文本文件超过 %s 字节的检查线。\n' "$signal_size" >&2
for item in "${notices[@]}"; do
  IFS=$'\t' read -r path size kind previous <<< "$item"
  case "$kind" in
    grown) printf '  %s：%s 字节（已接受为大而内聚，原大小 %s，本次增长）\n' "$path" "$size" "$previous" >&2 ;;
    pending) printf '  %s：%s 字节（清单中仍待评估）\n' "$path" "$size" >&2 ;;
    *) printf '  %s：%s 字节（尚未评估）\n' "$path" "$size" >&2 ;;
  esac
done
cat >&2 <<'EOF'
不要仅因超过检查线就拆分。先判断它是否混合了多个可以独立变化的关注点：
  - 是：按业务关注点拆分，让一次任务只读取相关内容，不按 helpers/utils 之类技术层拆。
  - 否：单一职责、高度内聚、很少与别处同时修改的文件可以保持原样；评估后把路径、当前大小与
    "keep: 内聚理由" 写进 .githooks/large-file-inventory.tsv。只有写清理由的文件才会在大小不变时静默。
这次提交继续执行。
EOF
exit 0
